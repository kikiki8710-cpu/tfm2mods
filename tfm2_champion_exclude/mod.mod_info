{
  "name": "tfm2_champion_exclude",
  "mod_id": "tfm2_champion_exclude",
  "author": "tfm2mods",
  "version": "0.3.0",
  "description": "인게임 시즌 패치의 신규 챔피언 추가 대상에서 특정 챔피언(바닐라·모드 모두)을 영구 제외. 환경설정 → 게임플레이 탭 맨 아래 '추가 챔피언 설정' 버튼으로 아직 추가되지 않은 챔피언을 골라 제외할 수 있고(팝업 UI — 클래스 필터·이름 검색 지원), 선택은 champion_exclude.cfg 에 저장된다('*' 한 줄 = 전면 차단, 수동 편집도 가능). 제외된 챔피언은 패치 후보에서 걸러져 절대 출시되지 않으며, 전부 제외하면 '모든 챔피언 추가 완료'와 동일하게 동작(추가 알림 없음). 이미 출시된 챔피언은 건드리지 않음. 진단 로그 = champion_exclude.txt. 게임 0.5.6 대응.",
  "last_updated": "2026-08-23",
  "dependencies": [
    {
      "mod_id": "base",
      "version": ">=0.5.6, <0.5.7"
    }
  ]
}
