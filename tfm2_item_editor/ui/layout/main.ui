        height: 1px;

        color: #a6a6a6ff;
      }

      #etc_category:empty {
        width: 100%;
        height: 152px;

        child_type: TopToBottom {
          spacing: 4px;
        }
      }
      
      #bar6:color {
        anchor_x: 0.5;
        pivot_x: 0.5;

        width: 215px;
        height: 1px;

        color: #a6a6a6ff;
      }

      #house_category:empty {
        width: 100%;
        height: 48px;

        child_type: TopToBottom {
          spacing: 4px;
        }
      }

      #scrim_category:empty {
        width: 100%;
        height: 48px;

        child_type: TopToBottom {
          spacing: 4px;
        }

        #scrim_btn:color_icon_button {
          width: 100%;
          height: 48px;
          hover_sound: "asset/base/sound/sfx/UI_mouse_hover";
          click_sound: "asset/base/sound/sfx/UI_mouse_click";
          color: #8a8d96ff;
          hover: { color: #e8e8e8ff; }
          active: { color: #e8e8e8ff; }
          btn: {
            color: #00000000;
            hover: { color: #ffffff14; }
            active: { color: #ffffff1f; }
          }

          icon: {
            source: "asset/base/ui/icons/statistics";
            rect: {
              x: 24;
              y: 12;
              w: 24;
              h: 24;
            }
          }

          text: {
            text: "#asset/base/text/ui?main.scrim";
            rect: {
              x: 56;
              y: 14;
              w: 184;
              h: 20;
            }
            font: "asset/base/font/set/bold";
            size: 18;
            align_x: Left;
            align_y: Center;
          }
        }
      }

      #ie_bar:color {
        anchor_x: 0.5; pivot_x: 0.5;
        width: 215px; height: 1px; color: #a6a6a6ff;
      }
      #ie_category:empty {
        width: 100%; height: 48px;
        child_type: TopToBottom { spacing: 4px; }
        #ie_open_box:color {
          width: 100%; height: 40px;
          back_color: #1d2740ff; color: #4a6c9aff; stroke: 1;
          rounding: Uniform { rounding: 6; }
          #ie_open_t:label {
            @"asset/base/style/main#label";
            width: 100%; height: 100%; align_x: Center; align_y: Center;
            size: 16; ignore_event: true; text: "아이템 편집";
          }
          #ie_open:button {
            width: 100%; height: 100%;
            hover_sound: "asset/base/sound/sfx/UI_mouse_hover";
          }
        }
      }

      #home:empty {
        width: 100%;
        height: 48px;
        anchor_y: 1;
        pivot_y: 1;
      }
    }

    #right:empty {
      width: 1656px;
      height: 100%;
    }
  }

  #scrim_modal:empty {
    width: 100%;
    height: 100%;

    visible: false;

    #scrim_close:color_icon_button {
      width: 100%;
      height: 100%;
      btn: { color: #000000bb; }
    }

    #panel:color {
      anchor_x: 0.5; pivot_x: 0.5;
      anchor_y: 0.5; pivot_y: 0.5;
      width: 1120px;
      height: 640px;
      color: #161721ff;
      rounding: Uniform { rounding: 12; }

      #header:label {
        @"asset/base/style/main#bold_label";
        x: 30px; y: 24px; width: 400px; height: 30px;
        align_y: Center; size: 22;
        ignore_event: true;
        text: "#asset/base/text/ui?main.scrim";
      }

      #scrim_close:button {
        width: 18px; height: 18px;
        anchor_x: 1; pivot_x: 1; x: -28px; y: 26px;
        source: "asset/base/ui/icons/cross";
        color: #c2c6ceff;
        hover: { color: #e8e8e8ff; }
        active: { color: #e8e8e8ff; }
      }

      #scrim_msg:label {
        @"asset/base/style/main#label";
        x: 30px; y: 64px; width: 1000px; height: 200px;
        align_y: Top; size: 18;
        ignore_event: true;
        text: "선수와 챔피언을 모두 선택하세요";
      }

      #scrim_head:empty {
        x: 62px; y: 122px; width: 966px; height: 26px;
