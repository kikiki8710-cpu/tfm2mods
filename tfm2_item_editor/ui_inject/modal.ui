ie_modal:empty {
  width: 100%;
  height: 100%;
  visible: false;
  #ie_dim:color_icon_button {
    width: 100%; height: 100%;
    btn: { color: #000000c0; }
  }
  #ie_panel:color {
    anchor_x: 0.5; pivot_x: 0.5;
    anchor_y: 0.5; pivot_y: 0.5;
    width: 900px; height: 880px;
    color: #161721ff;
    rounding: Uniform { rounding: 12; }
    #ie_title:label {
      @"asset/base/style/main#bold_label";
      x: 30px; y: 18px; width: 520px; height: 32px;
      align_y: Center; size: 22; ignore_event: true; text: "아이템 편집";
    }
    #ie_close:button {
      anchor_x: 1; pivot_x: 1; x: -28px; y: 26px; width: 20px; height: 20px;
      source: "asset/base/ui/icons/cross"; color: #c2c6ceff;
      hover: { color: #e8e8e8ff; } active: { color: #e8e8e8ff; }
      hover_sound: "asset/base/sound/sfx/UI_mouse_hover";
    }
    #ie_hdr_bg:color { x: 30px; y: 60px; width: 824px; height: 30px; back_color: #191b25ff; color: #2d3140ff; stroke: 1; rounding: Uniform { rounding: 5; } }
    #ie_hdr0:label { @"asset/base/style/main#bold_label"; x: 44px; y: 62px; width: 286px; height: 26px; align_x: Left; align_y: Center; size: 13; ignore_event: true; text: "이름"; }
    #ie_hdr1:label { @"asset/base/style/main#bold_label"; x: 334px; y: 62px; width: 92px; height: 26px; align_x: Center; align_y: Center; size: 13; ignore_event: true; text: "가격"; }
    #ie_hdr2:label { @"asset/base/style/main#bold_label"; x: 426px; y: 62px; width: 80px; height: 26px; align_x: Center; align_y: Center; size: 13; ignore_event: true; text: "공격"; }
    #ie_hdr3:label { @"asset/base/style/main#bold_label"; x: 506px; y: 62px; width: 80px; height: 26px; align_x: Center; align_y: Center; size: 13; ignore_event: true; text: "주문"; }
    #ie_hdr4:label { @"asset/base/style/main#bold_label"; x: 586px; y: 62px; width: 80px; height: 26px; align_x: Center; align_y: Center; size: 13; ignore_event: true; text: "방어"; }
    #ie_hdr5:label { @"asset/base/style/main#bold_label"; x: 666px; y: 62px; width: 84px; height: 26px; align_x: Center; align_y: Center; size: 13; ignore_event: true; text: "체력"; }
    #ie_hdr6:label { @"asset/base/style/main#bold_label"; x: 750px; y: 62px; width: 90px; height: 26px; align_x: Center; align_y: Center; size: 13; ignore_event: true; text: "마저"; }
    #ie_scroll:scroll_view {
      x: 30px; y: 94px; width: 856px; height: 666px;
      speed: 100; bar_width: 4;
      bar: { source: "asset/base/sprite/white"; color: #37d5b3ff; hover: { color: #ecfbf8ff; } }
      back: { source: "asset/base/sprite/white"; color: #00000000; }
      #ie_list:empty {
        width: 828px; height: 4140px;
        child_type: TopToBottom { spacing: 4px; }
      #ie_row00:color {
        width: 824px; height: 42px;
        back_color: #1d1f2cff; color: #34384aff; stroke: 1; rounding: Uniform { rounding: 5; }
        #ie_row00_n:label { @"asset/base/style/main#label"; x: 14px; width: 286px; height: 100%; align_x: Left; align_y: Center; size: 15; ignore_event: true; text: ""; }
        #ie_row00_v0:label { @"asset/base/style/main#label"; x: 304px; width: 92px; height: 100%; align_x: Center; align_y: Center; size: 14; ignore_event: true; text: ""; }
        #ie_row00_v1:label { @"asset/base/style/main#label"; x: 396px; width: 80px; height: 100%; align_x: Center; align_y: Center; size: 14; ignore_event: true; text: ""; }
        #ie_row00_v2:label { @"asset/base/style/main#label"; x: 476px; width: 80px; height: 100%; align_x: Center; align_y: Center; size: 14; ignore_event: true; text: ""; }
        #ie_row00_v3:label { @"asset/base/style/main#label"; x: 556px; width: 80px; height: 100%; align_x: Center; align_y: Center; size: 14; ignore_event: true; text: ""; }
        #ie_row00_v4:label { @"asset/base/style/main#label"; x: 636px; width: 84px; height: 100%; align_x: Center; align_y: Center; size: 14; ignore_event: true; text: ""; }
        #ie_row00_v5:label { @"asset/base/style/main#label"; x: 720px; width: 90px; height: 100%; align_x: Center; align_y: Center; size: 14; ignore_event: true; text: ""; }
        #ie_row00_b:button { width: 100%; height: 100%; hover_sound: "asset/base/sound/sfx/UI_mouse_hover"; }
      }
