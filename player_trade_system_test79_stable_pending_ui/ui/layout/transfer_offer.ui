          x: 16px;
          y: 50px;
          width: 324px;
          height: 108px;
          color: #252835ff;
          rounding: Uniform { rounding: 8; }

          #tag:label {
            @"asset/base/style/main#label";
            x: 14px; y: 8px; width: 296px; height: 22px;
            text: "영입 대상"; size: 14; color: #b9c0ccff; align_y: Center;
          }
          #pts_trade_custom_target_position_icon:image {
            x: 14px; y: 42px; width: 24px; height: 24px;
            source: "asset/base/ui/icons/mid"; ignore_event: true;
          }
          #pts_trade_custom_target_name:label {
            @"asset/base/style/main#bold_label";
            x: 48px; y: 32px; width: 258px; height: 32px;
