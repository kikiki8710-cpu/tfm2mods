    width: 1608px;
    height: 32px;
    align_x: Left;
    align_y: Center;
    size: 24;
    color: #e8e8e8ff;
  }

  #data:empty {
    y: 32px;
    width: 1608px;
    height: 100%;
    
    #row1:empty {
      width: 1608px;
      height: 341px;
      y: 10px;

      #info:color {
        width: 696px;
        height: 341px;

        rounding: Uniform {
          rounding: 12;
        }

        color: #161721ff;

        child_type: TopToBottom {
          spacing: 0px;
        }

        #header:color {
          width: 696px;
          height: 80px;

          color: #0f1016ff;

          #face_slot:color {
            x: 10px;
            y: 10px;
