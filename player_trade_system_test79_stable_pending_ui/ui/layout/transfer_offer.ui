  #amount_popup_layer:empty {
    width: 1920px;
    height: 1080px;
    x: -288px;
    y: -24px;
    visible: false;

    anchor_x: 0;
    pivot_x: 0;
    anchor_y: 0;
    pivot_y: 0;

    #fade:color {
      width: 100%;
      height: 100%;
      color: #60708540;
    }

    #amount_popup:color {
      width: 415px;
      height: 248px;

      anchor_x: 0.5;
      pivot_x: 0.5;
      anchor_y: 0.5;
      pivot_y: 0.5;

      color: #161721ff;

      rounding: Uniform {
        rounding: 12;
      }

      #header:label {
        @"asset/base/style/main#bold_label";

        width: 300px;
        height: 28px;

        size: 18;

        align_y: Center;
        text: "#asset/base/text/ui?amount_change.header";

        x: 24px;
        y: 24px;
      }

      #cancel:button {
        width: 16px;
        height: 16px;

        anchor_x: 1;
        pivot_x: 1;

        x: -24px;
        y: 24px;

        source: "asset/base/ui/icons/cross";

        color: #c2c6ceff;

        hover: {
          color: #e8e8e8ff;
        }

        active: {
          color: #e8e8e8ff;
        }
      }

      #amount:text_edit {
        @"asset/base/style/main#text_edit";

        width: 275px;
        height: 46px;
        y:66px;
        x: 24px;

        size: 18;
        align_y: Center;

        padding: {
          left: 15px;
          top: 5px;
          right: 15px;
          bottom: 5px;
        }

        placeholder: "#asset/base/text/ui?amount_change.placeholder";
        max_length: 12;
      }

      #unit:label {
        @"asset/base/style/main#label";
        x: 309px;
        y: 66px;

        width: 82px;
        height: 46px;

        text: "";
        size: 18;
        align_y: Center;
      }

      #desc:label {
