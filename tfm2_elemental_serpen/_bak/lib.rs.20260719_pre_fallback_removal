static DB_INGAME: AtomicBool = AtomicBool::new(false);
static DB_PTR: AtomicUsize = AtomicUsize::new(0);
static DB_A_PROV: AtomicUsize = AtomicUsize::new(0);
static DB_A_SEED: AtomicU64 = AtomicU64::new(0);
static DB_A_KNOWN: AtomicBool = AtomicBool::new(false);
static DB_B_PROV: AtomicUsize = AtomicUsize::new(0);
