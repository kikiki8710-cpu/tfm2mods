// ── Skia dispatcher detour: 세르펜 시트 커맨드의 텍스처 키를 속성 키로 교체 (그리기 직전) ──
type DispFn = extern "win64" fn(usize, usize, usize, usize, f32) -> usize;
extern "win64" fn disp_detour(a: usize, b: usize, c: usize, d: usize, e: f32) -> usize {
    RENDER_TID.store(unsafe { GetCurrentThreadId() }, Ordering::Relaxed); // dispatcher=렌더(관전) 스레드
    let t = DISP_TRAMP.load(Ordering::Relaxed);
    if t == 0 { return 0; }
    let orig: DispFn = unsafe { core::mem::transmute(t) };
    // 빠른 게이트: d 유효 + (swap이 켜져있고 속성 설정됨) 또는 probe
    if d > 0x10000 && d < (1usize << 48) {
        // 생산자 seam이 켜져 있으면 디스패처 교체는 하지 않는다(이중 교체 방지).
        let do_swap = !CFG_PRODUCER_SEAM.load(Ordering::Relaxed)
            && (CFG_SKIA_FORCE.load(Ordering::Relaxed)
                || (CFG_SKIA_SWAP.load(Ordering::Relaxed) && CURRENT_ATTR.load(Ordering::Relaxed) != -2));
        let do_probe = CFG_SKIA_PROBE.load(Ordering::Relaxed) && SKIA_PROBE_HITS.load(Ordering::Relaxed) < 20;
        if do_swap || do_probe {
            let v = unsafe { core::ptr::read_volatile(d as *const u64) };
            let tag = if v & 0x8000_0000_0000_0000 != 0 { (v & 0xff) as u32 } else { 7 };
            if tag == 3 || tag == 4 {
                if let Ok(Some(newd)) = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| unsafe {
                    inspect_or_swap_cmd(d, do_swap, do_probe)
                })) {
                    return orig(a, b, c, newd, e);
                }
            }
        }
    }
    orig(a, b, c, d, e)
}
// tag3/4 커맨드 검사: serpen 키 로그(probe) + 원본 serpen#sheet면 속성 키로 교체한 복사본 반환(swap).
unsafe fn inspect_or_swap_cmd(d: usize, do_swap: bool, do_probe: bool) -> Option<usize> {
    let kptr = *((d + 0x10) as *const usize);
    let klen = *((d + 0x18) as *const usize);
    if kptr < 0x10000 || klen < 10 || klen > 200 { return None; }
    // ★성능(2026-07-19): 여기는 **드로우 커맨드마다** 도는 최핫 경로다. 예전엔 모든 커맨드에 대해
    //   키 200바이트를 VEH 복사한 뒤 windows(6) 전수 스캔("serpen" 찾기, 커맨드당 ~1200회 바이트비교)
    //   을 돌렸다. 실제로 필요한 판정은 "키가 ingame/serpen#sheet로 끝나는가" 하나뿐 →
    //   꼬리 19바이트만 읽어 한 번 비교한다. 세르펜 아닌 커맨드(대다수)는 여기서 즉시 탈락.
    const SUF: &[u8] = b"ingame/serpen#sheet";
    // 진단 로그는 상한(20건)까지만 의미가 있으므로, 채워지면 스스로 꺼져 느린 경로가 사라진다.
    let probe_live = do_probe && SKIA_PROBE_HITS.load(Ordering::Relaxed) < 20;
    if !probe_live {
        if !do_swap || klen < SUF.len() { return None; }
        let mut tail = [0u8; 19];
        if !safe_copy(tail.as_mut_ptr(), (kptr + klen - SUF.len()) as *const u8, SUF.len()) { return None; }
        if tail != *SUF { return None; }
    } else {
        // 느린 경로: 진단이 살아있는 동안만 — 전체 키를 읽어 로그로 남긴다.
        let mut kb = [0u8; 200];
        if !safe_copy(kb.as_mut_ptr(), kptr as *const u8, klen) { return None; }
        let key = &kb[..klen];
        if !key.windows(6).any(|w| w == b"serpen") { return None; }
        if SKIA_PROBE_HITS.fetch_add(1, Ordering::Relaxed) < 20 {
            log_push(format!("[{}ms] SKIA key='{}' (len {})", now_ms(), String::from_utf8_lossy(key), klen));
        }
        if !do_swap { return None; }
        if !key.ends_with(SUF) { return None; }
    }
    // ★★커맨드 구조체 실측 덤프(2026-07-19) — 목적: **src rect(잘라낼 프레임 영역)** 필드 찾기.
    //   지금은 키(+0x10/+0x18)만 교체해서, 시트를 다른 크기로 갈면 게임이 계산해둔 바닐라 rect
    //   (예: idle=60,0,59,79)로 새 시트의 좌상단 조각만 퍼올린다(= "이상하게 나옴"의 원인).
    //   커맨드 안의 src rect를 찾아 우리 프레임표로 덮으면 png와 무관하게 프레임 배치를 바꿀 수 있고,
    //   dst rect까지 찾으면 크기(3배 등)도 바꿀 수 있다 → 리소스 override 없이 fanim 대체 효과.
    //   바닐라 값(x=0/60/120/180/240/300/360/450/648/850/1078.., w=59/89/197/201/227, h=75~225)을
    //   알고 있으므로, f32로 해석해 그 값이 나오는 오프셋이 곧 src rect다.
    if CFG_SKIA_PROBE.load(Ordering::Relaxed) && CMD_DUMP_N.load(Ordering::Relaxed) < 10 {
        let mut cb = [0u8; 0x120];
        if safe_copy(cb.as_mut_ptr(), d as *const u8, 0x120) {
            let n = CMD_DUMP_N.fetch_add(1, Ordering::Relaxed);
            let mut f32s = String::new();
            for i in 0..(0x120 / 4) {
                let v = f32::from_le_bytes([cb[i*4], cb[i*4+1], cb[i*4+2], cb[i*4+3]]);
                // 화면·시트 좌표로 그럴듯한 범위만 (rect 후보)
                if v.is_finite() && v != 0.0 && v.abs() >= 0.5 && v.abs() < 8192.0 && v.fract() * 8.0 == (v.fract() * 8.0).trunc() {
                    f32s.push_str(&format!("+{:#05x}={:.2} ", i * 4, v));
                }
            }
            log_push(format!("[{}ms] ◆CMD덤프#{} d={:#x}\n   f32후보: {}\n   hex: {}",
                now_ms(), n, d, f32s,
                cb.iter().map(|b| format!("{:02x}", b)).collect::<Vec<_>>().join("")));
        }
    }
    // ★어떤 바닐라 프레임을 그리는 중인지 먼저 판별 — 죽는 프레임(슬롯 10~17)이면 "방금 죽은"
    //   웨이브의 속성으로 그려야 한다. 처치 순간 카운터가 올라가 CURRENT_ATTR이 이미 다음
    //   세르펜을 가리키기 때문(안 그러면 죽는 모션만 다음 세르펜 모습으로 나온다).
    //   슬롯 판별은 여기서 **한 번만** 하고 아래 UV 교체에서 재사용한다(이중 계산 방지).
    let van_slot: Option<usize> = {
        let u = *((d + 0x68) as *const f32);
        let du = *((d + 0x70) as *const f32);
        if u.is_finite() && du.is_finite() && du > 0.0 {
            let vx = u * VAN_SHEET_W;
            let mut best = 0usize; let mut bd = f32::MAX;
            for (i, fx) in VAN_FRAME_X.iter().enumerate() {
                let dd = (fx - vx).abs();
                if dd < bd { bd = dd; best = i; }
            }
            if bd <= 8.0 { Some(best) } else { None }
        } else { None }
    };
    let dying = van_slot.map_or(false, |s| s >= 10);   // 슬롯 10~17 = dead
    let pool = POOL.lock().unwrap_or_else(|e| e.into_inner());
    let elder = ELDER.lock().unwrap_or_else(|e| e.into_inner());
    let attr: &Attr = if CFG_SKIA_FORCE.load(Ordering::Relaxed) {
        // [검증] 무조건 fire(빨강)로 — 모든 세르펜이 빨강이면 텍스처 교체 파이프라인 OK (원본 초록과 확연히 구분)
        pool.iter().find(|a| a.name == "fire").or_else(|| pool.first())?
    } else {
        // 죽는 프레임 = 방금 죽은 웨이브(PREV_ATTR), 그 외 = 현재 웨이브
        let mut idx = if dying { PREV_ATTR.load(Ordering::Relaxed) } else { CURRENT_ATTR.load(Ordering::Relaxed) };
        if idx == -2 && dying { idx = CURRENT_ATTR.load(Ordering::Relaxed); } // 직전값 없으면 폴백
        if idx == -2 { return None; }
        if idx == ELDER_IDX { elder.as_ref()? } else { pool.get(idx as usize)? }
    };
    if attr.sheet_key.is_empty() { return None; }
    // 커맨드 복사 → 키만 교체 → 복사본으로 그리기 (게임 메모리 무변경)
    let buf = core::ptr::addr_of_mut!(CMD_BUF) as *mut u8;
    core::ptr::copy_nonoverlapping(d as *const u8, buf, 0x120);
    *(buf.add(0x10) as *mut usize) = attr.sheet_key.as_ptr() as usize;
    *(buf.add(0x18) as *mut usize) = attr.sheet_key.len();
    // ★★fanim 교체 = src UV(+0x68) 재작성 (2026-07-19 커맨드 구조 실측으로 확정).
    //   +0x68: (u, v, du, dv) = 바닐라 시트(1498×226) 기준 정규화 좌표. +0x78/+0x7c = dst 좌상단.
    //   그리는 크기를 담은 필드는 **없다** — 크기는 UV×텍스처크기로 유도된다(높이 79↔77 프레임
    //   비교에서 바뀌는 화면값이 dst y 하나뿐, 그리고 중심 648이 보존됨 = 중앙 기준 그리기).
    //   따라서 UV를 새 시트 기준으로 바꾸면 프레임 배치와 크기가 함께 따라오고, 중심 유지를 위해
    //   dst를 (구크기-새크기)/2 만큼 보정해주면 된다.
    if !attr.frames.is_empty() && attr.sheet_w > 0.0 {
        let u = *(buf.add(0x68) as *const f32);
        let v = *(buf.add(0x6c) as *const f32);
        let du = *(buf.add(0x70) as *const f32);
        let dv = *(buf.add(0x74) as *const f32);
        // ★좌우 반전 = `+0x90` 바이트 플래그 (2026-07-19 RE 확정, 디스패처 0x9f6129 case3).
        //   디스패처는 flip_x!=0이면 translate(dst) 뒤에 scale(-1,1)을 걸고 쿼드를 (0,0,w,h)로 그린다
        //   → **반전 시 dst_x는 쿼드의 오른쪽 끝**이 된다. 생산자(엔티티 드로우 0x13c4e90)도
        //   `dst_x = ex + (flip ? +0.5 : -0.5)·w`, `dst_y = ey - (0.5·h + extra)`로 계산한다.
        //   ⇒ 불변량: center_x = dst_x - s·w/2 (s = flip ? +1 : -1),  center_y = dst_y + h/2
        //   UV 자체는 항상 양수다(반전을 UV로 표현하지 않는다).
        let flip_x = *(buf.add(0x90) as *const u8) != 0;
        if u.is_finite() && v.is_finite() && du.is_finite() && dv.is_finite()
            && du > 0.0 && dv > 0.0 {
            let vx = u * VAN_SHEET_W;                        // 바닐라 시트상 프레임 x
            let (vw, vh) = (du * VAN_SHEET_W, dv * VAN_SHEET_H); // 현재 그려지는 크기
            if let Some(best) = van_slot {                   // 위에서 이미 판별한 슬롯 재사용
                let ni = VAN_TO_NEW[best].min(attr.frames.len() - 1);
                let [nx, ny, nw, nh] = attr.frames[ni];
                // UV는 항상 양수 — 반전은 +0x90 플래그가 처리하므로 여기서 손대지 않는다.
                *(buf.add(0x68) as *mut f32) = nx / attr.sheet_w;
                *(buf.add(0x6c) as *mut f32) = ny / attr.sheet_h;
                *(buf.add(0x70) as *mut f32) = nw / attr.sheet_w;
                *(buf.add(0x74) as *mut f32) = nh / attr.sheet_h;
                // ★중심 보존 보정 — dst는 quad의 **좌상단**이고, 게임은 `dst = 중심 - 바닐라크기/2`로
                //   계산해 둔다(덤프 실측: 높이 79→dst_y 608.5, 77→609.5로 중심 648이 불변).
                //   우리가 크기를 바꿨으니 같은 중심을 유지하려면 새 크기 기준으로 다시 잡아야 한다:
                //     dst' = 중심 - 새크기/2 = dst + (바닐라크기 - 새크기)/2
                //   ⚠2026-07-19: 이 보정을 "이중 보정"으로 오판해 제거했다가 프레임마다 좌우로 튀었다.
                //     당시 어긋남의 진짜 원인은 fanim 파서 버그로 UV 교체 자체가 꺼져 있던 것이었고,
                //     이 코드는 실행조차 되지 않았다. 프레임 폭이 제각각이므로 이 보정이 반드시 필요하다.
                let dx = *(buf.add(0x78) as *const f32);
                let dy = *(buf.add(0x7c) as *const f32);
                // 셀 크기가 전 프레임 동일하므로, 보정을 꺼도 흔들리지 않고 "일정한 오프셋"만 남는다
                //   → 그 방향·크기를 보면 앵커 규칙이 확정된다. serpen.cfg로 켜고 끄며 실측 중.
                let (mut ndx, mut ndy) = (dx, dy);
                if SPR_CENTER_FIX.load(Ordering::Relaxed) {
                    // ★RE 확정 보정식: s = flip ? +1 : -1
                    //   dst_x' = dst_x + s·(nw-vw)/2 ,  dst_y' = dst_y - (nh-vh)/2
                    //   ⚠예전엔 s를 항상 -1로 고정해, 반대쪽을 볼 때만 가로가 어긋났다("한쪽으로 치우침").
                    let s = if flip_x { 1.0f32 } else { -1.0f32 };
                    ndx += s * (nw - vw) * 0.5;
                    ndy -= (nh - vh) * 0.5;
                }
                ndx += SPR_OFF_X.load(Ordering::Relaxed) as f32;
                ndy += SPR_OFF_Y.load(Ordering::Relaxed) as f32;
                if dx.is_finite() && dy.is_finite() {
                    *(buf.add(0x78) as *mut f32) = ndx;
                    *(buf.add(0x7c) as *mut f32) = ndy;
                }
                // 진단 카운터는 상한을 넘으면 원자적 증가(RMW)조차 하지 않게 load로 먼저 거른다
                // 진단(앵커 측정)은 skia_probe 플래그로만 — 규명 완료라 배포본에선 OFF.
                let n = if CFG_SKIA_PROBE.load(Ordering::Relaxed)
                    && UV_SWAP_N.load(Ordering::Relaxed) < 250 {
                    UV_SWAP_N.fetch_add(1, Ordering::Relaxed) } else { u64::MAX };
                // ★기준점 규명용 연속 측정: 한 세르펜의 idle→attack→dead 동안 바닐라 rect가 크게
                //   변하는데(59x79 ↔ 227x225 ↔ 3x3), 그때 dst가 어떻게 따라 움직이는지를 봐야
                //   앵커가 중심인지 다른 점인지 확정된다. 중복 줄을 줄이려고 값이 바뀔 때만 기록.
                if n < 250 {
                    let key = (best as u64) << 32 | (dx as i64 as u64 & 0xffff_ffff);
                    if UV_LAST_KEY.swap(key, Ordering::Relaxed) != key {
                        // 중심 불변량(RE): center_x = dst_x - s·w/2, center_y = dst_y + h/2
                        let s = if flip_x { 1.0f32 } else { -1.0f32 };
                        log_push(format!("[{}ms] ◆앵커 슬롯{:2} {}van({:.0}x{:.0}) 중심({:.1},{:.1}) | 새({:.0}x{:.0}) dst {:.1},{:.1}->{:.1},{:.1}",
                            now_ms(), best, if flip_x { "<반전> " } else { "" },
                            vw, vh, dx - s * vw * 0.5, dy + vh * 0.5,
                            nw, nh, dx, dy, ndx, ndy));
                    }
                }
            }
        }
    }
    let h = SWAP_HITS.fetch_add(1, Ordering::Relaxed);
    // ★장로 스왑 전용 카운터 — 재생이 장로 웨이브에 닿았을 때 elder 텍스처 교체가 실제 발화하는지 확정.
    let is_elder = CURRENT_ATTR.load(Ordering::Relaxed) == ELDER_IDX && !CFG_SKIA_FORCE.load(Ordering::Relaxed);
    if is_elder {
        let en = ELDER_SWAP_N.fetch_add(1, Ordering::Relaxed);
        if en < 4 { log_push(format!("[{}ms] ★장로 SKIA SWAP#{} → '{}'", now_ms(), en, attr.sheet_key)); }
    } else if h < 6 {
        log_push(format!("[{}ms] SKIA SWAP#{} → '{}'", now_ms(), h, attr.sheet_key));
    }
    Some(buf as usize)
}
// ★★skia 디스패처 = 다른 모드(map_skin_selector 등)도 후킹하는 공유 지점 → **체인 후킹**(CLAUDE.md §3).
//   "덮어쓰기" 금지: 진입부가 이미 외부 훅(48 b8 <tgt> ff e0)이면 그 12B를 내 트램폴린에 담아 tgt(외부
//   스텁)로 점프시킨다 → 게임 → 내 detour → 외부 detour → 원본, 순차 발화(양쪽 다 작동).
//   ⚠먼저 설치하면 상대가 덮어 고아되므로 **매 프레임 진입부 재검증**: 내 스텁이 아니면 그때의 12B로
//   재체인(상대가 나중에 덮어써도 다음 프레임에 그 위에 다시 얹음). 체인 시 프롤로그 검증은 skip.
static DISP_CHAIN_N: AtomicU64 = AtomicU64::new(0);
unsafe fn ensure_disp_chain() {
    let base = GetModuleHandleW(core::ptr::null());
    if base == 0 { return; }
    let fn_addr = base + DISP_RVA;
    let dt = disp_detour as usize;
    let mut cur = [0u8; 12];
    if !safe_copy(cur.as_mut_ptr(), fn_addr as *const u8, 12) { return; }
    // 진입부가 "movabs rax,imm64; jmp rax" 형태면 누군가의 훅
    let is_hook = cur[0] == 0x48 && cur[1] == 0xb8 && cur[10] == 0xff && cur[11] == 0xe0;
    if is_hook {
        let tgt = usize::from_le_bytes(match cur[2..10].try_into() { Ok(v) => v, Err(_) => return });
        if tgt == dt { return; } // 내 훅이 살아있음 — 할 일 없음
    } else if cur != DISP_PROLOGUE {
        return; // 원본도 훅도 아닌 미지의 진입부 → 건드리지 않음(안전)
    }
    // (재)체인: 지금 진입부 12B를 트램폴린에 담는다. 매번 새로 할당(실행 중 트램폴린 덮어쓰기 레이스 회피).
    let stub = VirtualAlloc(0, 64, 0x3000, 0x40);
    if stub == 0 { return; }
    let mut sb: Vec<u8> = Vec::new();
    sb.extend_from_slice(&cur); // 외부훅이면 이 12B가 곧 외부 스텁으로 점프 / 원본이면 프롤로그
    if !is_hook {
        // 원본 프롤로그였다면 나머지 본문(fn+12)으로 이어줌
        sb.extend_from_slice(&[0x48, 0xb8]);
        sb.extend_from_slice(&((fn_addr + 12) as u64).to_le_bytes());
        sb.extend_from_slice(&[0xff, 0xe0]);
    }
    core::ptr::copy_nonoverlapping(sb.as_ptr(), stub as *mut u8, sb.len());
    DISP_TRAMP.store(stub, Ordering::Relaxed);
    // 진입부를 내 detour로 교체
    let mut patch = [0u8; 12];
    patch[0] = 0x48; patch[1] = 0xb8; patch[2..10].copy_from_slice(&dt.to_le_bytes());
    patch[10] = 0xff; patch[11] = 0xe0;
    let mut old = 0u32;
    if VirtualProtect(fn_addr, 12, 0x40, &mut old) == 0 { return; }
    core::ptr::copy_nonoverlapping(patch.as_ptr(), fn_addr as *mut u8, 12);
    VirtualProtect(fn_addr, 12, old, &mut old);
    FlushInstructionCache(GetCurrentProcess(), fn_addr, 12);
    DISP_HOOK_INSTALLED.store(true, Ordering::Relaxed);
    let n = DISP_CHAIN_N.fetch_add(1, Ordering::Relaxed);
    if n < 8 {
        log_push(format!("[{}ms] skia disp {} (fn={:#x} 트램폴린={:#x} 재체인#{}) — 외부훅 공존",
            now_ms(), if is_hook { "★체인 후킹(외부훅 위에 얹음)" } else { "일반 후킹(원본)" }, fn_addr, stub, n));
    }
}

// ── 렌더 함수 detour: view-entity 덤프 (속성판정: 위치+0x164 vs 상태Vec+0xa0 확인) ──
type RenderFn = extern "win64" fn(u64, u64, u64, u64, u64, u64, u64) -> u64;
extern "win64" fn render_detour(rcx: u64, rdx: u64, r8: u64, r9: u64, a5: u64, a6: u64, a7: u64) -> u64 {
    RENDER_TID.store(unsafe { GetCurrentThreadId() }, Ordering::Relaxed); // 렌더=메인 스레드 식별
    if CFG_RENDER_PROBE.load(Ordering::Relaxed) && RENDER_HITS.load(Ordering::Relaxed) < 24 {
        let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| unsafe { probe_render(rdx); }));
    }
    let t = RENDER_TRAMP.load(Ordering::Relaxed);
    if t != 0 { let orig: RenderFn = unsafe { core::mem::transmute(t) }; orig(rcx, rdx, r8, r9, a5, a6, a7) } else { rcx }
}
unsafe fn probe_render(ve: u64) {
    let ve = ve as usize;
    if ve < 0x10000 { return; }
    // 스프라이트 이름 +0x58/+0x60
    let np = match safe_read_u64(ve + 0x58) { Some(v) => v as usize, None => return };
    let nl = safe_read_u64(ve + 0x60).unwrap_or(0) as usize;
    if np < 0x10000 || nl == 0 || nl > 40 { return; }
    let mut nb = [0u8; 40];
    if !safe_copy(nb.as_mut_ptr(), np as *const u8, nl) { return; }
    if &nb[..nl.min(6)] != b"serpen" { return; } // 세르펜 렌더만
    let name = String::from_utf8_lossy(&nb[..nl]).into_owned();
    let h = RENDER_HITS.fetch_add(1, Ordering::Relaxed);
    if h >= 24 { return; }
    // 위치 +0x164 (2×f32)
    let px = safe_read_i32(ve + 0x164).map(|v| f32::from_bits(v as u32));
    let py = safe_read_i32(ve + 0x168).map(|v| f32::from_bits(v as u32));
    // owner 핸들 +0x0 (16B)
    let o0 = safe_read_u64(ve).unwrap_or(0);
    let o1 = safe_read_u64(ve + 8).unwrap_or(0);
    // 상태Vec +0xa0(ptr)/+0xa8(len), 원소 0x28, 이름 +0x8/+0x10
    let sp = safe_read_u64(ve + 0xa0).unwrap_or(0) as usize;
    let sl = safe_read_u64(ve + 0xa8).unwrap_or(0) as usize;
    let mut buffs = String::new();
    if sp > 0x10000 && sl <= 16 {
        for i in 0..sl {
            let e = sp + i * 0x28;
            let bnp = safe_read_u64(e + 8).unwrap_or(0) as usize;
            let bnl = safe_read_u64(e + 0x10).unwrap_or(0) as usize;
            if bnp > 0x10000 && bnl > 0 && bnl <= 40 {
                let mut bb = [0u8; 40];
                if safe_copy(bb.as_mut_ptr(), bnp as *const u8, bnl) {
                    buffs.push_str(&format!("'{}' ", String::from_utf8_lossy(&bb[..bnl])));
                }
            }
        }
    }
    // ★ view-entity 안의 포인터 중 sim 세르펜 엔티티(kind@+0x68==6) 가리키는 오프셋 스캔 (zero-write 연결점)
    let mut sim = String::new();
    let mut off = 0usize;
    while off < 0x200 {
        if let Some(p) = safe_read_u64(ve + off) {
            if looks_heap(p) && safe_read_i32(p as usize + ENTITY_KIND_OFF) == Some(SERPEN_KIND) {
                let id = safe_read_u64(p as usize + O_ENTITY_ID).unwrap_or(0);
                let hp = safe_read_i32(p as usize + O_CUR_HP).unwrap_or(-1);
                sim.push_str(&format!("ve+{:#x}→ent{:#x}(id={:#x},hp={}) ", off, p, id, hp));
            }
        }
        off += 8;
    }
    log_push(format!("[{}ms] RENDER#{} name='{}' ve={:#x} pos=({:?},{:?}) state[{}]={{{}}}\n  simEntScan: {}",
        now_ms(), h, name, ve, px, py, sl, buffs.trim(),
        if sim.is_empty() { "없음".into() } else { sim }));
}
fn install_render_hook() {
    if RENDER_HOOK_INSTALLED.swap(true, Ordering::Relaxed) { return; }
    unsafe {
        let base = GetModuleHandleW(core::ptr::null());
        if base == 0 { RENDER_HOOK_INSTALLED.store(false, Ordering::Relaxed); return; }
        let fn_addr = base + RENDER_RVA;
        for i in 0..12 {
            if *((fn_addr + i) as *const u8) != RENDER_PROLOGUE[i] {
                log_push(format!("[{}ms] render prologue mismatch @+{}: {:#x}", now_ms(), i, *((fn_addr + i) as *const u8)));
                return;
            }
        }
        let stub = VirtualAlloc(0, 64, 0x3000, 0x40);
        if stub == 0 { return; }
        let mut sb: Vec<u8> = Vec::new();
        sb.extend_from_slice(&RENDER_PROLOGUE);
        sb.extend_from_slice(&[0x48, 0xb8]); sb.extend_from_slice(&((fn_addr + 0xc) as u64).to_le_bytes());
        sb.extend_from_slice(&[0xff, 0xe0]);
        core::ptr::copy_nonoverlapping(sb.as_ptr(), stub as *mut u8, sb.len());
        RENDER_TRAMP.store(stub, Ordering::Relaxed);
        let d = render_detour as usize;
        let mut patch = [0u8; 12];
        patch[0] = 0x48; patch[1] = 0xb8; patch[2..10].copy_from_slice(&d.to_le_bytes());
        patch[10] = 0xff; patch[11] = 0xe0;
        let mut old = 0u32;
        if VirtualProtect(fn_addr, 12, 0x40, &mut old) == 0 { return; }
        core::ptr::copy_nonoverlapping(patch.as_ptr(), fn_addr as *mut u8, 12);
        VirtualProtect(fn_addr, 12, old, &mut old);
        FlushInstructionCache(GetCurrentProcess(), fn_addr, 12);
        log_push(format!("[{}ms] render hook installed fn={:#x} (RVA {:#x})", now_ms(), fn_addr, RENDER_RVA));
    }
}

// ── sheet 룩업 detour: serpen 키 룩업 시 콜스택/컨텍스트 캡처 (인월드 렌더 경로 규명) ──
type SheetFn = extern "win64" fn(u64, u64, u64) -> u64;
extern "win64" fn sheet_detour(rcx: u64, rdx: u64, r8: u64) -> u64 {
    if CFG_SHEET_PROBE.load(Ordering::Relaxed) && SHEET_HITS.load(Ordering::Relaxed) < 30 {
        let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| unsafe {
            probe_sheet(rcx, rdx, r8);
        }));
    }
    // ★ base 세르펜 속성 키 → modid 네임스페이스 키 교체 (override 없이 모드 이미지 참조)
    let (krdx, kr8) = if CFG_KEY_SWAP.load(Ordering::Relaxed) {
        std::panic::catch_unwind(|| unsafe { maybe_swap_key(rdx, r8) }).ok().flatten().unwrap_or((rdx, r8))
    } else { (rdx, r8) };
    let t = SHEET_TRAMP.load(Ordering::Relaxed);
    if t != 0 { let orig: SheetFn = unsafe { core::mem::transmute(t) }; orig(rcx, krdx, kr8) } else { 0 }
}
// key가 원본 "asset/base/aseprite_resources/ingame/serpen#anim|#sheet"면 → 관전 세르펜 속성(CURRENT_ATTR)의 modid 키로 교체.
unsafe fn maybe_swap_key(rdx: u64, r8: u64) -> Option<(u64, u64)> {
    let len = r8 as usize;
    if len < 30 || len > 200 { return None; }
    let mut kb = [0u8; 200];
    if !safe_copy(kb.as_mut_ptr(), rdx as *const u8, len) { return None; }
    let key = &kb[..len];
    if !key.starts_with(b"asset/base/") { return None; }
    // 원본 세르펜 키 = ".../ingame/serpen#anim" 또는 "#sheet" (속성 없는 순수 serpen)
    let is_anim = key.ends_with(b"#anim");
    let is_sheet = key.ends_with(b"#sheet");
    if !is_anim && !is_sheet { return None; }
    if !key.windows(14).any(|w| w == b"ingame/serpen#") { return None; }
    // 관전 세르펜 속성
    let idx = CURRENT_ATTR.load(Ordering::Relaxed);
    if idx == -2 { return None; } // 미설정
    let pool = POOL.lock().unwrap_or_else(|e| e.into_inner());
    let elder = ELDER.lock().unwrap_or_else(|e| e.into_inner());
    let attr: &Attr = if idx == ELDER_IDX {
        match elder.as_ref() { Some(a) => a, None => return None }
    } else {
        match pool.get(idx as usize) { Some(a) => a, None => return None }
    };
    let k = if is_anim { &attr.anim_key } else { &attr.sheet_key };
    if k.is_empty() { return None; }
    Some((k.as_ptr() as u64, k.len() as u64))
}
unsafe fn probe_sheet(rcx: u64, rdx: u64, r8: u64) {
    let len = r8 as usize;
    if len == 0 || len > 200 { return; }
    let mut kb = [0u8; 200];
    if !safe_copy(kb.as_mut_ptr(), rdx as *const u8, len) { return; }
    let key = &kb[..len];
    // "serpen" 포함 키만 (base serpen 또는 우리 serpen_<attr>)
    if !key.windows(6).any(|w| w == b"serpen") { return; }
    let h = SHEET_HITS.fetch_add(1, Ordering::Relaxed);
    if h >= 30 { return; }
    let keys = String::from_utf8_lossy(key).into_owned();
    let base = EXE_BASE.load(Ordering::Relaxed);
    let mut bt = [0usize; 16];
    let cap = RtlCaptureStackBackTrace(1, 16, bt.as_mut_ptr(), core::ptr::null_mut()) as usize;
    let mut rvas: Vec<String> = Vec::new();
    for i in 0..cap.min(16) {
        let a = bt[i];
        if base != 0 && a > base && a < base + 0x6000000 { rvas.push(format!("{:#x}", a - base)); }
    }
    log_push(format!("[{}ms] SHEET#{} key='{}' rcx={:#x}\n    callstack RVAs=[{}]", now_ms(), h, keys, rcx, rvas.join(", ")));
}
fn install_sheet_hook() {
    if SHEET_HOOK_INSTALLED.swap(true, Ordering::Relaxed) { return; }
    unsafe {
        let base = GetModuleHandleW(core::ptr::null());
