    }
}
unsafe fn probe_buffapply(n: u64, r8: u64, r9: u64) {
    // GameSetting = *(r9+8) → 버프 name(+0xe3c, len@+0xe38)
    let Some(gs) = safe_read_u64(r9 as usize + 8) else { return; };
    if (gs as usize) < 0x10000 { return; }
    let Some(nlen) = safe_read_i32(gs as usize + GS_BUFF_NAMELEN) else { return; };
    if nlen <= 0 || nlen > 63 { log_push(format!("[{}ms] buffapply#{} r8={:#x} r9={:#x} gs={:#x} name_len={} (범위밖)", now_ms(), n, r8, r9, gs, nlen)); return; }
    let mut buf = [0u8; 64];
    if !safe_copy(buf.as_mut_ptr(), (gs as usize + GS_BUFF_NAME) as *const u8, nlen as usize) { return; }
    let name = String::from_utf8_lossy(&buf[..nlen as usize]).into_owned();
    // ★세르펜 버프만 로그 — epic_minion_buff(모르가드)가 처치당 수십 회 발화해 로그를 다 잡아먹는다.
    if !name.contains("serpen") { return; }
    let sn = SERPEN_BUFF_N.fetch_add(1, Ordering::Relaxed);
    if sn >= 12 { return; }
    // ★실제 뿌려지는 스탯값 — 0이 아닌 항목만. 우리 config 값(예: 바다 vamp/hp_regen)이
    //   보이면 모드 버프가 이 경로에 반영된 것이고, 바닐라 값이면 이 경로는 GameSetting 고정분이다.
    let sb = gs as usize + GS_BUFF_STATS;
    let stats: Vec<String> = (0..NUM_STATS)
        .filter_map(|i| stat_read(sb, i).filter(|v| *v != 0).map(|v| format!("[{}]={}", i, v)))
        .collect();
    log_push(format!("[{}ms] buffapply#{} name='{}' stats{{{}}} r8(ScoreState)={:#x} gs={:#x}",
        now_ms(), n, name, stats.join(" "), r8, gs));
}
fn install_buffapply_hook() {
    if BUFFAPPLY_HOOK_INSTALLED.swap(true, Ordering::Relaxed) { return; }
    unsafe {
        let base = GetModuleHandleW(core::ptr::null());
        if base == 0 { BUFFAPPLY_HOOK_INSTALLED.store(false, Ordering::Relaxed); return; }
        let fn_addr = base + BUFFAPPLY_RVA;
        for i in 0..12 {
            if *((fn_addr + i) as *const u8) != BUFFAPPLY_PROLOGUE[i] {
                log_push(format!("[{}ms] buffapply prologue mismatch @+{}: {:#x} (RVA {:#x})",
                    now_ms(), i, *((fn_addr + i) as *const u8), BUFFAPPLY_RVA));
                return;
            }
        }
        let stub = VirtualAlloc(0, 64, 0x3000, 0x40);
        if stub == 0 { return; }
        let mut sb: Vec<u8> = Vec::new();
        sb.extend_from_slice(&BUFFAPPLY_PROLOGUE);
        sb.extend_from_slice(&[0x48, 0xb8]); sb.extend_from_slice(&((fn_addr + 0xc) as u64).to_le_bytes());
        sb.extend_from_slice(&[0xff, 0xe0]);
        core::ptr::copy_nonoverlapping(sb.as_ptr(), stub as *mut u8, sb.len());
        BUFFAPPLY_TRAMP.store(stub, Ordering::Relaxed);
        let d = buffapply_detour as usize;
        let mut patch = [0u8; 12];
        patch[0] = 0x48; patch[1] = 0xb8; patch[2..10].copy_from_slice(&d.to_le_bytes());
        patch[10] = 0xff; patch[11] = 0xe0;
        let mut old = 0u32;
        if VirtualProtect(fn_addr, 12, 0x40, &mut old) == 0 { return; }
        core::ptr::copy_nonoverlapping(patch.as_ptr(), fn_addr as *mut u8, 12);
        VirtualProtect(fn_addr, 12, old, &mut old);
        FlushInstructionCache(GetCurrentProcess(), fn_addr, 12);
        log_push(format!("[{}ms] buffapply hook installed fn={:#x} stub={:#x} (RVA {:#x})",
            now_ms(), fn_addr, stub, BUFFAPPLY_RVA));
    }
}

// ── FUN_141fcdcc0 detour: serpen 이펙트 push 시 콜스택 캡처 (버프 어플라이어 특정) ──
type PushFn = extern "win64" fn(u64, u64);
extern "win64" fn push_detour(rcx: u64, rdx: u64) {
    if CFG_PUSH_PROBE.load(Ordering::Relaxed) && PUSH_SERPEN_HITS.load(Ordering::Relaxed) < 40 {
        let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| unsafe {
            probe_push(rcx, rdx);
        }));
    }
    let t = PUSH_TRAMP.load(Ordering::Relaxed);
    if t != 0 {
        let orig: PushFn = unsafe { core::mem::transmute(t) };
        orig(rcx, rdx);
    }
}
unsafe fn probe_push(rcx: u64, rdx: u64) {
    // 값싼 게이트: 이펙트 name_len(rdx+0) 먼저 → 6~63만, 아니면 즉시 return (hot-path 최소부담)
    let Some(nlen) = safe_read_i32(rdx as usize) else { return; };
    if nlen < 6 || nlen > 63 { return; }
    let mut nb = [0u8; 6];
    if !safe_copy(nb.as_mut_ptr(), (rdx as usize + 4) as *const u8, 6) { return; }
    if &nb != b"serpen" { return; } // serpen 이펙트만
    let h = PUSH_SERPEN_HITS.fetch_add(1, Ordering::Relaxed);
    if h >= 16 { return; }
    // 이펙트(rdx) 0x120 전체 덤프 → 스탯블록(+0x58) 검증 + tail(소스 핸들) 확인
    let mut eff = [0u8; 0x120];
    if !safe_copy(eff.as_mut_ptr(), rdx as *const u8, 0x120) { return; }
    let rd = |o: usize| i32::from_le_bytes([eff[o], eff[o + 1], eff[o + 2], eff[o + 3]]);
    let rq = |o: usize| u64::from_le_bytes(eff[o..o + 8].try_into().unwrap());
    let name_len = rd(0) as usize;
    let name = String::from_utf8_lossy(&eff[4..(4 + name_len.min(60)).min(0x120)]).into_owned();
    // 스탯블록 +0x58 i32 30개 (game_setting serpen_permanent_buff: attack_mult=stats[1], magic_power_mult=[3], defence_mult=[5], mr_mult=[9], move_speed_mult=[12])
    let mut stats = String::new();
    for k in 0..30 { stats.push_str(&format!("{} ", rd(0x58 + k * 4))); }
    // tail: +0x100~+0x120 u64 4개 (소스/caster 핸들 후보 = r15+0x98/0xa0)
    let mut tail = String::new();
    for k in 0..4 { tail.push_str(&format!("+{:#x}={:#x} ", 0x100 + k * 8, rq(0x100 + k * 8))); }
    // 대상 챔피언
    let ckind = rd_entity(rcx, ENTITY_KIND_OFF);
    let cid = safe_read_u64(rcx as usize + O_ENTITY_ID);
    // ⚠Team* 자동탐색은 제거 — 임의 포인터를 320회 역참조하는 위험·고비용 코드였고, 게임이
    //   처치 이력(provider+0xed20)에 team을 직접 담아주므로 애초에 불필요했다. (side@0x820도 팀 아님)
    log_push(format!(
        "[{}ms] PUSH serpen#{} name='{}' → champ={:#x} kind={:?} id={:?}\n  stats@+0x58 i32[30]=[{}]",
        now_ms(), h, name, rcx, ckind, cid, stats.trim()
    ));
    let _ = (rdx, rq(0x48), tail);
}
unsafe fn rd_entity(ent: u64, off: usize) -> Option<i32> { safe_read_i32(ent as usize + off) }

// ── BUILD 계층 detour: param_4 → 관전경기 provider/seed 도달 프로브 ──
type BuildFn = extern "win64" fn(u64, u64, u64, u64, u64) -> u64; // 5인자(p5..p8=rcx/rdx/r8/r9 + view=5th스택)
