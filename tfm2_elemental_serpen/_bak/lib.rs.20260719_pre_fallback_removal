unsafe fn probe_build(param4: u64) {
    let h = BUILD_HITS.fetch_add(1, Ordering::Relaxed);
    if h >= 10 { return; }
    let d230 = safe_read_u64(param4 as usize + 0x230);
    let d238 = safe_read_u64(param4 as usize + 0x238);
    let mut extra = String::new();
    if let (Some(data), Some(vt)) = (d230, d238) {
        if data > 0x10000 && vt > 0x10000 {
            if let Some(m) = safe_read_u64(vt as usize + 0x48) {
                if m > 0x10000 {
                    let f: extern "win64" fn(u64) -> u64 = core::mem::transmute(m as usize);
                    let obj = f(data); // shadow-call
                    let x = if obj > 0x10000 { safe_read_u64(obj as usize + 0x1660).unwrap_or(0) } else { 0 };
                    let seed = if x > 0x10000 { safe_read_u64(x as usize + SEED_OFF).unwrap_or(0) } else { 0 };
                    let known = { let wg = WORLDS.lock().unwrap_or_else(|e| e.into_inner()); wg.as_ref().map(|w| w.contains_key(&seed)).unwrap_or(false) };
                    extra = format!(" obj={:#x} x@0x1660={:#x} seed={:#x} WORLDS_has={}", obj, x, seed, known);
                }
            }
        }
    }
    log_push(format!("[{}ms] BUILD#{} param4={:#x} +0x230={:?} +0x238={:?}{}",
        now_ms(), h, param4, d230.map(|v| format!("{:#x}", v)), d238.map(|v| format!("{:#x}", v)), extra));
}
