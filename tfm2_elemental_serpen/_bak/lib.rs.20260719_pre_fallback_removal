            AMP_SEEN_N.load(Ordering::Relaxed), EXEC_CAND_N.load(Ordering::Relaxed)));
        s.push_str(&format!("[☠처형/화면] 화면경기 발화={}회 (0이면 화면 경기에서 조건 미성립 = 원인 그쪽)\n",
            AMP_FIRE_LIVE_N.load(Ordering::Relaxed)));
        s.push_str(&format!("[☠처형탈락] 비챔대상={} disc={} 팀={} TLS월드={} dense={} 창없음={} 임계초과={} 공격자비챔={}\n",
            AMP_REJ[0].load(Ordering::Relaxed), AMP_REJ[1].load(Ordering::Relaxed),
            AMP_REJ[2].load(Ordering::Relaxed), AMP_REJ[3].load(Ordering::Relaxed),
            AMP_REJ[4].load(Ordering::Relaxed), AMP_REJ[5].load(Ordering::Relaxed),
            AMP_REJ[6].load(Ordering::Relaxed), AMP_REJ[8].load(Ordering::Relaxed)));
        s.push_str(&format!("[장로UI] 잔여틱(B/R)=({}, {}) 표시갱신={}회 노드미발견={}회\n",
            ELDER_LEFT_B.load(Ordering::Relaxed), ELDER_LEFT_R.load(Ordering::Relaxed),
            ELDER_UI_N.load(Ordering::Relaxed), ELDER_NODE_MISS.load(Ordering::Relaxed)));
        let bsrc = |team: usize| -> String {
            let v = LAST_BUFF_SRC[team].load(Ordering::Relaxed);
            if v == 0 { "없음".into() } else { format!("처치#{} kill={}", (v >> 32) & 0xff, v & 0xffffffff) }
        };
        s.push_str(&format!("[장로UI출처] 블루={} | 레드={} | 버프ON로그={}회\n",
            bsrc(0), bsrc(1), ELDER_ANOMALY_N.load(Ordering::Relaxed)));
        s.push_str(&format!("[화면카운터] 세르펜 화면처치수 B={} R={} | 장로버프시작(game_time) B={} R={}\n",
            SERPEN_CNT_ONSCREEN[0].load(Ordering::Relaxed), SERPEN_CNT_ONSCREEN[1].load(Ordering::Relaxed),
            ELDER_BUFF_START[0].load(Ordering::Relaxed), ELDER_BUFF_START[1].load(Ordering::Relaxed)));
        s.push_str(&format!("[★런처] 발화={}회 화면경기적중={}회 RENDER_SEED={:#x} 최근retaddr_rva={:#x}\n",
            LAUNCH_N.load(Ordering::Relaxed), LAUNCH_HIT.load(Ordering::Relaxed),
            RENDER_SEED.load(Ordering::Relaxed), LAUNCH_LAST_RVA.load(Ordering::Relaxed)));
        { // 런처 호출처 distinct — 다시보기에서 적중=0이면 여기 목록 중 하나가 다시보기 경로다
            let g = LAUNCH_RVAS.lock().unwrap_or_else(|e| e.into_inner());
            let list: Vec<String> = g.as_ref().map(|v| v.iter()
                .map(|(r, c)| format!("{:#x}×{}{}", r, c,
                    if *r == LAUNCHER_RET_A as u64 || *r == LAUNCHER_RET_B as u64 { "★게이트" } else { "" }))
                .collect()).unwrap_or_default();
            s.push_str(&format!("[런처호출처] {}\n", if list.is_empty() { "없음".into() } else { list.join(" ") }));
        }
        if let Some(w) = wg.as_mut() {
            // 죽은 경기 정리. ⚠화면 경기(LIVE_SEED)는 절대 지우지 않는다 — sim이 화면보다 앞서
            //   끝나면 detour가 더 안 오지만(last_ms 정지) 화면은 그 프레임을 재생 중이라 waves가 필요.
            w.retain(|sd, ws| *sd == ls || now.saturating_sub(ws.last_ms) < 60_000);
            let mut list: Vec<(&u64, &WorldState)> = w.iter().collect();
            list.sort_by_key(|(_, ws)| core::cmp::Reverse(ws.last_ms));
            s.push_str(&format!("[경기별] 총 {}경기 (★=화면경기)\n", list.len()));
            for (seed, ws) in list.iter().take(6) {
                let live = if ls != 0 && **seed == ls { "★" } else { " " };
                let nm = |i: i32| -> String {
                    if i == ELDER_IDX { elder.as_ref().map(|a| a.display_name.clone()).unwrap_or_else(|| "?".into()) }
                    else { pool.get(i as usize).map(|a| a.display_name.clone()).unwrap_or_else(|| "?".into()) }
                };
                s.push_str(&format!("  {}seed={:#x} 웨이브#{} spawn_tick={} 색='{}' sim_tick={} 처치={}건 최근={}ms전\n",
                    live, seed, ws.wave_idx, ws.spawn_tick, nm(ws.current), ws.sim_tick,
                    ws.kills.len(), now.saturating_sub(ws.last_ms)));
            }
        }
        s
    };
    let v = PROBE_LOG.lock().unwrap_or_else(|e| e.into_inner());
    let n = v.len();
    if n == 0 { return; }
    // 경기별 상태는 계속 변하므로, 로그 줄수가 200줄 만석으로 고정된 뒤에도 1초 주기로 flush
    if n == LOG_FLUSHED_LEN.load(Ordering::Relaxed)
        && now.saturating_sub(LAST_FLUSH_MS.load(Ordering::Relaxed)) < 1000 { return; }
    LOG_FLUSHED_LEN.store(n, Ordering::Relaxed);
    LAST_FLUSH_MS.store(now, Ordering::Relaxed);
    let head = format!("enter_count={} seh_faults={}\n{}", ENTER_COUNT.load(Ordering::Relaxed), unsafe {
        *(core::ptr::addr_of!(SEH) as *const u64).add(7)
    }, dump);
    write_log("serpen_probe.txt", &(head + &v.join("\n")));
}
static LAST_FLUSH_MS: AtomicU64 = AtomicU64::new(0);

// ───────────────────────── cfg 로드 ─────────────────────────
fn load_cfg() {
    let Some(txt) = read_text("serpen_probe.cfg") else { return; };
    for line in txt.lines() {
        let line = line.trim();
        if line.is_empty() || line.starts_with('#') { continue; }
        let Some((k, v)) = line.split_once('=') else { continue; };
        let (k, v) = (k.trim(), v.split('#').next().unwrap_or("").trim()); // 인라인 주석(#) 제거
        let on = v == "1" || v.eq_ignore_ascii_case("true");
        match k {
            "probe_log" => CFG_PROBE_LOG.store(on, Ordering::Relaxed),
            "entity_lookup" => CFG_ENTITY_LOOKUP.store(on, Ordering::Relaxed),
            "gamectx_probe" => CFG_GAMECTX_PROBE.store(on, Ordering::Relaxed),
            "buffapply_probe" => CFG_BUFFAPPLY_PROBE.store(on, Ordering::Relaxed),
            "push_probe" => CFG_PUSH_PROBE.store(on, Ordering::Relaxed),
            "tooltip" => CFG_TOOLTIP.store(on, Ordering::Relaxed),
            "execute" => CFG_EXECUTE.store(on, Ordering::Relaxed), // 장로 처형   // arg_str 훅(크래시, 재시도금지)
            // ⚠게임함수 shadow-call 포함 → 기본 OFF. 이식 가능여부 1회 판정용.
            "anim_probe" => CFG_ANIM_PROBE.store(on, Ordering::Relaxed),
            // 1=생산자 seam(키 리졸버) / 0=기존 디스패처 UV 교체. 둘은 배타.
            "producer_seam" => CFG_PRODUCER_SEAM.store(on, Ordering::Relaxed),
            "tip_node" => CFG_TIP_NODE.store(on, Ordering::Relaxed), // 노드 텍스트 교체(크래시)
            "tip_panel" => CFG_TIP_PANEL.store(on, Ordering::Relaxed), // v3: 모드 소유 패널(안전)
            "attr_system" => CFG_ATTR_SYSTEM.store(on, Ordering::Relaxed),
            "elemental_enabled" => CFG_ELEMENTAL.store(on, Ordering::Relaxed), // 원소 세르펜 온오프
            "elder_enabled" => CFG_ELDER.store(on, Ordering::Relaxed),         // 장로 세르펜 온오프
            "sheet_probe" => CFG_SHEET_PROBE.store(on, Ordering::Relaxed),
            "name_probe" => CFG_NAME_PROBE.store(on, Ordering::Relaxed),
            "name_swap" => CFG_NAME_SWAP.store(on, Ordering::Relaxed),
            "key_swap" => CFG_KEY_SWAP.store(on, Ordering::Relaxed),
            "render_probe" => CFG_RENDER_PROBE.store(on, Ordering::Relaxed),
            "skia_probe" => CFG_SKIA_PROBE.store(on, Ordering::Relaxed),
            "skia_swap" => CFG_SKIA_SWAP.store(on, Ordering::Relaxed),
            "skia_force" => CFG_SKIA_FORCE.store(on, Ordering::Relaxed),
            "build_probe" => CFG_BUILD_PROBE.store(on, Ordering::Relaxed),
            "spawn_hook" => CFG_SPAWN_HOOK.store(on, Ordering::Relaxed),
            // 장로 버프 UI 표시 지연(tick) — 처치 후 사망 연출/재생 여유분만큼 늦게 띄워 "장로 살아있는데
            //   버프 뜸" 방지. 버프 지속시간은 처치 기준 그대로(표시 시작만 지연). 기본 90(3초).
            "buff_show_delay_tick" => BUFF_SHOW_DELAY.store(v.parse().unwrap_or(90), Ordering::Relaxed),
            _ => {}
        }
    }
}

// ───────────────────────── 세르펜 detour ─────────────────────────
type SerpenFn = extern "win64" fn(u64, u64, u64, u64, u64, u64);
extern "win64" fn serpen_detour(rcx: u64, rdx: u64, r8: u64, r9: u64, a5: u64, a6: u64) {
    // 진입 실측 (항상, lock-free)
    let n = ENTER_COUNT.fetch_add(1, Ordering::Relaxed);
    // 안전 프로브: 첫 몇 회만 rcx/rdx 값 로그 (shadow-call 없음)
    if CFG_PROBE_LOG.load(Ordering::Relaxed) && n < 8 {
        let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
            probe_safe(n, rcx, rdx, a5);
        }));
    }
    // 위험 프로브(cfg ON): 엔티티 shadow-lookup — 기본 OFF
    if CFG_ENTITY_LOOKUP.load(Ordering::Relaxed) && n < 32 {
        let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| unsafe {
            probe_entity_lookup(n, rcx, rdx, a5);
        }));
    }
    // ★ 속성 시스템: 세르펜 리스폰 감지 → 속성 배정 → +0x108 템플릿 덮기 → 처치 시 자동 전파
    if CFG_ATTR_SYSTEM.load(Ordering::Relaxed) {
        let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| unsafe {
            serpen_apply_attr(rcx, rdx, a5);
        }));
    }
    // GameCtx 검증(cfg ON): SDK GameCtx가 detour서 유효/경기매칭인지 — 기본 OFF
    if CFG_GAMECTX_PROBE.load(Ordering::Relaxed) && n < 8 {
        let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
            probe_gamectx(n, a5);
        }));
    }
    // 원본 실행 (게임 로직 정상 진행)
    let t = SERPEN_TRAMP.load(Ordering::Relaxed);
    if t != 0 {
        let orig: SerpenFn = unsafe { core::mem::transmute(t) };
        orig(rcx, rdx, r8, r9, a5, a6);
    }
}

// 안전 프로브: raw 인자값만 기록 (게임함수 재호출 안 함)
fn probe_safe(n: u64, rcx: u64, rdx: u64, a5: u64) {
    unsafe {
        let acc = safe_read_u64(rdx as usize + O_ENTITY_ACCESSOR);
        log_push(format!(
            "[{}ms] enter#{} rcx={:#x} rdx={:#x} a5={:#x} rdx+0x150(accessor)={}",
            now_ms(), n, rcx, rdx, a5,
            acc.map(|v| format!("{:#x}", v)).unwrap_or_else(|| "<unreadable>".into())
        ));
    }
}

// 위험 프로브: rdx+0x150 액세서를 shadow-call로 재현해 세르펜 엔티티 획득 후 필드 덤프.
//   ⚠ AV 위험(VEH 미포착 경로) → cfg entity_lookup=1일 때만. SlotMap 핸들 인자엔 가드 금지.
unsafe fn probe_entity_lookup(n: u64, rcx: u64, rdx: u64, a5: u64) {
    let Some(acc) = safe_read_u64(rdx as usize + O_ENTITY_ACCESSOR) else { return; };
    if acc < 0x10000 { return; }
    let resolver: extern "win64" fn(u64, u64) -> u64 = core::mem::transmute(acc as usize);
    let ent = resolver(rcx, a5) as usize;
    if ent < 0x10000 { log_push(format!("[{}ms] lookup#{} entity=<null/{:#x}>", now_ms(), n, ent)); return; }
    let kind = safe_read_i32(ent + ENTITY_KIND_OFF);
    let id = safe_read_u64(ent + O_ENTITY_ID);
    let cur = safe_read_i32(ent + O_CUR_HP);
    let max = safe_read_i32(ent + O_MAX_HP);
    // ★ +0xb0 이펙트 템플릿 (처치 시 챔피언에 복사되는 원본) — 여기 덮으면 속성 버프 자동 전파
    let tmpl = ent + O_SERPEN_TEMPLATE;
    let tnlen = safe_read_i32(tmpl).unwrap_or(-1);
    let mut tname = String::new();
    if tnlen > 0 && tnlen <= 63 {
        let mut tb = [0u8; 64];
        if safe_copy(tb.as_mut_ptr(), (tmpl + 4) as *const u8, tnlen as usize) {
            tname = String::from_utf8_lossy(&tb[..tnlen as usize]).into_owned();
        }
    }
    let mut ts = String::new();
    for k in 0..14 { ts.push_str(&format!("{} ", safe_read_i32(tmpl + 0x58 + k * 4).unwrap_or(-999))); }
    log_push(format!(
        "[{}ms] lookup#{} entity={:#x} kind={:?} id={:?} hp={:?}/{:?}\n  +0xb0 tmpl: name_len={} name='{}' stats@+0x58(=ent+0x108)=[{}]",
        now_ms(), n, ent, kind, id, cur, max, tnlen, tname, ts.trim()
    ));
}

// GameCtx 검증 프로브 (cfg gamectx_probe=1): init서 저장한 GameCtx 포인터가 detour 스레드
//   (배경 sim 병렬 포함)에서 유효한지 + 이 세르펜(a5=id)을 아는지 = SDK add_buff 사용 가능 판정.
//   ⚠ GameCtx 내부 vtable이 stale/다른경기면 AV 위험 → cfg 게이트, 첫 진입만.
fn probe_gamectx(n: u64, a5: u64) {
    let p = SAVED_GAMECTX.load(Ordering::Relaxed);
    if p == 0 { log_push(format!("[{}ms] gamectx#{} SAVED_GAMECTX=null", now_ms(), n)); return; }
    let ctx: &GameCtx = unsafe { &*(p as *const GameCtx) };
    let tick = ctx.tick();
    let seed = ctx.seed();
    let ec = ctx.entity_count();
    // 이 세르펜(id=a5)을 GameCtx가 아는가? (배경 경기면 None이거나 다른 인스턴스)
    let ge = ctx.get_entity(a5 as usize).map(|e| {
        let h = e.hp();
        (e.id(), e.is_alive(), h.current, h.max)
    });
    log_push(format!(
        "[{}ms] gamectx#{} tick={} seed={:#x} entity_count={} get_entity({})={:?}",
        now_ms(), n, tick, seed, ec, a5, ge
    ));
}

// ── FUN_1f47970 detour: 뿌리는 버프 이름 로그 (serpen? morgard? 판별) ──
type BuffApplyFn = extern "win64" fn(u64, u64, u64, u64);
extern "win64" fn buffapply_detour(rcx: u64, rdx: u64, r8: u64, r9: u64) {
    let n = BUFFAPPLY_ENTER.fetch_add(1, Ordering::Relaxed);
    if CFG_BUFFAPPLY_PROBE.load(Ordering::Relaxed) {
        let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| unsafe {
            probe_buffapply(n, r8, r9);
        }));
    }
