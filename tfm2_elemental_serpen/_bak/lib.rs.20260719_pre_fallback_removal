const RENDER_STEP_RVA: usize = 0x872950;
const RENDER_STEP_PROLOGUE: [u8; 12] = [0x55, 0x41, 0x57, 0x41, 0x56, 0x41, 0x55, 0x41, 0x54, 0x56, 0x57, 0x53];
