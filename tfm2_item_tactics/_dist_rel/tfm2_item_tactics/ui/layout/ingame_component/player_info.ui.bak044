player_info:empty {
  width: 887px;
  height: 40px;

  #blue_player:empty {
    source: "asset/base/ui/ingame/blue_player";
    width: 412px;
    height: 40px;

    #position:image {
      x: 5px;
      y: 5px;

      width: 30px;
      height: 30px;

      source: "asset/base/ui/icons/mid";
    }

    #champion:color {
      x: 372px;

      width: 40px;
      height: 40px;


      color: #263cbfff;

      #icon:image {
        width: 40px;
        height: 40px;

        anchor_x: 0.5;
        anchor_y: 0.5;
        pivot_x: 0.5;
        pivot_y: 0.5;
      }
    }

    #kda:label {
      @"asset/base/style/main#bold_label";
      x: 224px;
      y: 6px;

      width: 76px;
      height: 28px;
      size: 18;

      text: "0/0/0";

      align_x: Center;
      align_y: Center;
    }

    #cs:label {
      @"asset/base/style/main#bold_label";
