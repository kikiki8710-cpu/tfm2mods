{
  "mod_id": "tfm2_item_tactics",
  "name": "tfm2_item_tactics",
  "author": "tfm2mods",
  "version": "2.8.0",
  "description": "개인전술 아이템 1~4칸 전부에 모드 아이템/바닐라 지정 가능(라이브 경기 빌드에 실제 주입, 아군팀만·모드 챔피언 포함). 조합테스트에서는 블루/레드 진영별로 따로 지정할 수 있고, 그 지정은 일반 경기와 분리되어 저장됩니다. 아이템 칸 3↔4 토글(4items.cfg): 4칸=4번째 신경망 자동추천, 3칸=바닐라 3칸 지정. 경기중 4번째 슬롯 아이콘·툴팁 표시. 비활성 모드의 아이템은 목록에서 자동 제외. ★게임 0.5.4 전용 - 다른 버전에서는 자동으로 비활성화됩니다.",
  "dependencies": [
    {
      "mod_id": "base",
      "version": ">=0.5.4, <0.5.5"
    }
  ],
  "last_updated": "2026-08-08"
}
