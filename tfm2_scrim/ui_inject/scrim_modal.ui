    #scrim_start:color_icon_button {
      @"asset/base/style/main#primary_button";
      anchor_x: 0.5; pivot_x: 0.5;
      anchor_y: 1; pivot_y: 1; y: -28px;
      width: 280px; height: 60px;
      text: {
        text: "#asset/base/text/ui?main.scrim_start";
        font: "asset/base/font/set/bold";
        size: 22; align_x: Center; align_y: Center;
      }
    }
    #scrim_confirm:color_icon_button {
      @"asset/base/style/main#primary_button";
      anchor_x: 0.5; pivot_x: 0.5;
      anchor_y: 1; pivot_y: 1; y: -28px;
      width: 280px; height: 60px;
      visible: false;
      text: {
        text: "확인";
        font: "asset/base/font/set/bold";
        size: 22; align_x: Center; align_y: Center;
      }
    }
      #scrim_openbar:empty { anchor_x:0.5; pivot_x:0.5; y:474px; width:354px; height:34px; child_type: LeftToRight { spacing:14px; }
      #scrim_open_strat_box:color { width:170px; height:34px; back_color:#1d1f2cff; color:#3a3d4aff; stroke:1; rounding: Uniform { rounding:6; } #scrim_open_strat_t:label { @"asset/base/style/main#label"; width:100%; height:100%; align_x:Center; align_y:Center; size:15; ignore_event:true; text:"팀 전술"; } #scrim_open_strat:button { width:100%; height:100%; hover_sound:"asset/base/sound/sfx/UI_mouse_hover"; click_sound:"asset/base/sound/sfx/UI_mouse_click"; } }
      #scrim_open_items_box:color { width:170px; height:34px; back_color:#1d1f2cff; color:#3a3d4aff; stroke:1; rounding: Uniform { rounding:6; } #scrim_open_items_t:label { @"asset/base/style/main#label"; width:100%; height:100%; align_x:Center; align_y:Center; size:15; ignore_event:true; text:"개인 전술"; } #scrim_open_items:button { width:100%; height:100%; hover_sound:"asset/base/sound/sfx/UI_mouse_hover"; click_sound:"asset/base/sound/sfx/UI_mouse_click"; } }
