scrim_modal:empty {
  width: 100%;
  height: 100%;

  visible: false;

  #scrim_close:color_icon_button {
    width: 100%;
    height: 100%;
    btn: { color: #000000bb; }
  }

  #panel:color {
    anchor_x: 0.5; pivot_x: 0.5;
    anchor_y: 0.5; pivot_y: 0.5;
    width: 1120px;
    height: 640px;
    color: #161721ff;
    rounding: Uniform { rounding: 12; }

    #header:label {
      @"asset/base/style/main#bold_label";
      x: 30px; y: 24px; width: 400px; height: 30px;
      align_y: Center; size: 22;
      ignore_event: true;
      text: "#asset/base/text/ui?main.scrim";
    }

    #scrim_close:button {
      width: 18px; height: 18px;
      anchor_x: 1; pivot_x: 1; x: -28px; y: 26px;
      source: "asset/base/ui/icons/cross";
      color: #c2c6ceff;
      hover: { color: #e8e8e8ff; }
      active: { color: #e8e8e8ff; }
    }

    #scrim_msg:label {
      @"asset/base/style/main#label";
      x: 30px; y: 64px; width: 1000px; height: 200px;
      align_y: Top; size: 18;
      ignore_event: true;
      text: "선수와 챔피언을 모두 선택하세요";
    }

    #scrim_head:empty {
      x: 62px; y: 122px; width: 966px; height: 26px;
      #h_blue:label { @"asset/base/style/main#bold_label"; x: 0px;   width: 438px; height: 26px; align_x: Left; align_y: Center; size: 18; ignore_event: true; text: "■ 블루팀"; }
      #h_red:label  { @"asset/base/style/main#bold_label"; x: 528px; width: 438px; height: 26px; align_x: Left; align_y: Center; size: 18; ignore_event: true; text: "■ 레드팀"; }
    }

          #scrim_row0:empty {
            x: 62px; y: 156px; width: 966px; height: 44px;
            child_type: LeftToRight { spacing: 8px; }
            #scrim_pdd0:dropdown {
              @"asset/base/style/main#dropdown";
              width: 240px; height: 44px;
              max_items_height: 280;
              text: { size: 18; }
              item_text: { size: 18; }
              text_layout: { x: 12px; y: 9px; width: 100%; height: 26px; }
              item_layout: { height: 40px; width: 236px; x: 2px; }
              item_text_layout: { x: 12px; y: 7px; width: 100%; height: 26px; }
            }
            #scrim_c0_box:color {
              width: 190px; height: 44px;
              back_color: #1d1f2cff; color: #4a4c56ff; stroke: 1;
              rounding: Uniform { rounding: 6; }
              #scrim_c0_t:label {
                @"asset/base/style/main#label";
                width: 100%; height: 100%;
                align_x: Center; align_y: Center; y: 2px;
                size: 18; ignore_event: true;
                text: "(선택)";
              }
              #scrim_c0:button {
                width: 100%; height: 100%;
                hover_sound: "asset/base/sound/sfx/UI_mouse_hover";
                click_sound: "asset/base/sound/sfx/UI_mouse_click";
              }
            }
            #scrim_gap0:empty { width: 90px; height: 44px; }
            #scrim_pdd5:dropdown {
              @"asset/base/style/main#dropdown";
              width: 240px; height: 44px;
