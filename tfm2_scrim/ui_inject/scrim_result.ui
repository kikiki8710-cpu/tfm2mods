scrim_result:empty {
  width: 100%;
  height: 100%;
  visible: false;

  #scrim_res_bg:color_icon_button {
    width: 100%;
    height: 100%;
    btn: { color: #000000cc; }
  }

  #res_panel:color {
    anchor_x: 0.5; pivot_x: 0.5;
    anchor_y: 0.5; pivot_y: 0.5;
    width: 1180px;
    height: 892px;
    color: #161721ff;
    rounding: Uniform { rounding: 12; }

    #res_phdr:label { @"asset/base/style/main#bold_label"; x: 24px; y: 18px; width: 320px; height: 36px; align_y: Center; text: "조합 테스트"; size: 20; ignore_event: true; }
    #res_daily:label { @"asset/base/style/main#label"; x: 350px; y: 18px; width: 300px; height: 36px; align_y: Center; text: ""; size: 16; color: #9a9ca6ff; ignore_event: true; }
    #res_stamina:label { @"asset/base/style/main#label"; x: 24px; y: 60px; width: 900px; height: 24px; align_y: Center; text: "시작하면 참가 선수의 체력이 5 감소합니다."; size: 15; color: #fba37cff; ignore_event: true; }

    #res_title:label { @"asset/base/style/main#bold_label"; x: 24px; y: 96px; width: 500px; height: 30px; align_y: Center; text: "빠른 시뮬레이션 요약"; size: 20; ignore_event: true; }
    #res_wintag:label { @"asset/base/style/main#bold_label"; x: 24px; y: 132px; width: 1132px; height: 22px; align_x: Center; align_y: Center; text: ""; size: 15; ignore_event: true; }
    #res_score:label { @"asset/base/style/main#bold_label"; x: 24px; y: 158px; width: 1132px; height: 44px; align_x: Center; align_y: Center; text: ""; size: 28; ignore_event: true; }

    #res_obj:empty { x: 255px; y: 214px; width: 670px; height: 36px; child_type: LeftToRight { spacing: 15px; }
      #res_obj_m:empty { width: 210px; height: 36px;
        #icon:image { x: 0px; y: 7px; width: 22px; height: 22px; source: "asset/base/ui/icons/morgard"; ignore_event: true; }
        #res_morg:label { @"asset/base/style/main#bold_label"; x: 30px; width: 180px; height: 36px; align_y: Center; text: ""; size: 15; ignore_event: true; }
      }
      #res_obj_s:empty { width: 210px; height: 36px;
        #icon:image { x: 0px; y: 7px; width: 22px; height: 22px; source: "asset/base/ui/icons/serpen"; ignore_event: true; }
        #res_serp:label { @"asset/base/style/main#bold_label"; x: 30px; width: 180px; height: 36px; align_y: Center; text: ""; size: 15; ignore_event: true; }
      }
      #res_obj_t:empty { width: 220px; height: 36px;
        #icon:image { x: 0px; y: 7px; width: 22px; height: 22px; source: "asset/base/ui/icons/tower"; ignore_event: true; }
        #res_tow:label { @"asset/base/style/main#bold_label"; x: 30px; width: 190px; height: 36px; align_y: Center; text: ""; size: 15; ignore_event: true; }
      }
    }

    #res_bars:empty { x: 24px; y: 272px; width: 1132px; height: 148px;
      #res_deal_l:label { @"asset/base/style/main#label"; x: 0px; y: 0px; width: 1132px; height: 16px; align_x: Center; align_y: Center; text: "가한 피해"; size: 13; color: #9a9ca6ff; ignore_event: true; }
      #res_deal_bv:label { @"asset/base/style/main#bold_label"; x: 132px; y: 24px; width: 130px; height: 16px; align_x: Center; align_y: Center; text: "0"; size: 13; color: #37d5b3ff; ignore_event: true; }
      #res_deal_rv:label { @"asset/base/style/main#bold_label"; x: 870px; y: 24px; width: 130px; height: 16px; align_x: Left; align_y: Center; text: "0"; size: 13; color: #eb3d4dff; ignore_event: true; }
      #res_deal_tk:color { x: 272px; y: 26px; width: 588px; height: 12px; color: #161721ff; rounding: Uniform { rounding: 6; }
        #res_deal_bf:color { x: 0px; width: 294px; height: 12px; color: #37d5b3ff; rounding: Uniform { rounding: 6; } }
        #res_deal_rf:color { anchor_x: 1; pivot_x: 1; x: 0px; width: 294px; height: 12px; color: #eb3d4dff; rounding: Uniform { rounding: 6; } }
      }
