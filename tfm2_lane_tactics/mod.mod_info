{"mod_id": "tfm2_lane_tactics", "name": "Lane Tactics (post-laning positions)", "author": "tfm2mods", "version": "0.1.3", "mod_type": "native", "contains_code": true, "description": "After the laning phase, each AI position picks its lane by a priority list you set in lane_tactics.cfg (fixed lane / most pushed-in lane / most pushed-out lane / same lane as an ally / game default). Applies to every AI team.", "dependencies": [{"mod_id": "base", "version": ">=0.6.2, <0.6.3"}], "last_updated": "2026-09-30"}