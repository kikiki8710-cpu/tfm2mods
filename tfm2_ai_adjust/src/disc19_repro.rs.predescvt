// disc19_repro.rs — disc19/disc18 넥서스 방어 AI 완전재현 + dcap 검증하네스.
// 들어있는 것: my_disc19/my_disc18 및 d19_*/d18_* 전 헬퍼, disc13/15/16/17, disc19_dcmp/disc18_dcmp/dump_disc_commands,
//   disc19/18 capture wrap, apply_disc19_imm(severity byte-patch), vt게터 순수화(vt90_get 등).
// 언제 손대나: disc19 판단로직/severity 상수/넥서스 방어 튜닝 변경 시. RVA는 rva_051.rs.

// ★[07-15] 로드시점 1회 호출(install_wrap과 동일 타이밍 = sim 실행 전 = .text 패치 안전).
//   게임플레이중(백그라운드 sim이 disc19 동시실행) 패치는 쓰기 AV폴트(exe+0x1c83e6a) → post_update 호출 금지.
unsafe fn apply_disc19_imm() {
    if D19IMM_DONE.swap(true, Ordering::Relaxed) { return; }   // 1회만
    let enable = tune("d19i_enable", 0) != 0;
    // 위협비율표(threat를 curHP%로 본 tr 문턱): 이 값보다 크면 후퇴검토. HP경계별로 낮아짐.
    let sr0 = tune("d19_sev_ratio_0", 49);   // HP무관 기본 문턱
    let sr1 = tune("d19_sev_ratio_1", 29);   // HP<hp1
    let sr2 = tune("d19_sev_ratio_2", 17);   // HP<hp2
    let sr3 = tune("d19_sev_ratio_3",  9);   // HP<hp3
    let sh1 = tune("d19_sev_hp_1", 66);      // 1단계 HP% 경계
    let sh2 = tune("d19_sev_hp_2", 41);      // 2단계
    let sh3 = tune("d19_sev_hp_3", 26);      // 3단계
    let ah  = tune("d19_ally_hp", 50);       // ally넥서스 위기 HP%(이 위면 지원 안 감)
    let rh  = tune("d19_retreat_hp", 45);    // 후퇴 HP%문턱(기존 키 재사용)
    let pt  = tune("d19_phase_threat", 30);  // 위협판정 시작 phase
    let pa  = tune("d19_phase_ally", 39);    // ally지원 판정 phase
    let base = exe_base();
    if base == 0 { D19IMM_DONE.store(false, Ordering::Relaxed); return; }   // base 미준비=재시도 허용
    let b1 = |v: i64| (v.max(0).min(0x7f)) as u64;   // imm8 sign-safe clamp
    // enable=cfg(경계변환 적용) / disable=게임 원본 imm 복원
    let (p_sr0,p_sr1,p_sr2,p_sr3,p_sh1,p_sh2,p_sh3,p_ah,p_rha,p_rhb,p_pt,p_pa) = if enable {
        (b1(sr0), b1(sr1), b1(sr2), b1(sr3+1), b1(sh1-1), b1(sh2-1), b1(sh3-1), b1(ah), b1(rh), b1(rh+1), b1(pt-1), b1(pa-1))
    } else {
        (0x31, 0x1d, 0x11, 0x0a, 0x41, 0x28, 0x19, 0x32, 0x2d, 0x2e, 0x1d, 0x26)
    };
    let mut ok = 0u32;
    // ★[0.5.1 마이그] disc19=0x1e0ddb0(프레임0x648). threat CALL=0x141e0e311. hp_pct RSI→R15(49 83 ff), phase R10→R9(49 83 f9). RAX/RCX 불변.
    // 위협비율표 (RAX=tr, 48 83 f8) — 각 1인스턴스
    ok += patch_imm_bytes(base + 0x1e0e503, &[0x48,0x83,0xf8], 3, 1, p_sr0) as u32;   // tr>49
    ok += patch_imm_bytes(base + 0x1e0e50f, &[0x48,0x83,0xf8], 3, 1, p_sr1) as u32;   // tr>29
    ok += patch_imm_bytes(base + 0x1e0e51b, &[0x48,0x83,0xf8], 3, 1, p_sr2) as u32;   // tr>17
    ok += patch_imm_bytes(base + 0x1e0e529, &[0x48,0x83,0xf8], 3, 1, p_sr3) as u32;   // tr>9 (인코딩 +1)
    // HP단계 경계 (R15=hp_pct, 49 83 ff ← 구 RSI 48 83 fe) — 인코딩 V-1
    ok += patch_imm_bytes(base + 0x1e0e509, &[0x49,0x83,0xff], 3, 1, p_sh1) as u32;   // hp<66
    ok += patch_imm_bytes(base + 0x1e0e515, &[0x49,0x83,0xff], 3, 1, p_sh2) as u32;   // hp<41
    ok += patch_imm_bytes(base + 0x1e0e523, &[0x49,0x83,0xff], 3, 1, p_sh3) as u32;   // hp<26
    // ally넥서스 위기 HP% (RAX 48 83 f8) — 2곳 동일값
    ok += patch_imm_bytes(base + 0x1e0e589, &[0x48,0x83,0xf8], 3, 1, p_ah) as u32;    // ally>50 #1(64bit div)
    ok += patch_imm_bytes(base + 0x1e0e5d5, &[0x48,0x83,0xf8], 3, 1, p_ah) as u32;    // ally>50 #2(32bit div)
    // retreat_hp (R15 49 83 ff) — 2곳, #2는 +1
    ok += patch_imm_bytes(base + 0x1e0e4b4, &[0x49,0x83,0xff], 3, 1, p_rha) as u32;   // hp>45 #1
    ok += patch_imm_bytes(base + 0x1e0e5e2, &[0x49,0x83,0xff], 3, 1, p_rhb) as u32;   // hp>=46 #2(+1)
    // phase 진입 (RCX=48 83 f9 / R9=49 83 f9 ← 구 R10 49 83 fa) — 인코딩 V-1
    ok += patch_imm_bytes(base + 0x1e0e2d7, &[0x48,0x83,0xf9], 3, 1, p_pt) as u32;    // phase>=30 (RCX)
    ok += patch_imm_bytes(base + 0x1e0e498, &[0x49,0x83,0xf9], 3, 1, p_pa) as u32;    // phase>=39 #1 (R9)
    ok += patch_imm_bytes(base + 0x1e0e532, &[0x49,0x83,0xf9], 3, 1, p_pa) as u32;    // phase>=39 #2 (R9)
    ok += patch_imm_bytes(base + 0x1e0e5c2, &[0x49,0x83,0xf9], 3, 1, p_pa) as u32;    // phase>=39 #3 (R9)
    // ★LOG_ON 무관 직접 write(설치확증 — itemnet_guard와 동일). write_named은 LOG_ON 게이트라 미확인됐었음.
    if let Some(p) = pth("d19_imm.txt") {
        let _ = fs::write(p, format!("d19i_enable={} applied={}/15 sev=[{} {} {} {}] hp=[{} {} {}] ally={} retreat={} phase=[{} {}] @base{:#x}\n",
            enable, ok, sr0, sr1, sr2, sr3, sh1, sh2, sh3, ah, rh, pt, pa, base));
    }
}

// sret Vec<Command>{buf@0, roster_ref@8, cap@0x10, len@0x18} 덤프. Command stride 0x4f8, tag@+0x4f1.
unsafe fn dump_disc_commands(disc: u32, sret: usize) {
    if !DISC1819_CAP.load(Ordering::Relaxed) { return; }
    let buf = match rd_u64(sret) { Some(v) => v as usize, None => return };
    let len = rd_u64(sret + 0x18).unwrap_or(0);
    if len > 64 { return; }   // 비정상 방어
    let n = if disc == 18 { D18_N.fetch_add(1, Ordering::Relaxed) } else { D19_N.fetch_add(1, Ordering::Relaxed) } + 1;
    if n % 200 != 1 { return; }   // 200회당 1회 샘플(관측 부담 억제)
    // ★LOG_ON 무관 직접 write(로그 인프라 사망 대비 — itemnet_guard 패턴). dcap=1이면 항상 기록.
    if !DISC_FILE_INIT.swap(true, Ordering::Relaxed) {
        if let Some(p) = pth("disc1819cap.txt") { let _ = fs::write(p, "=== disc18/19(진짜 넥서스) game 출력 캡처 (Vec<Command> stride 0x4f8, tag@+0x4f1) ===\n"); }
    }
    let mut s = format!("[disc{} #{}] len={}", disc, n, len);
    for i in 0..len.min(8) as usize {
        let e = buf + i * D19_STRIDE;   // ★0.5.1 stride 0x500(was 0x4f8)
        let tag = rd_u8(e + 0x4f9);      // ★0.5.1 tag +0x4f9(was +0x4f1)
        let f0 = rd_u64(e).unwrap_or(0); let f8 = rd_u64(e + 8).unwrap_or(0);
        let f10 = rd_u64(e + 0x10).unwrap_or(0); let f18 = rd_u64(e + 0x18).unwrap_or(0);
        s.push_str(&format!(" | [{}]tag={:#x} iss={:#x} t8={:#x} t10={:#x} t18={:#x}", i, tag, f0, f8, f10, f18));
    }
    s.push('\n');
    if let Some(p) = pth("disc1819cap.txt") { if let Ok(mut f) = fs::OpenOptions::new().create(true).append(true).open(&p) { let _ = write!(f, "{}", s); } }
}

unsafe extern "C" fn disc18_capture(sret: usize, p2: usize, p3: usize, p4: usize, p5: usize, p6: usize, p7: usize) -> usize {
    let orig = ORIG_DISC18.load(Ordering::Relaxed);
    let f: extern "C" fn(usize,usize,usize,usize,usize,usize,usize) -> usize = core::mem::transmute(orig);
    let ret = f(sret, p2, p3, p4, p5, p6, p7);   // game 원본 실행 → sret 채워짐
    let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| dump_disc_commands(18, sret)));
    // ★my_disc18 병렬계산 → game sret와 대조(disc18cmp.txt). game 것 안 건드리고 별도 scratch Vec에 계산(관찰 전용).
    let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| disc18_dcmp(sret, p2, p3, p4, p5, p6, p7)));
    ret
}

unsafe extern "C" fn disc19_capture(sret: usize, p2: usize, p3: usize, p4: usize, p5: usize, p6: usize, p7: usize) -> usize {
    let orig = ORIG_DISC19.load(Ordering::Relaxed);
    let f: extern "C" fn(usize,usize,usize,usize,usize,usize,usize) -> usize = core::mem::transmute(orig);
    let ret = f(sret, p2, p3, p4, p5, p6, p7);   // game 원본 실행 → sret 채워짐(훼손 금지)
    let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| dump_disc_commands(19, sret)));
    // ★my_disc19 병렬계산 → game sret와 대조(disc19cmp.txt). game 것 안 건드리고 별도 scratch Vec에 계산.
    let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| disc19_dcmp(sret, p2, p3, p4, p5, p6, p7)));
    ret
}


// out(Vec<Command>{buf@0,roster_ref@8,cap@0x10,len@0x18}) 끝에 command 1개 push. cap 초과·무효 buf시 false.
//   ★scratch record는 dcmp가 사전 0클리어 → 여기선 비교필드만 write(iss/dest/verb/tag).
unsafe fn d19_emit(out: usize, tag: u8, iss: u64, f8: u64, f10: u64, f18: u64,
                   v4a0: u64, v4b0: u64, v4b8: u64, v4c0: u64) -> bool {
    let buf = rd_u64(out).unwrap_or(0) as usize;
    let cap = rd_u64(out + 0x10).unwrap_or(0);
    let len = rd_u64(out + 0x18).unwrap_or(0);
    if !ptr_ok(buf) || len >= cap { return false; }
    let e = buf + (len as usize) * D19_STRIDE;
    wr_u64(e, iss);            // +0    issuer = vt0x28(sim_obj) tick
    wr_u64(e + 8, f8);         // +8    tag3 destX / else target_id
    wr_u64(e + 0x10, f10);     // +0x10 tag3 destY / 능력 byte0
    wr_u64(e + 0x18, f18);     // +0x18 tag5 orderY
    wr_u64(e + 0x4a0, v4a0);   // verb
    wr_u64(e + 0x4b0, v4b0);   // tag3 −1 / tag5 80000
    wr_u64(e + 0x4b8, v4b8);   // tag3 0 / tag5 5
    wr_u64(e + 0x4c0, v4c0);   // tag3 1 / tag5 5
    wr_u8(e + 0x4f9, tag);   // ★0.5.1 tag +0x4f9(was +0x4f1)
    wr_u64(out + 0x18, len + 1);
    true
}

// tag3 본진후퇴(§11.9.3 B). +0x4a0=5,+0x4b0=−1,+0x4b8=0,+0x4c0=1.
//   ★[2026-07-11 game대조 정정] disc19cmp #1201/#3601 실측: side0→(LO,HI)=(0x7d00,0xe2900) / side1→(HI,LO)=(0xe2900,0x7d00).
//   구버전(side0→HI,LO)은 game과 정반대(스왑방향 뒤집힘)였음 → 교정.
unsafe fn d19_emit_retreat(out: usize, side: usize, issuer: u64) {
    let (dx, dy) = if side == 0 { (D19_HOME_LO, D19_HOME_HI) } else { (D19_HOME_HI, D19_HOME_LO) };
    d19_emit(out, 3, issuer, dx, dy, 0, 5, u64::MAX, 0, 1);   // +0x4b0=−1=u64::MAX (⚠폭 i32일 수 있음 — 대조는 tag/dest 위주)
}


// 적건물 b가 nx에 도달 가능? (§11.9.3 C reach식 — 건물 struct_threat 전용)
//   R = b+0x420(reach_base) + geom[2] + (lvl−1)*geom[3] + vt0x90(cast,b) + bonus. d²(b,nx) <= R².
//   ★[2026-07-11 game대조 정정] 구버전은 sight(+0x628)*0x1e + mit(b) + mit(nx)를 더해 R을 과대→struct_threat 상시참→
//     게이트 상시발화(mlen=1). §11.9.3 C의 건물reach식엔 sight/mit항 없음(그건 §11.9.5 능력reach식). 제거하니 R=reach_base만
//     → 적넥서스(kind0xd)는 우리넥서스와 맵대각(≈1.27e6)이라 d²≫R² → struct_threat 거의 거짓 → 게이트 거짓 → 후반B 진입(game 일치).
//   TODO: geom[2]/(lvl−1)*geom[3]/vt0x90(cast,b) = 이제 desc(subtype슬롯)+vt90_get으로 순수 복원(07-11 함께 0취급되던 desc[2]/desc[3]/vt0x90). bonus(mit/sight)만 미가산 유지.
unsafe fn d19_building_reaches(nx: usize, b: usize, p5: usize, p6: usize) -> bool {
    // ★[시야 게이트] Gate1 bVar5(d19_gate1 L5140) 동일 확률 시야 롤: type==0xd(caller가 체크) 직후 FUN_14237d910(p5,p6,b).
    //   미노출(false)이면 건물 후보 제외(reach 계산 안 함) — game은 실desc 건물에 이 롤을 걸어 미노출을 struct_threat에서 뺀다.
    //   d19_g1_pred_pure = per-call 지역RNG(entity/self/tick seed, 전역 sim-rng 미소비→재sim 안전, shadow와 17790건 비트동일 검증) + catch_unwind + ptr_ok 가드.
    //   인자 순서·방식·실패시 반환(false) = Gate1 bVar5의 d19_g1_pred(p5, p6, e)와 동일 계약. cfg d19vis 기본 ON(4건 회귀 해소); OFF=구동작(visible=true 가정).
    //   D19_G1_SHADOW(cfg d19_g1_shadow, 기본 OFF=순수). ON이면 FUN_14237d910 shadow-call로 롤백(안전 대비).
    if D19_VIS_GATE.load(Ordering::Relaxed) {
        let vis = if D19_G1_SHADOW.load(Ordering::Relaxed) { d19_g1_pred(p5, p6, b) } else { d19_g1_pred_pure(p5, p6, b) };
        if !vis { return false; }
    }
    let (bx, by) = (rd_u64(b + 0x648).unwrap_or(0), rd_u64(b + 0x650).unwrap_or(0));
    let (nxx, nxy) = (rd_u64(nx + 0x648).unwrap_or(0), rd_u64(nx + 0x650).unwrap_or(0));
    let d2 = sqd(bx, by, nxx, nxy);
    let base420 = rd_i64(b + 0x420).unwrap_or(0);   // reach_base
    let level = rd_i64(b + 0x5b0).unwrap_or(0);
    // subtype(+0x70)별 desc 선택 + state guard(1|2) = Gate1 bVar5 loop 동일 규약(§11.9.1 d19_gate1 L5140~5146).
    let (desc, guard): (usize, i32) = match rd_i64(b + 0x70).unwrap_or(0) {
        6 => if level < 5 { (0, -1) } else { (b + 0x520, rd_i32(b + 0x550).unwrap_or(-1)) },
        5 => if level < 3 { (0, -1) } else { (b + 0x4e8, rd_i32(b + 0x518).unwrap_or(-1)) },
        4 => (b + 0x4b0, rd_i32(b + 0x4e0).unwrap_or(-1)),
        _ => (0, -1),   // subtype∉{4,5,6} → 후보 아님(guard=-1로 아래 게이트서 제외)
    };
    // ★[2026-07-11 게이트 추가] state∈{1,2}인 건물만 reach 후보. -1(기본desc/저레벨)·0 → struct_threat 후보 제외(skip).
    //   구버전은 guard∉{1,2}일 때 desc_term=0으로 두되 reach=base420으로 여전히 집계 → 극근접 저레벨 기본desc 건물 오집계(회귀 1건).
    //   game(FUN_141c83700 전반A @0x1c83820~)은 이 state에서 건물을 후보에서 빼므로 여기서도 false 반환. Gate1 `continue`와 동일 규약.
    if guard != 1 && guard != 2 { return false; }
    // desc[2] + (lvl-1)*desc[3] + vt0x90(desc1,align16 data). vt0x90 = 순수 필드게터(vt90_get). bonus(mit/sight)는 07-11 실측대로 미가산.
    //   ★계측용으로 세 항을 개별 바인딩. 게이트 통과 후이므로 desc!=0 & guard∈{1,2} 확정.
    let (t_desc2, t_desc3, t_vt90): (i64, i64, i64) = {
        let d2_desc = rd_i64(desc + 0x10).unwrap_or(0);          // desc[2]
        let d3_desc = rd_i64(desc + 0x18).unwrap_or(0);          // desc[3]
        let getter_val = {                                       // *(desc[1]+0x90) 필드게터 순수화
            let desc1 = rd_u64(desc + 8).unwrap_or(0) as usize;
            if ptr_ok(desc1) {
                let inner = rd_u64(desc1 + 0x10).unwrap_or(0) as usize;
                let dbuf = rd_u64(desc).unwrap_or(0) as usize;
                let aligned = (inner.wrapping_sub(1) & !0xf).wrapping_add(dbuf).wrapping_add(0x10);
                vt90_get(desc1, aligned)
            } else { 0 }
        };
        (d2_desc, (level - 1).wrapping_mul(d3_desc), getter_val)
    };
    let desc_term = t_desc2 + t_desc3 + t_vt90;
    let reach = base420 + desc_term;
    if reach <= 0 { return false; }
    let fired = d2 <= (reach as u64).wrapping_mul(reach as u64);
    // ── 계측(순수 관찰): 도달판정 true인 건물(struct_threat 유발)의 reach 각 항을 static에 캡처. 판정값 fired는 무변경. ──
    //   caller는 첫 true에서 break하므로 이 store는 my_disc19당 최대 1회(첫 도달건물). 미도달 건물은 store 안 함 → sentinel 보존.
    if fired {
        D19_BR_BASE.store(base420, Ordering::Relaxed);
        D19_BR_D2.store(d2 as i64, Ordering::Relaxed);
        D19_BR_DESC2.store(t_desc2, Ordering::Relaxed);
        D19_BR_DESC3.store(t_desc3, Ordering::Relaxed);
        D19_BR_VT90.store(t_vt90, Ordering::Relaxed);
        D19_BR_R.store(reach, Ordering::Relaxed);
        D19_BR_BK.store(rd_i64(b + 0x68).unwrap_or(0), Ordering::Relaxed);
        D19_BR_BST.store(rd_i64(b + 0x70).unwrap_or(0), Ordering::Relaxed);
        D19_BR_BID.store(rd_i64(b + 0x5a8).unwrap_or(0), Ordering::Relaxed);
    }
    fired
}


// 7×7 존캐시 조회(§11.9.2 A: p7+0x9f0~, row 0x150, col 0x30, 원점 p7+0x1320/0x1328). → (flag0@+0x28, flag1@+0x29).
//   ⚠TODO: 셀크기·인덱싱은 정적 미확정 → 잠정 cell=32000·clamp[0,6]. 런타임 트램폴린 덤프로 확정 필요.
unsafe fn d19_zone_cache(p7: usize, x: u64, y: u64) -> Option<(bool, bool)> {
    if !ptr_ok(p7) { return None; }
    let ox = rd_u64(p7 + 0x1320).unwrap_or(0);
    let oy = rd_u64(p7 + 0x1328).unwrap_or(0);
    let cx = (x.wrapping_sub(ox) / 32000).min(6) as usize;
    let cy = (y.wrapping_sub(oy) / 32000).min(6) as usize;
    let cell = p7 + 0x9f0 + cy * 0x150 + cx * 0x30;
    Some((rd_u8(cell + 0x28) != 0, rd_u8(cell + 0x29) != 0))
}


// ── vt0x28 base-dmg getter 순수 페어반환 워커(RAX=phys, RDX=magic) ★[07-12 ghidra-re 6종 계약] ──
//   r9(&DAT_1438503b0) 우회: [r9+0x30]=스탯블록복사(e+0x600..0x648)라 스탯을 e+0x600/0x638 직접 read.
//   RNG-free. 6종 전부 순수(#4 cond=이름 딕셔너리 멤버십 FUN_1fc0d70 규명완). 미지 RVA만 None→shadow 폴백.
//   재귀 aligned = ((*(O+0x10)-1)&~0xf) + D + 0x10 (probe_basedmg_r9 aligned식과 동형).
unsafe fn d19_bd_walk(p1: usize, list_off: usize, cnt_off: usize, stride: usize, e: usize, exe: usize, depth: u32) -> Option<(i64, i64)> {
    let lb = rd_u64(p1 + list_off).unwrap_or(0) as usize;
    let cnt = rd_i64(p1 + cnt_off).unwrap_or(0);
    if cnt < 0 || cnt > 256 { return None; }
    if cnt > 0 && !ptr_ok(lb) { return None; }
    let (mut ph, mut mg) = (0i64, 0i64);
    for i in 0..cnt as usize {
        let entry = lb + i * stride;
        let d = rd_u64(entry).unwrap_or(0) as usize;               // entry[+0] = 서브데이터 D
        let o = rd_u64(entry + 8).unwrap_or(0) as usize;           // entry[+8] = 서브obj O
        if !ptr_ok(o) { return None; }
        let sub_gptr = rd_u64(o + 0x28).unwrap_or(0) as usize;
        let inner = rd_u64(o + 0x10).unwrap_or(0) as usize;
        let sub_aligned = (inner.wrapping_sub(1) & !0xf).wrapping_add(d).wrapping_add(0x10);
        let (a, m) = d19_basedmg_dispatch(sub_gptr, sub_aligned, e, exe, depth + 1)?;
        ph = ph.wrapping_add(a);
        mg = mg.wrapping_add(m);
    }
    Some((ph, mg))
}

unsafe fn d19_basedmg_dispatch(gptr: usize, p1: usize, e: usize, exe: usize, depth: u32) -> Option<(i64, i64)> {
    if depth > 8 || !ptr_ok(gptr) || !ptr_ok(p1) { return None; }
    match gptr.wrapping_sub(exe) {
        0x1f23a60 | 0x1d204c0 => d19_bd_walk(p1, 8, 0x10, 16, e, exe, depth), // ★0.5.1(was 0x19ebd90). 챔피언 16B walker, primary 0x1f23a60+secondary 0x1d204c0(monomorphic 복제)
        0x1a5ee60 => d19_bd_walk(p1, 0x20, 0x28, 24, e, exe, depth),         // ★0.5.1(was 0x1e67de0). 미니언 24B walker
        0x1d1f630 => {                                                        // ★0.5.1(was 0x1e67090). 이중 walker
            let a = d19_bd_walk(p1, 0x68, 0x70, 0x18, e, exe, depth)?;
            let b = d19_bd_walk(p1, 0x80, 0x88, 0x10, e, exe, depth)?;
            Some((a.0.wrapping_add(b.0), a.1.wrapping_add(b.1)))
        }
        0x1dce1d0 => {                                                        // ★0.5.1(was 0x2273350). terminal: flat+ratio*stat/100
            let s = rd_i64(e + 0x600).unwrap_or(0);
            Some((rd_i64(p1 + 0x10).unwrap_or(0).wrapping_add(rd_i64(p1 + 0x18).unwrap_or(0).wrapping_mul(s) / 100), 0))
        }
        0x1d328e0 => {                                                        // ★0.5.1(was 0x1e114e0). 스택형 terminal(decay 반복)
            let s = rd_i64(e + 0x600).unwrap_or(0);
            let raw = rd_i64(e + 0x638).unwrap_or(0);
            let n = (raw + 1).min(rd_i64(p1 + 0x30).unwrap_or(0));
            if n < 0 || n > 4096 { return None; }
            let mut f = rd_i64(p1 + 0x18).unwrap_or(0);
            let decay = rd_i64(p1 + 0x20).unwrap_or(0);
            let floor = rd_i64(p1 + 0x28).unwrap_or(0);
            let mut acc = 0i64;
            for _ in 0..n {
                acc = acc.wrapping_add(f.wrapping_mul(s) / 100);
                f = (f.wrapping_mul(decay) / 100).max(floor);
            }
            Some((acc, 0))
        }
        0x23a4d90 => {                                                       // ★0.5.1(was 0x1e65740). 조건 picker(cond=이름 딕셔너리 멤버십)
            let key = rd_u64(p1 + 0x08).unwrap_or(0) as usize;
            let klen = rd_u64(p1 + 0x10).unwrap_or(0);
            let b = d19_dict_has(e, key, klen);                              // ctx=e(P3), e+0x2c8/0x2d0 name-table
            let sel = if b { 0x10 } else { 0 };
            let d = rd_u64(p1 + 0x18 + sel).unwrap_or(0) as usize;
            let o = rd_u64(p1 + 0x20 + sel).unwrap_or(0) as usize;
            if !ptr_ok(o) { return None; }
            let sub_gptr = rd_u64(o + 0x28).unwrap_or(0) as usize;
            let inner = rd_u64(o + 0x10).unwrap_or(0) as usize;
            let sub_aligned = (inner.wrapping_sub(1) & !0xf).wrapping_add(d).wrapping_add(0x10);
            d19_basedmg_dispatch(sub_gptr, sub_aligned, e, exe, depth + 1)   // 선택 서브게터 재귀(tail)
        }
        _ => None,   // 미지 RVA → shadow 폴백
    }
}

// 이름 딕셔너리 멤버십(FUN_1fc0d70): ctx+0x2d0=개수, ctx+0x2c8=base, stride 0x120, 레코드 {u32 len, key바이트@+4}.
//   key_len==stored_len && memcmp(rec+4, key, len)==0 인 레코드 존재하면 true. RNG-free·순수.
unsafe fn d19_dict_has(ctx: usize, key: usize, klen: u64) -> bool {
    let n = rd_i64(ctx + 0x2d0).unwrap_or(0);
    if n <= 0 || n > 4096 { return false; }
    if klen > 256 || (klen != 0 && !ptr_ok(key)) { return false; }
    let mut rec = rd_u64(ctx + 0x2c8).unwrap_or(0) as usize;
    if !ptr_ok(rec) { return false; }
    let klen_u = klen as usize;
    for _ in 0..n {
        if !readable(rec, 4) { return false; }
        if rd_u32(rec) as u64 == klen {
            if klen == 0 { return true; }                                   // 빈 키 = 길이만 일치
            if readable(rec + 4, klen_u) && readable(key, klen_u) {
                let mut eq = true;
                for i in 0..klen_u { if rd_u8(rec + 4 + i) != rd_u8(key + i) { eq = false; break; } }
                if eq { return true; }
            }
        }
        rec = rec.wrapping_add(0x120);
    }
    false
}

// base 페어(phys,magic) — 기본 순수(d19_basedmg_dispatch), 실패/미지 RVA/강제시 shadow(probe_basedmg_r9).
//   d19_bd_cmp=1이면 순수 성공 시 shadow도 호출해 비트동일 대조(bdcmp.txt, mmN=0 목표) — 순수화 검증용.
unsafe fn d19_basedmg(e: usize, world: usize, exe: usize) -> (i64, i64) {
    if !D19_BASEDMG_SHADOW.load(Ordering::Relaxed) {
        let v480 = rd_u64(e + 0x480).unwrap_or(0) as usize;
        if ptr_ok(v480) {
            let gptr = rd_u64(v480 + 0x28).unwrap_or(0) as usize;
            let inner = rd_u64(v480 + 0x10).unwrap_or(0) as usize;
            let buf = rd_u64(e + 0x478).unwrap_or(0) as usize;
            let aligned = (inner.wrapping_sub(1) & !0xf).wrapping_add(buf).wrapping_add(0x10);
            if let Some(pm) = d19_basedmg_dispatch(gptr, aligned, e, exe, 0) {
                if D19_BD_CMP.load(Ordering::Relaxed) {
                    let sv = probe_basedmg_r9(e, world, exe, exe + RVA_DISC7_DMG_SHEET);   // ★0.5.1(was 리터럴 0x38503b0 stale) shadow(대조 전용)
                    if sv.0 >= 0 && sv.1 >= 0 {                                  // shadow 유효할 때만
                        if sv == pm { BD_CMP_OK.fetch_add(1, Ordering::Relaxed); }
                        else {
                            let n = BD_CMP_MM.fetch_add(1, Ordering::Relaxed);
                            if n < 60 {
                                if let Some(p) = pth("bdcmp.txt") {
                                    if let Ok(mut f) = fs::OpenOptions::new().create(true).append(true).open(&p) {
                                        let _ = write!(f, "[bdMM #{}] rva={:#x} kind={} pure=({},{}) shadow=({},{})\n",
                                            n + 1, gptr.wrapping_sub(exe), rd_i32(e + 0x68).unwrap_or(-1), pm.0, pm.1, sv.0, sv.1);
                                    }
                                }
                            }
                        }
                        // 주기적 tally
                        let ok = BD_CMP_OK.load(Ordering::Relaxed);
                        let mm = BD_CMP_MM.load(Ordering::Relaxed);
                        if (ok + mm) % 500 == 1 {
                            if let Some(p) = pth("bdcmp.txt") {
                                if let Ok(mut f) = fs::OpenOptions::new().create(true).append(true).open(&p) {
                                    let _ = write!(f, "[bd tally] OK={} MM={}\n", ok, mm);
                                }
                            }
                        }
                    }
                }
                return pm;
            }
        }
    }
    probe_basedmg_r9(e, world, exe, exe + RVA_DISC7_DMG_SHEET)   // ★0.5.1(was 리터럴 0x38503b0 stale). shadow 폴백(#4/미지 RVA or d19_bd_shadow=1)
}


// FUN_141f22180(위협dmg) 순수 대체 — ★[07-12 ghidra-re 확정] memo(TLS SwissTable) 생략=bit-exact:
//   실계산 결정론(RNG 0)·memo는 같은 스탬프기간 내 순수 최적화라 결과 불변. "스킬DB 규모 포팅 필요"는 오귀속 —
//   데미지코어 FUN_1422e85a0=기구현(my_combat_dmg, §12.16 ⑤-d). base쌍 getter도 순수화(d19_basedmg, 6종 전부) —
//   미지 RVA만 shadow 폴백. ⚠ my_combat_dmg는 COEF_MULT_PCT(cfg coef_mult, 기본100) 경유.
unsafe fn d19_threat_dmg(enemy: usize, world: usize, tgt: usize, exe: usize) -> i64 {
    if rd_i32(enemy + 0x4a8).unwrap_or(-1) == -1 { return 0; }   // 게임=패닉가드 assert, 우리=0
    let (raw_p, raw_m) = d19_basedmg(enemy, world, exe);
    if raw_p < 0 || raw_m < 0 { return 0; }        // shadow 폴백 센티널(-1/-2/-3)=실패 (정상 base는 비음수)
    if raw_p == 0 && raw_m == 0 { return 0; }
    let kind = rd_i32(enemy + 0x4a4).unwrap_or(0) as u32;
    my_combat_dmg(enemy, tgt, raw_p, kind, 0, exe)
        .wrapping_add(my_combat_dmg(enemy, tgt, raw_m, kind, 1, exe))
}


// FUN_1420a3fd0(0x20a3fd0) 순수재현 ★[07-12 ghidra-re 좌표화]: other팀 유닛3리스트 순회 + 위협가중 누적.
//   memo(TLS SwissTable)=순수 최적화라 생략=bit-exact. 전역RNG 미소비(재sim 안전).
//   유일 잔여 shadow = d19_threat_dmg 내부 vt0x28 base쌍 getter(probe_basedmg_r9).
unsafe fn d19_threat_pure(phase: i64, p6_pair: usize, nx: usize, x: u64, y: u64, scan_w: u64) -> i64 {
    if phase < 0x1e || rd_u64(nx).unwrap_or(1) != 0 { return 0; }
    let exe = exe_base();
    let g0 = rd_u64(p6_pair).unwrap_or(0) as usize;          // p2[0] = 리스트 컨테이너
    let world = rd_u64(p6_pair + 8).unwrap_or(0) as usize;   // p2[1] = world/sim ctx
    if exe == 0 || !ptr_ok(g0) || !ptr_ok(world) { return 0; }
    // w = max(scanW, *(*(world+8)+0x12f8)>>1)  (scanW=같은 필드*2라 사실상 scanW지만 원본 충실 재현)
    let w1 = rd_u64(world + 8).unwrap_or(0) as usize;
    let w = scan_w.max(if ptr_ok(w1) { rd_u64(w1 + 0x12f8).unwrap_or(0) >> 1 } else { 0 });
    let side = rd_i64(nx + 8).unwrap_or(-1);                 // nexus+8 = 자기 팀 인덱스
    if !(0..=1).contains(&side) { return 0; }                // 게임=bounds 패닉가드
    let t = (1 - side) as usize;
    let nexus_id = rd_u64(nx + 0x5a8).unwrap_or(0);
    let nx_is_bld = rd_i32(nx + 0x68).unwrap_or(0) == 0xd;
    let sat_sq = |v: u64| -> u64 {
        let p = (v as u128) * (v as u128);
        if p >> 64 != 0 { u64::MAX } else { p as u64 }       // 128bit 상위≠0 → 포화(원본 동일)
    };
    let mut acc: u64 = 0;
    let cbase = t * 0x20;
    for &(bo, co) in &[(0x10usize, 0x28usize), (0x50, 0x68), (0x90, 0xa8)] {
        let begin = rd_u64(g0 + cbase + bo).unwrap_or(0) as usize;
        let cnt = rd_i64(g0 + cbase + co).unwrap_or(0);
        if begin == 0 || cnt <= 0 || cnt > 4096 { continue; }
        for i in 0..cnt as usize {
            let e = rd_u64(begin + i * 8).unwrap_or(0) as usize;   // 원소=*mut entity, 1회 deref
            if !ptr_ok(e) { continue; }
            if rd_i32(e + 0x68).unwrap_or(0) != 1 { continue; }        // type==1만
            if rd_i32(e + 0x4a8).unwrap_or(-1) == -1 { continue; }     // 생존/스킬 필터
            let dx = rd_u64(e + 0x648).unwrap_or(0).abs_diff(x);
            let dy = rd_u64(e + 0x650).unwrap_or(0).abs_diff(y);
            let d2 = sat_sq(dx).saturating_add(sat_sq(dy));
            if d2 >= 0x35a4e9001 { continue; }                          // strict <
            let hit = d19_threat_dmg(e, world, nx, exe);                // FUN_141f22180 (memo 생략)
            if hit == 0 { continue; }   // hit==0 → 유닛 통째 skip(eff/rangeMul 미계산, 원본 동일)
            let hit = hit as u64;
            // eff_cd: cd=vt90(threat 체인), u=haste+100, q=cd*100/max(u,1... (u<2→1)), eff=max(q,3)
            let cd = vt560_threat(e);
            let u = rd_i32(e + 0x3e4).unwrap_or(0) as i64 + 100;
            let div = if u < 2 { 1 } else { u };
            let q = cd.wrapping_mul(100) / div;
            let eff = if q < 4 { 3u64 } else { q as u64 };
            let base = hit.wrapping_mul(w) / eff;                       // wrapping 곱(원본 동일)
            let range_mul: u64 = if rd_i32(e + 0x88).unwrap_or(0) == 1 {
                if rd_u64(e + 0x90).unwrap_or(0) == nexus_id { D19_RANGE_ATKME.load(Ordering::Relaxed) as u64 }    // 나를 공격중(기본100)
                else if nx_is_bld { D19_RANGE_BLD.load(Ordering::Relaxed) as u64 } else { D19_RANGE_OTHER.load(Ordering::Relaxed) as u64 }   // 타대상(건물완화)
            } else { D19_RANGE_IDLE.load(Ordering::Relaxed) as u64 };   // 비교전(기본80)
            let sev_mul: u64 = if d2 > 8_100_000_000 {
                if rd_u8(e + 0x118) != 0 { 0x41 } else { 0x2d }         // 원거리
            } else { 100 };                                             // 근거리
            acc = acc.saturating_add(range_mul.wrapping_mul(base.wrapping_add(hit)).wrapping_mul(sev_mul) / 10000);
        }
    }
    let hp = rd_i64(nx + 0x658).unwrap_or(0);
    let cap: u64 = if hp < 0 { u64::MAX } else { let h2 = (hp as u64).wrapping_mul(2); h2 + (h2 == 0) as u64 };
    acc.min(cap) as i64
}

// 위협점수 진입 — d19thr(기본 OFF)=threat 활성 게이트. 활성 시 기본=순수(d19_threat_pure),
//   d19thrpure=0이면 전체 shadow-call(FUN_1420a3fd0, AV위험 §3) 롤백 경로.
unsafe fn d19_threat(phase: i64, p6_pair: usize, nx: usize, x: u64, y: u64) -> i64 {
    if !D19_THREAT_SHADOW.load(Ordering::Relaxed) { return 0; }
    let base = exe_base();
    if base == 0 || !ptr_ok(p6_pair) || !ptr_ok(nx) { return 0; }
    // ★[2026-07-11] 6번째 인자 교정: rmin(nexusHP>>1)은 초기추정 오류 → scanW=*(local_c0[1]+0x12f8)*2 (정밀규명 a48105662).
    //   기존 rmin은 threat 과대(거의 항상 >=curHP → 항상 홈복귀 = Gate2 89건 오발화)의 원인.
    let lc0 = rd_u64(p6_pair + 8).unwrap_or(0) as usize;
    let lc01 = rd_u64(lc0 + 8).unwrap_or(0) as usize;
    let scan_w = if ptr_ok(lc0) && ptr_ok(lc01) { rd_i64(lc01 + 0x12f8).unwrap_or(0) * 2 } else { 0 };
    if D19_THREAT_PURE.load(Ordering::Relaxed) {
        let t = d19_threat_pure(phase, p6_pair, nx, x, y, scan_w as u64);
        let m = D19_THREAT_MULT.load(Ordering::Relaxed);   // ★위협 배수%(기본100=원본). d19_threat_pure는 비트동일 보존, 배수는 여기서.
        return if m == 100 { t } else { t.saturating_mul(m) / 100 };
    }
    // ⚠[0.5.1] 0x20a3fd0=0.5.0_3 stale(재배치 가능성). 기본 d19thr=OFF(순수 d19_threat_pure)라 미호출. d19thr 켜기 전 0.5.1 재핀 필수.
    if !code_ptr_ok(base + 0x20a3fd0) { return 0; }   // ★[07-15 하드닝] stale/비.text RVA CALL 사전차단
    let f: extern "C" fn(usize, usize, usize, u64, u64, i64) -> u64 = core::mem::transmute(base + 0x20a3fd0);
    let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| f(phase as usize, p6_pair, nx, x, y, scan_w)));
    r.unwrap_or(0) as i64
}


// tag5 커밋오더/레인 방어이동 emit(§11.9.3 B/D·task 필드맵): +8=target_id(+0x5a8)·+0x10/+0x18=대상좌표·+0x4a0=5·+0x4b0=80000·+0x4b8=5·+0x4c0=5·tag=5.
unsafe fn d19_emit_tag5(out: usize, issuer: u64, target_id: u64, x: u64, y: u64) -> bool {
    d19_emit(out, 5, issuer, target_id, x, y, 5, 80000, 5, 5)
}

// 엔티티 e → nexus 최근접 갱신 헬퍼(tag5 대상선정용).
#[inline] unsafe fn d19_near(e: usize, nxx: u64, nxy: u64, best: &mut usize, bestd: &mut u64) {
    if !ptr_ok(e) { return; }
    let d = sqd(rd_u64(e + 0x648).unwrap_or(0), rd_u64(e + 0x650).unwrap_or(0), nxx, nxy);
    if d < *bestd { *bestd = d; *best = e; }
}

// 레인압박 판정(emit B ④용): concat3(OTHER측 3리스트 g0+other*0x20+{(0x10,0x28),(0x50,0x68),(0x90,0xa8)}=begin/count)
//   유닛 중 (+0x68==1 && +0x88==1 && +0x90==lane_id) 존재하면 해당 레인이 압박당하는 것.
unsafe fn d19_lane_pressed(g0: usize, other: usize, lane_id: i64) -> bool {
    let cbase = other * 0x20;
    for &(bo, co) in &[(0x10usize, 0x28usize), (0x50, 0x68), (0x90, 0xa8)] {
        let begin = rd_u64(g0 + cbase + bo).unwrap_or(0) as usize;
        let cnt = rd_i64(g0 + cbase + co).unwrap_or(0);
        if begin == 0 || cnt <= 0 || cnt > 4096 { continue; }
        for i in 0..cnt as usize {
            let u = rd_u64(begin + i * 8).unwrap_or(0) as usize;
            if u != 0 && rd_i32(u + 0x68).unwrap_or(0) == 1 && rd_i32(u + 0x88).unwrap_or(0) == 1
                && rd_i64(u + 0x90).unwrap_or(0) == lane_id {
                return true;
            }
        }
    }
    false
}


// ════ 능력배정 발행블록(tag 0xf/0x10/0x11) 순수 헬퍼 (FUN_141c83700 0x84c35~0x8525b) ════
//   전부 D19_ABIL 게이트(기본 OFF) 하에서만 호출. usable_slot0/target_valid=순수 match(RNG-free).
//   ★[07-12] usable_slot1/2·vt90 range getter 전부 순수화 완료(vt90_get/vta8_get/vtc8_get) —
//   shadow는 d19_us_shadow=1 롤백 전용. 능력배정 블록 = 완전 순수(RNG-free·게임호출 0).

// 엔티티 효과배열 순회(base=u+0x2b0, cnt=u+0x2b8, stride0x28, type@+0). type콜백이 참인 원소 하나라도 있으면 true.
unsafe fn d19_eff_any<F: Fn(i32) -> bool>(u: usize, f: F) -> bool {
    let base = rd_u64(u + 0x2b0).unwrap_or(0) as usize;
    let cnt = rd_i64(u + 0x2b8).unwrap_or(0);
    if !ptr_ok(base) || cnt <= 0 || cnt > 4096 { return false; }
    for i in 0..cnt as usize {
        if f(rd_i32(base + i * 0x28).unwrap_or(0)) { return true; }
    }
    false
}

// 슬롯별 쿨다운 필드 오프셋(kind→off). kind∈{0,3,13}은 별도처리라 여기 미포함(-1=미정의).
#[inline] fn d19_cd_off(kind: i32) -> i64 {
    match kind {
        1 => 0xb8, 2 => 0x110, 4 => 0xf0, 5 => 0x1f0, 6 => 0x1f0, 7 => 0xe8,
        8 => 0xb0, 9 => 0xc8, 10 => 0xf0, 11 => 0xd8, 12 => 0xd0, _ => -1,
    }
}

// usable_slot0(self) 순수재현(FUN_141fbe670, JT아님):
//   pre: 효과 중 type==3 있으면 false. kind=rd_i32(self+0x68)∈{0,3}→false.
//   kind==13→ self+0xb0!=0면 false, else effgate(cd=none). else→ effgate(cd=CD_OFF[kind]).
//   effgate: 효과 중 !(2<=type<=5) 있으면 false. kind==13→true. else→ rd_i64(self+CD_OFF)==0.
unsafe fn d19_usable_slot0(u: usize) -> bool {
    if d19_eff_any(u, |t| t == 3) { return false; }
    let kind = rd_i32(u + 0x68).unwrap_or(0);
    if kind == 0 || kind == 3 { return false; }
    // effgate 효과체크(kind13/기타 공통)
    if d19_eff_any(u, |t| !(2..=5).contains(&t)) { return false; }
    if kind == 13 {
        if rd_i64(u + 0xb0).unwrap_or(0) != 0 { return false; }
        return true;
    }
    let off = d19_cd_off(kind);
    if off < 0 { return false; }
    rd_i64(u + off as usize).unwrap_or(1) == 0
}

// target_valid(desc, C, T) 순수재현(FUN_141fcf860, JT아님):
//   pre: T+0x6a0!=1→false. T+0x688!=0→false. S=rd_i32(desc)∈0..13.
//   same=C.f0==T.f0 && (C.f0!=0 || C.f8==T.f8). enemy=!same. cc(T)=효과 type∈{0,1,2,6,8,9}.
unsafe fn d19_target_valid(desc: usize, c: usize, t: usize) -> bool {
    if rd_u8(t + 0x6a0) != 1 { return false; }
    if rd_i64(t + 0x688).unwrap_or(0) != 0 { return false; }
    let s = rd_i32(desc).unwrap_or(-1);
    let cf0 = rd_u64(c).unwrap_or(0);
    let cf8 = rd_u64(c + 8).unwrap_or(0);
    let tf0 = rd_u64(t).unwrap_or(1);
    let tf8 = rd_u64(t + 8).unwrap_or(1);
    let cid = rd_u64(c + 0x5a8).unwrap_or(0);
    let tid = rd_u64(t + 0x5a8).unwrap_or(1);
    let tkind = rd_i32(t + 0x68).unwrap_or(-1);
    let same = cf0 == tf0 && (cf0 != 0 || cf8 == tf8);
    let enemy = !same;
    let k13 = tkind == 13;
    let not23 = tkind != 2 && tkind != 3;
    let cc = |t: usize| d19_eff_any(t, |tp| matches!(tp, 0 | 1 | 2 | 6 | 8 | 9));
    match s {
        0 => same,
        1 => same && k13,
        2 => same && k13 && cc(t),
        3 => same && k13 && cid != tid,
        4 => cid == tid,
        5 => enemy,
        6 => enemy && not23,
        7 => enemy && k13,
        8 => enemy && k13 && cc(t),
        // ★[07-15 명령어 대조] case 9 owner 조건 = mine이 `same`으로 뒤집혀 있었음(0x11 under의 정체).
        //   게임(0x1fcf917): cf0==tf0 → cf0==0 && cf8!=tf8 / cf0!=tf0 → (cf0&1)==0. 인덱스 cf8<2, arr!=0, k13.
        9 => {
            let owner_ok = if cf0 == tf0 { cf0 == 0 && cf8 != tf8 } else { cf0 & 1 == 0 };
            owner_ok && k13 && (cf8 as usize) < 2 && rd_i64(t + 0x670 + (cf8 as usize) * 8).unwrap_or(0) != 0
        },
        10 => true,
        11 => cid != tid && not23,
        12 => k13,
        _ => false,   // 13 및 그 외 = false
    }
}

// FUN_141fcf590(0x1fcf590) de40 usability predicate 순수재현 ★[07-12 §11.9.10] — fcf860(target_valid) 형제.
//   selector=*(desc+0x12c). source id = desc(Gr=*desc, Sr=*(desc+8), Xr=*(desc+0xf8)). 대상=unit. (Kt&!1)!=2 ≡ not23.
unsafe fn d19_fcf590(desc: usize, unit: usize) -> bool {
    if rd_u8(unit + 0x6a0) != 1 { return false; }
    if rd_i64(unit + 0x688).unwrap_or(0) != 0 { return false; }
    let sel = rd_u32(desc + 0x12c) as i32;
    let gr = rd_u64(desc).unwrap_or(0);
    let sr = rd_u64(desc + 8).unwrap_or(0);
    let xr = rd_u64(desc + 0xf8).unwrap_or(0);
    let gt = rd_u64(unit).unwrap_or(1);
    let st = rd_u64(unit + 8).unwrap_or(1);
    let xt = rd_u64(unit + 0x5a8).unwrap_or(1);
    let kt = rd_i32(unit + 0x68).unwrap_or(-1);
    let same = gr == gt && (gr != 0 || sr == st);
    let k13 = kt == 13;
    let not23 = kt != 2 && kt != 3;
    let cc = || d19_eff_any(unit, |tp| matches!(tp, 0 | 1 | 2 | 6 | 8 | 9));
    match sel {
        0 => same,
        1 => same && k13,
        2 => same && k13 && cc(),
        3 => same && xr != xt,
        4 => xr == xt,
        5 => !same,
        6 => !same && not23,
        7 => !same && k13,
        8 => !same && k13 && cc(),
        9 => !same && k13 && (sr as usize) < 2 && rd_i64(unit + 0x670 + (sr as usize) * 8).unwrap_or(0) != 0,
        10 => true,
        11 => xr != xt && not23,
        12 => k13,
        _ => false,
    }
}

// ★[07-15] 쿨다운 base 게터 = skill vt+0x90. 대부분 필드게터(vt90_get)지만 FUN_141c974a0은 2인자 계산게터라 엔티티 e 필요.
//   FUN_141c974a0: saturating_sub(skill[0x50], entity[0x5b0]*skill[0x108]) (rdx=entity=usable의 param_1=e). skill만으론 재현불가라 특수처리.
unsafe fn d19_cd_base(vt: usize, data: usize, e: usize) -> u64 {
    let slot = rd_u64(vt + 0x90).unwrap_or(0) as usize;
    if !in_text(slot) { return 0; }   // ★[07-15 하드닝] .text 게이트(실패=0=게임 실패시 base; 유효 게터 무영향)
    if slot == exe_base().wrapping_add(0x1c974a0) {
        let s50 = rd_u64(data + 0x50).unwrap_or(0);
        let prod = rd_u64(e + 0x5b0).unwrap_or(0).wrapping_mul(rd_u64(data + 0x108).unwrap_or(0));
        return s50.saturating_sub(prod);
    }
    vt90_get(vt, data) as u64
}

// usable_slot1 순수재현(FUN_141fce700) ★[07-12 전수스캔+의사코드 확정. §11.9.4 C 정정 2건 반영:
//   ⑤스캔 술어=type∉{2,3,4,5} 전부(구기록 "{6..9}만"은 부정확) / aim c8 비교=정확히 ==1]:
//   다형 3슬롯 전부 순수화 — vt90_get(쿨다운 base, data=raw *(e+0x568) 정렬보정 없음)/vta8_get(divisor)/
//   vtc8_get(aim 게이트, 도달가능 구현=상수 true 1종). id!=-1 가드가 c8 호출 선행, kind!=0xd는 type5 경로선 c8 뒤.
unsafe fn d19_usable_slot1(e: usize) -> bool {
    if d19_eff_any(e, |t| t == 4) { D19_US1_FAIL.store(1, Ordering::Relaxed); return false; }   // ①
    let has5 = d19_eff_any(e, |t| t == 5);                               // ② 시전중?
    if !has5 {
        if rd_i32(e + 0x68).unwrap_or(0) != 0xd { D19_US1_FAIL.store(3, Ordering::Relaxed); return false; }
    } else {
        if rd_i32(e + 0x4e0).unwrap_or(-1) != -1 {                       // slot1 id 가드(선행)
            let vt = rd_u64(e + 0x4b8).unwrap_or(0) as usize;            // aim 체인 vt(A계열 sk1)
            let db = rd_u64(e + 0x4b0).unwrap_or(0) as usize;            // A계열 data base(db1)
            if ptr_ok(vt) && descvt_c8(vt, descvt_obj(db, vt), 0) { D19_US1_FAIL.store(2, Ordering::Relaxed); return false; }  // ★[07-15] A계열 c8(구 vtc8_get=상수true 오귀속→0x10 under 정정, 2차와 동일)
        }
        if rd_i32(e + 0x68).unwrap_or(0) != 0xd { D19_US1_FAIL.store(3, Ordering::Relaxed); return false; }
    }
    // 쿨다운: q=max(base*100/max(haste+100,1),3), q−q/div < *(e+0xb8) → 불가
    let data = rd_u64(e + 0x568).unwrap_or(0) as usize;
    let vt = rd_u64(e + 0x570).unwrap_or(0) as usize;
    if !ptr_ok(vt) { D19_US1_FAIL.store(4, Ordering::Relaxed); return false; }
    let base = d19_cd_base(vt, data, e);                                 // ★[07-15] 계산게터(0x1c974a0) 포함(구 vt90_get=base0 오판→쿨다운 under 정정)
    let haste = rd_i32(e + 0x3e8).unwrap_or(0) as i64 + 100;
    let div = vta8_get(vt, data);                                        // ≥1 보장(div0=게임 panic 경로)
    let denom = if haste > 1 { haste as u64 } else { 1 };
    let mut q = base.wrapping_mul(100) / denom;
    if q < 4 { q = 3; }
    D19_US1_BASE.store(base, Ordering::Relaxed); D19_US1_DIV.store(div, Ordering::Relaxed);
    D19_US1_Q.store(q, Ordering::Relaxed); D19_US1_CD.store(rd_u64(e + 0xb8).unwrap_or(u64::MAX), Ordering::Relaxed);
    D19_US1_SLOTRVA.store((rd_u64(vt + 0x90).unwrap_or(0) as u64).wrapping_sub(exe_base() as u64), Ordering::Relaxed);
    if q - q / div < rd_u64(e + 0xb8).unwrap_or(u64::MAX) { D19_US1_FAIL.store(5, Ordering::Relaxed); return false; }
    if d19_eff_any(e, |t| !(2..=5).contains(&t)) { D19_US1_FAIL.store(6, Ordering::Relaxed); return false; }       // ⑤ type∉{2,3,4,5} 존재 → 불가
    if rd_i32(e + 0x4e0).unwrap_or(-1) == -1 { D19_US1_FAIL.store(7, Ordering::Relaxed); return false; }
    D19_US1_FAIL.store(0, Ordering::Relaxed);
    true
}

unsafe fn d19_usable_slot2(e: usize) -> bool {
    if d19_eff_any(e, |t| t == 4) { D19_US2_FAIL.store(1, Ordering::Relaxed); return false; }
    let has5 = d19_eff_any(e, |t| t == 5);
    let lvl = rd_u64(e + 0x5b0).unwrap_or(0);
    let p = if lvl > 2 { e + 0x4e8 } else { exe_base() + D19_SLOT2_EMPTY_RVA };
    if !has5 {
        if rd_i32(e + 0x68).unwrap_or(0) != 0xd { D19_US2_FAIL.store(3, Ordering::Relaxed); return false; }
    } else {
        if rd_i32(p + 0x30).unwrap_or(-1) != -1 {                        // p[6] id 가드
            let vt = rd_u64(p + 8).unwrap_or(0) as usize;                // vt = p[1](A계열 sk2)
            let db = rd_u64(p).unwrap_or(0) as usize;                    // A계열 data base(db2)
            if ptr_ok(vt) && descvt_c8(vt, descvt_obj(db, vt), 0) { D19_US2_FAIL.store(2, Ordering::Relaxed); return false; }  // ★[07-15] A계열 c8(오귀속→0x11 under 정정, 2차와 동일)
        }
        if rd_i32(e + 0x68).unwrap_or(0) != 0xd { D19_US2_FAIL.store(3, Ordering::Relaxed); return false; }
    }
    let data = rd_u64(e + 0x578).unwrap_or(0) as usize;
    let vt = rd_u64(e + 0x580).unwrap_or(0) as usize;
    if !ptr_ok(vt) { D19_US2_FAIL.store(4, Ordering::Relaxed); return false; }
    let base = d19_cd_base(vt, data, e);                                 // ★[07-15] 계산게터 포함
    let haste = rd_i32(e + 0x3e8).unwrap_or(0) as i64 + 100;
    let low = lvl < 3;
    let div_data = rd_u64(e + if low { 0x598 } else { 0x578 }).unwrap_or(0) as usize;
    let div_vt = rd_u64(e + if low { 0x5a0 } else { 0x580 }).unwrap_or(0) as usize;
    if !ptr_ok(div_vt) { return false; }
    let div = vta8_get(div_vt, div_data);
    let denom = if haste > 1 { haste as u64 } else { 1 };
    let mut q = base.wrapping_mul(100) / denom;
    q += (q == 0) as u64;
    D19_US2_BASE.store(base, Ordering::Relaxed); D19_US2_DIV.store(div, Ordering::Relaxed);
    D19_US2_Q.store(q, Ordering::Relaxed); D19_US2_CD.store(rd_u64(e + 0xc0).unwrap_or(u64::MAX), Ordering::Relaxed);
    D19_US2_LVL.store(lvl, Ordering::Relaxed);
    D19_US2_SLOTRVA.store((rd_u64(vt + 0x90).unwrap_or(0) as u64).wrapping_sub(exe_base() as u64), Ordering::Relaxed);
    if q - q / div < rd_u64(e + 0xc0).unwrap_or(u64::MAX) { D19_US2_FAIL.store(5, Ordering::Relaxed); return false; }
    if d19_eff_any(e, |t| !(2..=5).contains(&t)) { D19_US2_FAIL.store(6, Ordering::Relaxed); return false; }
    if rd_i32(p + 0x30).unwrap_or(-1) == -1 { D19_US2_FAIL.store(7, Ordering::Relaxed); return false; }            // 최종 id 가드(p 재산출=동일)
    D19_US2_FAIL.store(if low { 8 } else { 0 }, Ordering::Relaxed);
    !low                                                                 // lvl>=3
}

// usable_slot1/2 셀렉터: 기본=순수(위), d19_us_shadow=1이면 shadow-call 롤백(AV위험 §3).
unsafe fn d19_usable_slot1_sel(e: usize) -> bool {
    if D19_US_SHADOW.load(Ordering::Relaxed) { d19_usable_slot1_shadow(e) } else { d19_usable_slot1(e) }
}

unsafe fn d19_usable_slot2_sel(e: usize) -> bool {
    if D19_US_SHADOW.load(Ordering::Relaxed) { d19_usable_slot2_shadow(e) } else { d19_usable_slot2(e) }
}

unsafe fn d19_usable_slot1_shadow(self_u: usize) -> bool {
    let base = exe_base();
    if base == 0 || !ptr_ok(self_u) { return false; }
    // ⚠[0.5.1] 0x1fce700=0.5.0_3 stale. 기본 d19_us_shadow=OFF(순수 d19_usable_slot1)라 미호출. 켜기 전 0.5.1 재핀.
    if !code_ptr_ok(base + 0x1fce700) { return false; }   // ★[07-15 하드닝] stale/비.text RVA CALL 사전차단
    let f: D19Us = core::mem::transmute(base + 0x1fce700);
    let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| f(self_u))).unwrap_or(0);
    (r & 1) != 0
}

unsafe fn d19_usable_slot2_shadow(self_u: usize) -> bool {
    let base = exe_base();
    if base == 0 || !ptr_ok(self_u) { return false; }
    // ⚠[0.5.1] 0x1fbe950=0.5.0_3 stale. 기본 d19_us_shadow=OFF(순수 d19_usable_slot2)라 미호출. 켜기 전 0.5.1 재핀.
    if !code_ptr_ok(base + 0x1fbe950) { return false; }   // ★[07-15 하드닝] stale/비.text RVA CALL 사전차단
    let f: D19Us = core::mem::transmute(base + 0x1fbe950);
    let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| f(self_u))).unwrap_or(0);
    (r & 1) != 0
}

// scaled(u) — ★[07-15 명령어 대조] 게임 e33d~e361: MOVSXD·ADD100·IMUL(부호곱) 후 **SHR(논리)** ×2 + umulh.
//   ⚠구 재현은 `>>2`가 i64=SAR(산술)이라 P<0에서 게임(SHR)과 갈림=under의 정체 → **전부 u64 무부호로 교정**.
#[inline] unsafe fn d19_scaled(u: usize) -> u64 {
    let ps = (rd_i32(u + 0x458).unwrap_or(0) as i64 + 100).wrapping_mul(rd_i64(u + 0x668).unwrap_or(0));  // IMUL(부호)
    if ps < 0 { D19_PNEG.fetch_add(1, Ordering::Relaxed); }   // ★진단: P<0 발생수(0이면 SHR교정 무효)
    let p = ps as u64;
    let a = p >> 2;                                                          // ★논리 SHR(SAR 아님)
    let hi = (a as u128).wrapping_mul(0x28f5c28f5c28f5c3u128) >> 64;         // umulh
    (hi as u64) >> 2                                                         // ★논리 SHR
}

// ── vt0x90 스킬게터 순수재현(shadow-call 제거) ──────────────────────────────────────────
//   vt0x90 슬롯값 = 함수포인터. 6종 전부 trivial 필드게터(`mov rax,[data+imm]; ret`, self/target·RNG 미참조,
//   47 vtable 전수확인). 그래서 CALL 대신 슬롯 RVA로 imm을 판정해 *(data+imm)을 직접 read = bit-exact 순수화.
//   (c8c_cast_get의 vt0x90 서브셋과 동일 표 + 0x19ed260→+0x20 추가.) 미등재 슬롯은 decode_getter로 프롤로그 파싱.
unsafe fn vt90_get(vt: usize, data: usize) -> i64 {
    let slot = rd_u64(vt + 0x90).unwrap_or(0) as usize;
    if slot == 0 || !ptr_ok(data) || !in_text(slot) { return 0; }   // ★[07-15 하드닝] .text 게이트(유효 게터 무영향)
    let base = exe_base();
    let imm: i64 = match slot.wrapping_sub(base) {
        0x19f2f60 => 0x30, 0x1a13cb0 => 0x28, 0x19ed260 => 0x20,
        0x19ed250 => 0x18, 0x1a3a240 => 0x08, 0xb024b0 => 0x00,
        0x1e85540 => 0x170,   // ★[07-15] mov rax,[rcx+0x170](쿨다운 base 게터, disp32라 구 decode_getter 미파싱)
        _ => decode_getter(slot),   // 미등재: 프롤로그 바이트 파싱(미래 챔피언 일반화)
    };
    if imm < 0 { return 0; }
    rd_i64(data + imm as usize).unwrap_or(0)
}

// decode_getter: 미등재 슬롯의 프롤로그를 VEH-safe로 읽어 필드게터인지 판정.
//   패턴A `48 8B 41 <imm8> C3` (mov rax,[rcx+imm8];ret) → imm8. 패턴B `48 8B 01 C3` (mov rax,[rcx];ret) → 0.
//   그 외(다른 레지스터/movzx/실제 로직 등) → -1(미지원, 0 반환).
unsafe fn decode_getter(slot: usize) -> i64 {
    if !readable(slot, 8) { return -1; }
    if rd_u8(slot) == 0x48 && rd_u8(slot + 1) == 0x8B {
        let b2 = rd_u8(slot + 2);
        if b2 == 0x41 && rd_u8(slot + 4) == 0xC3 { return rd_u8(slot + 3) as i64; } // [rcx+imm8]
        if b2 == 0x01 && rd_u8(slot + 3) == 0xC3 { return 0; }                       // [rcx]
        // ★[07-15] disp32형 `48 8B 81 <imm32> C3` (오프셋 ≥0x80이라 어셈블러가 disp32 인코딩) → imm8형과 동일 필드게터.
        if b2 == 0x81 && rd_u8(slot + 7) == 0xC3 {
            return (rd_u8(slot+3) as i64) | ((rd_u8(slot+4) as i64)<<8) | ((rd_u8(slot+5) as i64)<<16) | ((rd_u8(slot+6) as i64)<<24);
        }
    }
    -1
}

// vt+0xa8 쿨다운 divisor 게터 순수재현 ★[07-12 전수스캔]: 135 vtable에서 구현 3종, 전부 rcx(data)-only·RNG-free.
//   fn(rcx=data, rdx=e)->u64. 0x9a1230=상수1(133/135 우세형) / 0x1bbe3c0=max(*(data+0x40),1)(circus_blade)
//   / 0x1a13cb0=*(data+0x28)(ghost_skill2, 0이면 게임=div panic → 우리=1 가드).
unsafe fn vta8_get(vt: usize, data: usize) -> u64 {
    let slot = rd_u64(vt + 0xa8).unwrap_or(0) as usize;
    if slot == 0 || !in_text(slot) { return 1; }   // ★[07-15 하드닝] .text 게이트. 실패=1(div0 가드 유지, 유효 게터 무영향)
    let v = match slot.wrapping_sub(exe_base()) {
        0x9a1230 => 1,
        0x1bbe3c0 => rd_u64(data + 0x40).unwrap_or(0),
        0x1a13cb0 => rd_u64(data + 0x28).unwrap_or(0),
        _ => {
            // 폴백(미래 챔피언): max(f,1) 패턴 `48 8B 41 40 / 48 83 F8 01 / 48 83 D0 00 / C3` → 필드+adc.
            if rd_u8(slot) == 0x48 && rd_u8(slot + 1) == 0x8B && rd_u8(slot + 2) == 0x41
                && rd_u8(slot + 4) == 0x48 && rd_u8(slot + 5) == 0x83 && rd_u8(slot + 6) == 0xF8 {
                rd_u64(data + rd_u8(slot + 3) as usize).unwrap_or(0)
            } else {
                emulate_getter(slot, data).unwrap_or(1) as u64   // B8 imm32/필드게터/xor 공통 디코드
            }
        }
    };
    v.max(1)   // div0 가드(게임=panic 경로 미도달 전제, 우리=1)
}

// vt0x90 range getter(skillobj vtable+0x90 다형) = 순수화(구 shadow-call). ★ghidra 확정: skillobj가 슬롯마다 다름
//   (slot0=*(self+0x480), slot1=*(self+0x4b8), slot2=*(slot2+0x8)), dbase도 각각(0x478/0x4b0/slot2+0).
//   dataptr=align16(*(skillobj+0x10)-1)+dbase+0x10. getter=*(skillobj+0x90)=필드게터 → vt90_get(skillobj,dataptr).
unsafe fn d19_vt90_range(skillobj: usize, dbase: usize) -> i64 {
    if !ptr_ok(skillobj) { return 0; }
    let inner = rd_u64(skillobj + 0x10).unwrap_or(0) as usize;
    let dataptr = (inner.wrapping_sub(1) & !0xf).wrapping_add(dbase).wrapping_add(0x10);
    vt90_get(skillobj, dataptr)
}

// in_range_slotN: R = rbase + spd*30 + *(self+0x420) + (*(self+0x5b0)-1)*perlvl + vt90 + scaled(self)+scaled(r13).
//   ★[07-14 RE 정정] `*(self+0x628)` = **이동속도(speed)**이고 `*0x1e(30)` = **30틱 리드**항(구 "sight" 표기는 오해).
//   rbase/perlvl/skillobj/dbase는 슬롯별로 caller가 산출해 전달(slot0/1=self기준, slot2=slot2기준). d2 > R² → range 밖(false).
//   기본형 d19_in_range = spd를 self+0x628 원본으로(1차 emitter·enemies_near·self 경로 = 보정 없음, 검증완 동작 보존).
#[inline] unsafe fn d19_in_range(self_u: usize, r13: usize, rbase: i64, perlvl: i64, skillobj: usize, dbase: usize) -> bool {
    d19_in_range_spd(self_u, r13, rbase, perlvl, skillobj, dbase, rd_i64(self_u + 0x628).unwrap_or(0))
}

// speed 파라미터화 변형 — 2차 emitter cand_main 루프의 **리드 보정**(d19_lead_speed) 적용용.
unsafe fn d19_in_range_spd(self_u: usize, r13: usize, rbase: i64, perlvl: i64, skillobj: usize, dbase: usize, spd: i64) -> bool {
    // ★[07-15 명령어 대조] R 누산은 전부 64-bit **무부호 wrapping**, 비교는 무부호 제곱(JA). ★게임엔 r<=0 가드 없음(제거).
    let (sx, sy) = (rd_u64(self_u + 0x648).unwrap_or(0), rd_u64(self_u + 0x650).unwrap_or(0));
    let (rx, ry) = (rd_u64(r13 + 0x648).unwrap_or(0), rd_u64(r13 + 0x650).unwrap_or(0));
    let d2 = sqd(sx, sy, rx, ry);
    let level = rd_i64(self_u + 0x5b0).unwrap_or(0);
    // vt+0x90 = A계열(SkillDesc) descvt_90.
    let vt90: u64 = if ptr_ok(skillobj) { descvt_90(skillobj, descvt_obj(dbase, skillobj), self_u, r13, 0) } else { 0 };
    let r = (rbase as u64)
        .wrapping_add(rd_i64(self_u + 0x420).unwrap_or(0) as u64)                         // *(self+0x420)
        .wrapping_add((perlvl as u64).wrapping_mul((level as u64).wrapping_sub(1)))        // perlvl*(level-1)
        .wrapping_add(vt90)
        .wrapping_add(d19_scaled(self_u))
        .wrapping_add(d19_scaled(r13))
        .wrapping_add((spd as u64).wrapping_mul(30));                                      // lead*30
    D19_INR_RSQ.store(r.wrapping_mul(r), Ordering::Relaxed); D19_INR_D2.store(d2, Ordering::Relaxed); D19_INR_R.store(r, Ordering::Relaxed);
    d2 <= r.wrapping_mul(r)                                                                // 무부호 제곱 비교(JA)
}

// ★[07-15 RE] dive-safe(soak) 게이트 = FUN_14237ed50 완전재현. 반환 true=차단(ed50==1), false=허용(ed50==0).
//   콜사이트 `OR CL,AL; JNZ skip` → emit엔 ed50==0(허용) 필요. 구 `dive=(kind==2)` 무조건차단은 오류(kind==2도 soaker 있으면 허용).
//   kind(S+0x68)≠2 → 허용. kind==2면 구조물 S 사거리 내 concat3 유닛(soaker) 카운트로 판정:
//     S+0x88!=1(일반 타워): soaker≥1 → 허용, 없으면 차단.
//     S+0x88==1(특수): self가 S 현재타깃(S+0x98==self+0x5a8)이면 차단 / soaker≥2 → 허용, else 차단.
//   soaker reach = skillvcall(S,u) + reachS + size(u), reachS = S+0x420 + S+0x488 + (levelS-1)*S+0x490 + (S+0x4a8==0?size(S):0).
//   soak side = state[0x820] → FUN_142076da0 내부반전 = enemy = other (gate(ii)와 동일 오프셋). dist/reach는 S 위치·S 사거리 기준.
unsafe fn d19_divesafe(g0: usize, other: usize, self_u: usize, s: usize) -> bool {
    if rd_i32(s + 0x68).unwrap_or(0) != 2 { return false; }        // kind≠2 → 허용
    let s4a8 = rd_i32(s + 0x4a8).unwrap_or(-1);
    if s4a8 == -1 { return true; }                                 // panic 가드 경로 = 차단(return 1)
    let branch_b = rd_i32(s + 0x88).unwrap_or(0) == 1;
    if branch_b && rd_u64(s + 0x98).unwrap_or(0) == rd_u64(self_u + 0x5a8).unwrap_or(0) { return true; }  // self=S 현재타깃 → 차단
    // reachS 구성(S 기준)
    let size_s = if s4a8 == 0 { d19_scaled(s) } else { 0 };
    let level_s = rd_i64(s + 0x5b0).unwrap_or(0);
    let reach_s = (rd_i64(s + 0x420).unwrap_or(0) as u64)
        .wrapping_add(rd_i64(s + 0x488).unwrap_or(0) as u64)
        .wrapping_add((rd_i64(s + 0x490).unwrap_or(0) as u64).wrapping_mul((level_s as u64).wrapping_sub(1)))
        .wrapping_add(size_s);
    let skillobj = rd_u64(s + 0x480).unwrap_or(0) as usize;
    let dbase = rd_u64(s + 0x478).unwrap_or(0) as usize;
    let s_obj = descvt_obj(dbase, skillobj);
    let (sx, sy) = (rd_u64(s + 0x648).unwrap_or(0), rd_u64(s + 0x650).unwrap_or(0));
    let mut n = 0i64;
    for &(bo, co) in &[(0x10usize, 0x28usize), (0x50, 0x68), (0x90, 0xa8)] {
        let begin = rd_u64(g0 + other * 0x20 + bo).unwrap_or(0) as usize;
        let cnt = rd_i64(g0 + other * 0x20 + co).unwrap_or(0);
        if begin == 0 || cnt <= 0 || cnt > 4096 { continue; }
        for i in 0..cnt as usize {
            let u = rd_u64(begin + i * 8).unwrap_or(0) as usize;
            if !ptr_ok(u) { continue; }
            let skillvc = if ptr_ok(skillobj) { descvt_90(skillobj, s_obj, s, u, 0) } else { 0 };
            let reach = skillvc.wrapping_add(reach_s).wrapping_add(d19_scaled(u));
            let (ux, uy) = (rd_u64(u + 0x648).unwrap_or(0), rd_u64(u + 0x650).unwrap_or(0));
            let dist2 = sqd(sx, sy, ux, uy);
            if reach.wrapping_mul(reach) >= dist2 {
                if branch_b { n += 1; } else { return false; }     // 일반: soaker 1개 → 허용
            }
        }
    }
    if branch_b { n < 2 } else { true }                            // 특수: ≥2 허용 / 일반: soaker없음 차단
}

// 능력 커맨드 emit(tag 0xf/0x10/0x11). stride0x4f8: +0x00=src(issuer), +0x08=target(r13+0x5a8), +0x10 byte=0, +0x4f1=tag. 나머지 0.
unsafe fn d19_emit_abil(out: usize, src: u64, target: u64, tag: u8) -> bool {
    let buf = rd_u64(out).unwrap_or(0) as usize;
    let cap = rd_u64(out + 0x10).unwrap_or(0);
    let len = rd_u64(out + 0x18).unwrap_or(0);
    if !ptr_ok(buf) || len >= cap { return false; }
    let e = buf + (len as usize) * D19_STRIDE;
    wr_u64(e, src);            // +0x00 src(issuer)
    wr_u64(e + 8, target);     // +0x08 target id(r13+0x5a8)
    wr_u8(e + 0x10, 0);        // +0x10 byte0=0
    wr_u8(e + 0x4f9, tag);     // ★0.5.1 +0x4f9 tag(was +0x4f1)
    wr_u64(out + 0x18, len + 1);
    true
}


// 능력배정 발행블록(tag 0xf/0x10/0x11) — FUN_141c83700 0x84c35~0x8525b. tag5/tag3 발행 뒤 추가발행.
//   self_u=nx(=self-unit, dd7_slot128 이미 resolve). cand=concat3(OTHER 3리스트, g0 기준 = d19_lane_pressed와 동일).
//   ★D19_ABIL 게이트 하에서만 호출. ★[07-12] 기본 완전 순수(usable_slot1/2·vt90 순수화; shadow=d19_us_shadow 롤백만).
unsafe fn d19_abil_block(out: usize, g0: usize, other: usize, self_u: usize, src: u64, sim_obj: usize, geom2: usize) {
    if !ptr_ok(self_u) { return; }
    ABIL_DBG[0].fetch_add(1, Ordering::Relaxed);   // 블록 진입
    let (sx, sy) = (rd_i64(self_u + 0x648).unwrap_or(0), rd_i64(self_u + 0x650).unwrap_or(0));
    let self_team = rd_u8(self_u) == 0;
    let self_f8 = rd_u64(self_u + 8).unwrap_or(0) as usize;
    // 슬롯 상수(self 기준 1회 산출)
    let slot1_desc = self_u + 0x4d8;
    let level = rd_i64(self_u + 0x5b0).unwrap_or(0);
    // 슬롯2 desc base: level>=3 → self+0x4e8, else → STATIC_TEMPLATE(RVA 미확정이면 0=skip)
    let slot2_base = if level >= 3 {
        self_u + 0x4e8
    } else if D19_STATIC_TEMPLATE_RVA != 0 {
        exe_base().wrapping_add(D19_STATIC_TEMPLATE_RVA)
    } else {
        0
    };
    // 후보 concat3(OTHER 3리스트): g0 + other*0x20 + {(begin,cnt)} = {(0x10,0x28),(0x50,0x68),(0x90,0xa8)}
    let cbase = other * 0x20;
    D19_C1DBG_N.store(0, Ordering::Relaxed); D19_C1S1_N.store(0, Ordering::Relaxed); D19_C1S2_N.store(0, Ordering::Relaxed);   // ★진단 리셋
    for &(bo, co) in &[(0x10usize, 0x28usize), (0x50, 0x68), (0x90, 0xa8)] {
        let begin = rd_u64(g0 + cbase + bo).unwrap_or(0) as usize;
        let cnt = rd_i64(g0 + cbase + co).unwrap_or(0);
        if begin == 0 || cnt <= 0 || cnt > 4096 { continue; }
        for i in 0..cnt as usize {
            ABIL_DBG[10].fetch_add(1, Ordering::Relaxed);   // 후보 총순회
            let r13 = rd_u64(begin + i * 8).unwrap_or(0) as usize;
            if !ptr_ok(r13) { continue; }
            ABIL_DBG[1].fetch_add(1, Ordering::Relaxed);   // ptr_ok 후보
            // (A) 거리 프리필터: (d2>>0xe) > 0x5f5e0 이면 skip
            let dx = (sx - rd_i64(r13 + 0x648).unwrap_or(0)).unsigned_abs();
            let dy = (sy - rd_i64(r13 + 0x650).unwrap_or(0)).unsigned_abs();
            let d2 = dx.wrapping_mul(dx).wrapping_add(dy.wrapping_mul(dy));
            let c1id = rd_u64(r13 + 0x5a8).unwrap_or(0) & 0xffff;
            let mut c1 = |code: u64| { let di = D19_C1DBG_N.fetch_add(1, Ordering::Relaxed); if di < 128 { D19_C1DBG[di].store((c1id << 8) | code, Ordering::Relaxed); } };
            if (d2 >> 0xe) > 0x5f5e0 { c1(1); continue; }
            ABIL_DBG[2].fetch_add(1, Ordering::Relaxed);   // dist 통과
            // (B) 팀필터: self.team0 && *(r13 + 0x38 + self.f8*0x18)!=0 → skip
            if self_team { ABIL_DBG[11].fetch_add(1, Ordering::Relaxed); }
            if self_team && rd_u64(r13 + 0x38 + self_f8 * 0x18).unwrap_or(0) != 0 { c1(2); continue; }
            ABIL_DBG[3].fetch_add(1, Ordering::Relaxed);   // team 통과
            let target = rd_u64(r13 + 0x5a8).unwrap_or(0);
            // slot별 in_range 파라미터(★ghidra 확정: rbase/perlvl은 slot0/1=self+0x488/+0x490 공통, slot2=slot2+0x10/+0x18.
            //   skillobj/dbase는 slot0=self+0x480/+0x478, slot1=self+0x4b8/+0x4b0, slot2=slot2+0x8/+0).
            let (rb01, pl01) = (rd_i64(self_u + 0x488).unwrap_or(0), rd_i64(self_u + 0x490).unwrap_or(0));
            // (C) 슬롯0 → tag 0xf
            let u0 = d19_usable_slot0(self_u);
            if u0 { ABIL_DBG[4].fetch_add(1, Ordering::Relaxed); }
            if !u0 { c1(3); }
            else if d19_in_range(self_u, r13, rb01, pl01,
                                rd_u64(self_u + 0x480).unwrap_or(0) as usize,
                                rd_u64(self_u + 0x478).unwrap_or(0) as usize) {
                ABIL_DBG[5].fetch_add(1, Ordering::Relaxed);
                c1(0);   // emit 0xf
                d19_emit_abil(out, src, target, 0xf);
            } else { c1(4); }
            // (D) 슬롯1 → tag 0x10 (하위게이트 분리계측)
            let mut c1s1 = |code: u64| { let di = D19_C1S1_N.fetch_add(1, Ordering::Relaxed); if di < 24 { D19_C1S1[di].store((c1id << 8) | code, Ordering::Relaxed); } };
            let s1a = rd_i64(self_u + 0x4e0).unwrap_or(-1) != -1;   // slot-valid(+0x4e0)
            if s1a { ABIL_DBG[12].fetch_add(1, Ordering::Relaxed); }
            let s1b = s1a && d19_usable_slot1_sel(self_u);          // +usable_sel
            if s1b { ABIL_DBG[13].fetch_add(1, Ordering::Relaxed); }
            let u1 = s1b && d19_target_valid(slot1_desc, self_u, r13);   // +target_valid
            if u1 { ABIL_DBG[6].fetch_add(1, Ordering::Relaxed); }
            if !s1a { c1s1(1); } else if !s1b { c1s1(2); } else if !u1 { c1s1(3); }
            else if d19_in_range(self_u, r13,
                                rd_i64(self_u + 0x4c0).unwrap_or(0), rd_i64(self_u + 0x4c8).unwrap_or(0),   // ★[07-12 RE] slot1 rb/pl = self+0x4c0/0x4c8 (구버전 slot0필드 0x488/0x490 오용=0x10 under-emit)
                                rd_u64(self_u + 0x4b8).unwrap_or(0) as usize,
                                rd_u64(self_u + 0x4b0).unwrap_or(0) as usize) {
                ABIL_DBG[7].fetch_add(1, Ordering::Relaxed);
                c1s1(0);
                d19_emit_abil(out, src, target, 0x10);
            } else { c1s1(4); }
            // (E) 슬롯2 → tag 0x11 (하위게이트 분리계측; slot2_base=0=STATIC미확정 폴백이면 skip)
            let mut c1s2 = |code: u64| { let di = D19_C1S2_N.fetch_add(1, Ordering::Relaxed); if di < 24 { D19_C1S2[di].store((c1id << 8) | code, Ordering::Relaxed); } };
            let s2a = slot2_base != 0 && rd_i64(slot2_base + 0x30).unwrap_or(-1) != -1;   // slot-valid(+0x30)
            if s2a { ABIL_DBG[14].fetch_add(1, Ordering::Relaxed); }
            let s2b = s2a && d19_usable_slot2_sel(self_u);          // +usable_sel
            if s2b { ABIL_DBG[15].fetch_add(1, Ordering::Relaxed); }
            let u2 = s2b && d19_target_valid(slot2_base + 0x28, self_u, r13);   // +target_valid
            if u2 { ABIL_DBG[8].fetch_add(1, Ordering::Relaxed); }
            if !s2a { c1s2(1); } else if !s2b { c1s2(2); } else if !u2 { c1s2(3); }
            else if d19_in_range(self_u, r13,
                                rd_i64(slot2_base + 0x10).unwrap_or(0), rd_i64(slot2_base + 0x18).unwrap_or(0),
                                rd_u64(slot2_base + 0x8).unwrap_or(0) as usize,
                                rd_u64(slot2_base).unwrap_or(0) as usize) {
                ABIL_DBG[9].fetch_add(1, Ordering::Relaxed);
                c1s2(0);
                d19_emit_abil(out, src, target, 0x11);
            } else { c1s2(4); }
        }
    }
    // ═══ ★[07-15 RE] 방어리스트 3슬롯 발행 (FUN_142376f00 @0x141c853aa, concat3 뒤 호출) ═══
    //   소스: begin=*(g0+0xf0+other*0x20), cnt=*(g0+0x108+other*0x20). concat3(0x10/0x50/0x90)와 디스조인트한 "방어대상" 리스트.
    //   = 0x1ec류 all-3-tags 단일타깃 under의 정체. 게이트: 가시성(geom_vt68/vtc0 폴백, sim_obj vtable=2차동일) + 방어플래그(0x6a0!=0 && 0x688==0)
    //   + 팀슬롯 + coarse dist(<0x17d784000) + 슬롯준비(concat3와 오프셋·공식 완전동일).
    {
        let side = 1 - other;
        let dbeg = rd_u64(g0 + 0xf0 + other * 0x20).unwrap_or(0) as usize;
        let dcnt = rd_i64(g0 + 0x108 + other * 0x20).unwrap_or(0);
        let (rb01, pl01) = (rd_i64(self_u + 0x488).unwrap_or(0), rd_i64(self_u + 0x490).unwrap_or(0));
        D19_DEFDBG_N.store(0, Ordering::Relaxed);
        if dbeg != 0 && dcnt > 0 && dcnt <= 4096 {
            for i in 0..dcnt as usize {
                let r13 = rd_u64(dbeg + i * 8).unwrap_or(0) as usize;
                if !ptr_ok(r13) { continue; }
                let id = rd_u64(r13 + 0x5a8).unwrap_or(0);
                let did = id & 0xffff;
                let mut dfg = |code: u64| { let di = D19_DEFDBG_N.fetch_add(1, Ordering::Relaxed); if di < 32 { D19_DEFDBG[di].store((did << 8) | code, Ordering::Relaxed); } };
                // (1) 가시성 — cand_main과 동일: geom_vt68(sim_obj,side,id) ∥ geom_vtc0 폴백(rec+0x8b0→geom2 last-seen+0x78 유예)
                let visible = if geom_vt68(sim_obj, side, id) { true } else {
                    let rec = geom_vtc0(sim_obj, id);
                    if rec != 0 {
                        let idx2 = rd_u32(rec + 0x8b0) as usize;
                        let last_seen = rd_i64(geom2 + 0x1e0 + other * 0x2e8 + idx2 * 8).unwrap_or(i64::MIN);
                        geom_vt28(sim_obj) <= last_seen.wrapping_add(0x78)
                    } else { false }
                };
                if !visible { dfg(1); continue; }
                // (2) 방어플래그
                if rd_u8(r13 + 0x6a0) == 0 || rd_i64(r13 + 0x688).unwrap_or(0) != 0 { dfg(2); continue; }
                // (3) 팀슬롯(concat3 team필터와 동일)
                if self_team && rd_u64(r13 + 0x38 + self_f8 * 0x18).unwrap_or(0) != 0 { dfg(3); continue; }
                // (4) coarse dist
                let dx = (sx - rd_i64(r13 + 0x648).unwrap_or(0)).unsigned_abs();
                let dy = (sy - rd_i64(r13 + 0x650).unwrap_or(0)).unsigned_abs();
                let d2 = dx.wrapping_mul(dx).wrapping_add(dy.wrapping_mul(dy));
                if d2 >= 0x17d784000 { dfg(4); continue; }
                // (5) 슬롯별 발행 (concat3와 동일공식)
                let target = id;
                let mut fired = false;
                if d19_usable_slot0(self_u) && d19_in_range(self_u, r13, rb01, pl01,
                        rd_u64(self_u + 0x480).unwrap_or(0) as usize, rd_u64(self_u + 0x478).unwrap_or(0) as usize) {
                    d19_emit_abil(out, src, target, 0xf); fired = true;
                }
                if rd_i64(self_u + 0x4e0).unwrap_or(-1) != -1 && d19_usable_slot1_sel(self_u)
                    && d19_target_valid(slot1_desc, self_u, r13)
                    && d19_in_range(self_u, r13, rd_i64(self_u + 0x4c0).unwrap_or(0), rd_i64(self_u + 0x4c8).unwrap_or(0),
                        rd_u64(self_u + 0x4b8).unwrap_or(0) as usize, rd_u64(self_u + 0x4b0).unwrap_or(0) as usize) {
                    d19_emit_abil(out, src, target, 0x10); fired = true;
                }
                if slot2_base != 0 && rd_i64(slot2_base + 0x30).unwrap_or(-1) != -1 && d19_usable_slot2_sel(self_u)
                    && d19_target_valid(slot2_base + 0x28, self_u, r13)
                    && d19_in_range(self_u, r13, rd_i64(slot2_base + 0x10).unwrap_or(0), rd_i64(slot2_base + 0x18).unwrap_or(0),
                        rd_u64(slot2_base + 0x8).unwrap_or(0) as usize, rd_u64(slot2_base).unwrap_or(0) as usize) {
                    d19_emit_abil(out, src, target, 0x11); fired = true;
                }
                dfg(if fired { 0 } else { 5 });
            }
        }
    }
    // ═══ ★[07-15 RE] Path B: 구조물 0xf (1차 emitter 0x141c85ae8) — mine이 누락했던 저ID 구조물 소스 ═══
    //   최근접 적 구조물 S에 slot0 발행. r15=FUN_142326080=d19_threat_dmg(S→self), 게이트 FUN_14237ed50=구조물(kind≠2)엔 0.
    //   emit 조건: 최근접S 유효 && self+0x4a8!=-1 && S 사거리내 && 사거리내 적유닛 존재 && !dive && usable_slot0 && curHP>r15.
    {
        let mut sl = [0usize; 32];
        let m = d19_struct_list(g0, other, &mut sl);
        let (mut best_s, mut best_d) = (0usize, u64::MAX);
        for k in 0..m {
            let s = sl[k];
            if rd_u8(s + 0x6a0) != 1 || rd_i64(s + 0x688).unwrap_or(1) != 0 { continue; }   // 유효 구조물
            let d = sqd(sx as u64, sy as u64, rd_u64(s + 0x648).unwrap_or(0), rd_u64(s + 0x650).unwrap_or(0));
            if d < best_d { best_d = d; best_s = s; }
        }
        if best_s != 0 && rd_i32(self_u + 0x4a8).unwrap_or(-1) != -1 {
            let s = best_s;
            let (rb01, pl01) = (rd_i64(self_u + 0x488).unwrap_or(0), rd_i64(self_u + 0x490).unwrap_or(0));
            let sk0 = rd_u64(self_u + 0x480).unwrap_or(0) as usize;
            let db0 = rd_u64(self_u + 0x478).unwrap_or(0) as usize;
            let s_in_range = d19_in_range(self_u, s, rb01, pl01, sk0, db0);
            // 사거리내 적 유닛 존재?(게이트용, concat3 재순회)
            let mut unit_in_range = false;
            'ur: for &(bo, co) in &[(0x10usize, 0x28usize), (0x50, 0x68), (0x90, 0xa8)] {
                let begin = rd_u64(g0 + other * 0x20 + bo).unwrap_or(0) as usize;
                let cnt = rd_i64(g0 + other * 0x20 + co).unwrap_or(0);
                if begin == 0 || cnt <= 0 || cnt > 4096 { continue; }
                for i in 0..cnt as usize {
                    let r13 = rd_u64(begin + i * 8).unwrap_or(0) as usize;
                    if !ptr_ok(r13) { continue; }
                    let dx = (sx - rd_i64(r13 + 0x648).unwrap_or(0)).unsigned_abs();
                    let dy = (sy - rd_i64(r13 + 0x650).unwrap_or(0)).unsigned_abs();
                    if (dx.wrapping_mul(dx).wrapping_add(dy.wrapping_mul(dy)) >> 0xe) > 0x5f5e0 { continue; }
                    if self_team && rd_u64(r13 + 0x38 + self_f8 * 0x18).unwrap_or(0) != 0 { continue; }
                    if d19_in_range(self_u, r13, rb01, pl01, sk0, db0) { unit_in_range = true; break 'ur; }
                }
            }
            let r15 = d19_threat_dmg(s, g0, self_u, exe_base());   // = FUN_142326080 (S+0x4a8==-1→0 내장가드)
            let blocked = d19_divesafe(g0, other, self_u, s);       // ★FUN_14237ed50 완전재현(구 dive=kind==2 오류 교정)
            let hp_gt = rd_i64(self_u + 0x658).unwrap_or(0) > r15;
            // ★Path B 진단
            D19_PB_M.store(m as u64, Ordering::Relaxed);
            D19_PB_BEST.store(rd_u64(s + 0x5a8).unwrap_or(0) & 0xffff, Ordering::Relaxed);
            let gate = (1u64) | ((rd_i32(self_u+0x4a8).unwrap_or(-1)!=-1) as u64)<<1
                | (s_in_range as u64)<<2 | (unit_in_range as u64)<<3
                | ((!blocked) as u64)<<4 | (d19_usable_slot0(self_u) as u64)<<5 | (hp_gt as u64)<<6;
            D19_PB_GATE.store(gate, Ordering::Relaxed);
            if unit_in_range && s_in_range && !blocked && d19_usable_slot0(self_u) && hp_gt {
                d19_emit_abil(out, src, rd_u64(s + 0x5a8).unwrap_or(0), 0xf);
            }
        } else {
            D19_PB_M.store(m as u64, Ordering::Relaxed);
            D19_PB_BEST.store(0xfffe, Ordering::Relaxed);   // best_s==0 or 4a8==-1
            D19_PB_GATE.store(if best_s!=0 {1} else {0}, Ordering::Relaxed);
        }
    }
    // ★진단 덤프(50진입마다): abil_dbg.txt — 어느 게이트가 후보를 전부 거부하는지
    if ABIL_DBG[0].load(Ordering::Relaxed) % 50 == 0 {
        if let Some(p) = pth("abil_dbg.txt") {
            let g = |i: usize| ABIL_DBG[i].load(Ordering::Relaxed);
            let _ = fs::write(&p, format!(
                "[abil] blk={} cand={} ptrok={} dist통과={} team통과={} selfteam0={}\n  s0: usable={} emit0xf={}\n  s1: slotvalid={} +sel={} +tgtvalid={} emit0x10={}\n  s2: slotvalid={} +sel={} +tgtvalid={} emit0x11={}\n",
                g(0), g(10), g(1), g(2), g(3), g(11),
                g(4), g(5),
                g(12), g(13), g(6), g(7),
                g(14), g(15), g(8), g(9)));
        }
    }
}


// ════════ A계열(SkillDesc) vtable 게터 — ★[07-14 전수스캔] B계열(dyn Skill)과 별개 trait군 ════════
//   A계열 = desc `self+0x478/0x4b0/0x4e8/0x520` (stride 0x38, {data@0, vt@8, r0@0x10, r1@0x18, skilltype@0x28, state@0x30}).
//     전 vtable align=8 확정 ⇒ **obj = desc.data + 0x10** 하드코딩 가능.
//   B계열 = dyn Skill `self+0x558+i*0x10` (vt90_get/vta8_get/vtc8_get이 여기 유효 — 쿨다운 base/div).
//   ★혼용 주의: ddf0의 `*(self+0x4b8)+0xc8`(aim)·`+0x90`(사거리보너스)은 **A계열**이므로 B계열 매핑(vtc8_get=상수true)을 쓰면 틀림.
//     실제 A계열 vt+0xc8은 0x50fc80(=false)이 36/64로 우세 → 게임은 스코어게이트를 대부분 건너뛰고 바로 emit.
//     (구 vtc8_get을 A계열에 쓰면 항상 true → 스코어게이트 과다실행 → 0x10/0x11 under-emit의 정체.)

// ★[07-15 RE] A계열 obj 계산 = `data + ((vt[0x10]-1) & !0xF) + 0x10`. vt[0x10]=Rust vtable align.
//   최상위는 align=8이라 data+0x10이지만, **composite의 sub 원소는 각자 자기 align**을 쓰므로 하드코딩 금지.
#[inline] unsafe fn descvt_obj(data: usize, vt: usize) -> usize {
    let al = rd_u64(vt + 0x10).unwrap_or(8) as usize;
    (al.wrapping_sub(1) & !0xf).wrapping_add(data).wrapping_add(0x10)
}

// ★[07-15] 제네릭 프롤로그 디코더 — 챔피언별로 다양한 trivial leaf(상수/필드검사)를 바이트로 분류.
//   RVA 테이블 무한증식 회피(매 매치 새 챔피언 leaf가 나오는 롱테일 해소). composite/delegate는 CALL 있어 None→테이블 담당.
//   bool leaf `fn(rcx=obj)->AL`: 31c0c3/33c0c3=false / b0 II c3=const II / 48 83 79 II 00 0f95c0 c3=[obj+II]!=0.
unsafe fn decode_bool_leaf(f: usize, obj: usize) -> Option<bool> {
    if !readable(f, 9) { return None; }
    let b0 = rd_u8(f); let b1 = rd_u8(f + 1); let b2 = rd_u8(f + 2);
    if (b0 == 0x31 || b0 == 0x33) && b1 == 0xc0 && b2 == 0xc3 { return Some(false); }   // xor eax,eax; ret
    if b0 == 0xb0 && b2 == 0xc3 { return Some(b1 != 0); }                                // mov al,imm8; ret
    if b0 == 0x48 && b1 == 0x83 && b2 == 0x79 && rd_u8(f + 4) == 0x00
        && rd_u8(f + 5) == 0x0f && rd_u8(f + 6) == 0x95 && rd_u8(f + 7) == 0xc0 && rd_u8(f + 8) == 0xc3 {
        return Some(rd_u64(obj + rd_u8(f + 3) as usize).unwrap_or(0) != 0);              // cmp qword[rcx+II],0; setne; ret
    }
    None
}

// 0x48 tag leaf `fn(rcx=sret,rdx=obj)`: 상수 tag = `48 c7 00 <imm32>`(→[rax]) / `48 c7 01 <imm32>`(→[rcx]). CALL 전에 나오면 상수.
unsafe fn decode_tag_leaf(f: usize) -> Option<bool> {
    if !readable(f, 24) { return None; }
    let mut i = 0usize;
    while i < 20 {
        let b = rd_u8(f + i);
        if b == 0xe8 || b == 0xff { return None; }                                       // call → composite
        if b == 0x48 && rd_u8(f + i + 1) == 0xc7 {
            let modrm = rd_u8(f + i + 2);
            if modrm == 0x00 || modrm == 0x01 { return Some(rd_u32(f + i + 3) != 0); }    // mov qword[rax/rcx],imm = tag
        }
        i += 1;
    }
    None
}

// A계열 composite 컨테이너 any(): 레이아웃 2종(ptr/len 오프셋·엔트리 stride가 구현마다 다름).
unsafe fn descvt_any_at(obj: usize, po: usize, lo: usize, stride: usize, slot: u16, depth: u32) -> bool {
    let p = rd_u64(obj + po).unwrap_or(0) as usize;
    let n = rd_i64(obj + lo).unwrap_or(0);
    if !ptr_ok(p) || n <= 0 || n > 256 { return false; }
    for i in 0..n as usize {
        let d = rd_u64(p + i * stride).unwrap_or(0) as usize;
        let v = rd_u64(p + i * stride + 8).unwrap_or(0) as usize;
        let sub_obj = descvt_obj(d, v);
        let r = if slot == 0x78 { descvt_78(v, sub_obj, depth + 1) } else { descvt_c8(v, sub_obj, depth + 1) };
        if r { return true; }
    }
    false
}

// ★[07-15 전수스캔 최종] A계열 vt+0x78 = pred("이 이펙트가 **적 타겟을 필요로 하는가**") fn(rcx=obj)->bool.
//   Gate#2(FUN_1423802d0): `pred(obj)==0 → 즉시 true`(타겟불요=self-cast 무조건 허용) / `!=0 → 컨테이너 스캔`.
//   ⚠구 구현이 **0x5418a0(=true, 15 vtable)·0x1e66f40·0x1eacc00을 누락**해 composite 자식을 전부 false로 처리 →
//     pred=false → Gate#2 즉시 true → **self-target 무조건 emit = over-emit의 정체**(07-15 실측 확정).
unsafe fn descvt_78(vt: usize, obj: usize, depth: u32) -> bool {
    if depth > 4 || !ptr_ok(vt) || !ptr_ok(obj) { return false; }
    let slot = rd_u64(vt + 0x78).unwrap_or(0) as usize;
    if slot == 0 { return false; }
    let rva = slot.wrapping_sub(exe_base());
    if depth == 0 {
        match rva { 0x50fc80 => a2(37), 0x19ec2c0 => a2(38), 0x5418a0 => a2(39), _ => a2(44) }
    }
    match rva {
        0x50fc80 => false,                                       // xor eax,eax; ret → 타겟불요 (98 vtable)
        0x5418a0 => true,                                        // ★mov al,1; ret → 타겟필요 (15 vtable) — 누락분
        0x19ec2c0 => descvt_any_at(obj, 0x08, 0x10, 0x10, 0x78, depth),   // any(): 16B 엔트리 (16 vtable)
        0x1e66f40 => descvt_any_at(obj, 0x50, 0x58, 0x18, 0x78, depth),   // ★any(): ptr@+0x50/len@+0x58, 24B 엔트리 (2 vtable)
        0x1eacc00 => {                                           // delegate: 내부 fat ptr {data@obj+0, vt@obj+8}
            let d = rd_u64(obj).unwrap_or(0) as usize;
            let v = rd_u64(obj + 8).unwrap_or(0) as usize;
            descvt_78(v, descvt_obj(d, v), depth + 1)
        }
        0x1e65a80 => {                                           // ★[07-15] delegate: {data@obj+0x18, vt@obj+0x20}
            let d = rd_u64(obj + 0x18).unwrap_or(0) as usize;
            let v = rd_u64(obj + 0x20).unwrap_or(0) as usize;
            descvt_78(v, descvt_obj(d, v), depth + 1)
        }
        // ⚠0x1f635c0은 **A계열 아님**(vtable 0x38af9e0 = 다른 트레이트, +0x78에 우연히 fn ptr) → 등재하지 않음.
        r => decode_bool_leaf(slot, obj).unwrap_or_else(|| { unreg_cap(0x78, r); false }),
    }
}

// A계열 vt+0xc8 = aim 게이트 fn(rcx=obj)->bool. 도달구현 5종(전수스캔 확정).
// ════ A계열 자식 슬롯 0x50 / 0x58 / 0x48 (aim composite가 재귀하는 실제 슬롯들) ════
//   ★[07-15 전수스캔] vt+0xc8의 composite는 자식의 **0xc8이 아니라 0x50/0x58/0x48**을 부른다.
//     구 구현이 0xc8을 재귀해 대부분 false → 0x10/0x11 오차의 근본원인.
//   trio(x) = x.0x50 || x.0x58 || (x.0x48.tag != 0)   ← 모든 0x48 tag ∈ {0,1}이라 bool 축약 가능.
unsafe fn descvt_child(data: usize, vt: usize, which: u16, depth: u32) -> bool {
    let obj = descvt_obj(data, vt);
    match which { 0x50 => descvt_50(vt, obj, depth), 0x58 => descvt_58(vt, obj, depth), _ => descvt_48(vt, obj, depth) }
}

// 컨테이너 any(): (ptr@po, len@lo, stride) 각 엔트리 {data@0, vt@8} → 자식의 `which` 슬롯 OR.
unsafe fn descvt_cany(obj: usize, po: usize, lo: usize, stride: usize, which: u16, depth: u32) -> bool {
    let p = rd_u64(obj + po).unwrap_or(0) as usize;
    let n = rd_i64(obj + lo).unwrap_or(0);
    if !ptr_ok(p) || n <= 0 || n > 256 { return false; }
    for i in 0..n as usize {
        let d = rd_u64(p + i * stride).unwrap_or(0) as usize;
        let v = rd_u64(p + i * stride + 8).unwrap_or(0) as usize;
        if descvt_child(d, v, which, depth + 1) { return true; }
    }
    false
}

#[inline] unsafe fn descvt_trio(data: usize, vt: usize, depth: u32) -> bool {
    descvt_child(data, vt, 0x50, depth) || descvt_child(data, vt, 0x58, depth) || descvt_child(data, vt, 0x48, depth)
}

unsafe fn descvt_50(vt: usize, obj: usize, depth: u32) -> bool {
    if depth > 6 || !ptr_ok(vt) || !ptr_ok(obj) { return false; }
    match (rd_u64(vt + 0x50).unwrap_or(0) as usize).wrapping_sub(exe_base()) {
        0x50fc80  => false,
        0x5418a0  => true,                                              // ★[07-15 캡처] 상수 true stub(전 슬롯 공용)
        0x19ebf60 => descvt_cany(obj, 0x08, 0x10, 0x10, 0x50, depth),
        0x1bbcd20 => rd_u64(obj + 0x18).unwrap_or(0) != 0 && rd_u64(obj + 0x10).unwrap_or(0) != 0,
        0x1e658c0 => descvt_child(rd_u64(obj + 0x18).unwrap_or(0) as usize, rd_u64(obj + 0x20).unwrap_or(0) as usize, 0x50, depth),
        0x1eacac0 => descvt_child(rd_u64(obj).unwrap_or(0) as usize, rd_u64(obj + 8).unwrap_or(0) as usize, 0x50, depth),
        r => decode_bool_leaf(rd_u64(vt+0x50).unwrap_or(0) as usize, obj).unwrap_or_else(|| { unreg_cap(0x50, r); false }),
    }
}

unsafe fn descvt_58(vt: usize, obj: usize, depth: u32) -> bool {
    if depth > 6 || !ptr_ok(vt) || !ptr_ok(obj) { return false; }
    match (rd_u64(vt + 0x58).unwrap_or(0) as usize).wrapping_sub(exe_base()) {
        0x50fc80  => false,
        0x5418a0  => true,                                              // ★[07-15 캡처 0x58:0x5418a0] 상수 true stub
        0x19ebf00 => descvt_cany(obj, 0x08, 0x10, 0x10, 0x58, depth),
        0x1c93e30 => descvt_cany(obj, 0x50, 0x58, 0x18, 0x58, depth)     // 2컨테이너 (A: stride 0x18)
                  || descvt_cany(obj, 0x68, 0x70, 0x10, 0x58, depth),    //           (B: stride 0x10)
        0x1e668b0 => descvt_cany(obj, 0x50, 0x58, 0x18, 0x58, depth),
        0x1ef8820 => rd_u64(obj + 0x18).unwrap_or(0) != 0,
        0x1e658a0 => descvt_child(rd_u64(obj + 0x18).unwrap_or(0) as usize, rd_u64(obj + 0x20).unwrap_or(0) as usize, 0x58, depth),
        0x1eacaa0 => descvt_child(rd_u64(obj).unwrap_or(0) as usize, rd_u64(obj + 8).unwrap_or(0) as usize, 0x58, depth),
        r => decode_bool_leaf(rd_u64(vt+0x58).unwrap_or(0) as usize, obj).unwrap_or_else(|| { unreg_cap(0x58, r); false }),
    }
}

// 0x48: fn(sret, obj) → {tag,a,b}. aim엔 tag!=0만 필요. 전 구현 tag∈{0,1}.
unsafe fn descvt_48(vt: usize, obj: usize, depth: u32) -> bool {
    if depth > 6 || !ptr_ok(vt) || !ptr_ok(obj) { return false; }
    match (rd_u64(vt + 0x48).unwrap_or(0) as usize).wrapping_sub(exe_base()) {
        0x9c8850  => false,                                              // 항상 tag=0
        0x5418a0  => true,                                              // 상수 true stub(공용)
        0x19ec040 => descvt_cany(obj, 0x08, 0x10, 0x10, 0x48, depth),
        0x1e690f0 | 0x1bbcd40 => rd_u64(obj + 0x18).unwrap_or(0) != 0,
        0x1e69920 => true,
        0x1eadf90 => true,                                             // ★[07-15 캡처 0x48:0x1eadf90] out.tag=1 무조건
        0x1e65950 => descvt_child(rd_u64(obj + 0x18).unwrap_or(0) as usize, rd_u64(obj + 0x20).unwrap_or(0) as usize, 0x48, depth),
        0x1eacb50 => descvt_child(rd_u64(obj).unwrap_or(0) as usize, rd_u64(obj + 8).unwrap_or(0) as usize, 0x48, depth),
        r => decode_tag_leaf(rd_u64(vt+0x48).unwrap_or(0) as usize).unwrap_or_else(|| { unreg_cap(0x48, r); false }),
    }
}

// ★A계열 vt+0xc8 (aim 게이트) — 전수스캔 확정 10종(합 134 vtable).
unsafe fn descvt_c8(vt: usize, obj: usize, depth: u32) -> bool {
    if depth > 6 || !ptr_ok(vt) || !ptr_ok(obj) { return false; }
    let slot = rd_u64(vt + 0xc8).unwrap_or(0) as usize;
    if slot == 0 || !in_text(slot) { return false; }   // ★[07-15 하드닝] 슬롯 함수포인터 .text 범위 게이트(유효 게터 무영향, garbage=false)
    let rva = slot.wrapping_sub(exe_base());
    if depth == 0 {
        match rva {
            0x50fc80 => a2(45),
            0x1a5a200 | 0x21a83c0 | 0x1c93e30 | 0x1e668b0 => a2(46),
            0x1ef8820 | 0x1ef8760 | 0x1ef87c0 | 0x5418a0 => a2(47),
            _ => a2(35),   // 미등재(0x9c8ae0 어댑터 포함) — 0이면 테이블 완전
        }
    }
    match rva {
        0x50fc80  => false,                                              // 86 vtable
        0x5418a0  => true,                                               // 2 — 상수 true
        0x1ef8820 => rd_u64(obj + 0x18).unwrap_or(0) != 0,               // 9
        0x1a5a200 => {                                                   // 16 — any(trio(child)), stride 0x10
            let p = rd_u64(obj + 0x08).unwrap_or(0) as usize;
            let n = rd_i64(obj + 0x10).unwrap_or(0);
            if !ptr_ok(p) || n <= 0 || n > 256 { return false; }
            for i in 0..n as usize {
                let d = rd_u64(p + i * 0x10).unwrap_or(0) as usize;
                let v = rd_u64(p + i * 0x10 + 8).unwrap_or(0) as usize;
                if descvt_trio(d, v, depth + 1) { return true; }
            }
            false
        }
        0x21a83c0 => descvt_cany(obj, 0x08, 0x10, 0x10, 0x50, depth)     // 6 — 0x48 패스 없음
                  || descvt_cany(obj, 0x08, 0x10, 0x10, 0x58, depth),
        0x1c93e30 => descvt_cany(obj, 0x50, 0x58, 0x18, 0x58, depth)     // 8 — 2컨테이너, 0x58만
                  || descvt_cany(obj, 0x68, 0x70, 0x10, 0x58, depth),
        0x1e668b0 => descvt_cany(obj, 0x50, 0x58, 0x18, 0x58, depth),    // 4
        0x1ef8760 => descvt_trio(rd_u64(obj + 0x18).unwrap_or(0) as usize, rd_u64(obj + 0x20).unwrap_or(0) as usize, depth + 1),  // 1
        0x1ef87c0 => descvt_trio(rd_u64(obj).unwrap_or(0) as usize, rd_u64(obj + 8).unwrap_or(0) as usize, depth + 1),            // 1
        r => decode_bool_leaf(slot, obj).unwrap_or_else(|| { unreg_cap(0xc8, r); false }),   // 0x9c8ae0 어댑터 등
    }
}

// ★[07-15 RE] A계열 vt+0x90 = 사거리 보너스 `fn(rcx=obj, rdx=self, r8=target) -> u64`. 도달구현 3종.
//   ★이걸 B계열 vt90_get으로 잘못 조회해 **0을 반환**하던 것이 0x11 under의 주범.
//   0x50fc80 = 0 (52/64 우세) / 0x23cbf20 = composite **unsigned MAX**(합산 아님, CMOVA) / 0x214d210 = lvl≥3 조건부.
//   ⚠ 전부 u64 비교/반환(음수면 거대 unsigned가 되어 max를 먹음 — 비트동일 위해 u64 유지).
unsafe fn descvt_90(vt: usize, obj: usize, self_u: usize, tgt: usize, depth: u32) -> u64 {
    if depth > 4 || !ptr_ok(vt) || !ptr_ok(obj) { return 0; }
    let slot = rd_u64(vt + 0x90).unwrap_or(0) as usize;
    if slot == 0 || !in_text(slot) { return 0; }   // ★[07-15 하드닝] .text 게이트(유효 게터 무영향)
    if depth == 0 {
        match slot.wrapping_sub(exe_base()) {
            0x50fc80 => a2(32), 0x23cbf20 => a2(33), 0x214d210 => a2(34), _ => a2(35),
        }
    }
    let rv = match slot.wrapping_sub(exe_base()) {
        0x50fc80 => 0,                                      // xor eax,eax; ret
        0x23cbf20 => {                                      // composite: unsigned MAX
            let n = rd_u64(obj + 0x10).unwrap_or(0);
            if n == 0 || n > 256 { return 0; }
            let p = rd_u64(obj + 0x08).unwrap_or(0) as usize;
            if !ptr_ok(p) { return 0; }
            let mut acc = 0u64;
            for i in 0..n as usize {
                let d = rd_u64(p + i * 0x10).unwrap_or(0) as usize;
                let v = rd_u64(p + i * 0x10 + 8).unwrap_or(0) as usize;
                let x = descvt_90(v, descvt_obj(d, v), self_u, tgt, depth + 1);
                if i == 0 || x > acc { acc = x; }            // unsigned max
            }
            acc
        }
        0x214d210 => {                                      // lvl≥3 조건부 → obj+0x40
            if rd_u64(self_u + 0x5b0).unwrap_or(0) < 3 { return 0; }
            let p = rd_u64(tgt + 0x280).unwrap_or(0) as usize;
            let n = rd_u64(tgt + 0x288).unwrap_or(0);
            if !ptr_ok(p) || n == 0 || n > 4096 { return 0; }
            let mut r = 0u64;
            for i in 0..n as usize {
                if rd_u8(p + i * 0x38 + 0x34) == 1 {
                    r = rd_u64(obj + 0x40).unwrap_or(0);   // ★첫 매치서 즉시 return
                    break;
                }
            }
            r
        }
        _ => 0,
    };
    if depth == 0 && rv != 0 { a2(36); }
    rv
}


// FUN_142076a60(0x2076a60) side별 핵심구조물 concat 빌더(§11.9.11-3) — 순수. Gate#1 (A)블록 선점검사용.
//   6 스칼라슬롯 null-skip + 동적리스트(begin/count) + 단일슬롯.
unsafe fn d19_struct_list(base: usize, side: usize, out: &mut [usize; 32]) -> usize {
    let mut n = 0usize;
    for &so in &[0x180usize, 0x1a0, 0x1c0, 0x190, 0x1b0, 0x1d0] {
        let v = rd_u64(base + so + side * 8).unwrap_or(0) as usize;
        if v != 0 && n < 32 { out[n] = v; n += 1; }
    }
    let begin = rd_u64(base + 0x130 + side * 0x20).unwrap_or(0) as usize;
    let cnt = rd_i64(base + 0x148 + side * 0x20).unwrap_or(0);
    if begin != 0 && cnt > 0 && cnt <= 4096 {
        for i in 0..cnt as usize {
            let v = rd_u64(begin + i * 8).unwrap_or(0) as usize;
            if v != 0 && n < 32 { out[n] = v; n += 1; }
        }
    }
    let sng = rd_u64(base + 0x170 + side * 8).unwrap_or(0) as usize;
    if sng != 0 && n < 32 { out[n] = sng; n += 1; }
    n.min(32)   // ★[07-15 하드닝] 배열크기 clamp(caller 루프 상한 안전)
}


// cand_main 멤버십(FUN_1422a1180) — 상대팀 5슬롯 유닛배열. tag!=-1 & U!=null & (geom_vt68 시야 ∥ last-seen 유예창) &
//   U+0x6a0!=0 & U+0x688==0 인 유닛만 수락. 반환=수락 유닛수(out_units에 U 채움, ≤5). emit엔 unit만 필요(tag/q0/q1은 멤버십 판정용).
unsafe fn d19_cand_main(g0: usize, sim_obj: usize, geom2: usize, side: usize,
                        out_units: &mut [usize; 5], out_tags: &mut [i64; 5]) -> usize {
    let other = 1 - side;
    let mut n = 0usize;
    for idx in 0..5usize {
        let u_raw = rd_u64(g0 + 0x1e0 + other * 0x28 + idx * 8).unwrap_or(0) as usize;
        let id_raw = if ptr_ok(u_raw) { rd_u64(u_raw + 0x5a8).unwrap_or(0) & 0xffff } else { 0xffff };
        let mut rej = |code: u64| D19_RAWROST[idx].store((id_raw << 8) | code, Ordering::Relaxed);
        // 데이터슬롯 = geom2 + 0x368 + idx*0x18 + flag*(-0x2e8). tag=*(slot-8).
        let slot = geom2.wrapping_add(0x368).wrapping_add(idx * 0x18).wrapping_sub(side * 0x2e8);
        let tag = rd_i64(slot.wrapping_sub(8)).unwrap_or(-1);
        if tag == -1 || tag == -2 { rej(1); continue; }   // ★[07-14 RE] -1=무효 / -2=이 슬롯 skip
        a2(3);
        // 유닛배열 = g0 + 0x1e0 + (1-flag)*0x28 + idx*8
        let u = u_raw;
        if !ptr_ok(u) { rej(2); continue; }
        a2(4);
        let id = rd_u64(u + 0x5a8).unwrap_or(0);
        let pass = if geom_vt68(sim_obj, side, id) {
            a2(5); true
        } else {
            let rec = geom_vtc0(sim_obj, id);
            if rec != 0 {
                let idx2 = rd_u32(rec + 0x8b0) as usize;
                let last_seen = rd_i64(geom2 + 0x1e0 + other * 0x2e8 + idx2 * 8).unwrap_or(i64::MIN);
                let ok = geom_vt28(sim_obj) <= last_seen.wrapping_add(0x78);      // 현재틱 ≤ 마지막목격+0x78(시야유예)
                if ok { a2(6); }
                ok
            } else { false }
        };
        if !pass { rej(3); continue; }
        if rd_u8(u + 0x6a0) == 0 { rej(4); continue; }                           // 생존/타겟가능 플래그(!=0 요구)
        if rd_i64(u + 0x688).unwrap_or(0) != 0 { rej(5); continue; }             // 저지필드(==0 요구)
        a2(7);
        rej(0);
        if n < 5 { out_units[n] = u; out_tags[n] = tag; n += 1; }
    }
    n.min(5)   // ★[07-15 하드닝] 배열크기 clamp(caller 루프 상한 안전)
}


// ★[07-14 RE] cand_main 루프 전용 **리드속도 보정**(slot0/1/2 공통, enemies_near·self엔 없음).
//   tag(entry[0])==0 && cand의 상태이상이 전부 마스크 0x3b8(bits{3,4,5,7,8,9}=이동을 막지 않는 CC) 안이면
//   → 적이 도망칠 수 있음 → 리드를 **상대속도**로 축소: spd = saturating_sub(self.spd, cand.spd) (unsigned, 언더플로 0).
//   마스크 밖 type(하드 CC=스턴/속박)이 하나라도 있으면 적이 못 도망 → self 속도 그대로(사거리 큼).
//   상태리스트: base +0x2b0 / count +0x2b8 / stride 0x28 / [0]=u32 type. count==0 = vacuously true → 보정 적용.
unsafe fn d19_lead_speed(self_u: usize, cand: usize, tag: i64) -> i64 {
    let self_spd = rd_i64(self_u + 0x628).unwrap_or(0);
    if !D19_LEAD.load(Ordering::Relaxed) { return self_spd; }   // 진단 토글: OFF면 감산 없음
    if tag != 0 { return self_spd; }
    let n = rd_i64(cand + 0x2b8).unwrap_or(0);
    let p = rd_u64(cand + 0x2b0).unwrap_or(0) as usize;
    let mut all_masked = true;
    if n > 0 && n <= 4096 && ptr_ok(p) {
        for i in 0..n as usize {
            let t = rd_u32(p + i * 0x28);
            if (0x3b8u32 >> (t & 0x1f)) & 1 == 0 { all_masked = false; break; }
        }
    }
    if all_masked {
        let cand_spd = rd_i64(cand + 0x628).unwrap_or(0);
        (self_spd as u64).saturating_sub(cand_spd as u64) as i64   // CMOVC = unsigned saturating_sub
    } else {
        self_spd
    }
}


// enemies_near — 자팀 5슬롯 non-null + 근접필터(진영키 다름 && (dx²+dy²)>>8 < 0x53d1ac1). 반환=수락수.
unsafe fn d19_enemies_near(g0: usize, side: usize, self_u: usize, out_units: &mut [usize; 5]) -> usize {
    let mut n = 0usize;
    let self_key = rd_u64(self_u + 0x5a8).unwrap_or(0);
    let (sx, sy) = (rd_i64(self_u + 0x648).unwrap_or(0), rd_i64(self_u + 0x650).unwrap_or(0));
    for i in 0..5usize {
        let u = rd_u64(g0 + 0x1e0 + side * 0x28 + i * 8).unwrap_or(0) as usize;
        if !ptr_ok(u) { continue; }
        if rd_u64(u + 0x5a8).unwrap_or(0) == self_key { continue; }              // 진영키 같으면 제외
        let dx = (sx - rd_i64(u + 0x648).unwrap_or(0)).unsigned_abs();
        let dy = (sy - rd_i64(u + 0x650).unwrap_or(0)).unsigned_abs();
        let d2 = dx.wrapping_mul(dx).wrapping_add(dy.wrapping_mul(dy));
        if (d2 >> 8) < 0x53d1ac1 && n < 5 { out_units[n] = u; n += 1; }
    }
    n.min(5)   // ★[07-15 하드닝] 배열크기 clamp
}


// ★[07-15] 스코어게이트에 넘길 score = **해당 슬롯의 스킬 데미지**(self→target).
//   0x10 사이트 = **B슬롯(vt=*(self+0x4b8), data=*(self+0x4b0), dtype=*(self+0x4dc))** / 0x11 = C슬롯(slot2_base 기반).
//   ⚠구 버그: d19_threat_dmg(A슬롯 주공격 +0x480/dtype +0x4a4)를 score로 써서 값이 어긋남(0x10 over의 정체).
//   base 페어 = vt[0x28] 게터(d19_basedmg_dispatch 재사용) → my_combat_dmg(phys,0)+my_combat_dmg(mag,1).
unsafe fn d19_slot_score(self_u: usize, target: usize, sk_vt: usize, db_data: usize, dtype: u32, exe: usize) -> i64 {
    if !ptr_ok(sk_vt) || !ptr_ok(db_data) { return 0; }
    let gptr = rd_u64(sk_vt + 0x28).unwrap_or(0) as usize;
    let inner = rd_u64(sk_vt + 0x10).unwrap_or(0) as usize;
    let aligned = (inner.wrapping_sub(1) & !0xf).wrapping_add(db_data).wrapping_add(0x10);
    let (b0, b1) = match d19_basedmg_dispatch(gptr, aligned, self_u, exe, 0) {
        Some(pm) => pm,
        None => return 0,                                    // 미지 게터 = 보수적 0(shadow 폴백 없음, self슬롯 전용)
    };
    if b0 == 0 && b1 == 0 { return 0; }
    my_combat_dmg(self_u, target, b0, dtype, 0, exe)
        .wrapping_add(my_combat_dmg(self_u, target, b1, dtype, 1, exe))
}


// Gate#1 FUN_14236f530(0x236f530) 가치/스코어 게이트 — false=emit skip. 전부 순수(RNG-free).
//   caster=self_u(시전자), target=unit, score=self의 target 예상딜(phys+magic, d19_threat_dmg). game=*(p6_pair+8).
unsafe fn d19_score_gate(g0: usize, sim_obj: usize, geom2: usize, game: usize,
                         side: usize, caster: usize, target: usize, score: i64) -> bool {
    let exe = exe_base();
    let target_hp = rd_i64(target + 0x658).unwrap_or(0);
    if target_hp <= score { return true; }                                      // (1) 확정처치 → emit OK
    let other = 1 - side;
    let cur_tick = geom_vt28(sim_obj);
    let game_state = rd_u64(game + 8).unwrap_or(0) as usize;                     // game[1]
    let deadline = if ptr_ok(game_state) { rd_i64(game_state + 0x13f8).unwrap_or(i64::MAX) } else { i64::MAX };

    // (A) 데드라인 內: other팀 구조물이 caster를 더 잘 죽이나(선점) → true면 skip.
    if cur_tick < deadline {
        let mut sl = [0usize; 32];
        let m = d19_struct_list(g0, other, &mut sl);
        let caster_hp = rd_i64(caster + 0x658).unwrap_or(0);
        let (tx, ty) = (rd_i64(target + 0x648).unwrap_or(0), rd_i64(target + 0x650).unwrap_or(0));
        for k in 0..m {
            let u = sl[k];
            if rd_i32(u + 0x4a8).unwrap_or(-1) == -1 { continue; }
            let extra = if rd_i32(u + 0x4a8).unwrap_or(-1) == 0 {
                (rd_i32(u + 0x458).unwrap_or(0) as i64 + 100).wrapping_mul(rd_i64(u + 0x668).unwrap_or(0)) / 100
            } else { 0 };
            let vt90 = d19_vt90_range(rd_u64(u + 0x480).unwrap_or(0) as usize, rd_u64(u + 0x478).unwrap_or(0) as usize);
            let caster_r = (rd_i32(caster + 0x458).unwrap_or(0) as i64 + 100).wrapping_mul(rd_i64(caster + 0x668).unwrap_or(0)) / 100;
            let lvl = rd_i64(u + 0x5b0).unwrap_or(0);
            let reach = rd_i64(u + 0x488).unwrap_or(0) + caster_r + 15000 + rd_i64(u + 0x420).unwrap_or(0)
                + (lvl - 1).wrapping_mul(rd_i64(u + 0x490).unwrap_or(0)) + extra + vt90;
            let dx = (tx - rd_i64(u + 0x648).unwrap_or(0)).unsigned_abs();
            let dy = (ty - rd_i64(u + 0x650).unwrap_or(0)).unsigned_abs();
            let d2 = dx.wrapping_mul(dx).wrapping_add(dy.wrapping_mul(dy));
            let rr = reach.max(0) as u64;
            if d2 <= rr.wrapping_mul(rr) {
                let enemy_dmg = d19_threat_dmg(u, sim_obj, caster, exe);         // u→caster 딜(phys+magic)
                if caster_hp <= enemy_dmg { return false; }                     // 남이 날 확실히 죽임 → skip
                if (score as i128) * (caster_hp as i128) < (enemy_dmg as i128) * (target_hp as i128) { return false; }  // 저쪽 트레이드가 더 좋음
            }
        }
    }

    // (B) target 주변 other팀 5슬롯 카운트 → A값.
    let a_val: i64;
    {
        let mut cnt = 0i64;
        let mut any = false;
        let tid = rd_i64(target + 0x5a8).unwrap_or(0);
        let (tx, ty) = (rd_i64(target + 0x648).unwrap_or(0), rd_i64(target + 0x650).unwrap_or(0));
        for k in 0..5usize {
            let e = rd_u64(g0 + 0x1e0 + other * 0x28 + k * 8).unwrap_or(0) as usize;
            if e == 0 { continue; }
            any = true;
            if rd_i64(e + 0x5a8).unwrap_or(0) == tid { continue; }
            let dx = (tx - rd_i64(e + 0x648).unwrap_or(0)).unsigned_abs();
            let dy = (ty - rd_i64(e + 0x650).unwrap_or(0)).unsigned_abs();
            if dx.wrapping_mul(dx).wrapping_add(dy.wrapping_mul(dy)) > 14400000000 { continue; }   // 120000² 밖
            let eid = rd_u64(e + 0x5a8).unwrap_or(0);
            if geom_vt68(sim_obj, side, eid) { cnt += 1; }
            else {
                let rec = geom_vtc0(sim_obj, eid);
                if rec != 0 {
                    let idx2 = rd_u32(rec + 0x8b0) as usize;
                    let thr = rd_i64(geom2 + other * 0x2e8 + 0x1e0 + idx2 * 8).unwrap_or(i64::MIN);
                    if geom_vt28(sim_obj) <= thr.wrapping_add(0x78) { cnt += 1; }
                }
            }
        }
        a_val = if !any { 1 } else { cnt + 1 };
    }

    // (C) target 주변 team 5슬롯 카운트 → B값 + 조기 true.
    let mut b_val = 0i64;
    {
        let mut any = false;
        let cid = rd_i64(caster + 0x5a8).unwrap_or(0);
        let (tx, ty) = (rd_i64(target + 0x648).unwrap_or(0), rd_i64(target + 0x650).unwrap_or(0));
        for k in 0..5usize {
            let e = rd_u64(g0 + 0x1e0 + side * 0x28 + k * 8).unwrap_or(0) as usize;
            if e == 0 { continue; }
            any = true;
            if rd_i64(e + 0x5a8).unwrap_or(0) == cid { continue; }
            let dx = (tx - rd_i64(e + 0x648).unwrap_or(0)).unsigned_abs();
            let dy = (ty - rd_i64(e + 0x650).unwrap_or(0)).unsigned_abs();
            if dx.wrapping_mul(dx).wrapping_add(dy.wrapping_mul(dy)) < 0x35a4e9001 { b_val += 1; }  // < 120000²+1
        }
        if !any { if a_val < 2 { return true; } }
        else if a_val < b_val + 2 { return true; }
    }

    // (D) 최종 HP% 부등식: (A-B)*15 + HP%target < HP%caster.
    let cmax = rd_i64(caster + 0x610).unwrap_or(0);
    let tmax = rd_i64(target + 0x610).unwrap_or(0);
    let chp_pct = rd_i64(caster + 0x658).unwrap_or(0).wrapping_mul(100) / if cmax == 0 { 1 } else { cmax };
    let thp_pct = target_hp.wrapping_mul(100) / if tmax == 0 { 1 } else { tmax };
    (a_val - b_val).wrapping_mul(15) + thp_pct < chp_pct
}


// ════════ Gate#2 FUN_1423802d0(0x23802d0) 자기/아군 캐스트 게이트 — self-target site4/site7(단일분기) ════════
//   ★[07-15 디컴확정] 컨테이너 6종을 순서대로 훑어 **유효 생존 대상이 하나라도 사거리 안이면 true**(조기 return).
//   베이스 = g0(=ctx[0]=state). world=*(g0)=sim_obj(geom 대상), teamdata=geom2(=ctx[2]).
//   술어 2종: 컨테이너 1·2·3 = **A(가시성 게이트 포함)** / 4·5·6 = **B(가시성 없음, +0x6a0==1 정확비교)**.
//   ⚠ A술어 시야유예 threshold 행 인덱스 = **other**(team 아님 — 디스어셈 확정, 정본 §11.9.11-2 기술과 모순).
//   pred(obj)==0(타겟불요)이면 즉시 true. pred = A계열 vt+0x78 = descvt_78.
#[inline] unsafe fn d19_mit2(e: usize) -> i64 {
    (rd_i32(e + 0x458).unwrap_or(0) as i64 + 100).wrapping_mul(rd_i64(e + 0x668).unwrap_or(0)) / 100
}

// A술어(가시성 포함)
unsafe fn d19_g2_vis(world: usize, geom2: usize, team: usize, other: usize, e: usize) -> bool {
    let eid = rd_u64(e + 0x5a8).unwrap_or(0);
    if geom_vt68(world, team, eid) { return true; }
    let a = geom_vtc0(world, eid);
    if a == 0 { return false; }
    let idx = rd_u32(a + 0x8b0) as usize;
    let thr = rd_i64(geom2 + other * 0x2e8 + 0x1e0 + idx * 8).unwrap_or(i64::MIN);   // ★other
    geom_vt28(world) <= thr.wrapping_add(0x78)
}

#[inline] unsafe fn d19_g2_hit(caster: usize, e: usize, rng2: u64) -> bool {
    let (cx, cy) = (rd_i64(caster + 0x648).unwrap_or(0), rd_i64(caster + 0x650).unwrap_or(0));
    let dx = (cx - rd_i64(e + 0x648).unwrap_or(0)).unsigned_abs();
    let dy = (cy - rd_i64(e + 0x650).unwrap_or(0)).unsigned_abs();
    dx.wrapping_mul(dx).wrapping_add(dy.wrapping_mul(dy)) <= rng2
}

unsafe fn d19_cast_gate(g0: usize, world: usize, geom2: usize, team: usize, caster: usize,
                        gbase: usize, skvt: usize) -> bool {
    // pred = A계열 vt+0x78(obj = gbase + 0x10, align=8 확정). pred==false(타겟불요) → **즉시 true**(단락).
    a2(40);                                                   // Gate#2 호출수
    if !descvt_78(skvt, gbase.wrapping_add(0x10), 0) {
        a2(41);                                               // ★pred 단락 = 무조건 emit
        return true;
    }
    let other = 1 - team;
    // 효과반경
    let mut r = if rd_i32(caster + 0x4a8).unwrap_or(-1) == -1 {
        90000
    } else {
        let lvl = rd_i64(caster + 0x5b0).unwrap_or(0);
        d19_mit2(caster) + rd_i64(caster + 0x488).unwrap_or(0) + rd_i64(caster + 0x420).unwrap_or(0)
            + (lvl - 1).wrapping_mul(rd_i64(caster + 0x490).unwrap_or(0)) + 30000
    };
    r += rd_i64(caster + 0x628).unwrap_or(0).wrapping_mul(0x1e);
    if r <= 0 { return false; }
    let rng2 = (r as u64).wrapping_mul(r as u64);
    // 공통 술어
    let pass_a = |e: usize| -> bool {
        ptr_ok(e) && d19_g2_vis(world, geom2, team, other, e)
            && rd_u8(e + 0x6a0) != 0 && rd_i64(e + 0x688).unwrap_or(1) == 0
            && d19_g2_hit(caster, e, rng2)
    };
    let pass_b = |e: usize| -> bool {
        ptr_ok(e) && rd_u8(e + 0x6a0) == 1 && rd_i64(e + 0x688).unwrap_or(1) == 0
            && d19_g2_hit(caster, e, rng2)
    };
    // 벡터 순회 헬퍼(원소 8B ptr)
    let scan = |ptr_off: usize, len_off: usize, is_a: bool| -> bool {
        let p = rd_u64(g0 + ptr_off).unwrap_or(0) as usize;
        let n = rd_i64(g0 + len_off).unwrap_or(0);
        if !ptr_ok(p) || n <= 0 || n > 4096 { return false; }
        for i in 0..n as usize {
            let e = rd_u64(p + i * 8).unwrap_or(0) as usize;
            if e == 0 { continue; }
            if if is_a { pass_a(e) } else { pass_b(e) } { return true; }
        }
        false
    };
    let hit = (|| -> bool {
        // ① 5슬롯: g0 + 0x1e0 + other*0x28 + k*8  (A)
        for k in 0..5usize {
            let e = rd_u64(g0 + 0x1e0 + other * 0x28 + k * 8).unwrap_or(0) as usize;
            if e != 0 && pass_a(e) { return true; }
        }
        // ② Vec: ptr g0+0xf0+other*0x20 / len +0x108+other*0x20  (A)
        if scan(0xf0 + other * 0x20, 0x108 + other * 0x20, true) { return true; }
        // ③ FUN_142076da0 = 3-Vec concat (= 1차 concat3와 동일 소스)  (A)
        for &(po, lo) in &[(0x10usize, 0x28usize), (0x50, 0x68), (0x90, 0xa8)] {
            if scan(po + other * 0x20, lo + other * 0x20, true) { return true; }
        }
        // ④ Vec(공용): ptr g0+0xd0 / len g0+0xe8  (B)
        if scan(0xd0, 0xe8, false) { return true; }
        // ⑤ FUN_142076820 = 6스칼라(0필터) ++ 동적Vec  (B)
        for &so in &[0x180usize, 0x1a0, 0x1c0, 0x190, 0x1b0, 0x1d0] {
            let e = rd_u64(g0 + so + other * 8).unwrap_or(0) as usize;
            if e != 0 && pass_b(e) { return true; }
        }
        if scan(0x130 + other * 0x20, 0x148 + other * 0x20, false) { return true; }
        // ⑥ 단일: g0 + 0x170 + other*8  (B)
        let e = rd_u64(g0 + 0x170 + other * 8).unwrap_or(0) as usize;
        e != 0 && pass_b(e)
    })();
    if hit { a2(42); } else { a2(43); }
    hit
}

// FUN_1421282a0(0x21282a0) 순수 사거리판정: f(desc, p2=대상, p3=사거리소스)
//   target_valid(desc+0x28, p3, p2) 통과 시 reach = mit(p3)+mit(p2)+*(p3+0x420)+desc[0x10]+(lvl_p3-1)*desc[0x18]+vt90(A계열)
unsafe fn d19_reach_1282a0(desc: usize, p2: usize, p3: usize) -> bool {
    if !ptr_ok(desc) || !ptr_ok(p2) || !ptr_ok(p3) { return false; }
    if !d19_target_valid(desc + 0x28, p3, p2) { return false; }
    let dvt = rd_u64(desc + 0x08).unwrap_or(0) as usize;
    let ddata = rd_u64(desc).unwrap_or(0) as usize;
    let vt90 = if ptr_ok(dvt) { descvt_90(dvt, descvt_obj(ddata, dvt), p3, p2, 0) as i64 } else { 0 };
    let lvl = rd_i64(p3 + 0x5b0).unwrap_or(0);
    let reach = d19_mit2(p3) + d19_mit2(p2) + rd_i64(p3 + 0x420).unwrap_or(0)
        + rd_i64(desc + 0x10).unwrap_or(0)
        + (lvl - 1).wrapping_mul(rd_i64(desc + 0x18).unwrap_or(0))
        + vt90;
    if reach <= 0 { return false; }
    let d2 = sqd(rd_u64(p2 + 0x648).unwrap_or(0), rd_u64(p2 + 0x650).unwrap_or(0),
                 rd_u64(p3 + 0x648).unwrap_or(0), rd_u64(p3 + 0x650).unwrap_or(0));
    d2 <= (reach as u64).wrapping_mul(reach as u64)
}

// FUN_141fccad0(0x1fccad0) slot3 usable — fce700/fbe950 동형(임계 +0xc8, lvl≥5, haste 분모에 +0x454 추가).
unsafe fn d19_usable_slot3(e: usize) -> bool {
    if d19_eff_any(e, |t| t == 4) { return false; }
    let has5 = d19_eff_any(e, |t| t == 5);
    let lvl = rd_i64(e + 0x5b0).unwrap_or(0);
    let low = lvl < 5;
    let d3 = if low { exe_base() + D19_SLOT2_EMPTY_RVA } else { e + 0x520 };
    if has5 && rd_i32(d3 + 0x30).unwrap_or(-1) != -1 {
        let vt = rd_u64(d3 + 8).unwrap_or(0) as usize;
        let dt = rd_u64(d3).unwrap_or(0) as usize;
        if ptr_ok(vt) && descvt_c8(vt, descvt_obj(dt, vt), 0) { return false; }
    }
    if rd_i32(e + 0x68).unwrap_or(0) != 0xd { return false; }
    let vt = rd_u64(e + 0x590).unwrap_or(0) as usize;          // B계열 pair
    if !ptr_ok(vt) { return false; }
    let v = vt90_get(vt, rd_u64(e + 0x588).unwrap_or(0) as usize) as u64;
    let div_vt = rd_u64(e + if low { 0x5a0 } else { 0x590 }).unwrap_or(0) as usize;
    let div_dt = rd_u64(e + if low { 0x598 } else { 0x588 }).unwrap_or(0) as usize;
    if !ptr_ok(div_vt) { return false; }
    let div = vta8_get(div_vt, div_dt);
    let hz = rd_i32(e + 0x3e8).unwrap_or(0) as i64 + rd_i32(e + 0x454).unwrap_or(0) as i64 + 100;
    let denom = if hz > 1 { hz as u64 } else { 1 };
    let mut x = v.wrapping_mul(100) / denom;
    if x == 0 { x = 1; }
    if x - x / div < rd_u64(e + 0xc8).unwrap_or(u64::MAX) { return false; }
    if d19_eff_any(e, |t| !matches!(t, 2 | 3 | 5)) { return false; }
    if rd_i32(d3 + 0x30).unwrap_or(-1) == -1 { return false; }
    !low
}

// Gate#3 본체. world=sim_obj(셀 슬라이스·resolve150 소스), caster=self.
unsafe fn d19_aoe_gate(world: usize, caster: usize, off: usize) -> bool {
    let tv7 = exe_base() + D19_TV7_RVA;                        // target_valid desc(selector=7)
    let p = rd_u64(world + 0xb178).unwrap_or(0) as usize;      // vt+0x198 = (ptr,len)
    let n = rd_i64(world + 0xb180).unwrap_or(0);
    if !ptr_ok(p) || n <= 0 || n > 4096 { return false; }
    // Gate#3 p1 = AoE 스킬객체 = *(self+0x578+off) (off = lvl<3 ? 0x20 : 0). 반경 = 그 첫 qword.
    let mode = rd_u64(caster + 0x578 + off).unwrap_or(0) as usize;
    let base_r = if ptr_ok(mode) { rd_i64(mode).unwrap_or(0) } else { 0 };
    // ── loop1: 셰이프 사거리 내 유효 적 존재? ──
    for i in 0..n as usize {
        let cell = rd_u64(p + i * 8).unwrap_or(0);
        let e = geom_resolve150(world, cell);
        if !ptr_ok(e) || rd_i64(e + 0x658).unwrap_or(0) == 0 { continue; }
        if !d19_target_valid(tv7, caster, e) { continue; }
        let reach = base_r + d19_mit2(e) + d19_mit2(caster);
        if reach <= 0 { continue; }
        let d2 = sqd(rd_u64(e + 0x648).unwrap_or(0), rd_u64(e + 0x650).unwrap_or(0),
                     rd_u64(caster + 0x648).unwrap_or(0), rd_u64(caster + 0x650).unwrap_or(0));
        if d2 <= (reach as u64).wrapping_mul(reach as u64) { return true; }
    }
    // ── loop2: 셀 내 적이 자기 4스킬로 caster를 역으로 때릴 수 있나(역위협) ──
    for i in 0..n as usize {
        let cell = rd_u64(p + i * 8).unwrap_or(0);
        let e = geom_resolve150(world, cell);
        if !ptr_ok(e) || rd_i64(e + 0x658).unwrap_or(0) == 0 { continue; }
        if !d19_target_valid(tv7, caster, e) { continue; }
        let lvl = rd_i64(e + 0x5b0).unwrap_or(0);
        // slot0(주공격 +0x478) / slot1(+0x4b0, idx +0x4e0) / slot2(+0x4e8, lvl≥3) / slot3(+0x520, lvl≥5)
        if d19_usable_slot0(e) {
            let d = if rd_i32(e + 0x4a8).unwrap_or(-1) == -1 { 0 } else { e + 0x478 };
            if d != 0 && d19_reach_1282a0(d, caster, e) { return true; }
        }
        if d19_usable_slot1_sel(e) {
            let d = if rd_i32(e + 0x4e0).unwrap_or(-1) == -1 { 0 } else { e + 0x4b0 };
            if d != 0 && d19_reach_1282a0(d, caster, e) { return true; }
        }
        if d19_usable_slot2_sel(e) {
            let d = if lvl < 3 { exe_base() + D19_SLOT2_EMPTY_RVA } else { e + 0x4e8 };
            if rd_i32(d + 0x30).unwrap_or(-1) != -1 && d19_reach_1282a0(d, caster, e) { return true; }
        }
        if d19_usable_slot3(e) {
            let d = if lvl < 5 { exe_base() + D19_SLOT2_EMPTY_RVA } else { e + 0x520 };
            if rd_i32(d + 0x30).unwrap_or(-1) != -1 && d19_reach_1282a0(d, caster, e) { return true; }
        }
    }
    false
}


// ── 2차 emitter 본체(비-self 5사이트 + Gate#1) ──
unsafe fn d19_abil2_block(out: usize, g0: usize, sim_obj: usize, geom2: usize, p6_pair: usize,
                          self_u: usize, side: usize, src: u64) {
    if !ptr_ok(self_u) || !ptr_ok(g0) { return; }
    let exe = exe_base();
    let game = rd_u64(p6_pair + 8).unwrap_or(0) as usize;   // ctx[1]=game(deadline 소스)
    let level = rd_i64(self_u + 0x5b0).unwrap_or(0);
    let slot2_base = if level > 2 { self_u + 0x4e8 } else { exe.wrapping_add(D19_STATIC2_TEMPLATE_RVA) };
    // slot in_range 파라미터(1차 d19_abil_block과 동일 레이아웃)
    let (rb0, pl0) = (rd_i64(self_u + 0x488).unwrap_or(0), rd_i64(self_u + 0x490).unwrap_or(0));
    let (sk0, db0) = (rd_u64(self_u + 0x480).unwrap_or(0) as usize, rd_u64(self_u + 0x478).unwrap_or(0) as usize);
    let (rb1, pl1) = (rd_i64(self_u + 0x4c0).unwrap_or(0), rd_i64(self_u + 0x4c8).unwrap_or(0));
    let (sk1, db1) = (rd_u64(self_u + 0x4b8).unwrap_or(0) as usize, rd_u64(self_u + 0x4b0).unwrap_or(0) as usize);
    let (rb2, pl2) = (rd_i64(slot2_base + 0x10).unwrap_or(0), rd_i64(slot2_base + 0x18).unwrap_or(0));
    let (sk2, db2) = (rd_u64(slot2_base + 0x8).unwrap_or(0) as usize, rd_u64(slot2_base).unwrap_or(0) as usize);

    let mut cm = [0usize; 5]; let mut ct = [0i64; 5];
    let ncm = d19_cand_main(g0, sim_obj, geom2, side, &mut cm, &mut ct);
    let mut en = [0usize; 5]; let nen = d19_enemies_near(g0, side, self_u, &mut en);
    // ★슬롯별 최상위 readiness 게이트(§11.9.11-2 디컴 확정): 존재(!=-1) && usable(FUN_141fbe670/fce700/fbe950 = d19_usable_slot0/1/2).
    //   ★[07-14] 이 뒤 절(시전가능성=상태이상/kind13/마나·쿨)을 누락하면 침묵/스턴/쿨 무시하고 3슬롯 다 발행 → ~5배 over-emit의 근본원인.
    //   슬롯 블록 전체를 게이트(self 기준 1회 산출, 후보 무관 상수).
    let slot0_ready = rd_i32(self_u + 0x4a8).unwrap_or(-1) != -1 && d19_usable_slot0(self_u);
    let slot1_ready = rd_i32(self_u + 0x4e0).unwrap_or(-1) != -1 && d19_usable_slot1_sel(self_u);
    let slot2_ready = rd_i32(slot2_base + 0x30).unwrap_or(-1) != -1 && d19_usable_slot2_sel(self_u);
    // ★[07-14 RE 정정] cand_main 존재게이트 = **1차 emitter 팀필터와 동일**: `*(self)!=0 || *(cand+0x38+*(self+8)*0x18)==0`.
    //   (구현 오류였던 `*(unit+0x38+side*0x18)==0`을 교정 — 인덱스가 side가 아니라 *(self+8), 그리고 *(self)!=0 우회 누락.)
    let self_team0 = rd_u8(self_u) == 0;
    let self_f8 = rd_u64(self_u + 8).unwrap_or(0) as usize;
    #[inline] unsafe fn cm_gate(unit: usize, self_team0: bool, self_f8: usize) -> bool {
        !self_team0 || rd_u64(unit + 0x38 + self_f8 * 0x18).unwrap_or(1) == 0
    }

    a2(0);
    A2DBG[1].fetch_add(ncm as i64, Ordering::Relaxed);
    A2DBG[2].fetch_add(nen as i64, Ordering::Relaxed);
    if slot0_ready { a2(8); } if slot1_ready { a2(9); } if slot2_ready { a2(10); }
    let self_spd = rd_i64(self_u + 0x628).unwrap_or(0);

    // ═══ tag 0xf (slot0) — cand_main만 (readiness→존재게이트→리드보정 in_range, target_valid 없음) ═══
    D19_CMDBG_N.store(0, Ordering::Relaxed);   // 진단: 이 호출의 cand_main 후보 리셋
    if slot0_ready {
        for k in 0..ncm {
            let unit = cm[k];
            let tid = rd_u64(unit + 0x5a8).unwrap_or(0) & 0xffff;
            let g = cm_gate(unit, self_team0, self_f8);
            if !g {
                let di = D19_CMDBG_N.fetch_add(1, Ordering::Relaxed);   // 존재게이트 탈락도 기록(bit16=0,bit17=0)
                if di < 12 { D19_CMDBG[di].store(tid, Ordering::Relaxed); }
                continue;
            }
            a2(11);
            let spd = d19_lead_speed(self_u, unit, ct[k]);
            if spd != self_spd { a2(12); }   // 리드보정 발동수(0이면 tag!=0이라 보정 미발동 = 무효한 수정)
            let inr = d19_in_range_spd(self_u, unit, rb0, pl0, sk0, db0, spd);
            let di = D19_CMDBG_N.fetch_add(1, Ordering::Relaxed);
            if di < 12 { D19_CMDBG[di].store(tid | (1 << 16) | ((inr as u64) << 17), Ordering::Relaxed); }
            if inr {
                a2(13);
                d19_emit_abil(out, src, rd_u64(unit + 0x5a8).unwrap_or(0), 0xf);
            }
        }
    }
    // ═══ tag 0x10 (slot1) ═══
    if slot1_ready {
        // (2) cand_main: 존재게이트→target_valid→리드보정 in_range→[vtc8&&kind13 스코어게이트]→emit
        D19_S1DBG_N.store(0, Ordering::Relaxed);   // 진단 리셋
        for k in 0..ncm {
            let unit = cm[k];
            let s1id = rd_u64(unit + 0x5a8).unwrap_or(0) & 0xffff;
            let mut s1rej = |code: u64| { let di = D19_S1DBG_N.fetch_add(1, Ordering::Relaxed); if di < 12 { D19_S1DBG[di].store((s1id << 8) | code, Ordering::Relaxed); } };
            if !cm_gate(unit, self_team0, self_f8) { s1rej(1); continue; }
            a2(14);
            if !d19_target_valid(self_u + 0x4d8, self_u, unit) {
                let sel = (rd_i32(self_u + 0x4d8).unwrap_or(-1) as u64) & 0xf;
                let tk = (rd_i32(unit + 0x68).unwrap_or(-1) as u64) & 0xf;
                let sm = (rd_u64(self_u).unwrap_or(0) == rd_u64(unit).unwrap_or(1)) as u64;
                let di = D19_S1DBG_N.fetch_add(1, Ordering::Relaxed);
                if di < 12 { D19_S1DBG[di].store((s1id << 8) | 2 | (sel << 24) | (tk << 28) | (sm << 32), Ordering::Relaxed); }
                continue;
            }
            a2(15);
            let spd = d19_lead_speed(self_u, unit, ct[k]);
            if !d19_in_range_spd(self_u, unit, rb1, pl1, sk1, db1, spd) {
                D19_S1BR_RSQ.store(D19_INR_RSQ.load(Ordering::Relaxed), Ordering::Relaxed);
                D19_S1BR_D2.store(D19_INR_D2.load(Ordering::Relaxed), Ordering::Relaxed);
                D19_S1BR_R.store(D19_INR_R.load(Ordering::Relaxed), Ordering::Relaxed);
                D19_S1BR_ID.store(rd_u64(unit + 0x5a8).unwrap_or(0) & 0xffff, Ordering::Relaxed);
                s1rej(3); continue;
            }
            a2(16);
            // ★[07-14] A계열 vt+0xc8(descvt_c8). 구 vtc8_get(B계열=상수true)은 오귀속 → 스코어게이트 과다실행=under-emit 원인.
            // ★[07-15] score = B슬롯(sk1/db1, dtype self+0x4dc) 데미지. descvt_c8 obj = align 보정.
            if descvt_c8(sk1, descvt_obj(db1, sk1), 0) && rd_i32(unit + 0x68).unwrap_or(0) == 0xd {
                a2(17);
                let score = d19_slot_score(self_u, unit, sk1, db1, rd_u32(self_u + 0x4dc), exe);
                if !d19_score_gate(g0, sim_obj, geom2, game, side, self_u, unit, score) { s1rej(4); continue; }
                a2(18);
            }
            a2(19);
            s1rej(0);
            d19_emit_abil(out, src, rd_u64(unit + 0x5a8).unwrap_or(0), 0x10);
        }
        // (3) enemies_near: target_valid→in_range(보정 없음=self.spd 원본)→emit (스코어게이트 없음)
        for k in 0..nen {
            let unit = en[k];
            if !d19_target_valid(self_u + 0x4d8, self_u, unit) { continue; }
            a2(20);
            if d19_in_range(self_u, unit, rb1, pl1, sk1, db1) {
                a2(21);
                d19_emit_abil(out, src, rd_u64(unit + 0x5a8).unwrap_or(0), 0x10);
            }
        }
    }
    // ═══ tag 0x11 (slot2) ═══
    if slot2_ready {
        // (5) cand_main: 존재게이트→target_valid(slot2+0x28)→리드보정 in_range→[스코어게이트]→emit
        D19_S2DBG_N.store(0, Ordering::Relaxed);   // 진단 리셋
        for k in 0..ncm {
            let unit = cm[k];
            let s2id = rd_u64(unit + 0x5a8).unwrap_or(0) & 0xffff;
            let mut s2rej = |code: u64| { let di = D19_S2DBG_N.fetch_add(1, Ordering::Relaxed); if di < 12 { D19_S2DBG[di].store((s2id << 8) | code, Ordering::Relaxed); } };
            if !cm_gate(unit, self_team0, self_f8) { s2rej(1); continue; }
            a2(22);
            if !d19_target_valid(slot2_base + 0x28, self_u, unit) {
                // ★진단: tv 거부 시 셀렉터·tkind·same을 상위비트에 인코딩(id 8-23·code 0-7 / sel 24-27·tkind 28-31·same 32)
                let sel = (rd_i32(slot2_base + 0x28).unwrap_or(-1) as u64) & 0xf;
                let tk = (rd_i32(unit + 0x68).unwrap_or(-1) as u64) & 0xf;
                let same = (rd_u64(self_u).unwrap_or(0) == rd_u64(unit).unwrap_or(1)) as u64;
                let di = D19_S2DBG_N.fetch_add(1, Ordering::Relaxed);
                if di < 12 { D19_S2DBG[di].store((s2id << 8) | 2 | (sel << 24) | (tk << 28) | (same << 32), Ordering::Relaxed); }
                continue;
            }
            a2(23);
            let spd = d19_lead_speed(self_u, unit, ct[k]);
            if !d19_in_range_spd(self_u, unit, rb2, pl2, sk2, db2, spd) { s2rej(3); continue; }
            a2(24);
            // ★[07-14] A계열 vt+0xc8(descvt_c8) — slot1과 동일 이유.
            // ★[07-15] score = C슬롯(sk2/db2, dtype slot2_base+0x2c) 데미지.
            if descvt_c8(sk2, descvt_obj(db2, sk2), 0) && rd_i32(unit + 0x68).unwrap_or(0) == 0xd {
                a2(25);
                let score = d19_slot_score(self_u, unit, sk2, db2, rd_u32(slot2_base + 0x2c), exe);
                if !d19_score_gate(g0, sim_obj, geom2, game, side, self_u, unit, score) { s2rej(4); continue; }
                a2(26);
            }
            a2(27);
            s2rej(0);
            d19_emit_abil(out, src, rd_u64(unit + 0x5a8).unwrap_or(0), 0x11);
        }
        // (6) enemies_near: target_valid(slot2+0x28)→in_range(보정 없음)→emit
        for k in 0..nen {
            let unit = en[k];
            if !d19_target_valid(slot2_base + 0x28, self_u, unit) { continue; }
            a2(28);
            if d19_in_range(self_u, unit, rb2, pl2, sk2, db2) {
                a2(29);
                d19_emit_abil(out, src, rd_u64(unit + 0x5a8).unwrap_or(0), 0x11);
            }
        }
    }
    // ★계측 덤프(200 블록마다): abil2_dbg.txt
    if A2DBG[0].load(Ordering::Relaxed) % 200 == 0 {
        if let Some(p) = pth("abil2_dbg.txt") {
            let g = |i: usize| A2DBG[i].load(Ordering::Relaxed);
            let _ = fs::write(&p, format!(
"[abil2] blk={} cand합={} near합={}
 멤버십: tag유효={} ptrok={} vis={} 폴백={} accept={}
 ready:  s0={} s1={} s2={}
 0xf  (cand): cmgate={} 리드보정발동={} emit={}
 0x10 (cand): cmgate={} tv={} inr={} c8true={} score통과={} emit={}
 0x10 (near): tv={} emit={}
 0x11 (cand): cmgate={} tv={} inr={} c8true={} score통과={} emit={}
 0x11 (near): tv={} emit={}
 self-target: 0x10(Gate#2) emit={}  0x11(Gate#2/#3) emit={}
 descvt_90: 0x50fc80(=0)={} 0x23cbf20(max)={} 0x214d210(lvl3)={} 미등재={} | nonzero반환={}
 descvt_78(pred): 0x50fc80(false)={} 0x19ec2c0(comp)={} 0x5418a0(true)={} 미등재={}
 Gate#2: 호출={} pred단락(무조건emit)={} 컨테이너통과={} false={}
 descvt_c8(aim): 0x50fc80(false)={} composite={} 기타등재={} ★미등재={}  (미등재>0 = 테이블 불완전!)
 P<0(scaled) 발생수={}  (0이면 SHR교정=no-op, under 원인은 다른 곳)
",
                g(0), g(1), g(2),
                g(3), g(4), g(5), g(6), g(7),
                g(8), g(9), g(10),
                g(11), g(12), g(13),
                g(14), g(15), g(16), g(17), g(18), g(19),
                g(20), g(21),
                g(22), g(23), g(24), g(25), g(26), g(27),
                g(28), g(29),
                g(30), g(31),
                g(32), g(33), g(34), g(35), g(36),
                g(37), g(38), g(39), g(44),
                g(40), g(41), g(42), g(43),
                g(45), g(46), g(47), g(35),
                D19_PNEG.load(Ordering::Relaxed)));
            // ★미등재 RVA 캡처 덤프
            let un = UNREG_N.load(Ordering::Relaxed).min(16);
            let mut us = String::from(" UNREG RVAs (slot:rva):");
            for i in 0..un {
                let k = UNREG[i].load(Ordering::Relaxed);
                us.push_str(&format!(" {:#x}:{:#x}", k >> 40, k & 0xff_ffff_ffff));
            }
            us.push('\n');
            if let Ok(mut f) = fs::OpenOptions::new().create(true).append(true).open(&p) { let _ = write!(f, "{}", us); }
        }
    }
    // ═══ (4) tag 0x10 self-target: target_valid(self+0x4d8, self, self) && Gate#2 → emit(target=self.id) ═══
    if slot1_ready
        && d19_target_valid(self_u + 0x4d8, self_u, self_u)
        && d19_cast_gate(g0, sim_obj, geom2, side, self_u, db1, sk1)
    {
        a2(30);
        d19_emit_abil(out, src, rd_u64(self_u + 0x5a8).unwrap_or(0), 0x10);
    }
    // ═══ (7) tag 0x11 self-target + AoE분기 ═══
    //   ★[07-15] AoE 판정 **순수 등가**: mode 16B(TypeId) vs DAT_1438a5ea0 전일치 ≡ `*(self+0x580) == exe+0x3886538`
    //     (skill vtable 200종 전수스캔서 그 TypeId 보유 concrete = `hitman_ult_projectile` 단 1종).
    //     ⇒ typeid/shadow 재현 불요. AoE면 Gate#3(FUN_1421283d0), 아니면 Gate#2(단일).
    if slot2_ready && d19_target_valid(slot2_base + 0x28, self_u, self_u) {
        // ★[07-15 RE] AoE 판정 소스는 `self+0x578+off` / `self+0x580+off`이고 **off = (lvl<3) ? 0x20 : 0**.
        //   (게임은 vt[0x68](as_any) → vt[0x18](TypeId) 16B를 DAT_1438a5ea0와 비교하지만,
        //    그 TypeId를 갖는 concrete skill vtable = 0x143886538 단 1종이라 **vtable 직접비교와 등가**.)
        let off = if level < 3 { 0x20usize } else { 0 };
        let is_aoe = rd_u64(self_u + 0x580 + off).unwrap_or(0) as usize == exe.wrapping_add(0x3886538);
        let ok = if is_aoe {
            d19_aoe_gate(sim_obj, self_u, off)
        } else {
            d19_cast_gate(g0, sim_obj, geom2, side, self_u, db2, sk2)
        };
        if ok {
            a2(31);
            d19_emit_abil(out, src, rd_u64(self_u + 0x5a8).unwrap_or(0), 0x11);
        }
    }
}


// 후반B(다중 방어커맨드) — §11.9.3 D. ★[2026-07-11] 커밋오더 tag5(③)+레인 tag5(④)+tag3 후퇴(⑥) 구현.
//   전부 순수재현(rd_* + geom_resolve150(vt0x150 순수)): shadow-call·전역RNG 없음. disc17 검증패턴 재사용
//   (커밋오더 es=geom2+other*0x2e8 3서브 = my_disc17 near_flag / 레인압박 concat3 = disc17_pred 2차병합).
//   능력배정 tag0xf/0x10/0x11(⑤/⑦/⑧)=usability leaf(fbe670/fce700/fbe950/fcf860 vt3슬롯), D19_ABIL 게이트.
unsafe fn d19_phase_b(out: usize, sim_obj: usize, g0: usize, geom2: usize, nx: usize,
                      side: usize, issuer: u64, _phase: i64, p6_pair: usize) -> i64 {
    let other = 1 - side;
    // ① nexus2 = nx 재사용(vt0x138 이미 해결). ②~④ 좌표기준 = nexus 위치.
    let (nxx, nxy) = (rd_u64(nx + 0x648).unwrap_or(0), rd_u64(nx + 0x650).unwrap_or(0));
    // 넥서스 폴백/커밋오더 nearest 기준 엔티티 = *(g0/local_58 + 0x170 + side*8) (cref).
    //   커밋오더 tag5(③) refx/refy 기준이자, 레인 tag5(④) 레인0개일 때 넥서스 폴백 target으로 공용.
    let cref = rd_u64(g0 + 0x170 + side * 8).unwrap_or(0) as usize;

    // ③ 커밋오더 tag5: es=geom2+OTHER*0x2e8. 3서브오더 {flag@+0/+0x28/+0x50, handle@+8/+0x30/+0x58}.
    //    활성만 vt0x150(geom_resolve150)로 d1/d2/d3 해결 → null제거(FUN_142315240 매핑) → nexus 최근접 → tag5.
    //    dest=대상(오더)좌표·target_id=대상+0x5a8·반경 80000.
    if ptr_ok(geom2) {
        // ★[2026-07-11 ghidra 실측계약 교정 FUN_141c83700 emit A @0x141c84456]
        //   후보 3슬롯 union: flag(i32)@{0,0x28,0x50}==1, handle@{8,0x30,0x58} → geom_resolve150 → non-null만.
        let es = geom2 + other * 0x2e8;
        let subs = [
            (rd_i32(es).unwrap_or(0) == 1,        rd_u64(es + 8).unwrap_or(0)),
            (rd_i32(es + 0x28).unwrap_or(0) == 1, rd_u64(es + 0x30).unwrap_or(0)),
            (rd_i32(es + 0x50).unwrap_or(0) == 1, rd_u64(es + 0x58).unwrap_or(0)),
        ];
        //   nearest 기준 = 우리 넥서스 = cref(위에서 호이스트, nx=dd7리졸브 아님).
        let (refx, refy) = (rd_i64(cref + 0x648).unwrap_or(0) as u64, rd_i64(cref + 0x650).unwrap_or(0) as u64);
        let (mut best, mut bestd) = (0usize, u64::MAX);
        for &(active, h) in &subs {
            if !active { continue; }
            d19_near(geom_resolve150(sim_obj, h), refx, refy, &mut best, &mut bestd);   // SlotMap핸들=ptr_ok가드 금지
        }
        if best != 0 {
            //   target = chosen+0x5a8 핸들, 좌표는 target 재리졸브(chosen 직독 아님). 실패시 0x767932b1.
            let target = rd_u64(best + 0x5a8).unwrap_or(0);
            let ru = geom_resolve150(sim_obj, target);
            let (dx, dy) = if ptr_ok(ru) {
                (rd_i64(ru + 0x648).unwrap_or(0) as u64, rd_i64(ru + 0x650).unwrap_or(0) as u64)
            } else {
                (0x767932b1u64, 0x767932b1u64)
            };
            d19_emit_tag5(out, issuer, target, dx, dy);
        }
    }

    // ④ 레인 tag5(레인압박 방어이동, emit B @0x141c847e8 ghidra 실측). 커밋오더 tag5(③) 직후·tag3 후퇴(⑥) 앞.
    //    레인배열 = g0(local_58)+side*0x20+{0x130 base(stride8), 0x148 len}. 각 레인 lane_id=lane+0x5a8.
    //    압박레인 = ∃concat3(OTHER) 유닛 u: u+0x68==1 && u+0x88==1 && u+0x90==lane_id (d19_lane_pressed).
    //    압박레인 중 nexus dist²최소, 없으면 전체 레인 중 nexus dist²최소, 레인0개면 skip.
    //    emit B: +8=lane_id, dest=(dx,dy)=vt0x150(sim,lane_id)엔티티 +0x648/+0x650(stale시 0x767932b1), +0x4a0 미기록(=0).
    {
        let lane_base = rd_u64(g0 + side * 0x20 + 0x130).unwrap_or(0) as usize;
        let lane_len = rd_i64(g0 + side * 0x20 + 0x148).unwrap_or(0);
        let mut best = 0usize;
        if lane_base != 0 && lane_len > 0 && lane_len <= 4096 {
            // ①압박레인 우선 / ②전체 최근접 폴백 — 기존 로직 불변.
            let (mut bestd, mut best_press) = (u64::MAX, false);
            for i in 0..lane_len as usize {
                let lane = rd_u64(lane_base + i * 8).unwrap_or(0) as usize;
                if lane == 0 { continue; }
                let lane_id = rd_i64(lane + 0x5a8).unwrap_or(0);
                let pressed = d19_lane_pressed(g0, other, lane_id);
                if best_press && !pressed { continue; }              // 압박레인 존재 시 비압박 폴백 무시
                if pressed && !best_press { best = 0; bestd = u64::MAX; best_press = true; }  // 첫 압박레인서 폴백 리셋
                let d = sqd(rd_u64(lane + 0x648).unwrap_or(0), rd_u64(lane + 0x650).unwrap_or(0), nxx, nxy);
                if d < bestd { bestd = d; best = lane; }
            }
        } else {
            // ③ 넥서스 폴백(레인0개): target_lane = *(local_58+self*8+0x170) = cref(커밋오더 [0]와 동일 엔티티).
            //    id = cref+0x5a8(진영인덱스 0/1). game 실측 33건 불일치(my skip vs game emit B) 교정.
            best = cref;
        }
        if best != 0 {
            let lane_id = rd_i64(best + 0x5a8).unwrap_or(0) as u64;   // 레인=lane_id / 넥서스폴백=진영인덱스 0/1
            let e = geom_resolve150(sim_obj, lane_id);               // vt0x150(sim,lane_id) — SlotMap핸들이라 ptr_ok가드 금지
            let (dx, dy) = if ptr_ok(e) {
                (rd_i64(e + 0x648).unwrap_or(0) as u64, rd_i64(e + 0x650).unwrap_or(0) as u64)
            } else {
                (0x767932b1u64, 0x767932b1u64)                       // stale-id 폴백상수
            };
            d19_emit(out, 5, issuer, lane_id, dx, dy, 0, 80000, 5, 5);  // emit B(+0x4a0=0=미기록, tag5)
        }
    }

    // ⑥ tag3 본진후퇴(FUN_14236ddf0 아군능력빌더의 후행 tag3). game 실측 disc19 기본 = tag5×2+tag3.
    d19_emit_retreat(out, side, issuer);
    // ⑤/⑦/⑧ 능력배정(tag 0xf/0x10/0x11) — tag5/tag3 뒤 추가발행. D19_ABIL 게이트(기본 OFF=현행 완전보존).
    //   self_u=nx(self-unit). src=issuer(vt0x28 tick, tag5와 동일). shadow-call 포함이라 게이트 하에서만.
    // ★[07-15 RE] 게임 호출순서 = **2차(0x1c84ae6) → 1차(0x1c84c35)**. 두 emitter가 같은 self로 같은 리스트에 순서대로 append.
    //   (구 코드는 1차→2차로 역순이었음 — 위치별 대조가 어긋나는 원인.)
    if D19_ABIL2.load(Ordering::Relaxed) {
        d19_abil2_block(out, g0, sim_obj, geom2, p6_pair, nx, side, issuer);
    }
    if D19_ABIL.load(Ordering::Relaxed) {
        d19_abil_block(out, g0, other, nx, issuer, sim_obj, geom2);
    }
    3
}

// FUN_14237d910(p5,p6,e) 확률술어 → 저비트=bool. 로컬RNG(entity id/self/tick seed=전역 sim-rng 미소비, 규명 a48105662).
#[inline] unsafe fn d19_g1_pred(p5: usize, p6: usize, e: usize) -> bool {
    let base = exe_base();
    if base == 0 || !ptr_ok(p5) || !ptr_ok(p6) || !ptr_ok(e) { return false; }
    // ⚠[0.5.1] 0x237d910(VisionRoll)=0.5.0_3 stale(재배치 추정). 기본 d19_g1_shadow=OFF(순수 d19_g1_pred_pure)라 미호출. 켜기 전 0.5.1 재핀.
    if !code_ptr_ok(base + 0x237d910) { return false; }   // ★[07-15 하드닝] stale/비.text RVA CALL 사전차단
    let f: F237d = core::mem::transmute(base + 0x237d910);
    let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| f(p5, p6, e))).unwrap_or(0);
    (r & 1) != 0
}

// ══ FUN_14237d910 순수재현 (§11.9.3.3 최신E B.1, RVA 0x237d910) — shadow 부품 재사용, PRNG 신규구현 X ══
//   반환 = visible(bool). seed의 tick항 = max(tick-r14,0)<<0x28[최신E/new] — shadow와 17790건 비트동일(mmN=0) 검증완료.
//   실패(레이아웃/포인터 미해결)시 false = d19_g1_pred(shadow)의 실패시 반환과 동일 계약(struct_threat/Gate1 bVar5서 미노출=제외로 보수처리).
//   부품: LocalRng::seed_from_u64/gen_range_i64, geom_vtc0, dd7_slot128 (전부 순수·전역 sim-rng 미소비).
unsafe fn d19_g1_pred_pure(p5: usize, p6: usize, e: usize) -> bool {
    d19_g1_pred_pure_calc(p5, p6, e).unwrap_or(false)
}

#[inline] unsafe fn d19_g1_pred_pure_calc(p5: usize, p6: usize, e: usize) -> Option<bool> {
    if !ptr_ok(p5) || !ptr_ok(p6) || !ptr_ok(e) { return None; }
    // sim_obj(geom gc) = p6 레이아웃 자동감지(my_disc19 L5214와 동일: dd7_slot128 유효한 쪽 채택).
    let self_h = rd_u64(p5 + 0x818)?;                                   // *(p5+0x818) = self/nexus 핸들 = seed항
    let cand_a = rd_u64(p6)? as usize;
    let cand_b = if ptr_ok(cand_a) { rd_u64(cand_a).unwrap_or(0) as usize } else { 0 };
    let sim_obj = if ptr_ok(cand_a) && ptr_ok(dd7_slot128(cand_a, self_h)) { cand_a }
                  else if ptr_ok(cand_b) && ptr_ok(dd7_slot128(cand_b, self_h)) { cand_b }
                  else { return None; };
    let kind = rd_i64(e + 0x68).unwrap_or(0);                           // e+0x68 kind (0xd=건물)
    let subtype = rd_i64(e + 0x70).unwrap_or(0);                        // e+0x70 subtype
    let tid = rd_i64(e + 0x5a8).unwrap_or(0);                           // e+0x5a8 team/id (SlotMap 핸들 — ptr_ok 금지)
    let prof = rd_i64(p5 + 0x1e8).unwrap_or(0);                         // p5+0x1e8 FOG/판단력
    let jud = { let d = 100 - prof; if d > 0 { d } else { 0 } };        // clamp0(100-prof)
    let tick = rd_i64(sim_obj + 0xeac0).unwrap_or(0);                   // vt0x28 tick
    let is_building = kind == 0xd;
    let r14 = if is_building && (3..=6).contains(&subtype) { rd_i64(e + 0x78).unwrap_or(0) } else { 0 };  // 시야임계(subtype∈{3,4,5,6})
    // teamstat = vt0xc0(sim_obj, tid) ? min(*(rec+0x1f0),100) : 50
    let teamstat = { let rec = geom_vtc0(sim_obj, tid as u64);
                     if rec != 0 { let v = rd_i64(rec + 0x1f0).unwrap_or(50); if v < 100 { v } else { 100 } } else { 50 } };
    // lo/hi (연산우선순위: (((jud²*C1)*C2)>>S)+K)
    let jj = jud * jud;
    let lo = (((jj * 0x3a) * 0x68db9) >> 0x20) + 2;                     // ((jud²*58*0x68db9)>>32)+2
    let hi = (((jj * 0x72) * 0x1a36e3) >> 0x22) + 6;                    // ((jud²*114*0x1a36e3)>>34)+6
    // bias = (((teamstat²*0xc)/10000)*jud & 0xffff)/100
    let bias = ((((teamstat * teamstat * 0xc) / 10000) * jud) & 0xffff) / 100;
    // seed base(tid<<0x14 ^ self_h) + tick항 = max(tick-r14,0)<<0x28[최신E, 검증됨]
    let base_seed = ((tid as u64) << 0x14) ^ self_h;
    let tick_new = { let d = tick - r14; if d > 0 { d } else { 0 } };
    let seed_new = base_seed ^ ((tick_new as u64) << 0x28);
    let roll_new = LocalRng::seed_from_u64(seed_new).gen_range_i64(lo, hi);   // inclusive [lo,hi]
    // visible: 건물(kind==0xd)=(r14 >= roll+bias) / 유닛=((roll+bias)==0)
    Some(if is_building { r14 >= roll_new + bias } else { (roll_new + bias) == 0 })
}

unsafe fn g1cap_record(p6: usize) {
    if G1CAP_CNT.load(Ordering::Relaxed) >= 16 { return; }
    let inner = rd_u64(p6).unwrap_or(0) as usize;
    if !ptr_ok(inner) { return; }
    let gameobj = rd_u64(inner).unwrap_or(0) as usize;
    let vtbl = rd_u64(inner + 8).unwrap_or(0) as usize;
    if !ptr_ok(vtbl) { return; }
    let vt170 = rd_u64(vtbl + 0x170).unwrap_or(0) as usize;
    if !ptr_ok(vt170) { return; }
    let exe = exe_base();
    let rva = vt170.wrapping_sub(exe);
    let mut empty = usize::MAX;
    for i in 0..16usize {
        let v = G1CAP_SET[i].load(Ordering::Relaxed);
        if v == rva { return; }
        if v == 0 && empty == usize::MAX { empty = i; }
    }
    if empty == usize::MAX { return; }
    if G1CAP_SET[empty].compare_exchange(0, rva, Ordering::SeqCst, Ordering::SeqCst).is_err() { return; }
    G1CAP_CNT.fetch_add(1, Ordering::Relaxed);
    // vt170 + compFlag이 쓰는 나머지 gameobj vtable 다형 게터 슬롯을 한 번에 덤프(concrete RVA+프롤로그).
    let dump = |slot: usize, lbl: &str| -> String {
        let g = rd_u64(vtbl + slot).unwrap_or(0) as usize;
        if !ptr_ok(g) { return format!(" {}[+{:#x}=null]", lbl, slot); }
        let mut hex = String::with_capacity(72);
        for i in 0..36usize { if !readable(g + i, 1) { break; } hex.push_str(&format!("{:02x}", rd_u8(g + i))); }
        format!(" {}[+{:#x}]={:#x} p={}", lbl, slot, g.wrapping_sub(exe), hex)
    };
    let mut s = format!("[g1cap #{}] gameobj_rva={:#x} vtbl_rva={:#x}\n  vt170[+0x170]={:#x} p={}\n",
        G1CAP_CNT.load(Ordering::Relaxed), gameobj.wrapping_sub(exe), vtbl.wrapping_sub(exe), rva, {
            let mut hex = String::with_capacity(96);
            for i in 0..48usize { if !readable(vt170 + i, 1) { break; } hex.push_str(&format!("{:02x}", rd_u8(vt170 + i))); }
            hex
        });
    s.push_str("  slots:");
    s.push_str(&dump(0x28, "vt28"));
    s.push_str(&dump(0x68, "vt68"));
    s.push_str(&dump(0x138, "vt138"));
    s.push_str(&dump(0x150, "vt150"));
    s.push('\n');
    if let Some(p) = pth("g1cap.txt") {
        if let Ok(mut f) = fs::OpenOptions::new().create(true).append(true).open(&p) { let _ = write!(f, "{}", s); }
    }
}

// ── compFlag reach: FUN_142066640 디스패처(cat별) ★[07-12 §11.9.10 최종] ──
//   cat 0,1,6,7,8,9,≥11 → 무조건 true. cat2 → reach_cat2(JT1 subshape). cat3/4/5 → shape_test(C=desc+0x100,S=desc+0x110).
//   cat10 → shape_test(C=S=desc+0x70, 점축약). castRange=r9.
unsafe fn d19_reach(desc: usize, cat: i64, tx: i64, ty: i64, cr: i64) -> bool {
    let d = |o: usize| rd_i64(desc + o).unwrap_or(0);
    match cat {
        2 => d19_reach_cat2(desc, tx, ty, cr),
        3 | 4 | 5 => d19_shape_test(desc, d(0x110), d(0x118), d(0x100), d(0x108), tx, ty, cr),
        10 => d19_shape_test(desc, d(0x70), d(0x78), d(0x70), d(0x78), tx, ty, cr),
        _ => true,   // 0,1,6,7,8,9,≥11 = reach 미적용(무조건 통과)
    }
}

// FUN_14207c670(shape0-3) 순수재현: desc[0x10]=shape / [0x18]=r0 / [0x20]=r1. C=(cx,cy)=인자, S=(sx,sy)=인자(콘).
//   캡슐(shape1)은 desc+0x20~0x38 자체필드. 전부 i64 정수·÷10000(투영t)·÷1000(콘 코사인).
unsafe fn d19_shape_test(desc: usize, sx: i64, sy: i64, cx: i64, cy: i64, tx: i64, ty: i64, cr: i64) -> bool {
    let d = |o: usize| rd_i64(desc + o).unwrap_or(0);
    let r0 = d(0x18);
    match d(0x10) {
        0 => { // 원: |P-C|² <= (cr+r0)²
            let dx = tx - cx; let dy = ty - cy; let rr = cr + r0;
            dx.wrapping_mul(dx).wrapping_add(dy.wrapping_mul(dy)) <= rr.wrapping_mul(rr)
        }
        2 => { // 박스: |Δx|<=r0/2+cr && |Δy|<=r1/2+cr
            (tx - cx).abs() <= r0 / 2 + cr && (ty - cy).abs() <= d(0x20) / 2 + cr
        }
        1 => { // 캡슐: 세그 A→B 사영점 dist² <= (cr+r0)²
            let (ax, ay, bx, by) = (d(0x20), d(0x28), d(0x30), d(0x38));
            let (dxs, dys) = (bx - ax, by - ay);
            let len2 = dxs.wrapping_mul(dxs).wrapping_add(dys.wrapping_mul(dys));
            let (px, py) = (tx - ax, ty - ay);
            let t = if len2 == 0 { 0 } else {
                ((dxs.wrapping_mul(px).wrapping_add(dys.wrapping_mul(py))).wrapping_mul(10000) / len2).clamp(0, 10000)
            };
            let qx = px - dxs.wrapping_mul(t) / 10000;
            let qy = py - dys.wrapping_mul(t) / 10000;
            let rr = cr + r0;
            qx.wrapping_mul(qx).wrapping_add(qy.wrapping_mul(qy)) <= rr.wrapping_mul(rr)
        }
        3 => { // 콘: 원(cr+r0) ∧ dot(P-C, C-S) >= isqrt(|P-C|²)*r1*isqrt(|C-S|²)/1000
            let dx = tx - cx; let dy = ty - cy; let rr = cr + r0;
            let pc2 = dx.wrapping_mul(dx).wrapping_add(dy.wrapping_mul(dy));
            if pc2 > rr.wrapping_mul(rr) { return false; }
            let ex = cx - sx; let ey = cy - sy;
            let cs2 = ex.wrapping_mul(ex).wrapping_add(ey.wrapping_mul(ey));
            let dist = isqrt(pc2.max(0) as u64) as i64;
            let elen = isqrt(cs2.max(0) as u64) as i64;
            let dot = dx.wrapping_mul(ex).wrapping_add(dy.wrapping_mul(ey));
            dot >= dist.wrapping_mul(d(0x20)).wrapping_mul(elen) / 1000
        }
        _ => false,
    }
}

// JT1(cat2) reach: subshape(desc+0x10) 0/1=캡슐(반경 desc+0x18), 2=AABB. 고정 여유분 M=15000(0x3a98).
unsafe fn d19_reach_cat2(desc: usize, tx: i64, ty: i64, cr: i64) -> bool {
    let d = |o: usize| rd_i64(desc + o).unwrap_or(0);
    const M: i64 = 15000;
    let r0 = d(0x18);
    // 캡슐: 선분 A→B 최근접 dist <= cr + r0 + M
    let capsule = |ax: i64, ay: i64, bx: i64, by: i64| -> bool {
        let (dxs, dys) = (bx - ax, by - ay);
        let len2 = dxs.wrapping_mul(dxs).wrapping_add(dys.wrapping_mul(dys));
        let (px, py) = (tx - ax, ty - ay);
        let t = if len2 == 0 { 0 } else {
            ((dxs.wrapping_mul(px).wrapping_add(dys.wrapping_mul(py))).wrapping_mul(10000) / len2).clamp(0, 10000)
        };
        let qx = tx - (ax + dxs.wrapping_mul(t) / 10000);
        let qy = ty - (ay + dys.wrapping_mul(t) / 10000);
        let dist = isqrt(qx.wrapping_mul(qx).wrapping_add(qy.wrapping_mul(qy)).max(0) as u64) as i64;
        dist <= cr + r0 + M
    };
    match d(0x10) {
        0 => capsule(d(0x100), d(0x108), d(0x68), d(0x70)),
        1 => capsule(d(0x20), d(0x28), d(0x30), d(0x38)),
        2 => (tx - d(0x100)).abs() <= r0 / 2 + cr + M && (ty - d(0x108)).abs() <= d(0x20) / 2 + cr + M,  // AABB
        _ => false,   // subshape≥3 = 게임 panic 가드
    }
}

// ── compFlag 순수재현 d19_g1_compflag_pure(FUN_14209a750 compFlag0/1 슬라이스) ★[07-12 §11.9.10.1] ──
//   g0=로스터홀더(*p6), go=geom ctx/오브젝티브홀더(*g0), self=ref=nexus, q=(qx,qy)=넥서스셀중심. 데미지코어 무접촉.
unsafe fn d19_cf_castrange(u: usize, pad: i64) -> i64 {
    (rd_i32(u + 0x458).unwrap_or(0) as i64 + 100).wrapping_mul(rd_i64(u + 0x668).unwrap_or(0)) / 100 + pad
}

// compFlag0/1 순수 계산. shadow(d19_g1_compflag_dyn) 대체. D19_G1CF_SHADOW로 롤백.
//   ★[07-12] g0/go = shadow(FUN_142090ec0) 동일 도출: g0(로스터)=*(p6), go(geom/objectives)=*(*p6). (passed cand_a는 프레임따라 상이=under-set 원인)
unsafe fn d19_g1_compflag_pure(p5: usize, p6: usize, nexus: usize, other: usize, qx: u64, qy: u64) -> (u8, u8) {
    let g0 = rd_u64(p6).unwrap_or(0) as usize;   // 로스터 홀더 = *(p6)
    let go = rd_u64(g0).unwrap_or(0) as usize;   // geom ctx = 오브젝티브 홀더 = *(*p6)
    if !ptr_ok(g0) || !ptr_ok(go) || !ptr_ok(nexus) { return (0, 0); }
    let side = 1 - other;
    // ★[07-12 RE확정] collector teamIdx = *(p5+0x820) (state=param_3=p5). 진단대조용.
    let tidx = if ptr_ok(p5) { rd_i64(p5 + 0x820).unwrap_or(-1) } else { -1 };
    let refkey = rd_u64(nexus + 0x5a8).unwrap_or(0);
    let (qxi, qyi) = (qx as i64, qy as i64);
    let d2q = |u: usize| -> u64 {
        let dx = rd_u64(u + 0x648).unwrap_or(0).abs_diff(qx);
        let dy = rd_u64(u + 0x650).unwrap_or(0).abs_diff(qy);
        dx.saturating_mul(dx).saturating_add(dy.saturating_mul(dy))
    };
    // ★[07-12 RE확정] 슬롯유효 base = *(p6+0x10) (param_4+0x10), NOT *(g0+0x10)=*(*(p6)+0x10). 유닛배열 base=g0+0x1e0은 일치.
    let mblk_fix = rd_u64(p6 + 0x10).unwrap_or(0) as usize;
    let mblk = rd_u64(g0 + 0x10).unwrap_or(0) as usize;   // (구) per-team 블록 base — list_a/b 보존용
    let unit_at = |team: usize, i: usize| -> usize {
        if mblk == 0 { return 0; }
        if rd_i32(mblk + team * 0x2e8 + 0x78 + i * 0x18).unwrap_or(-1) == -1 { return 0; }
        rd_u64(g0 + 0x1e0 + team * 0x28 + i * 8).unwrap_or(0) as usize
    };
    D19_STAGE.store(60, Ordering::Relaxed);   // pure setup 완료, list_a 진입
    // ── A 리스트(self side, self 제외) — de40 touched용 ──
    let mut list_a: [usize; 5] = [0; 5]; let mut na = 0;
    for i in 0..5 {
        let u = unit_at(side, i);
        if !ptr_ok(u) || d2q(u) > 0x9502F9000 { continue; }
        if rd_u64(u + 0x5a8).unwrap_or(0) == refkey { continue; }
        list_a[na] = u; na += 1;
    }
    D19_STAGE.store(65, Ordering::Relaxed);   // list_a 완료, list_b 진입
    // ── B 리스트(other side, 관계필터) — loop2용 ──
    let mut list_b: [usize; 5] = [0; 5]; let mut nb = 0;
    for i in 0..5 {
        let u = unit_at(other, i);
        if !ptr_ok(u) { continue; }
        let key = rd_u64(u + 0x5a8).unwrap_or(0);
        let accept = if geom_vt68(go, side, key) { true } else {
            let r = geom_vtc0(go, key);
            if r == 0 { false } else {
                let lane = rd_u64(r + 0x8b0).unwrap_or(0) as usize;   // ★[07-12] lane*8·t+0x78 wrapping(garbage lane/t시 overflow panic 방지 — 기존 plain산술이 stage65 panic 원인)
                let addr = mblk.wrapping_add(other * 0x2e8).wrapping_add(0x1e0).wrapping_add(lane.wrapping_mul(8));
                let t = rd_i64(addr).unwrap_or(0);
                t.wrapping_add(0x78) >= geom_vt28(go)
            }
        };
        if d2q(u) > 0x9502F9000 || !accept { continue; }
        list_b[nb] = u; nb += 1;
    }
    D19_STAGE.store(66, Ordering::Relaxed);   // list_b 완료, list_c 진입
    // ── C 리스트(cat2 SPECIAL용) ★[07-12 RE확정] collector: team=tidx(=*(p5+0x820)), 슬롯유효 base=*(p6+0x10)=mblk_fix, 유닛배열=g0+0x1e0.
    //    (구버전은 team=other[반대팀]·mblk=*(g0+0x10)[간접차수오류]로 게임 적 집합을 못 봄 → cat2 over-set의 근본원인)
    let gteam = if tidx == 0 || tidx == 1 { tidx as usize } else { other };
    let mut list_c: [usize; 5] = [0; 5]; let mut nc = 0;
    for i in 0..5 {
        if rd_i32(mblk_fix + gteam * 0x2e8 + 0x78 + i * 0x18).unwrap_or(-1) == -1 { continue; }   // 슬롯유효(수정 base)
        let u = rd_u64(g0 + 0x1e0 + gteam * 0x28 + i * 8).unwrap_or(0) as usize;
        if !ptr_ok(u) || d2q(u) > 0x9502F9000 { continue; }
        if rd_u64(u + 0x5a8).unwrap_or(0) == refkey { continue; }   // 적팀(actor 제외)
        if geom_vtc0(go, rd_u64(u + 0x5a8).unwrap_or(0)) == 0 { continue; }   // vt0xc0 유효성
        list_c[nc] = u; nc += 1;
    }
    D19_STAGE.store(61, Ordering::Relaxed);   // list빌드 완료, de40 진입
    // ── de40: 오브젝티브 Vec(go+0x7f8/0x800, stride 0x138) 순회 ──
    let mut cf0 = false; let mut cf1 = false; let mut cf0_l2 = false;
    let mut nobj_pass = 0i64;   // 거리프리필터 통과 오브젝티브 수(진단)
    let obeg = rd_u64(go + 0x7f8).unwrap_or(0) as usize;
    let ocnt = rd_i64(go + 0x800).unwrap_or(0);
    if ptr_ok(obeg) && ocnt > 0 && ocnt <= 256 {
        for oi in 0..ocnt as usize {
            let desc = obeg + oi * 0x138;
            let cx = rd_i64(desc + 0x100).unwrap_or(0); let cy = rd_i64(desc + 0x108).unwrap_or(0);
            let (dqx, dqy) = (cx - qxi, cy - qyi);
            let dqd = dqx.wrapping_mul(dqx).wrapping_add(dqy.wrapping_mul(dqy));
            if (dqd >> 8) > 0xe8d4a50 { continue; }
            let cat = rd_i64(desc + 0x40).unwrap_or(0);
            // 진단: 각 오브젝티브의 정지단계(0=flag0/1 세팅, 1=knight,2=cat,3=vt150,4=fcf590,5=reach,6=srcself,7=cat2 suppress,8=cat4)
            let mut stop = 0i64;
            let idx = if cat < 2 { 7 } else { cat - 2 };
            // 엔트리게이트: skip-flag!=0 이거나 knight_ult 특수유닛(source==self & 이름=="knight_ult") ★[07-12 핸드오프 §11.9.10.2 B]
            let entry_ok = rd_u8(desc + 0x131) != 0 || (
                rd_u64(desc).unwrap_or(0) == rd_u64(nexus).unwrap_or(1)
                && (rd_u64(desc).unwrap_or(0) != 0 || rd_u64(desc + 8).unwrap_or(0) == rd_u64(nexus + 8).unwrap_or(1))
                && rd_i64(desc + 0xa0).unwrap_or(0) == 10
                && {
                    let np = rd_u64(desc + 0x98).unwrap_or(0) as usize;
                    ptr_ok(np) && rd_u64(np).unwrap_or(0) == 0x755f_7468_6769_6e6b
                    && (rd_u32(np + 8) & 0xffff) == 0x746c
                }
            );
            if !entry_ok { stop = 1; }
            else if cat == 6 || cat == 7 || (idx == 7 && cat == 1) { stop = 2; }
            else if geom_resolve150(go, rd_u64(desc + 0xf8).unwrap_or(0)) == 0 { stop = 3; }
            else if !d19_fcf590(desc, nexus) { stop = 4; }
            else if !d19_reach(desc, cat, qxi, qyi, d19_cf_castrange(nexus, 18000)) { stop = 5; }   // actor_radius=castRange(actor)+18000 (base_r는 오독=non-cat2 깨짐)
            else if { let dr = rd_u64(desc).unwrap_or(0);   // ★[07-12 RE확정] same(desc,actor): dr==actor[0] && (dr!=0 || desc[8]==actor[8]). dr!=0면 desc[8] 무시(구버전은 항상 요구=too strict, cat4 cf1 over-set 원인)
                    dr == rd_u64(nexus).unwrap_or(1)
                    && (dr != 0 || rd_u64(desc + 8).unwrap_or(0) == rd_u64(nexus + 8).unwrap_or(1)) } { stop = 6; }  // source==self=score
            else if cat == 2 && (rd_u8(desc + 0x78) & 1) == 0 {
                // ★[07-12 RE확정] cat2 SPECIAL 진입 = cat==2 && (desc78 & 1)==0 (bit0만, 짝수 desc78 포함 — e267 `desc78^1` AND). 적(list_c)+fcf590+reach → (적발견 && min_적dist²(→desc) < |q−desc|²)=suppress.
                let mut a8 = i64::MAX; let mut has = false; let mut n590 = 0i64; let mut guard = 0i64;
                let mut dbg_same = -1i64; let mut dbg_kt = -9i64;
                for k in 0..nc {
                    let u = list_c[k];
                    if k == 0 {
                        let gr = rd_u64(desc).unwrap_or(0); let gt = rd_u64(u).unwrap_or(1);
                        dbg_same = (gr == gt && (gr != 0 || rd_u64(desc + 8).unwrap_or(0) == rd_u64(u + 8).unwrap_or(1))) as i64;
                        dbg_kt = rd_i32(u + 0x68).unwrap_or(-9) as i64;
                    }
                    if rd_u8(u + 0x6a0) == 1 && rd_i64(u + 0x688).unwrap_or(1) == 0 { guard += 1; }
                    if !d19_fcf590(desc, u) { continue; }
                    n590 += 1;
                    let (ux, uy) = (rd_u64(u + 0x648).unwrap_or(0) as i64, rd_u64(u + 0x650).unwrap_or(0) as i64);
                    if !d19_reach(desc, cat, ux, uy, d19_cf_castrange(u, 0)) { continue; }
                    has = true;
                    let dd = (ux - cx).wrapping_mul(ux - cx).wrapping_add((uy - cy).wrapping_mul(uy - cy));
                    if dd < a8 { a8 = dd; }
                }
                G1CF_DBG[6].store(rd_u32(desc + 0x12c) as i64 * 1000 + dbg_same * 100 + (dbg_kt + 9), Ordering::Relaxed);   // sel*1000+same*100+(kt+9)
                G1CF_DBG[7].store((nc as i64) * 10000 + guard * 100 + n590, Ordering::Relaxed);   // nc/guard/n590
                // ★게임 teamIdx(tidx=gteam) 슬롯 전수덤프 + 수정 슬롯유효 base(mblk_fix=*(p6+0x10)): 게임이 보는 적 집합 확정
                let dg = rd_u64(desc).unwrap_or(0);
                for i in 0..5usize {
                    let sv = (rd_i32(mblk_fix + gteam * 0x2e8 + 0x78 + i * 0x18).unwrap_or(-1) != -1) as i64;
                    let u = rd_u64(g0 + 0x1e0 + gteam * 0x28 + i * 8).unwrap_or(0) as usize;
                    let uok = ptr_ok(u) as i64;
                    let (dist, side_ok, geom, fcf, sm, gd) = if uok == 1 {
                        let du = d2q(u);
                        let gt = rd_u64(u).unwrap_or(1);
                        let sm = (dg == gt && (dg != 0 || rd_u64(desc + 8).unwrap_or(0) == rd_u64(u + 8).unwrap_or(1))) as i64;
                        (((du <= 0x9502F9000) as i64),
                         ((rd_u64(u + 0x5a8).unwrap_or(0) != refkey) as i64),
                         ((geom_vtc0(go, rd_u64(u + 0x5a8).unwrap_or(0)) != 0) as i64),
                         (d19_fcf590(desc, u) as i64), sm,
                         ((rd_u8(u + 0x6a0) == 1 && rd_i64(u + 0x688).unwrap_or(1) == 0) as i64))
                    } else { (0, 0, 0, 0, 0, 0) };
                    G1CF_SLOT[i].store(sv * 10_000_000 + uok * 1_000_000 + dist * 100_000 + side_ok * 10_000 + geom * 1_000 + fcf * 100 + sm * 10 + gd, Ordering::Relaxed);
                }
                G1CF_SLOT[5].store(tidx * 1000 + (other as i64) * 100 + gteam as i64 * 10, Ordering::Relaxed);   // tidx/other/gteam
                if has && a8 < dqd { stop = 7; } else { cf0 = true; }
            } else if cat == 4 { cf1 = true; stop = 8; }   // ★[07-12 RE확정] cat4는 적탐지/거리 무관 무조건 cf1(적탐지 누산은 cat2 전용). same(desc,actor)는 위 stop=6서 이미 거름.
            else { cf0 = true; }
            // 진단 인코딩: cat*1000 + (desc78!=0)*100 + stop
            if nobj_pass < 16 {
                let d78 = (rd_u8(desc + 0x78) != 0) as i64;
                G1CF_DBG[8 + nobj_pass as usize].store(cat * 1000 + d78 * 100 + stop, Ordering::Relaxed);
            }
            nobj_pass += 1;
        }
    }
    D19_STAGE.store(62, Ordering::Relaxed);   // de40 완료, loop2 진입
    // ── loop2: B 배열 flag0 게이트 ★[07-12 loop2 RE 정정] — threat/eff 무관(스코어경로였음). st∈{3,4}+usability+tick+사영거리 ──
    if D19_G1CF_LOOP2.load(Ordering::Relaxed) {
        let ok68b = geom_vt68(go, other, refkey);   // 루프 불변
        let tick = geom_vt28(go);                    // vt0x28 = *(go+0xeac0)
        let cr20 = d19_cf_castrange(nexus, 20000);   // ★[07-12 핸드오프 §11.9.10.2] selfScaled=castRange(>>2 없음, de40 검증식과 동일)
        for k in 0..nb {
            let u = list_b[k];
            let d2 = d2q(u);
            if (d2 >> 10) >= 0x9502F9 && !ok68b { continue; }   // record 진입 전제(threat 게이트)
            let raw = rd_i64(u + 0x2f0).unwrap_or(0);
            let st = if raw >= 0 { 4 } else { raw ^ (1i64 << 63) };   // ① st 디코드
            if st != 3 && st != 4 { continue; }
            let (b_off, range_off, cond_off, sd_off): (usize, usize, usize, usize) =
                if st == 3 { (0x318, 0x328, 0x330, 0x344) } else { (0x328, 0x338, 0x340, 0x354) };
            if !d19_target_valid(u + sd_off, u, nexus) { continue; }   // ② usability(fcf860)
            if tick < rd_i64(u + cond_off).unwrap_or(i64::MAX) { continue; }   // ③ tick >= *(u+cond_off)
            // ④ 넥서스축 사영거리: 세그 A=(u+0x648,0x650)→B=(u+b_off,+8), q 사영 → D <= *(u+range_off)+self_sc+20000
            let (ax, ay) = (rd_i64(u + 0x648).unwrap_or(0), rd_i64(u + 0x650).unwrap_or(0));
            let (bx, by) = (rd_i64(u + b_off).unwrap_or(0), rd_i64(u + b_off + 8).unwrap_or(0));
            let (dxs, dys) = (bx - ax, by - ay);
            let len2 = dxs.wrapping_mul(dxs).wrapping_add(dys.wrapping_mul(dys));
            let (px, py) = (qxi - ax, qyi - ay);
            let t = if len2 == 0 { 0 } else {
                ((dxs.wrapping_mul(px).wrapping_add(dys.wrapping_mul(py))).wrapping_mul(10000) / len2).clamp(0, 10000)
            };
            let projx = ax + dxs.wrapping_mul(t) / 10000; let projy = ay + dys.wrapping_mul(t) / 10000;
            let dd = (qxi - projx).wrapping_mul(qxi - projx).wrapping_add((qyi - projy).wrapping_mul(qyi - projy));
            let d = isqrt(dd.max(0) as u64) as i64;
            if d <= rd_i64(u + range_off).unwrap_or(0) + cr20 { cf0_l2 = true; }
        }
    }
    D19_STAGE.store(63, Ordering::Relaxed);   // loop2 완료, phase-pass 진입
    // ── phase-pass(@14209f5c0, Block A): 적팀(other=1-tidx) 챔피언 subplan objective-push → cf0 (de40와 OR). ★[07-12 RE phase-pass 완전게이트] ──
    //   Block A 멤버십 = team=other, base=*(p6)+0x1e0 / slotvalid=mblk_fix=*(p6+0x10), dist²≤200000²(중심 q), 관계 geom_vt68(go,side=tidx,key)+폴백.
    //   게이트사슬(loop2와 동일 오프셋) = kind(+0x68)==13 & +0x4e0!=-1 & +0xb8>=0xb4 & st∈{3,4} & target_valid(u+0x354/0x344,u,nexus) & tick>=*(u+0x340/0x330) & 투영D<=*(u+0x338/0x328)+castRange(nexus,20000).
    let mut pp_cf0 = false;
    {
        let tick = geom_vt28(go);
        let cr20 = d19_cf_castrange(nexus, 20000);
        for i in 0..5 {
            if rd_i32(mblk_fix + other * 0x2e8 + 0x78 + i * 0x18).unwrap_or(-1) == -1 { continue; }
            let u = rd_u64(g0 + 0x1e0 + other * 0x28 + i * 8).unwrap_or(0) as usize;
            if !ptr_ok(u) || d2q(u) > 0x9502F9000 { continue; }
            let key = rd_u64(u + 0x5a8).unwrap_or(0);
            let rel = if geom_vt68(go, side, key) { true } else {
                let r = geom_vtc0(go, key);
                if r == 0 { false } else {
                    let lane = rd_u64(r + 0x8b0).unwrap_or(0) as usize;   // ★[07-12] wrapping(overflow panic 방지, list_b와 동일)
                    let addr = mblk.wrapping_add(other * 0x2e8).wrapping_add(0x1e0).wrapping_add(lane.wrapping_mul(8));
                    rd_i64(addr).unwrap_or(0).wrapping_add(0x78) >= tick
                }
            };
            if !rel { continue; }
            if rd_i32(u + 0x68).unwrap_or(0) != 0xd { continue; }          // kind==13 챔피언
            if rd_i64(u + 0x4e0).unwrap_or(-1) == -1 { continue; }
            if rd_i64(u + 0xb8).unwrap_or(0) < 0xb4 { continue; }
            let raw = rd_i64(u + 0x2f0).unwrap_or(0);
            let st = if raw >= 0 { 4 } else { raw ^ (1i64 << 63) };
            if st != 3 && st != 4 { continue; }
            let (b_off, range_off, thr_off, sel_off): (usize, usize, usize, usize) =
                if st == 3 { (0x318, 0x328, 0x330, 0x344) } else { (0x328, 0x338, 0x340, 0x354) };
            if !d19_target_valid(u + sel_off, u, nexus) { continue; }
            if tick < rd_i64(u + thr_off).unwrap_or(i64::MAX) { continue; }
            // 투영거리 게이트 (fccd-fd0c, loop2와 동일)
            let (ax, ay) = (rd_i64(u + 0x648).unwrap_or(0), rd_i64(u + 0x650).unwrap_or(0));
            let (bx, by) = (rd_i64(u + b_off).unwrap_or(0), rd_i64(u + b_off + 8).unwrap_or(0));
            let (dxs, dys) = (bx - ax, by - ay);
            let len2 = dxs.wrapping_mul(dxs).wrapping_add(dys.wrapping_mul(dys));
            let (px, py) = (qxi - ax, qyi - ay);
            let t = if len2 == 0 { 0 } else {
                ((dxs.wrapping_mul(px).wrapping_add(dys.wrapping_mul(py))).wrapping_mul(10000) / len2).clamp(0, 10000)
            };
            let projx = ax + dxs.wrapping_mul(t) / 10000; let projy = ay + dys.wrapping_mul(t) / 10000;
            let dd = (qxi - projx).wrapping_mul(qxi - projx).wrapping_add((qyi - projy).wrapping_mul(qyi - projy));
            let d = isqrt(dd.max(0) as u64) as i64;
            if d <= rd_i64(u + range_off).unwrap_or(0) + cr20 { pp_cf0 = true; break; }
        }
    }
    // 진단 기록: [0]=de40cf0 [1]=loop2cf0(+pp*10) [2]=cf1 [3]=nobj_pass [4]=na [5]=nb
    G1CF_DBG[0].store(cf0 as i64, Ordering::Relaxed);
    G1CF_DBG[1].store(cf0_l2 as i64 + (pp_cf0 as i64) * 10, Ordering::Relaxed);   // units=l2cf0, tens=pp_cf0
    G1CF_DBG[2].store(cf1 as i64, Ordering::Relaxed);
    G1CF_DBG[3].store(nobj_pass, Ordering::Relaxed);
    G1CF_DBG[4].store(na as i64, Ordering::Relaxed);
    G1CF_DBG[5].store(nb as i64, Ordering::Relaxed);
    D19_STAGE.store(64, Ordering::Relaxed);   // phase-pass 완료, compFlag pure 정상 반환
    ((cf0 || cf0_l2 || pp_cf0) as u8, cf1 as u8)   // ★cf0 = de40 | loop2 | phase-pass. cf1 = de40 단독(phase-pass 미설정 확정).
}

// FUN_142090ec0(&out48B, phase, p5, p6, worldX, worldY, mode=2) → out+0x28 byte0=cf0, +0x29 byte1=cf1. (phase>=0x1d 동적 위협그리드)
unsafe fn d19_g1_compflag_dyn(phase: i64, p5: usize, p6: usize, wx: u64, wy: u64) -> (u8, u8) {
    let base = exe_base();
    if base == 0 || !ptr_ok(p5) || !ptr_ok(p6) { return (0, 0); }
    if G1CAP_ON.load(Ordering::Relaxed) { g1cap_record(p6); }   // vt0x170 concrete 타깃 캡처(순수 read)
    if !code_ptr_ok(base + 0x236b6b0) { return (0, 0); }   // ★[07-15 하드닝] stale/비.text RVA CALL 사전차단
    let mut obuf = [0u64; 8];   // 64B (game은 48B write). +0x28=obuf[5].
    let bp = obuf.as_mut_ptr() as usize;
    let f: Fn2090 = core::mem::transmute(base + 0x236b6b0);   // ★0.5.1(was 0.5.0_3 0x2090ec0=재배치). ghidra-re 확정(8push+SUB0x178+MOV RDI,R9 프롤로그 바이트동일=로직불변, disc19핸들러 7-arg 호출확증). ⚠기본은 순수경로(D19_G1CF_SHADOW=false)라 미호출
    let ok = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
        f(bp, phase as usize, p5, p6, wx as usize, wy as usize, 2u8);
    })).is_ok();
    if !ok { return (0, 0); }
    ((obuf[5] & 0xff) as u8, ((obuf[5] >> 8) & 0xff) as u8)   // out+0x28 byte0/byte1
}

// phase<0x1d 정적 precomp 그리드 read(게임 실측식). ★placement상 Gate1은 phase>0x1d에서만 도달 → 실질 미도달(완전성용 재현).
unsafe fn d19_g1_compflag_pre(p7: usize, cellx: u64, celly: u64) -> (u8, u8) {
    if !ptr_ok(p7) { return (0, 0); }
    let ox = rd_i64(p7 + 0x1320).unwrap_or(0);
    let oy = rd_i64(p7 + 0x1328).unwrap_or(0);
    let mut lx = (cellx as i64 - ox) + 3; if lx < 1 { lx = 0; } else if lx > 5 { lx = 6; }
    let mut ly = (celly as i64 - oy) + 3; if ly < 1 { ly = 0; } else if ly > 5 { ly = 6; }
    let idx = (lx * 0x2a + ly * 6 + 0x143) as usize;   // flag qword index (=puVar2[1])
    let q = rd_u64(p7 + idx * 8).unwrap_or(0);
    ((q & 0xff) as u8, ((q >> 8) & 0xff) as u8)
}

// Gate1 본체: (bVar5, cf0, cf1) 반환. bVar5=적건물 5슬롯 중 사거리 도달자 존재. compFlag=위협그리드.
unsafe fn d19_gate1(p5: usize, p6: usize, p7: usize, g0: usize, nexus: usize,
                    other: usize, phase: i64, nxx: u64, nxy: u64) -> (bool, u8, u8) {
    D19_STAGE.store(50, Ordering::Relaxed);   // d19_gate1 진입(bVar5 루프 중)
    // ── bVar5: OTHER측 건물 5슬롯(g0+0x1e0+other*0x28+i*8) 순회 ──
    let mut bvar5 = false;
    for i in 0..5usize {
        let e = rd_u64(g0 + 0x1e0 + other * 0x28 + i * 8).unwrap_or(0) as usize;
        if e == 0 { continue; }
        if rd_i64(e + 0x68).unwrap_or(0) != 0xd { continue; }   // type==0xd (game은 longlong read)
        // 시야 확률술어(type==0xd만 호출=로컬RNG 브랜치): 기본 순수재현(검증됨), D19_G1_SHADOW ON=FUN_14237d910 shadow-call 롤백.
        let vis = if D19_G1_SHADOW.load(Ordering::Relaxed) { d19_g1_pred(p5, p6, e) } else { d19_g1_pred_pure(p5, p6, e) };
        if !vis { continue; }
        let st = rd_i64(e + 0x70).unwrap_or(0);                 // subtype
        let level = rd_i64(e + 0x5b0).unwrap_or(0);
        // subtype별 (desc, state guard). 기본desc(&DAT_14380d3f0=all0,[6]=-1)는 guard=-1=게임 abort-guard → skip.
        let (desc, guard): (usize, i32) = match st {
            6 => if level < 5 { (0, -1) } else { (e + 0x520, rd_i32(e + 0x550).unwrap_or(-1)) },
            5 => if level < 3 { (0, -1) } else { (e + 0x4e8, rd_i32(e + 0x518).unwrap_or(-1)) },
            4 => (e + 0x4b0, rd_i32(e + 0x4e0).unwrap_or(-1)),
            _ => continue,
        };
        if guard != 1 && guard != 2 { continue; }               // state∈{1,2}만 진행(기본desc -1 포함 skip)
        // ── reach(LAB_141c83a20): e.420 + desc[2] + (level-1)*desc[3] + getter(vt0x90) + wave_bonus + nexus_range ──
        let d2_desc = rd_i64(desc + 0x10).unwrap_or(0);         // desc[2]
        let d3_desc = rd_i64(desc + 0x18).unwrap_or(0);         // desc[3]
        let base420 = rd_i64(e + 0x420).unwrap_or(0);
        let getter_val: i64 = {                                 // *(desc[1]+0x90) 필드게터 → vt90_get(desc1, aligned) 순수화
            let desc1 = rd_u64(desc + 8).unwrap_or(0) as usize; // desc[1] vtable
            if ptr_ok(desc1) {
                let inner = rd_u64(desc1 + 0x10).unwrap_or(0) as usize;
                let dbuf = rd_u64(desc).unwrap_or(0) as usize;  // desc[0] buf
                let aligned = (inner.wrapping_sub(1) & !0xf).wrapping_add(dbuf).wrapping_add(0x10);
                vt90_get(desc1, aligned)
            } else { 0 }
        };
        let d6 = rd_i32(desc + 0x30).unwrap_or(0);              // (int)desc[6]==0 → wave bonus 가산
        let wave_bonus = if d6 == 0 {
            (rd_i32(e + 0x458).unwrap_or(0) as i64 + 100) * rd_i64(e + 0x668).unwrap_or(0) / 100
        } else { 0 };
        let nexus_range = (rd_i32(nexus + 0x458).unwrap_or(0) as i64 + 100)
                          * rd_i64(nexus + 0x668).unwrap_or(0) / 100;
        let reach = base420 + d2_desc + (level - 1).wrapping_mul(d3_desc) + getter_val + wave_bonus + nexus_range;
        let ex = rd_u64(e + 0x648).unwrap_or(0);
        let ey = rd_u64(e + 0x650).unwrap_or(0);
        if sqd(nxx, nxy, ex, ey) <= (reach.wrapping_mul(reach)) as u64 { bvar5 = true; break; }
    }
    D19_STAGE.store(51, Ordering::Relaxed);   // bVar5 루프 완료, compFlag 진입
    // ── compFlag: cellX/cellY = min(nexus/32000, 0x1d). phase<0x1d=정적(미도달) / >=0x1d=동적 shadow-call ──
    let cellx = (nxx / 32000).min(0x1d);
    let celly = (nxy / 32000).min(0x1d);
    let (cf0, cf1) = if phase < 0x1d {
        d19_g1_compflag_pre(p7, cellx, celly)
    } else {
        let (qx, qy) = (cellx * 32000 + 16000, celly * 32000 + 16000);
        // 기본=순수(d19_g1_compflag_pure). d19_g1cf_shadow=1이면 shadow(FUN_142090ec0) 롤백.
        let pure = !D19_G1CF_SHADOW.load(Ordering::Relaxed);
        let cmp = D19_G1CF_CMP.load(Ordering::Relaxed);
        if pure && !cmp {
            d19_g1_compflag_pure(p5, p6, nexus, other, qx, qy)
        } else {
            let sv = d19_g1_compflag_dyn(phase, p5, p6, qx, qy);
            if cmp {   // A/B 대조: 순수 vs shadow → bdcmp.txt 스타일(g1cfcmp.txt)
                let pv = d19_g1_compflag_pure(p5, p6, nexus, other, qx, qy);
                if pv == sv { G1CF_OK.fetch_add(1, Ordering::Relaxed); }
                else {
                    let n = G1CF_MM.fetch_add(1, Ordering::Relaxed);
                    if n < 80 {
                        if let Some(p) = pth("g1cfcmp.txt") {
                            if let Ok(mut f) = fs::OpenOptions::new().create(true).append(true).open(&p) {
                                let mut cats = String::new();
                                let no = G1CF_DBG[3].load(Ordering::Relaxed);
                                for i in 0..no.min(16) { cats.push_str(&format!("{},", G1CF_DBG[8 + i as usize].load(Ordering::Relaxed))); }
                                let _ = write!(f, "[g1cfMM #{}] phase={} pure=({},{}) shadow=({},{}) | de40cf0={} l2cf0={} cf1={} nobj={} na={} nb={} cat2[sel*1000+same*100+kt9={} nc/guard/n590={}] | objcats[{}] | slots(sv|uok|dist|side|geom|fcf|same|guard)[{} {} {} {} {}] tidx/other/gteam={}\n",
                                    n+1, phase, pv.0, pv.1, sv.0, sv.1,
                                    G1CF_DBG[0].load(Ordering::Relaxed), G1CF_DBG[1].load(Ordering::Relaxed), G1CF_DBG[2].load(Ordering::Relaxed),
                                    no, G1CF_DBG[4].load(Ordering::Relaxed), G1CF_DBG[5].load(Ordering::Relaxed),
                                    G1CF_DBG[6].load(Ordering::Relaxed), G1CF_DBG[7].load(Ordering::Relaxed), cats,
                                    G1CF_SLOT[0].load(Ordering::Relaxed), G1CF_SLOT[1].load(Ordering::Relaxed), G1CF_SLOT[2].load(Ordering::Relaxed), G1CF_SLOT[3].load(Ordering::Relaxed), G1CF_SLOT[4].load(Ordering::Relaxed), G1CF_SLOT[5].load(Ordering::Relaxed));
                            }
                        }
                    }
                }
                let (ok, mm) = (G1CF_OK.load(Ordering::Relaxed), G1CF_MM.load(Ordering::Relaxed));
                if (ok + mm) % 500 == 1 {
                    if let Some(p) = pth("g1cfcmp.txt") {
                        if let Ok(mut f) = fs::OpenOptions::new().create(true).append(true).open(&p) { let _ = write!(f, "[g1cf tally] OK={} MM={}\n", ok, mm); }
                    }
                }
                if pure { pv } else { sv }
            } else { sv }
        }
    };
    D19_STAGE.store(52, Ordering::Relaxed);   // d19_gate1 완료(정상 반환)
    (bvar5, cf0, cf1)
}


// ── my_disc19 본체: 전반A(nx resolve → 적건물 struct_threat → zone gate → tag3) + HP사다리 + 후반B 골격 ──
//   반환 = 최종 결정코드(3=후퇴 / 0x1d≤phase면 후반B rc). 실패 -9x는 대조로그용(계산불가).
//   out = 별도 scratch Vec(disc19_dcmp가 준비). p6_pair 레이아웃은 런타임 자동감지(문서 상충: §11.9.5 p6[0]=obj vs §11.9.3 p6[0][0]=obj).
unsafe fn my_disc19(out: usize, _p2: usize, p3_phase: usize, _p4: usize,
                    p5_sim: usize, p6_pair: usize, p7_zone: usize) -> i64 {
    D19_G2_THREAT.store(-1, Ordering::Relaxed);   // 계측: Gate2 미도달 sentinel(도달 시 아래에서 갱신). 로직 무영향.
    D19_G1_FIRED.store(0, Ordering::Relaxed);     // 계측: Gate1 미발화/미도달 리셋(도달·발화 시 아래 갱신). 로직 무영향.
    D19_G1_CF0.store(-1, Ordering::Relaxed); D19_G1_CF1.store(-1, Ordering::Relaxed); D19_G1_BV.store(-1, Ordering::Relaxed);
    D19_A4_F0.store(-1, Ordering::Relaxed); D19_A4_STRUCT.store(-1, Ordering::Relaxed);   // 계측: 전반A(4) 게이트 미도달 sentinel(도달 시 판정직전 갱신). 로직 무영향.
    D19_A4_F1.store(-1, Ordering::Relaxed); D19_A4_FIRED.store(0, Ordering::Relaxed);
    D19_BR_BASE.store(-1, Ordering::Relaxed); D19_BR_D2.store(-1, Ordering::Relaxed);   // 계측: 도달건물 reach 항별 미발화 sentinel. 로직 무영향.
    D19_BR_DESC2.store(-1, Ordering::Relaxed); D19_BR_DESC3.store(-1, Ordering::Relaxed); D19_BR_VT90.store(-1, Ordering::Relaxed);
    D19_BR_R.store(-1, Ordering::Relaxed); D19_BR_BK.store(-1, Ordering::Relaxed); D19_BR_BST.store(-1, Ordering::Relaxed); D19_BR_BID.store(-1, Ordering::Relaxed);
    D19_STAGE.store(1, Ordering::Relaxed);   // 진입
    if !ptr_ok(out) || !ptr_ok(p5_sim) || !ptr_ok(p6_pair) { return -99; }
    let side = rd_u64(p5_sim + 0x820).unwrap_or(2);
    if side > 1 { return -99; }
    let (side_u, other) = (side as usize, (1 - side) as usize);
    let self_h = rd_u64(p5_sim + 0x818).unwrap_or(0);
    // ── p6 레이아웃 자동감지: sim_obj = p6[0](직접) 또는 p6[0][0](이중deref). dd7_slot128이 유효 nx를 내는 쪽 채택. ──
    let cand_a = rd_u64(p6_pair).unwrap_or(0) as usize;
    let cand_b = if ptr_ok(cand_a) { rd_u64(cand_a).unwrap_or(0) as usize } else { 0 };
    let (sim_obj, nx, layout) =
        if ptr_ok(cand_a) && ptr_ok(dd7_slot128(cand_a, self_h)) { (cand_a, dd7_slot128(cand_a, self_h), 0u8) }
        else if ptr_ok(cand_b) && ptr_ok(dd7_slot128(cand_b, self_h)) { (cand_b, dd7_slot128(cand_b, self_h), 1u8) }
        else { D19_LAYOUT.store(0xff, Ordering::Relaxed); return -97; };   // 둘 다 실패 = 레이아웃 미해결
    D19_LAYOUT.store(layout, Ordering::Relaxed);
    D19_STAGE.store(2, Ordering::Relaxed);   // nx 해결
    // ★[2026-07-11] g0=SIMP fat(=cand_a, §11.9.3 "SIMP"). 적건물 슬롯·레인리스트는 g0 기준(gchild/sim_obj 아님 — disc17 검증패턴).
    //   geom_vt68/geom_resolve150은 gchild(sim_obj) 기준. geom2=p6[2]=커밋오더 박스.
    let g0 = cand_a;
    let geom2 = rd_u64(p6_pair + 0x10).unwrap_or(0) as usize;
    let phase = p3_phase as i64;
    let issuer = rd_i64(sim_obj + 0xeac0).unwrap_or(0) as u64;   // vt0x28 tick = *(sim_obj+0xeac0)
    let (nxx, nxy) = (rd_u64(nx + 0x648).unwrap_or(0), rd_u64(nx + 0x650).unwrap_or(0));

    // ── 전반A(2) 적건물 5슬롯 순회 → struct_threat: 시야(geom_vt68 순수) && kind(+0x68)==0xd && reach ──
    //   ★[2026-07-11 정정] 건물슬롯 base = g0(SIMP fat) — 구버전 sim_obj(gchild)는 잘못된 base(게이트 오판 일조).
    let mut struct_threat = false;
    for k in 0..5usize {
        let b = rd_u64(g0 + other * 0x28 + 0x1e0 + k * 8).unwrap_or(0) as usize;
        if !ptr_ok(b) { continue; }
        if rd_i32(b + 0x68).unwrap_or(0) != 0xd { continue; }
        let bid = rd_u64(b + 0x5a8).unwrap_or(0);
        if !geom_vt68(sim_obj, side_u, bid) { continue; }
        if d19_building_reaches(nx, b, p5_sim, p6_pair) { struct_threat = true; break; }   // p5/p6 = Gate1 bVar5의 d19_g1_pred 시야롤 인자
    }

    D19_STAGE.store(3, Ordering::Relaxed);   // struct_threat 루프 후
    // ── 전반A(3) 존조회: PHASE<0x1d → 7×7 그리드캐시 / ≥0x1d → shadow(TODO=0) ──
    let (mut flag0, mut flag1) = (false, false);
    if phase < 0x1d {
        if let Some((f0, f1)) = d19_zone_cache(p7_zone, nxx, nxy) { flag0 = f0; flag1 = f1; }
    } // else: TODO PHASE≥0x1d 동적zone(FUN_142090ec0/14209a750 §11.9.6) — 현재 flags=0

    // ── 계측(순수 관찰): 전반A(4) 조기후퇴 게이트 값 캡처(판정 직전). 발화 시 Gate1/Gate2보다 먼저 emit+return하므로
    //    여기서 잡지 않으면 g1/g2가 전부 sentinel로 남는다(glen>=3 vs mlen=1 홈복귀 실체). 아래 판정식 무변경. ──
    D19_A4_F0.store(flag0 as i64, Ordering::Relaxed);
    D19_A4_STRUCT.store(struct_threat as i64, Ordering::Relaxed);
    D19_A4_F1.store(flag1 as i64, Ordering::Relaxed);
    D19_A4_FIRED.store((flag0 || struct_threat || flag1) as i64, Ordering::Relaxed);
    // ── 전반A(4) 게이트: flag0||struct_threat||flag1 → tag3 후퇴 후 return ──
    if flag0 || struct_threat || flag1 { d19_emit_retreat(out, side_u, issuer); return 3; }

    D19_STAGE.store(4, Ordering::Relaxed);   // zone/A4 게이트 후
    // ── 전반A 끝: PHASE≤0x1d → 후반B(tag5) / else → Gate1 → Gate2(조기 홈복귀) ──
    if phase <= 0x1d { D19_STAGE.store(10, Ordering::Relaxed); return d19_phase_b(out, sim_obj, g0, geom2, nx, side_u, issuer, phase, p6_pair); }
    D19_STAGE.store(5, Ordering::Relaxed);   // phase>0x1d, Gate1 전

    // ── Gate1(FUN_141c83700 bVar5+compFlag, Gate2보다 먼저): cf0||bVar5||cf1 → tag3 홈복귀 1개만(glen=1). ──
    //   cfg d19gate1 격리(기본 OFF=현행 완전보존, 회귀0 유지). 켤 때만 shadow-call 3종 발화(AV+재sim오염 위험 상위세션 검증).
    if D19_GATE1.load(Ordering::Relaxed) {
        let (bv, cf0, cf1) = d19_gate1(p5_sim, p6_pair, p7_zone, g0, nx, other, phase, nxx, nxy);
        D19_G1_BV.store(bv as i64, Ordering::Relaxed);
        D19_G1_CF0.store(cf0 as i64, Ordering::Relaxed);
        D19_G1_CF1.store(cf1 as i64, Ordering::Relaxed);
        D19_G1_FIRED.store((cf0 != 0 || bv || cf1 != 0) as i64, Ordering::Relaxed);   // 계측: 판정 직전 gd1 확정(발화 케이스도 값 남김). 로직 무영향.
        if cf0 != 0 || bv || cf1 != 0 {
            d19_emit_retreat(out, side_u, issuer);   // glen=1 tag3 홈복귀(Gate2 HOME emit과 동일 계약)
            return 3;
        }
    }

    // ── Gate2(조기 홈복귀, PHASE>0x1d, FUN_141c83700 확정계약) ────────────────────────────────
    //   위협이 확실히 심각하면(!go_detailed) 커밋오더/레인 tag5를 전부 스킵하고 tag3 홈복귀 1개만 발행(glen=1).
    //   sev 임계표·go_detailed 상수(0x31/0x42/0x1d/0x29/0x11/0x1a/9/0x2d) = ghidra 확정치 → 결정론 게이트.
    //   ★threat = 기존 d19_threat(FUN_1420a3fd0). **순수 결정론 재현은 스킬 raw데미지 leaf(unit+0x480+0x28)+vt0x90
    //     쿨다운이 shadow-only(스킬DB 규모 deferred 대형과제)라 미완** → 기본 shadow-OFF=threat0 → sev0 → go_detailed=true
    //     → tag5(정상케이스 완전보존, 회귀0). d19thr=1일 때만 실threat로 Gate2 발화(대조용). cvar7=disc17_pred(FUN_141c8fd60).
    //   ★hp_pct·tr = *(nx+0x658)curHP / *(nx+0x610)분모. 연산순서·sev 로직은 FUN_141c83700 계약대로.
    D19_STAGE.store(6, Ordering::Relaxed);   // Gate1 통과, Gate2 진입
    let b = rd_i64(nx + 0x658).unwrap_or(0);                                    // curHP
    let a = rd_i64(nx + 0x610).unwrap_or(0);                                    // maxHP 분모(0→1)
    let hp_pct = b.wrapping_mul(100) / if a == 0 { 1 } else { a };
    let threat = d19_threat(phase, p6_pair, nx, nxx, nxy);
    D19_STAGE.store(7, Ordering::Relaxed);   // threat 계산 후
    // sev 임계표(전부 확정 상수): threat==0→0(정상경로 보존) / threat>=b→threat / else 비율게이트.
    let sev = if threat == 0 {
        0
    } else if threat >= b {
        threat
    } else {
        let tr = threat.wrapping_mul(100) / if b == 0 { 1 } else { b };
        if tr > 0x31 || (hp_pct < 0x42 && tr > 0x1d) || (hp_pct < 0x29 && tr > 0x11) || (hp_pct < 0x1a && tr > 9) {
            threat
        } else {
            0
        }
    };
    // cvar7: PHASE≥0x27일 때만. FUN_141c8fd60 실측계약 = ally넥서스(g0[self+0x2e]) HP%>0x32면 0, 아니면 disc17_pred.
    //   ★[2026-07-11] ally-HP 선게이트 추가(규명 §4). 누락시 disc17_pred=1이 go_detailed=true로 오판 → glen=1 미발화 16건.
    let cvar7 = if phase >= 0x27 {
        let ally = rd_u64(g0 + 0x170 + side_u * 8).unwrap_or(0) as usize;
        let ally_max = rd_i64(ally + 0x610).unwrap_or(0);
        let ally_pct = rd_i64(ally + 0x658).unwrap_or(0).wrapping_mul(100) / if ally_max == 0 { 1 } else { ally_max };
        if ally_pct > 0x32 {
            0
        } else {
            let gvt = rd_u64(g0 + 8).unwrap_or(0) as usize;
            if disc17_pred(sim_obj, gvt, g0, geom2, p5_sim) { 1i64 } else { 0 }
        }
    } else {
        0
    };
    D19_STAGE.store(8, Ordering::Relaxed);   // cvar7 후, go_detailed 계산 전
    let go_detailed = sev == 0 || (sev < b && (hp_pct > D19_RETREAT_HP.load(Ordering::Relaxed) || cvar7 != 0));   // ★[07-12] 0x2d(45)→cfg d19_retreat_hp. 높이면 수비적(높은 HP에도 후퇴)
    // ── 계측(순수 관찰): Gate2 계산값 캡처. dcmp가 마지막호출 값을 대조라인에 append. 아래 로직 무영향. ──
    D19_G2_THREAT.store(threat, Ordering::Relaxed);
    D19_G2_B.store(b, Ordering::Relaxed);
    D19_G2_HP.store(hp_pct, Ordering::Relaxed);
    D19_G2_SEV.store(sev, Ordering::Relaxed);
    D19_G2_CV.store(cvar7, Ordering::Relaxed);
    D19_G2_GD.store(go_detailed as i64, Ordering::Relaxed);
    D19_G2_PHASE.store(phase, Ordering::Relaxed);
    if !go_detailed {
        // HOME: tag3 홈복귀 1개만 발행(tag5 전부 스킵)하고 조기 종료. 좌표·필드 = d19_emit_retreat(확정).
        d19_emit_retreat(out, side_u, issuer);
        return 3;
    }
    // go_detailed → 기존 tag5 경로(커밋오더/레인/tag3) 그대로.
    d19_phase_b(out, sim_obj, g0, geom2, nx, side_u, issuer, phase, p6_pair)
}

unsafe fn d19_scratch() -> usize {
    D19_SCRATCH_TL.with(|c| {
        let cur = c.get();
        if cur != 0 { return cur; }
        let p = VirtualAlloc(0, D19_SCRATCH_SZ, 0x1000 | 0x2000, 0x04);   // MEM_COMMIT|RESERVE, PAGE_READWRITE
        if p != 0 { c.set(p); }
        p
    })
}

// ★[07-15 shape-aware] Command 레코드는 tag별로 앞필드 의미가 다름:
//   shape-A(능력, tag 0xf/0x10/0x11): +0x00=issuer(tick 소값), +0x08=target(char_id), +0x10 최하위바이트=flag.
//     ⚠ game은 능력 emit 시 +0x00/+0x08/+0x10 low만 쓰고 +0x10 상위·+0x18은 **Vec 재사용 잔재(비결정 garbage)** 그대로 둠.
//       (raw cap 실측: 동일레코드의 서로 다른 target 능력 2건이 +0x10/+0x18에 **같은 포인터**를 공유·상위 0xff.. 노출 = 미초기화 확정.)
//     ⇒ 여기서 +0x10 상위/+0x18을 마크에 넣으면 garbage 대조로 tag·target 일치 능력까지 XX로 오판(559건). 진짜 축 = (tag,issuer,target,flag).
//   shape-B(이동/후퇴, tag 2/3/5): 앞필드가 game=공유컨텍스트 포인터 vs mine=좌표라 **표현차**(구조 자체 상이) — 기존 동작 유지(2차 이슈).
// 반환 = (tag, mark_f8, mark_f10, disp_f18). 능력은 mark에 target·flag(low byte)만, issuer는 disp_f18(비마크·표시전용)로 실어 garbage 제거.
#[inline] unsafe fn d19_cmd_rd(buf: usize, i: usize, len: u64) -> (u8, u64, u64, u64) {
    if !ptr_ok(buf) || (i as u64) >= len { return (0xff, 0, 0, 0); }
    let e = buf + i * D19_STRIDE;
    let tag = rd_u8(e + 0x4f9);   // ★0.5.1 tag +0x4f9(was +0x4f1)
    if tag == 0xf || tag == 0x10 || tag == 0x11 {
        let target = rd_u64(e + 8).unwrap_or(0);              // +0x08 target id
        let flag = rd_u64(e + 0x10).unwrap_or(0) & 0xff;      // +0x10 최하위바이트만(상위=game 미초기화 잔재)
        let issuer = rd_u64(e).unwrap_or(0);                  // +0x00 issuer(tick) — 표시전용(마크 제외)
        return (tag, target, flag, issuer);
    }
    (tag, rd_u64(e + 8).unwrap_or(0), rd_u64(e + 0x10).unwrap_or(0), rd_u64(e + 0x18).unwrap_or(0))
}

// ★★[2026-07-14] 본문 전체를 catch_unwind로 감쌈(CLAUDE.md §3).
//   구조: 구버전은 my_disc19만 catch_unwind했고 **scratch 셋업·game 대조·format!·파일쓰기는 밖**이었음 →
//   거기서 panic 나면 디투어의 `extern "C"` 경계를 넘어 **abort(__fastfail)** → UEF(crash_install) 우회 → crash_log 없이 즉사.
//   (07-14 크래시: crash_log 없음 + disc19 재현부 rc=3만 = 이 경로와 부합.) 이제 어떤 panic도 여기서 흡수.
unsafe fn disc19_dcmp(sret: usize, p2: usize, p3: usize, p4: usize, p5: usize, p6: usize, p7: usize) {
    let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
        disc19_dcmp_inner(sret, p2, p3, p4, p5, p6, p7)
    }));
}

unsafe fn disc19_dcmp_inner(sret: usize, p2: usize, p3: usize, p4: usize, p5: usize, p6: usize, p7: usize) {
    if !DISC1819_CAP.load(Ordering::Relaxed) { return; }
    let n = D19_CMP_N.fetch_add(1, Ordering::Relaxed) + 1;
    if n % 200 != 1 { return; }   // 200회당 1회 샘플(관측부담 억제)
    let scratch = d19_scratch();
    if scratch == 0 { return; }
    // scratch Vec<Command> 헤더 세팅 + 버퍼 전체 0클리어(비교필드 잔재 제거).
    let buf = scratch + 0x20;
    core::ptr::write_bytes(buf as *mut u8, 0, 16 * D19_STRIDE);
    wr_u64(scratch, buf as u64);
    wr_u64(scratch + 8, 0);
    wr_u64(scratch + 0x10, 16);
    wr_u64(scratch + 0x18, 0);
    let rc = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| my_disc19(scratch, p2, p3, p4, p5, p6, p7)))
        .unwrap_or(-98);
    let g_buf = rd_u64(sret).unwrap_or(0) as usize;
    let g_len = rd_u64(sret + 0x18).unwrap_or(0).min(16);
    let m_len = rd_u64(scratch + 0x18).unwrap_or(0).min(16);
    if !D19_CMP_INIT.swap(true, Ordering::Relaxed) {
        if let Some(p) = pth("disc19cmp.txt") { let _ = fs::write(p, "=== disc19 game vs my_disc19 대조 (관찰단계: 전반A+tag3+후반B골격) ===\n=== rc: -97=p6레이아웃미해결 -98=panic -99=입력무효 / lay: 0=p6[0]=obj 1=p6[0][0]=obj ===\n"); }
    }
    let lay = D19_LAYOUT.load(Ordering::Relaxed);
    let mut s = format!("[d19cmp #{}] phase={:#x} rc={} stage={} lay={} glen={} mlen={} len{}",
        n, p3, rc, D19_STAGE.load(Ordering::Relaxed), lay, g_len, m_len, if g_len == m_len { "==" } else { "!!" });
    let show = g_len.max(m_len).min(24);
    for i in 0..show as usize {
        let (gt, gf8, gf10, gf18) = d19_cmd_rd(g_buf, i, g_len);
        let (mt, mf8, mf10, mf18) = d19_cmd_rd(buf, i, m_len);
        let mark = if gt == mt && gf8 == mf8 && gf10 == mf10 { "==" } else { "XX" };
        s.push_str(&format!(" |[{}]g(t{:#x} {:#x}/{:#x}/{:#x}) m(t{:#x} {:#x}/{:#x}/{:#x}){}",
            i, gt, gf8, gf10, gf18, mt, mf8, mf10, mf18, mark));
    }
    // ── Gate2 계측값 append(마지막 my_disc19 호출이 static에 저장한 값). thr/b/sev=16진, hp/cv/gd=10진. thr=-1(0x..ff)=Gate2 미도달. ──
    s.push_str(&format!(" |g2[thr={:#x} b={:#x} hp={} sev={:#x} cv={} gd={}]",
        D19_G2_THREAT.load(Ordering::Relaxed), D19_G2_B.load(Ordering::Relaxed),
        D19_G2_HP.load(Ordering::Relaxed), D19_G2_SEV.load(Ordering::Relaxed),
        D19_G2_CV.load(Ordering::Relaxed), D19_G2_GD.load(Ordering::Relaxed)));
    // ── Gate1 계측값 append(cf/bv= -1=게이트OFF/미도달, gd1=Gate1 발화=glen1 홈복귀). Gate1 발화 케이스 분석용. ──
    s.push_str(&format!(" |g1[cf0={} cf1={} bv={} gd1={}]",
        D19_G1_CF0.load(Ordering::Relaxed), D19_G1_CF1.load(Ordering::Relaxed),
        D19_G1_BV.load(Ordering::Relaxed), D19_G1_FIRED.load(Ordering::Relaxed)));
    // ── 전반A(4) 조기후퇴 게이트 계측(f/st= -1=미도달, fired=발화→glen1 홈복귀). Gate1/Gate2보다 앞선 홈복귀 케이스 분석용. ──
    s.push_str(&format!(" |a4[f0={} st={} f1={} fired={}]",
        D19_A4_F0.load(Ordering::Relaxed), D19_A4_STRUCT.load(Ordering::Relaxed),
        D19_A4_F1.load(Ordering::Relaxed), D19_A4_FIRED.load(Ordering::Relaxed)));
    // ── d19_building_reaches 항별 계측(struct_threat 유발 건물). 전부 -1(0x..ff)=미발화. R=base+desc2+desc3+vt90, 도달=d²<=R². 원인항 특정용. ──
    s.push_str(&format!(" |br[base={:#x} d2={:#x} desc2={:#x} desc3={:#x} vt90={:#x} rb={:#x} R={:#x} bk={:#x} bst={:#x} bid={:#x}]",
        D19_BR_BASE.load(Ordering::Relaxed), D19_BR_D2.load(Ordering::Relaxed),
        D19_BR_DESC2.load(Ordering::Relaxed), D19_BR_DESC3.load(Ordering::Relaxed),
        D19_BR_VT90.load(Ordering::Relaxed), D19_BR_BASE.load(Ordering::Relaxed),
        D19_BR_R.load(Ordering::Relaxed), D19_BR_BK.load(Ordering::Relaxed),
        D19_BR_BST.load(Ordering::Relaxed), D19_BR_BID.load(Ordering::Relaxed)));
    // ★[07-15] cand_main slot0 진단: id(gate/inr) — g=존재게이트 통과, r=in_range 통과. game 0xf 놓친 타겟이 여기 있으면 in_range탈락, 없으면 membership탈락.
    { let cn = D19_CMDBG_N.load(Ordering::Relaxed).min(12);
      s.push_str(" |cm[");
      for i in 0..cn { let v = D19_CMDBG[i].load(Ordering::Relaxed);
        s.push_str(&format!("{:#x}{}{} ", v & 0xffff, if v&(1<<16)!=0 {"g"} else {"-"}, if v&(1<<17)!=0 {"r"} else {"-"})); }
      s.push(']'); }
    // ★raw 5슬롯 로스터: id(탈락사유). rej 0=수락 1=tag 2=null 3=시야 4=6a0 5=688. game 놓친 타겟이 여기 없으면 로스터 자체에 없음(다른소스).
    { s.push_str(" |rost[");
      for i in 0..5 { let v = D19_RAWROST[i].load(Ordering::Relaxed);
        s.push_str(&format!("{:#x}.{} ", v >> 8, v & 0xff)); }
      s.push(']'); }
    // ★1차 concat3 slot0: id.code (0=emit0xf 1=dist 2=team 3=usable0 4=inrange).
    { let cn = D19_C1DBG_N.load(Ordering::Relaxed).min(128);
      s.push_str(" |c1[");
      for i in 0..cn { let v = D19_C1DBG[i].load(Ordering::Relaxed);
        s.push_str(&format!("{:#x}.{} ", v >> 8, v & 0xff)); }
      s.push(']'); }
    // ★방어리스트(FUN_142376f00): id.code (0=emit≥1슬롯 1=invisible 2=defflag 3=team 4=dist 5=슬롯전부게이트). 놓친 0x1ec류가 여기 뜨는지.
    { let cn = D19_DEFDBG_N.load(Ordering::Relaxed).min(32);
      s.push_str(" |def[");
      for i in 0..cn { let v = D19_DEFDBG[i].load(Ordering::Relaxed);
        s.push_str(&format!("{:#x}.{} ", v >> 8, v & 0xff)); }
      s.push(']'); }
    // ★Path B 최근접구조물: m=리스트수 best=구조물id gate비트(b0 best!=0/b1 4a8/b2 sinr/b3 unitinr/b4 !dive/b5 usable0/b6 hp>thr). best=0xfffe=best_s없음/4a8탈락.
    s.push_str(&format!(" |pb[m={} best={:#x} g={:#09b}]",
        D19_PB_M.load(Ordering::Relaxed), D19_PB_BEST.load(Ordering::Relaxed), D19_PB_GATE.load(Ordering::Relaxed)));
    s.push_str(&format!(" |us1f={} us1cd[base={} div={} q={} cd={} rva={:#x}]",
        D19_US1_FAIL.load(Ordering::Relaxed), D19_US1_BASE.load(Ordering::Relaxed), D19_US1_DIV.load(Ordering::Relaxed),
        D19_US1_Q.load(Ordering::Relaxed), D19_US1_CD.load(Ordering::Relaxed) as i64, D19_US1_SLOTRVA.load(Ordering::Relaxed)));
    s.push_str(&format!(" |us2f={} us2cd[base={} div={} q={} cd={} lvl={} rva={:#x}]",
        D19_US2_FAIL.load(Ordering::Relaxed), D19_US2_BASE.load(Ordering::Relaxed), D19_US2_DIV.load(Ordering::Relaxed),
        D19_US2_Q.load(Ordering::Relaxed), D19_US2_CD.load(Ordering::Relaxed) as i64, D19_US2_LVL.load(Ordering::Relaxed), D19_US2_SLOTRVA.load(Ordering::Relaxed)));
    s.push_str(&format!(" |s1br[id={:#x} R={} Rsq={} d2={} gap={}]",
        D19_S1BR_ID.load(Ordering::Relaxed), D19_S1BR_R.load(Ordering::Relaxed), D19_S1BR_RSQ.load(Ordering::Relaxed),
        D19_S1BR_D2.load(Ordering::Relaxed), D19_S1BR_D2.load(Ordering::Relaxed) as i64 - D19_S1BR_RSQ.load(Ordering::Relaxed) as i64));
    { let cn = D19_S2DBG_N.load(Ordering::Relaxed).min(12);
      s.push_str(" |s2[");
      for i in 0..cn { let v = D19_S2DBG[i].load(Ordering::Relaxed);
        let (id, code) = ((v >> 8) & 0xffff, v & 0xff);
        if code == 2 { s.push_str(&format!("{:#x}.2(sel{} tk{} sm{}) ", id, (v>>24)&0xf, (v>>28)&0xf, (v>>32)&1)); }
        else { s.push_str(&format!("{:#x}.{} ", id, code)); } }
      s.push(']'); }
    // ★2차 slot1(0x10) 게이트: id.code (0=emit 1=존재 2=tv(sel/tk/sm) 3=inr 4=score)
    { let cn = D19_S1DBG_N.load(Ordering::Relaxed).min(12);
      s.push_str(" |s1[");
      for i in 0..cn { let v = D19_S1DBG[i].load(Ordering::Relaxed);
        let (id, code) = ((v >> 8) & 0xffff, v & 0xff);
        if code == 2 { s.push_str(&format!("{:#x}.2(sel{} tk{} sm{}) ", id, (v>>24)&0xf, (v>>28)&0xf, (v>>32)&1)); }
        else { s.push_str(&format!("{:#x}.{} ", id, code)); } }
      s.push(']'); }
    // ★1차 slot1(0x10)·slot2(0x11) 게이트: id.code (0=emit 1=slotvalid 2=usable 3=tv 4=inr)
    { let cn = D19_C1S1_N.load(Ordering::Relaxed).min(24);
      s.push_str(" |1s1[");
      for i in 0..cn { let v = D19_C1S1[i].load(Ordering::Relaxed); s.push_str(&format!("{:#x}.{} ", v >> 8, v & 0xff)); }
      s.push(']'); }
    { let cn = D19_C1S2_N.load(Ordering::Relaxed).min(24);
      s.push_str(" |1s2[");
      for i in 0..cn { let v = D19_C1S2[i].load(Ordering::Relaxed); s.push_str(&format!("{:#x}.{} ", v >> 8, v & 0xff)); }
      s.push(']'); }
    s.push('\n');
    if let Some(p) = pth("disc19cmp.txt") { if let Ok(mut f) = fs::OpenOptions::new().create(true).append(true).open(&p) { let _ = write!(f, "{}", s); } }
}


// ════════════════════════════════════════════════════════════════════════════════════════════════
// disc18(AttackNexus) 완전재현 Phase2-2 골격 — my_disc18 (Phase1 in_range + Phase2 zone + Decision A + else tag5/tag3) + dcmp
//   근거: §11.9.2(제어흐름 A~E·필드맵 D·구조체 C)·§11.9.11(콜리 5종·게이트·band·zone Decision A 디스어셈).
//   ★관찰/대조 전용. game sret 훼손 금지 → out=disc18_dcmp가 넘기는 별도 scratch. RNG-free(전역 sim-rng 미소비).
//   ★재사용(disc19 검증완): d19_emit_retreat(tag3, 필드바이트 동일)·d19_emit_tag5·d19_emit_abil·vt90_get·geom_vt68·dd7_slot128.
//   TODO(골격 잔여, 인게임 dcmp로 보정): ① Phase1 reach의 actor 바인딩·subtype sight항·시야게이트 ② band≥0x1d 동적zone(142090ec0)
//     ③ 적넥서스 핸들 해석(핸들 vs 직접ptr) ④ else 능력블록 Phase3(14236ddf0)·142376f00·Phase4(14237ed50 safe_to_dive) 실발행.
// ════════════════════════════════════════════════════════════════════════════════════════════════
// 방어미티게이션 항: ((e+0x458+100)*e+0x668)/100 (§11.9.2 C·E reach식 공통).
#[inline] unsafe fn d18_mit(e: usize) -> i64 {
    (rd_i64(e + 0x458).unwrap_or(0) + 100).wrapping_mul(rd_i64(e + 0x668).unwrap_or(0)) / 100
}

// disc18 전용 zone 7×7 캐시(§11.9.11-6): self셀=coord/32000 먼저 clamp(≤0x1d) → origin(p7+0x1320/0x1328) 빼고 +3 윈도우 clamp[0,6].
//   ★disc19 d19_zone_cache와 인덱싱 다름(그건 origin-relative를 나중 나눔) → 별도 구현. flag0=rec+0x28, flag1=rec+0x29.
unsafe fn d18_zone_cache(p7: usize, sx: u64, sy: u64) -> Option<(bool, bool)> {
    if !ptr_ok(p7) { return None; }
    let self_col = (sx / 32000).min(0x1d) as i64;
    let self_row = (sy / 32000).min(0x1d) as i64;
    let ox = rd_u64(p7 + 0x1320).unwrap_or(0) as i64;
    let oy = rd_u64(p7 + 0x1328).unwrap_or(0) as i64;
    let row_idx = (self_col - ox + 3).clamp(0, 6) as usize;   // rowIdx = selfCol(x) − p7[0x1320] + 3
    let col_idx = (self_row - oy + 3).clamp(0, 6) as usize;   // colIdx = selfRow(y) − p7[0x1328] + 3
    let rec = p7 + 0x9f0 + row_idx * 0x150 + col_idx * 0x30;  // 레코드 48B(row stride 0x150 / col 0x30)
    Some((rd_u8(rec + 0x28) != 0, rd_u8(rec + 0x29) != 0))
}

// 적 핵심구조물 g가 actor 사거리 안? (§11.9.2 E reach_test 공통식). ★TODO(bit-exact): actor 바인딩·subtype별 sight항(g+0x628*0x1e)·시야게이트.
//   reach = g+0x420 + desc[2] + (lvl-1)*desc[3] + vt0x90(desc,g) + mit(actor) + mit(g). d²(actor,g) <= reach².
unsafe fn d18_struct_reaches(actor: usize, g: usize) -> bool {
    if !ptr_ok(actor) || !ptr_ok(g) { return false; }
    let (gx, gy) = (rd_u64(g + 0x648).unwrap_or(0), rd_u64(g + 0x650).unwrap_or(0));
    let (ax, ay) = (rd_u64(actor + 0x648).unwrap_or(0), rd_u64(actor + 0x650).unwrap_or(0));
    let d2 = sqd(gx, gy, ax, ay);
    let base420 = rd_i64(g + 0x420).unwrap_or(0);
    let level = rd_i64(g + 0x5b0).unwrap_or(0);
    // subtype(+0x70)별 desc 선택 + state guard(1|2) = d19_building_reaches 동일 규약(§11.9.2 C).
    let (desc, guard): (usize, i32) = match rd_i64(g + 0x70).unwrap_or(0) {
        6 => if level < 5 { (0, -1) } else { (g + 0x520, rd_i32(g + 0x550).unwrap_or(-1)) },
        5 => if level < 3 { (0, -1) } else { (g + 0x4e8, rd_i32(g + 0x518).unwrap_or(-1)) },
        4 => (g + 0x4b0, rd_i32(g + 0x4e0).unwrap_or(-1)),
        _ => (0, -1),
    };
    if guard != 1 && guard != 2 { return false; }
    let d2_desc = rd_i64(desc + 0x10).unwrap_or(0);
    let d3_desc = rd_i64(desc + 0x18).unwrap_or(0);
    let vt90 = {
        let desc1 = rd_u64(desc + 8).unwrap_or(0) as usize;
        if ptr_ok(desc1) {
            let inner = rd_u64(desc1 + 0x10).unwrap_or(0) as usize;
            let dbuf = rd_u64(desc).unwrap_or(0) as usize;
            let aligned = (inner.wrapping_sub(1) & !0xf).wrapping_add(dbuf).wrapping_add(0x10);
            vt90_get(desc1, aligned)
        } else { 0 }
    };
    let reach = base420 + d2_desc + (level - 1).wrapping_mul(d3_desc) + vt90 + d18_mit(actor) + d18_mit(g);
    let r = reach.max(0) as u128;
    (d2 as u128) <= r.wrapping_mul(r)
}

// ── my_disc18 본체(골격): Phase1 in_range + Phase2 zone + Decision A(tag3) + else(tag5 poke + tag3) ──
unsafe fn my_disc18(out: usize, _p2: usize, p3_band: usize, _p4: usize,
                    p5_sim: usize, p6_pair: usize, p7_zone: usize) -> i64 {
    D18_INRANGE.store(-1, Ordering::Relaxed); D18_F0.store(-1, Ordering::Relaxed);
    D18_F1.store(-1, Ordering::Relaxed); D18_BAND.store(-1, Ordering::Relaxed);
    if !ptr_ok(out) || !ptr_ok(p5_sim) || !ptr_ok(p6_pair) { return -99; }
    let side = rd_u64(p5_sim + 0x820).unwrap_or(2);
    if side > 1 { return -99; }
    let (side_u, other) = (side as usize, (1 - side) as usize);
    let self_h = rd_u64(p5_sim + 0x818).unwrap_or(0);
    // p6 레이아웃 자동감지(my_disc19 동일): sim_obj = p6[0] 또는 p6[0][0]. dd7_slot128이 유효 nx 내는 쪽.
    let cand_a = rd_u64(p6_pair).unwrap_or(0) as usize;
    let cand_b = if ptr_ok(cand_a) { rd_u64(cand_a).unwrap_or(0) as usize } else { 0 };
    let (sim_obj, nx, layout) =
        if ptr_ok(cand_a) && ptr_ok(dd7_slot128(cand_a, self_h)) { (cand_a, dd7_slot128(cand_a, self_h), 0u8) }
        else if ptr_ok(cand_b) && ptr_ok(dd7_slot128(cand_b, self_h)) { (cand_b, dd7_slot128(cand_b, self_h), 1u8) }
        else { D18_LAYOUT.store(0xff, Ordering::Relaxed); return -97; };
    D18_LAYOUT.store(layout, Ordering::Relaxed);
    let g0 = cand_a;
    let band = p3_band as i64;
    D18_BAND.store(band, Ordering::Relaxed);
    let issuer = rd_i64(sim_obj + 0xeac0).unwrap_or(0) as u64;   // vt0x28 tick = *(sim_obj+0xeac0)
    let (nxx, nxy) = (rd_u64(nx + 0x648).unwrap_or(0), rd_u64(nx + 0x650).unwrap_or(0));

    // ── Phase1: 적 핵심구조물 5슬롯(g0+other*0x28+0x1e0+k*8) → 시야(geom_vt68) && kind(+0x68)==0xd && reach → in_range ──
    let mut in_range = false;
    for k in 0..5usize {
        let g = rd_u64(g0 + other * 0x28 + 0x1e0 + k * 8).unwrap_or(0) as usize;
        if !ptr_ok(g) { continue; }
        if rd_i32(g + 0x68).unwrap_or(0) != 0xd { continue; }
        let gid = rd_u64(g + 0x5a8).unwrap_or(0);
        if !geom_vt68(sim_obj, side_u, gid) { continue; }
        if d18_struct_reaches(nx, g) { in_range = true; break; }   // ★TODO: actor=nx 가정(dcmp로 self vs nexus 보정)
    }
    D18_INRANGE.store(in_range as i64, Ordering::Relaxed);

    // ── Phase2: self-셀 zone 조회. band<0x1d → geom 7×7 캐시 / else → TODO 동적 142090ec0(현재 flags=0) ──
    let (mut flag0, mut flag1) = (false, false);
    if band < 0x1d {
        if let Some((f0, f1)) = d18_zone_cache(p7_zone, nxx, nxy) { flag0 = f0; flag1 = f1; }   // ★TODO: self좌표 vs nexus좌표 보정
    } // else: TODO band≥0x1d 동적 zone(FUN_142090ec0/14209a750 §11.9.6)
    D18_F0.store(flag0 as i64, Ordering::Relaxed);
    D18_F1.store(flag1 as i64, Ordering::Relaxed);

    // ── Decision A(§11.9.11-6): flag0 || in_range || flag1 → tag3 넥서스진격 1개 push하고 return ──
    //   필드바이트 = 홈좌표 이동과 동일(side0→(0x7d00,0xe2900)) → d19_emit_retreat 재사용(§11.9.2 D tag3).
    if flag0 || in_range || flag1 {
        d19_emit_retreat(out, side_u, issuer);
        return 3;
    }

    // ── Else(벽막힘): tag5 poke(적넥서스) + tag3 이동. 능력블록(Phase3/4)은 cfg d18abil 게이트(기본 OFF=골격 미발행). ──
    //   적넥서스 = resolver +(other+0x2e)*8 슬롯(§11.9.2 C "+enemy_side+0x2e qword = 적nexus 핸들"). ★TODO: 핸들 vs 직접ptr dcmp 확인.
    let enx = rd_u64(g0 + (other + 0x2e) * 8).unwrap_or(0) as usize;
    if ptr_ok(enx) {
        let enid = rd_u64(enx + 0x5a8).unwrap_or(0);
        let (ex, ey) = (rd_u64(enx + 0x648).unwrap_or(0), rd_u64(enx + 0x650).unwrap_or(0));
        d19_emit_tag5(out, issuer, enid, ex, ey);   // §11.9.2 D tag5: f8=nexus_id, f10/f18=넥서스좌표, +0x4b0=80000
    }
    d19_emit_retreat(out, side_u, issuer);           // §11.9.2 D tag3 이동(넥서스진격)

    if D18_ABIL.load(Ordering::Relaxed) {
        // ── TODO(골격 미발행): Phase3 다이브방어 slot0/1/2(usable fbe670/fce700/fbe950 + valid fcf860 + reach) ──
        //   + 142376f00(클린 emitter, 반경 80000) + Phase4 아군보호 skill0(게이트 band<0xd||hppct>0x37||!safe_to_dive[14237ed50]).
        //   14236ddf0 내부게이트 3종(1423802d0/14236f530/1421283d0)·142376f00·14237ed50 = §11.9.11 규명완. 실발행+dcmp 보정 예정.
    }
    5
}


// ── dcmp: my_disc18를 별도 scratch Vec에 계산 → game sret와 대조 → disc18cmp.txt 직접write(LOG_ON 무관, disc19_dcmp 미러) ──
// ★[2026-07-14] d19_scratch와 동일하게 thread_local화(구: 전역 D18_SCRATCH 공유 = 레이스).
unsafe fn d18_scratch() -> usize {
    D18_SCRATCH_TL.with(|c| {
        let cur = c.get();
        if cur != 0 { return cur; }
        let p = VirtualAlloc(0, D19_SCRATCH_SZ, 0x1000 | 0x2000, 0x04);
        if p != 0 { c.set(p); }
        p
    })
}

// ★[2026-07-14] disc19_dcmp와 동일하게 본문 전체 catch_unwind(abort 경로 봉쇄).
unsafe fn disc18_dcmp(sret: usize, p2: usize, p3: usize, p4: usize, p5: usize, p6: usize, p7: usize) {
    let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
        disc18_dcmp_inner(sret, p2, p3, p4, p5, p6, p7)
    }));
}

unsafe fn disc18_dcmp_inner(sret: usize, p2: usize, p3: usize, p4: usize, p5: usize, p6: usize, p7: usize) {
    if !DISC1819_CAP.load(Ordering::Relaxed) { return; }
    let n = D18_CMP_N.fetch_add(1, Ordering::Relaxed) + 1;
    if n % 200 != 1 { return; }
    let scratch = d18_scratch();
    if scratch == 0 { return; }
    let buf = scratch + 0x20;
    core::ptr::write_bytes(buf as *mut u8, 0, 16 * D19_STRIDE);
    wr_u64(scratch, buf as u64);
    wr_u64(scratch + 8, 0);
    wr_u64(scratch + 0x10, 16);
    wr_u64(scratch + 0x18, 0);
    let rc = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| my_disc18(scratch, p2, p3, p4, p5, p6, p7)))
        .unwrap_or(-98);
    let g_buf = rd_u64(sret).unwrap_or(0) as usize;
    let g_len = rd_u64(sret + 0x18).unwrap_or(0).min(16);
    let m_len = rd_u64(scratch + 0x18).unwrap_or(0).min(16);
    if !D18_CMP_INIT.swap(true, Ordering::Relaxed) {
        if let Some(p) = pth("disc18cmp.txt") { let _ = fs::write(p, "=== disc18 game vs my_disc18 대조 (골격: Phase1 in_range + zone + Decision A + else tag5/tag3) ===\n=== rc: -97=p6미해결 -98=panic -99=입력무효 / 5=else경로 3=DecisionA ===\n"); }
    }
    let lay = D18_LAYOUT.load(Ordering::Relaxed);
    let mut s = format!("[d18cmp #{}] band={:#x} rc={} lay={} glen={} mlen={} len{}",
        n, p3, rc, lay, g_len, m_len, if g_len == m_len { "==" } else { "!!" });
    let show = g_len.max(m_len).min(8);
    for i in 0..show as usize {
        let (gt, gf8, gf10, gf18) = d19_cmd_rd(g_buf, i, g_len);
        let (mt, mf8, mf10, mf18) = d19_cmd_rd(buf, i, m_len);
        let mark = if gt == mt && gf8 == mf8 && gf10 == mf10 { "==" } else { "XX" };
        s.push_str(&format!(" |[{}]g(t{:#x} {:#x}/{:#x}/{:#x}) m(t{:#x} {:#x}/{:#x}/{:#x}){}",
            i, gt, gf8, gf10, gf18, mt, mf8, mf10, mf18, mark));
    }
    s.push_str(&format!(" |ph1[inr={} f0={} f1={} band={}]",
        D18_INRANGE.load(Ordering::Relaxed), D18_F0.load(Ordering::Relaxed),
        D18_F1.load(Ordering::Relaxed), D18_BAND.load(Ordering::Relaxed)));
    s.push('\n');
    if let Some(p) = pth("disc18cmp.txt") { if let Ok(mut f) = fs::OpenOptions::new().create(true).append(true).open(&p) { let _ = write!(f, "{}", s); } }
}

// vt0x68 재현 (게임 RVA 0x20aacd0): now-visible. key(적 id) L3 resolve → entity[0x38+side*0x18]==0 이면 visible(true).
#[inline] unsafe fn geom_vt68(gc: usize, side: usize, key: u64) -> bool {
    if key < rd_u64(gc+0x740).unwrap_or(0) {
        let t3 = rd_u64(gc+0x738).unwrap_or(0) as usize;
        if ptr_ok(t3) && rd_i32(t3 + (key as usize)*0x10).unwrap_or(0) == 1 {
            let u = rd_u64(t3 + (key as usize)*0x10 + 8).unwrap_or(0);
            if u < rd_u64(gc+0x728).unwrap_or(0) && side < 2 {
                let e = (u as usize)*0x6a8 + rd_u64(gc+0x720).unwrap_or(0) as usize;
                return rd_u64(e + 0x38 + side*0x18).unwrap_or(1) == 0;   // side0=+0x38, side1=+0x50
            }
        }
    }
    false
}

// ════ disc16(실명 SerpenHunt — 구라벨 AttackNexus, §11.8; 진짜 AttackNexus=disc18 disp3 0x141c81980 미대체) idx14 인라인, 콜리 0개, RNG-free 재현. 출력{7, 0x12, 2}. 07-10 정밀RE. ════
//   시그(param): sim=param5(엔티티, 우리 r14), geom=param6(컨텍스트, 우리 r15), subplan=param2(idx14=add rdx,8 안함→raw subp).
//   self=vt0x138(gchild, sim+0x818). box=*(geom[1]+0x20)+0x6d70+side*0x20 {xmin,ymin@8,xmax@0x10,ymax@0x18}.
unsafe fn my_disc16(out: usize, sim: usize, geom: usize, subplan: usize) -> i64 {
    let g0 = rd_u64(geom).unwrap_or(0) as usize;
    if !ptr_ok(g0) { return -99; }
    let gchild = rd_u64(g0).unwrap_or(0) as usize;
    let gvt = rd_u64(g0 + 8).unwrap_or(0) as usize;
    if !ptr_ok(gchild) || !ptr_ok(gvt) { return -99; }
    let side = rd_u64(sim + 0x820).unwrap_or(2);
    if side > 1 { return -99; }
    let s = side as usize;
    let selfe = dd7_slot128(gchild, rd_u64(sim + 0x818).unwrap_or(0));
    if !ptr_ok(selfe) { return -99; }
    let m0 = rd_u64(rd_u64(geom + 8).unwrap_or(0) as usize + 0x20).unwrap_or(0) as usize;
    if !ptr_ok(m0) { return -99; }
    let r0 = m0 + 0x6d70 + s * 0x20;
    let (sx, sy) = (rd_u64(selfe + 0x648).unwrap_or(0), rd_u64(selfe + 0x650).unwrap_or(0));
    let inside = sx >= rd_u64(r0).unwrap_or(u64::MAX) && sx <= rd_u64(r0 + 0x10).unwrap_or(0)
        && sy >= rd_u64(r0 + 8).unwrap_or(u64::MAX) && sy <= rd_u64(r0 + 0x18).unwrap_or(0);
    if inside && rd_i64(selfe + 0x658).unwrap_or(0) < rd_i64(selfe + 0x610).unwrap_or(1) {
        wr_u64(out, 7); return 7;
    }
    if rd_u64(g0 + (1 - s) * 0x20 + 0x148).unwrap_or(1) == 0 {
        wr_u64(out, 0x12); return 0x12;
    }
    wr_u64(out, 2); wr_u8(out + 8, 0); wr_u8(out + 9, rd_u8(subplan + 0x10)); wr_u8(out + 0xa, 2);
    2
}

// FUN_141c8fd60 근접 위협 predicate 재현(1차; 2차 FUN_142076da0 병합은 미구현 — DIFF시 추가).
unsafe fn disc17_pred(gchild: usize, gvt: usize, g0: usize, geom2: usize, sim: usize) -> bool {
    let side = rd_u64(sim + 0x820).unwrap_or(2);
    if side > 1 { return false; }
    let s = side as usize;
    let refp = rd_u64(g0 + s * 8 + 0x170).unwrap_or(0) as usize;
    if !ptr_ok(refp) { return false; }
    let (rx, ry) = (rd_u64(refp + 0x648).unwrap_or(0), rd_u64(refp + 0x650).unwrap_or(0));
    let tick = rd_i64(gchild + 0xeac0).unwrap_or(0);
    for k in 0..5usize {
        let e = rd_u64(g0 + (1 - s) * 0x28 + 0x1e0 + k * 8).unwrap_or(0) as usize;
        if e == 0 { continue; }
        let h = rd_u64(e + 0x5a8).unwrap_or(0);
        let r = dd7_slot_a8(gchild, h);
        let ok = geom_vt68(gchild, s, h);
        let pass = ok || (r != 0 && {
            let rlane = rd_u32(r + 0x8b0) as usize;
            let box2 = geom2 + (1 - s) * 0x2e8 + 0x1e0 + rlane * 8;
            tick <= rd_i64(box2 + 0x78).unwrap_or(i64::MAX)
        });
        if pass && sqd(rd_u64(e + 0x648).unwrap_or(0), rd_u64(e + 0x650).unwrap_or(0), rx, ry) < (tune("disc17_pred_dist", 0xd693a4001) as u64) {
            return true;
        }
    }
    // ★2차 병합경로(07-10 완전RE, 1차 OR): FUN_142076da0=opp side 3리스트 concat3 순차스캔. elem+0x68==1 && +0x88==1 && +0x90==ref_id → true. dedup/RNG無.
    let ref_id = rd_i64(refp + 0x5a8).unwrap_or(0);
    let base = (1 - s) * 0x20;
    for &(bo, co) in &[(0x10usize, 0x28usize), (0x50, 0x68), (0x90, 0xa8)] {
        let begin = rd_u64(g0 + base + bo).unwrap_or(0) as usize;
        let cnt = rd_i64(g0 + base + co).unwrap_or(0);
        if begin == 0 || cnt <= 0 || cnt > 4096 { continue; }
        for i in 0..cnt as usize {
            let e = rd_u64(begin + i * 8).unwrap_or(0) as usize;
            if e != 0 && rd_i32(e + 0x68).unwrap_or(0) == 1 && rd_i32(e + 0x88).unwrap_or(0) == 1 && rd_i64(e + 0x90).unwrap_or(0) == ref_id {
                return true;
            }
        }
    }
    false
}

// ════ disc17(실명 SerpenPoke — 구라벨 "넥서스 근접전", §11.8) 핸들러 0x141c77f20 재현. 출력{7,0x13} code-only, RNG-free. ════
unsafe fn my_disc17(out: usize, _subplan: usize, param3: u64, sim: usize, geom: usize) -> i64 {
    let g0 = rd_u64(geom).unwrap_or(0) as usize;
    let geom1 = rd_u64(geom + 8).unwrap_or(0) as usize;
    let geom2 = rd_u64(geom + 0x10).unwrap_or(0) as usize;
    if !ptr_ok(g0) || !ptr_ok(geom1) || !ptr_ok(geom2) { return -99; }
    let gchild = rd_u64(g0).unwrap_or(0) as usize;
    let gvt = rd_u64(g0 + 8).unwrap_or(0) as usize;
    if !ptr_ok(gchild) || !ptr_ok(gvt) { return -99; }
    let side = rd_u64(sim + 0x820).unwrap_or(2);
    if side > 1 { return -99; }
    let s = side as usize;
    let tgt = dd7_slot128(gchild, rd_u64(sim + 0x818).unwrap_or(0));
    if !ptr_ok(tgt) { return -99; }
    let num = rd_i64(tgt + 0x658).unwrap_or(0);
    let denom = rd_i64(tgt + 0x610).unwrap_or(0);
    if denom == 0 { return -99; }   // 게임 panic 경로
    let progress = num.wrapping_mul(100) / denom;
    // 팀박스 inbox
    let m0 = rd_u64(geom1 + 0x20).unwrap_or(0) as usize;
    let r0 = m0 + 0x6d70 + s * 0x20;
    let (tx, ty) = (rd_u64(tgt + 0x648).unwrap_or(0), rd_u64(tgt + 0x650).unwrap_or(0));
    let inbox = tx >= rd_u64(r0).unwrap_or(u64::MAX) && tx <= rd_u64(r0 + 0x10).unwrap_or(0)
        && ty >= rd_u64(r0 + 8).unwrap_or(u64::MAX) && ty <= rd_u64(r0 + 0x18).unwrap_or(0);
    let refp = rd_u64(g0 + s * 8 + 0x170).unwrap_or(0) as usize;
    if !ptr_ok(refp) { return -99; }   // 게임 panic 경로
    let (rx, ry) = (rd_u64(refp + 0x648).unwrap_or(0), rd_u64(refp + 0x650).unwrap_or(0));
    // 역할 near-flag 3개 (enemy_struct = geom2+(1-side)*0x2e8 의 3슬롯)
    let es = geom2 + (1 - s) * 0x2e8;
    let near_flag = |active: bool, handle: u64| -> bool {
        if !active { return false; }
        let e = geom_resolve150(gchild, handle);
        e != 0 && sqd(rd_u64(e + 0x648).unwrap_or(0), rd_u64(e + 0x650).unwrap_or(0), rx, ry) < (tune("disc17_near_dist", 0x35a4e9001) as u64)
    };
    let near = [
        near_flag(rd_u8(es) != 0, rd_u64(es + 8).unwrap_or(0)),
        near_flag(rd_u32(es + 0x28) == 1, rd_u64(es + 0x30).unwrap_or(0)),
        near_flag(rd_u32(es + 0x50) == 1, rd_u64(es + 0x58).unwrap_or(0)),
    ];
    let strat = (rd_u8(geom1 + 0x38) as usize).min(5);
    let role_ok = DISC17_PAT[strat].iter().all(|&j| near[j as usize]);
    // region_near: 적 5슬롯 중 ref 근처 존재
    let mut region_near = false;
    for k in 0..5usize {
        let e = rd_u64(g0 + (1 - s) * 0x28 + 0x1e0 + k * 8).unwrap_or(0) as usize;
        if e != 0 && sqd(rd_u64(e + 0x648).unwrap_or(0), rd_u64(e + 0x650).unwrap_or(0), rx, ry) < (tune("disc17_near_dist", 0x35a4e9001) as u64) { region_near = true; break; }
    }
    let p3big = param3 > (tune("disc17_p3_gate", 0x26) as u64);
    // early13: param3>0x26 && ref풀피<=50% && predicate
    if p3big {
        let rd = rd_i64(refp + 0x610).unwrap_or(1).max(1);
        let refprog = rd_i64(refp + 0x658).unwrap_or(0).wrapping_mul(100) / rd;
        if refprog <= tune("disc17_ref_hp", 50) && disc17_pred(gchild, gvt, g0, geom2, sim) { wr_u64(out, 0x13); return 0x13; }
    }
    let mut threat = role_ok && region_near;
    if p3big { threat = threat || disc17_pred(gchild, gvt, g0, geom2, sim); }
    let code: i64 = if threat {
        if progress < tune("disc17_prog_crit", 21) && !inbox { 7 } else { 0x13 }
    } else if progress < tune("disc17_prog_low", 31) {
        7
    } else if num < denom && inbox {
        7
    } else {
        0x13
    };
    wr_u64(out, code as u64);
    code
}

// ════ disc15(실명 SerpenCheck, §11.8) idx13 핸들러 FUN_14235d230 재현. 출력{7, 0xB, 0x10}, RNG-소비(serpen_rng_pick). 07-10 정밀RE(★표본 미발화=검증불가, disasm 정적완결). ════
//   시그: (out, mem=subp+8, param3, rng, sim=param5=r14, geom=param6=r15, tp=param7). 구조물 시즈-공략 커밋(engage/retreat/hold).
//   판단: self(vt0x138)=팀존박스(disc16 동일)·HP비율·타깃유효구조물·시간창 종합. 콜리 FUN_141fe2500=serpen_rng_pick(disc12서 규명, 재사용).
unsafe fn my_disc15(out: usize, mem: usize, _param3: u64, rng: usize, sim: usize, geom: usize, tp: usize) -> i64 {
    let g0 = rd_u64(geom).unwrap_or(0) as usize;
    let geom1 = rd_u64(geom + 8).unwrap_or(0) as usize;
    if !ptr_ok(g0) || !ptr_ok(geom1) { return -99; }
    let gchild = rd_u64(g0).unwrap_or(0) as usize;
    let gvt = rd_u64(g0 + 8).unwrap_or(0) as usize;
    if !ptr_ok(gchild) || !ptr_ok(gvt) { return -99; }
    let side = rd_u64(sim + 0x820).unwrap_or(2);
    if side > 1 { return -99; }
    let s = side as usize;
    let selfe = dd7_slot128(gchild, rd_u64(sim + 0x818).unwrap_or(0));
    if !ptr_ok(selfe) { return -99; }
    let tgt_flag = rd_u8(mem) != 0;                                  // *(param_2) 타깃 유효플래그(payload)
    // ★target = self 현재 커밋 타깃(vt0x30 comp의 +0x1d8 존재체크 → +0x1d0 핸들ptr의ptr → vt0x150). payload+8 아님(07-10 재RE 정정).
    let comp = (gchild + 0xeaf0);   // vt0x30(obj) RDX = 현재 오더/커맨드 컴포넌트
    let target = if ptr_ok(comp) && rd_u64(comp + 0x1d8).unwrap_or(0) != 0 {
        let hp = rd_u64(comp + 0x1d0).unwrap_or(0) as usize;
        if ptr_ok(hp) { geom_resolve150(gchild, rd_u64(hp).unwrap_or(0)) } else { 0 }
    } else { 0 };
    // self 팀존박스(*(geom[1]+0x20)+0x6d70+side*0x20 {xmin,ymin@8,xmax@0x10,ymax@0x18})
    let m0 = rd_u64(geom1 + 0x20).unwrap_or(0) as usize;
    let r0 = m0 + 0x6d70 + s * 0x20;
    let (sx, sy) = (rd_u64(selfe + 0x648).unwrap_or(0), rd_u64(selfe + 0x650).unwrap_or(0));
    let inside = sx >= rd_u64(r0).unwrap_or(u64::MAX) && sx <= rd_u64(r0 + 0x10).unwrap_or(0)
        && sy >= rd_u64(r0 + 8).unwrap_or(u64::MAX) && sy <= rd_u64(r0 + 0x18).unwrap_or(0);
    let self_max = rd_i64(selfe + 0x610).unwrap_or(1).max(1);
    let self_cur = rd_i64(selfe + 0x658).unwrap_or(0);
    let hp_pct = self_cur.wrapping_mul(100) / self_max;
    // 후보(유효 구조물) = serpen_rng_pick discriminant(FUN_141fe2500, RNG는 후보>0시 콜리서 소비)
    let cand = serpen_rng_pick(rng, sim, geom1, false);   // ★live=false=tag만(disc15 자체 RNG경로, 이 task 범위 밖)
    // ★결정트리(07-10 완전재RE): engage(공격) → code 7 = target!=0 && target풀 && (self부상&박스내 || HP%<51 || 후보존재). else → time-window(0xB/0x10).
    let engage = ptr_ok(target)
        && rd_i64(target + 0x658).unwrap_or(0) == rd_i64(target + 0x610).unwrap_or(1)   // target full HP
        && ((self_cur < self_max && inside) || hp_pct < tune("d15_engage_hp_pct", 51) || cand != 0);
    if engage { wr_u64(out, 7); return 7; }
    // time-window: (start[tp+0xd0]+dur > cur[tp+0xd8]) && payload유효 → 0xB(타깃실음) / else 0x10(retreat). dur=*(*(geom[1]+8)+0x12f8).
    let dur = rd_i64(rd_u64(geom1 + 8).unwrap_or(0) as usize + 0x12f8).unwrap_or(0);
    if rd_i64(tp + 0xd0).unwrap_or(0).wrapping_add(dur) > rd_i64(tp + 0xd8).unwrap_or(0) && tgt_flag {
        wr_u64(out, 0xb); wr_u64(out + 8, rd_u64(mem + 8).unwrap_or(0)); wr_u8(out + 0x10, 1); wr_u8(out + 0x11, 0); wr_u8(out + 0x12, 0);   // out+0x10(u16)=1
        0xb
    } else {
        wr_u8(out + 8, 0); wr_u64(out, 0x10); 0x10
    }
}

// ════ disc13 (idx11 핸들러 FUN_1422d6d30, AttackNexus) 재현. 출력{7, 0xb, 0xd}, RNG-소비(serpen_rng_pick). 07-10 완전RE(★구 재현{7,0x11,2} 폐기·전면교체). ════
//   disc15와 동종(self·vt0x30 comp target·팀존박스·HP%·picker·engage→7). 차이: target=comp+0x1a8/0x1a0(단일 deref), fallback 0xb/0xd(val>thr 게이트).
//   시그: (out, mem=subp+8, param3, rng, sim=param5=r14, geom=param6=r15, ctx=param7=p7p).
unsafe fn my_disc13(out: usize, mem: usize, _param3: u64, rng: usize, sim: usize, geom: usize, ctx: usize) -> i64 {
    let g0 = rd_u64(geom).unwrap_or(0) as usize;
    let geom1 = rd_u64(geom + 8).unwrap_or(0) as usize;
    if !ptr_ok(g0) || !ptr_ok(geom1) { return -99; }
    let gchild = rd_u64(g0).unwrap_or(0) as usize;
    let gvt = rd_u64(g0 + 8).unwrap_or(0) as usize;
    if !ptr_ok(gchild) || !ptr_ok(gvt) { return -99; }
    let side = rd_u64(sim + 0x820).unwrap_or(2);
    if side > 1 { return -99; }
    let s = side as usize;
    let selfe = dd7_slot128(gchild, rd_u64(sim + 0x818).unwrap_or(0));
    if !ptr_ok(selfe) { return -99; }
    let self_max = rd_i64(selfe + 0x610).unwrap_or(1).max(1);
    let self_cur = rd_i64(selfe + 0x658).unwrap_or(0);
    let hp_pct = self_cur.wrapping_mul(100) / self_max;
    // target = comp(+0x1a8 존재) → vt0x150(*(comp+0x1a0)) 단일 deref (disc15는 +0x1d8/이중)
    let comp = (gchild + 0xeaf0);
    let target = if ptr_ok(comp) && rd_u64(comp + 0x1a8).unwrap_or(0) != 0 {
        geom_resolve150(gchild, rd_u64(comp + 0x1a0).unwrap_or(0))
    } else { 0 };
    // 팀존박스(disc15 동일)
    let m0 = rd_u64(geom1 + 0x20).unwrap_or(0) as usize;
    let r0 = m0 + 0x6d70 + s * 0x20;
    let (sx, sy) = (rd_u64(selfe + 0x648).unwrap_or(0), rd_u64(selfe + 0x650).unwrap_or(0));
    let inside = sx >= rd_u64(r0).unwrap_or(u64::MAX) && sx <= rd_u64(r0 + 0x10).unwrap_or(0)
        && sy >= rd_u64(r0 + 8).unwrap_or(u64::MAX) && sy <= rd_u64(r0 + 0x18).unwrap_or(0);
    let pick = serpen_rng_pick(rng, sim, geom1, false);   // ★live=false=tag만(disc13 자체 RNG경로, 이 task 범위 밖)
    // engage(공격) → code 7: target!=0 && target풀 && (self부상&박스내 || HP%<51 || 후보존재)
    let engage = ptr_ok(target)
        && rd_i64(target + 0x658).unwrap_or(0) == rd_i64(target + 0x610).unwrap_or(1)
        && ((self_cur < self_max && inside) || hp_pct < tune("d13_engage_hp_pct", 51) || pick != 0);
    if engage { wr_u64(out, 7); return 7; }
    // fallback: val=*(*(geom[1]+8)+0x12f8)+*(ctx+0x98) > thr=*(ctx+0xa0) && payload유효 → 0xb / else 0xd
    let val = rd_i64(rd_u64(geom1 + 8).unwrap_or(0) as usize + 0x12f8).unwrap_or(0).wrapping_add(rd_i64(ctx + 0x98).unwrap_or(0));
    let thr = rd_i64(ctx + 0xa0).unwrap_or(0);
    if val > thr && rd_u8(mem) != 0 {
        wr_u64(out, 0xb); wr_u64(out + 8, rd_u64(mem + 8).unwrap_or(0)); wr_u8(out + 0x10, 1); wr_u8(out + 0x11, 0); wr_u8(out + 0x12, 0);
        0xb
    } else {
        wr_u8(out + 8, 0); wr_u64(out, 0xd); 0xd
    }
}

unsafe fn disc7_threat_dps(e: usize, se: usize, world: usize, exe: usize) -> i64 {
    if rd_i32(e + 0x4a8).unwrap_or(-1) == -1 { return 0; }   // [e+0x4a8]==-1 → 기여 0
    let (b0, b1) = probe_basedmg_r9(e, world, exe, exe + RVA_DISC7_DMG_SHEET);   // Arc payload base쌍(vt+0x28, 다형 shadow-call — c8c520과 동급)
    let dmg = if b0 > 0 || b1 > 0 {
        let dt = rd_i32(e + 0x4a4).unwrap_or(0);
        serpen_dmg_core(e, se, b0.max(0), dt, 0) + serpen_dmg_core(e, se, b1.max(0), dt, 1)   // kind 0/1 2회 합(atk=e, tgt=self)
    } else { 0 };
    if dmg == 0 { return 0; }
    let per_eff = ((c8c_cast_get(e + 0x558, 0x90) as i64) * 100 / (rd_i32(e + 0x3e4).unwrap_or(0) as i64 + 100).max(1)).max(3);
    dmg * 1000 / per_eff.max(1)
}

// ════ disc7(Recall) 리졸버 FUN_141f37130 (0.5.0_3 RVA 0x1f37130) 완전재현. 출력 {7,8}. RNG-free. (2026-07-11 ghidra-re §12.22) ════
//   r15=ctxpair(sp6, [0]=resolver{gchild,vt}/[8]=world), r14=gholder(sp5, +0x818 self핸들/+0x820 side), payload=subp+8(디스패처 idx5 add rdx,8).
//   조건체인: ①zone-box early-7 ②웨이포인트 근접→위협 vec ΣDPS→TTD>TH→8 ③r12b 자힐 ④스캔2매치→스캔3 TTD판정 / 부재→hp% 임계(r12b?21:41).
//   ⬜부분: r12b 스킬힐 Arc-vt+0x30/0x40(다형 shadow·sret 구조)은 미구현 — 현재 r12b=리젠(self+0x3d8>0)만. 힐스킬 자힐 챔프는 놓칠 수 있음(disc7=캡처 전용이라 게임 무영향, 완성도 항).
//   self/entity resolve=vt_call2(검증된 vt0x138/0x150 슬롯 유지) — 라이브 배선 시 dd7_slot128/geom_resolve150 raw화 예정.
unsafe fn my_disc7(r15: usize, r14: usize, subp: usize) -> i64 {
    let exe = exe_base();
    let payload = subp + 8;
    let p48 = rd_u64(payload + 0x48).unwrap_or(0);
    let role = rd_u8(payload + 0x60) as usize;
    let g0 = rd_u64(r15).unwrap_or(0) as usize;             // ctxpair[0] = resolver obj
    if !ptr_ok(g0) { return 8; }
    let gchild = rd_u64(g0).unwrap_or(0) as usize;          // resolver[0] = data(gchild)
    let rvt = rd_u64(g0 + 8).unwrap_or(0) as usize;         // resolver[8] = vtable
    let world = rd_u64(r15 + 8).unwrap_or(0) as usize;      // ctxpair[8] = world
    if !ptr_ok(gchild) || !ptr_ok(rvt) || !ptr_ok(world) { return 8; }
    let self_h = rd_u64(r14 + 0x818).unwrap_or(0);
    let side = rd_u64(r14 + 0x820).unwrap_or(2) as usize;
    let se = vt_call2(rvt, 0x138, gchild, self_h as usize);
    if !ptr_ok(se) { return 8; }
    let maxhp = rd_i64(se + 0x610).unwrap_or(1).max(1);
    let hp = rd_i64(se + 0x658).unwrap_or(0);
    let (sx, sy) = (rd_u64(se + 0x648).unwrap_or(0), rd_u64(se + 0x650).unwrap_or(0));
    let g2 = rd_u64(world + 0x20).unwrap_or(0) as usize;
    // ① zone-box early-7 (자기팀 박스 g2+side*0x20+0x6d70..0x6d88 안 && hp<max → 7)
    if side < 2 && ptr_ok(g2) {
        let bx = g2 + side * 0x20 + 0x6d70;
        let (xmn, ymn, xmx, ymx) = (rd_u64(bx).unwrap_or(1), rd_u64(bx+8).unwrap_or(1), rd_u64(bx+0x10).unwrap_or(0), rd_u64(bx+0x18).unwrap_or(0));
        if sx >= xmn && sx <= xmx && sy >= ymn && sy <= ymx && hp < maxhp { return 7; }
    }
    let w8 = rd_u64(world + 8).unwrap_or(0) as usize;
    let th = if ptr_ok(w8) { rd_i64(w8 + 0x12f8).unwrap_or(i64::MAX) } else { i64::MAX };
    // 위협 vec 선택(gchild+0xeaf0 테이블, stride 0x30, idx=role0..3(P48≠0→+4)/role4→8/role5→9)
    let vidx = match role { 0..=3 => if p48 != 0 { role + 4 } else { role }, 4 => 8, 5 => 9, _ => role };
    let vent = gchild + 0xeaf0 + vidx * 0x30;
    let vptr = rd_u64(vent + 0x20).unwrap_or(0) as usize;
    let vlen = (rd_u64(vent + 0x28).unwrap_or(0) as usize).min(256);
    // ② 웨이포인트 근접(g2+0x68/+0x70 배열 stride 0x28, tag@+0x20==role 첫매치, P48로 (x0,y0)/(x1,y1) 선택)
    let (mut dx, mut dy) = (0u64, 0u64);
    if ptr_ok(g2) {
        let wp = rd_u64(g2 + 0x68).unwrap_or(0) as usize;
        let wl = (rd_u64(g2 + 0x70).unwrap_or(0) as usize).min(256);
        if wp != 0 {
            for i in 0..wl {
                let w = wp + i * 0x28;
                if rd_u8(w + 0x20) as usize == role {
                    if p48 == 0 { dx = rd_u64(w).unwrap_or(0); dy = rd_u64(w+8).unwrap_or(0); }
                    else { dx = rd_u64(w+0x10).unwrap_or(0); dy = rd_u64(w+0x18).unwrap_or(0); }
                    break;
                }
            }
        }
    }
    if sqd(sx, sy, dx, dy) <= tune("d7_wp_dist2", 0x35a4e9000) as u64 {   // ★튜닝: 웨이포인트 근접 거리²(120000²)
        let mut sumdps = 0i64;
        if vptr != 0 {
            for i in 0..vlen {
                let e = vt_call2(rvt, 0x150, gchild, rd_u64(vptr + i*8).unwrap_or(0) as usize);
                if ptr_ok(e) { sumdps += disc7_threat_dps(e, se, world, exe); }
            }
        }
        let ttd = if sumdps == 0 { i64::MAX } else { hp * 1000 / sumdps };
        if ttd > th { return 8; }
    }
    // ③ r12b 자힐(⬜리젠만·스킬힐 TODO) → ④ 스캔2(vec 중 [e+0x68]==4&&[e+0x88]==1&&[e+0x90]==self_id)
    let r12b = rd_i32(se + 0x3d8).unwrap_or(0) > 0;
    let self_id = rd_u64(se + 0x5a8).unwrap_or(0);
    let mut scan2 = false;
    if vptr != 0 {
        for i in 0..vlen {
            let e = vt_call2(rvt, 0x150, gchild, rd_u64(vptr + i*8).unwrap_or(0) as usize);
            if ptr_ok(e) && rd_i32(e+0x68).unwrap_or(-1) == 4 && rd_i32(e+0x88).unwrap_or(-1) == 1 && rd_u64(e+0x90).unwrap_or(0) == self_id { scan2 = true; break; }
        }
    }
    if scan2 {
        // 스캔3: 전 원소 DPS 합산 → TTD
        let mut sumdps = 0i64;
        if vptr != 0 {
            for i in 0..vlen {
                let e = vt_call2(rvt, 0x150, gchild, rd_u64(vptr + i*8).unwrap_or(0) as usize);
                if ptr_ok(e) { sumdps += disc7_threat_dps(e, se, world, exe); }
            }
        }
        if hp * 1000 / sumdps.max(1) > th { 8 } else { 7 }
    } else {
        // hp% 판정: 임계 = r12b ? 21 : 41 (★튜닝: 낮을수록 저체력에도 안 빠짐)
        let thr = if r12b { tune("d7_hp_selfheal", 0x15) } else { tune("d7_hp_normal", 0x29) };
        if hp.wrapping_mul(100) / maxhp >= thr { 8 } else { 7 }
    }
}
