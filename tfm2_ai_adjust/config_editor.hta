<!doctype html>
<html>
<head>
<meta http-equiv="x-ua-compatible" content="IE=edge">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>tfm2_ai_adjust 설정 편집기</title>
<hta:application id="app" applicationname="tfm2_ai_adjust 설정 편집기"
  border="thin" caption="yes" maximizebutton="yes" minimizebutton="yes"
  scroll="yes" singleinstance="yes" windowstate="maximize" />
<style>
  body{margin:0;background:#13151a;color:#e6e9ef;font:14px/1.55 "Segoe UI","Malgun Gothic",sans-serif}
  a{color:#5b9dff}
  #hdr{background:#1c1f27;border-bottom:1px solid #333947;padding:10px 16px}
  #hdr h1{display:inline-block;font-size:16px;margin:0 14px 0 0;vertical-align:middle}
  #hdr .right{float:right}
  #hdr:after{content:"";display:block;clear:both}
  .stat{display:inline-block;font-size:12px;padding:2px 9px;border-radius:20px;background:#2a2f3a;color:#9aa3b2;vertical-align:middle;margin-right:6px}
  button{background:#232732;color:#e6e9ef;border:1px solid #333947;border-radius:7px;padding:7px 12px;cursor:pointer;font-size:13px;margin-left:5px}
  button:hover{border-color:#5b9dff}
  button.primary{background:#3a6fd8;border-color:#3a6fd8;color:#fff}
  button.warn{border-color:#f0a020;color:#f0a020}
  select.top{background:#232732;border:1px solid #333947;border-radius:6px;color:#e6e9ef;padding:6px 8px;min-width:200px;vertical-align:middle}
  #nav{float:left;width:210px;background:#1c1f27;border-right:1px solid #333947;padding:8px 6px}
  #nav .cat{color:#9aa3b2;font-size:11px;margin:8px 6px 4px}
  #nav button{display:block;width:100%;text-align:left;margin:3px 0;border-color:transparent;background:transparent}
  #nav button.active{background:#232732;border-color:#333947;color:#5b9dff}
  #main{margin-left:210px;padding:16px 22px}
  .tabnote{background:#1c1f27;border:1px solid #333947;border-left:3px solid #5b9dff;border-radius:7px;padding:11px 15px;margin-bottom:14px;color:#9aa3b2;font-size:13px;line-height:1.75}
  .tabnote b{color:#e6e9ef}
  .tabnote code{background:#232732;color:#ffd479;padding:1px 5px;border-radius:4px;font-family:Consolas,monospace;font-size:12px}
  table.fields{width:100%;border-collapse:collapse}
  table.fields td{padding:8px 10px;border-bottom:1px solid #21252e;vertical-align:middle}
  td.k{width:210px;font-family:Consolas,monospace;font-weight:bold;font-size:13px}
  td.k small{display:block;color:#9aa3b2;font-weight:normal;font-family:"Segoe UI";margin-top:2px}
  td.ctrl{width:175px}
  td.desc{color:#9aa3b2;font-size:12.5px;line-height:1.5}
  tr.changed td{background:#1a2030}
  tr.changed td.k{color:#5b9dff}
  tr.added td.k{color:#48c78e}
  .newbadge{display:inline-block;background:#48c78e;color:#06231a;font-size:9px;font-weight:bold;padding:1px 5px;border-radius:8px;margin-left:6px;vertical-align:middle}
  tr.sect td{background:#171b24;color:#cdd3df;font-size:12.5px;font-weight:bold;padding:12px 10px 5px;border-bottom:1px solid #2a3140;letter-spacing:.3px}
  input.txt{width:158px;background:#232732;border:1px solid #333947;color:#e6e9ef;padding:5px 8px;font-family:Consolas,monospace}
  td.ctrl select{background:#232732;border:1px solid #333947;color:#e6e9ef;padding:5px}
  .tg{font-family:Consolas;color:#9aa3b2;font-size:12px;margin-left:6px}
  #toast{position:fixed;bottom:18px;right:18px;background:#48c78e;color:#06231a;padding:9px 18px;border-radius:8px;font-weight:bold;display:none;max-width:400px}
  #toast.err{background:#f0a020;color:#3a2600}
</style>
</head>
<body>
<div id="hdr">
  <h1>tfm2_ai_adjust 설정 편집기</h1>
  <span id="changed" class="stat">변경 0</span>
  <span class="right">
    <select id="cfgSel" class="top" title="config 폴더의 설정 파일"></select>
    <button id="loadBtn">📂 불러오기</button>
    <button id="saveAsBtn">➕ config에 저장…</button>
    <button id="resetBtn" class="warn">↺ 초기화</button>
    <button id="applyBtn" class="primary">💾 게임에 적용</button>
  </span>
</div>
<div id="nav"></div>
<div id="main"></div>
<div id="toast"></div>

<script type="text/javascript">
/* ===================== 파일 I/O (FSO + ADODB.Stream, UTF-8 BOM없음) ===================== */
var fso = new ActiveXObject("Scripting.FileSystemObject");
function htaFolder(){
  var p = location.pathname;
  try { p = decodeURIComponent(p); } catch(e){}
  p = p.replace(/^\//,"").replace(/\//g,"\\");
  return fso.GetParentFolderName(p);
}
var FOLDER      = htaFolder();
var ACTIVE_PATH = FOLDER + "\\tfm2_ai_adjust.cfg";
var CFG_DIR     = FOLDER + "\\config";
var DEFAULT_PATH= CFG_DIR + "\\default.txt";
var ACTIVE_NAME = "현재 (tfm2_ai_adjust.cfg)";
try { if (!fso.FolderExists(CFG_DIR)) fso.CreateFolder(CFG_DIR); } catch(e){}

function readUtf8(path){
  if (!fso.FileExists(path)) return null;
  try {
    var s = new ActiveXObject("ADODB.Stream");
    s.Type = 2; s.Charset = "utf-8"; s.Open(); s.LoadFromFile(path);
    var t = s.ReadText(); s.Close(); return t;
  } catch(e){ return null; }
}
function writeUtf8NoBom(path, text){
  var s = new ActiveXObject("ADODB.Stream");
  s.Type = 2; s.Charset = "utf-8"; s.Open(); s.WriteText(text);
  s.Position = 0; s.Type = 1; s.Position = 3;     // 바이너리로 전환 후 BOM 3바이트 스킵
  var bin = s.Read(); s.Close();
  var o = new ActiveXObject("ADODB.Stream");
  o.Type = 1; o.Open(); o.Write(bin); o.SaveToFile(path, 2); o.Close();  // 2=덮어쓰기
}
function listConfigs(){
  var names = [ACTIVE_NAME, "default.txt"];
  try {
    if (fso.FolderExists(CFG_DIR)) {
      var en = new Enumerator(fso.GetFolder(CFG_DIR).Files);
      for (; !en.atEnd(); en.moveNext()) {
        var nm = en.item().Name;
        if (/\.cfg$/i.test(nm) && !contains(names, nm)) names.push(nm);
      }
    }
  } catch(e){}
  return names;
}
function resolvePath(name){
  if (name === ACTIVE_NAME) return ACTIVE_PATH;
  if (name === "default.txt") return DEFAULT_PATH;
  var safe = name.replace(/[\\\/:*?"<>|]/g, "");
  if (!/\.(cfg|txt)$/i.test(safe)) safe += ".cfg";
  return CFG_DIR + "\\" + safe;
}

/* ===================== 유틸 ===================== */
function contains(arr, x){ for (var i=0;i<arr.length;i++) if (arr[i]===x) return true; return false; }
function trimv(s){ return s.replace(/^\s+|\s+$/g, ""); }
function toDec(v){ if(v==null) return ""; var s=trimv(""+v); var m=s.match(/^([-+]?)0[xX]([0-9a-fA-F]+)$/); if(m){ var n=parseInt(m[2],16); return (m[1]==="-"?-n:n).toString(); } return s; }
function findTab(id){ for (var i=0;i<TABS.length;i++) if (TABS[i].id===id) return TABS[i]; return TABS[0]; }
function toast(msg, err){ var t=document.getElementById("toast"); t.innerHTML=msg; t.className=err?"err":""; t.style.display="block"; setTimeout(function(){ t.style.display="none"; }, 2200); }

/* ===================== cfg 파서/직렬화 (순서·주석 보존) ===================== */
function parseCfg(text){
  var lines = text.split(/\r\n|\r|\n/), entries=[], map={};
  for (var li=0; li<lines.length; li++){
    var ln = lines[li], t = trimv(ln);
    if (t === ""){ entries.push({type:"blank"}); continue; }
    if (t.charAt(0) === "#"){ entries.push({type:"comment", raw:t.replace(/^#+\s?/,"")}); continue; }
    var m = ln.match(/^\s*([A-Za-z0-9_]+)\s*=\s*([^#]*?)\s*(?:#\s?(.*))?$/);
    if (m){ var e={type:"kv", key:m[1], val:toDec(trimv(m[2])), desc:(m[3]?trimv(m[3]):"")}; map[m[1]]=entries.length; entries.push(e); }
    else entries.push({type:"comment", raw:t});
  }
  return {entries:entries, map:map};
}
function serialize(){
  var out=[];
  for (var i=0;i<MODEL.entries.length;i++){ var e=MODEL.entries[i];
    if (e.type==="kv" && typeof REMOVED!=="undefined" && REMOVED[e.key]) continue;   // ★폐기키 제외
    if (e.type==="blank") out.push("");
    else if (e.type==="comment") out.push("# "+e.raw);
    else out.push(e.key+" = "+e.val);
  }
  return out.join("\r\n")+"\r\n";
}
var MODEL = {entries:[], map:{}};
var DEFAULTS = {};
var DEFAULT_TEXT = "";
function getVal(k){ var i=MODEL.map[k]; return (i==null)?"":MODEL.entries[i].val; }
function setVal(k,v){ var i=MODEL.map[k]; if (i==null){ MODEL.map[k]=MODEL.entries.length; MODEL.entries.push({type:"kv",key:k,val:v,desc:""}); } else MODEL.entries[i].val=v; refreshChanged(); }
function descOf(k){ if (DESC[k]) return DESC[k]; var i=MODEL.map[k]; return (i==null)?"":(MODEL.entries[i].desc||""); }
function loadInto(text){
  var base = parseCfg(DEFAULT_TEXT.length ? DEFAULT_TEXT : text);
  var loaded = parseCfg(text);
  for (var k in loaded.map){
    var i = base.map[k];
    if (i==null){ base.map[k]=base.entries.length; base.entries.push({type:"kv",key:k,val:loaded.entries[loaded.map[k]].val,desc:""}); }
    else base.entries[i].val = loaded.entries[loaded.map[k]].val;
  }
  MODEL = base; render();
}

/* ===================== 탭 (분류 + 실제 계산식) ===================== */
var TABS = [
  {id:"feel", title:"⭐ 전체 성향", note:
    "AI 성향 메인 다이얼. 각 judge 세밀계수에 <b>전체 배율</b>로 곱해집니다. 빠르게 성향만 바꾸려면 여기만 건드리세요.<br>"+
    "· 최종 교전임계 = eng_role × <b>t_engage</b>/100 &nbsp;· recall 점수 += <b>t_recall</b><br>"+
    "· <small>t_ttd·t_gb 는 게임이 그 자리를 상수로 굳혀 값이 반영되지 않아 뺐습니다(050 하드코딩).</small>",
    keys:["t_engage","t_recall"]},
  {id:"added", title:"🆕 신규 추가 (포탑·전력·성향)", note:
    "게임 원본 AI에 <b>없던 항</b>을 추가한 기능입니다 (<span style='color:#48c78e'>초록 = 신규</span>). 전부 <b>0이면 원본과 완전히 동일</b>(검증됨).<br>"+
    "공통 <b>전력(force) 승산</b> = 근처 양팀 <code>(ΣHP)×(Σ공격)</code> 비교(100=호각, &gt;100=우세). <b>머릿수+세기를 동시 반영</b> → 적어도 강하면 싸우고, 많아도 약하면 뺍니다(게임 전투스탯 기반).<br>"+
    "<b>포탑 회피</b> (<code>tower_threat</code> 0~100): 적 포탑 사거리(<code>tower_range</code>) 안 + <code>tower_threat &ge; 승산</code>이면 후퇴. ↑=더 조심(100=호각싸움도 수비), 0=미적용. 정글러는 포탑딜을 생존TTD에 가산.<br>"+
    "<b>일반교전 전력 회피</b> (<code>numbers_threat</code> 0~100): 포탑 무관, <code>numbers_threat &ge; 승산</code>이면 후퇴(모든 싸움). 100=이길싸움만, 50=확실히 질때만, 0=원본.<br>"+
    "<b>성향 반영</b> (<code>stat_influence</code> 0~100, <b>라이너 전용 · 정글러 판단엔 미반영</b>): 위 포탑·전력 후퇴판단에 챔프 성향을 섞습니다. 0=off(현행), 기준=공격성50·에고50·판단력100.<br>"+
    "&nbsp;&nbsp;◦ <b>공격성·에고</b> → 후퇴 임계 시프트. 높을수록 <b>덜 후퇴</b>(공격성↑=다이브, 에고↑=잘 안 빠짐), 낮을수록 더 후퇴. <b>위쪽은 절반가중</b> — 공100·에100 = '많이 안 뺌'(거의 절대 안 뺌은 150/150쯤 필요한데 스탯 상한 100이라 도달 불가). 공0·에0이어도 많이 유리하면 들어갑니다.<br>"+
    "&nbsp;&nbsp;◦ <b>판단력</b> → 결정론 노이즈. 낮을수록 <b>양방향 오판</b>(들어갈 때 안 가고 · 뺄 때 안 빼고), 100=완벽 판단(노이즈 0). 게임 RNG를 안 써서 같은 리플레이는 같은 결과.<br>"+
    "&nbsp;&nbsp;<small>공식: <code>실효임계 = 임계 − ((f(공격성)+f(에고))×강도/100) + 판단노이즈</code>, <code>f(s)= s&gt;50? (s−50)/2 : (s−50)</code> → 후퇴 조건 <code>실효임계 &ge; 승산</code>.</small>",
    keys:["§🗼 포탑 회피 — 적 포탑 사거리내 불리하면 후퇴","tower_threat","tower_range","tower_dps",
          "§⚖ 전력 비교 (일반교전, 포탑 무관)","numbers_threat","numbers_range",
          "§🧠 성향 반영 — 공격성·에고·판단력으로 위 판단 보정","stat_influence"]},
  {id:"vision", title:"👁 시야 (사라진 적 기억)", note:
    "적이 시야에서 사라져도 <b>일정 시간(틱)동안은 '아는 적'으로 기억</b>해 판단에 반영합니다 — 그 시간이 지나면 '잊고' 위협 계산에서 빠집니다(과합류·방심의 원인).<br>"+
    "<code>현재틱 ≤ 마지막 본 틱 + 기억창</code> 이면 아직 인지. 값↑ = 더 오래 경계(신중), ↓ = 빨리 잊음(공격적). (대략 60틱 ≈ 1초)<br>"+
    "<b>vis_window</b> = 전체 판단(교전·운영·합류) 공용 기억창 · <b>dd_lane_margin</b> = 라인 판단(dd7700) 전용 기억창.",
    keys:["vis_window","dd_lane_margin"]},
  {id:"engage", title:"⚔ 교전 (Engage)", note:
    "적과 마주쳤을 때 <b>싸울지 / 물러설지</b> 결정합니다.<br>"+
    "주사위 <code>난수(0~100)</code>를 굴려 <code>난수 &ge; 전환점 → 후퇴</code>, 아니면 교전. 전환점 = <code>eng_role[우선순위]</code> 값.<br>"+
    "<b>대상 우선순위</b> = 눈앞 상대가 얼마나 '주요 타깃'인가 등급(에이스/캐리일수록 높음, 4=핵심 ~ 기타). 우선순위 높은 상대일수록 더 잘 싸우게 됨.<br>"+
    "→ <b>eng_role 값을 키울수록 전환점↑ → 후퇴 덜함 → 더 적극적으로 교전.</b>",
    keys:["t_engage","eng_role4","eng_role3","eng_role2","eng_role_def"]},
  {id:"gank", title:"🗡 갱킹 / 처치 (TTD)", note:
    "<b>돌아다니며 적을 기습(갱킹)</b>할 때 '이 적을 죽일 수 있나'를 판단합니다.<br>"+
    "<b>TTD</b>(Time-To-Death) = 대상을 <b>처치하는 데 걸리는 예상 시간</b>. 짧을수록 '잡을 각'. <code>TTD = 대상HP × d4_ttd_scale / (아군들의 시간당 처치 기여 합)</code>.<br>"+
    "각 아군 기여 = <code>데미지 × d4_dmg_scale / coef</code> — <b>coef</b>는 데미지를 '처치 속도'로 환산하는 보정값(적 dps·체력회복 반영, 작을수록 빨리 죽인다고 봄).<br>"+
    "<b>TTD 분자</b> = 식의 윗쪽(대상HP × d4_ttd_scale). 사거리(거리² &lt; d4_coord_dist) 안의 적만 판단. <code>TTD 짧으면 → 갱킹.</code>",
    keys:["d4_dmg_scale","d4_div_base","d4_coef_scale","d4_coef_min","d4_coef_clamp","d4_coord_dist","d4_ttd_scale"]},
  {id:"recall", title:"🏠 복귀 (Recall)", note:
    "<b>집/안전지대로 돌아갈지(복귀)</b>를 점수로 결정합니다.<br>"+
    "적 위협이 없거나 지킬 아군 오브젝트가 없으면 점수 0(복귀 안함). 있으면 <code>mult</code>를 누적:<br>"+
    "시작값 <code>rc_u21_init</code> → ±[적 HP%] ±[리콜포인트~적 거리] ±[아군 HP%] ±[아군~적 거리] +[수적우세]<br>"+
    "<code>점수 = 난수 × mult / 100 + t_recall</code>. 점수 클수록 복귀. <b>t_recall↑ = 자주 복귀(안전 지향).</b>",
    keys:["t_recall","rc_u21_init","rc_ehp_t1","rc_ehp_t2","rc_ehp_t3","rc_ehp_v1","rc_ehp_v2","rc_norp_bonus","rc_ed_near","rc_ed_mid","rc_ed_far","rc_ed_near_pen","rc_ed_far_bonus","rc_ed_vfar_bonus","rc_ahp_t1","rc_ahp_t2","rc_u13_bonus","rc_ahp2_pen","rc_ad_near","rc_ad_mid","rc_ad_near_bonus","rc_ad_far_pen","rc_mult_bonus","rc_ally_hp_min"]},
  {id:"gb", title:"🧭 운영전환 (GenericBuild)", note:
    "<b>운영(한타 합류 / 라인 밀기 / 오브젝트 등)</b>을 '대상까지 거리'로 분기합니다.<br>"+
    "기준값 <code>base = 위협 × 진척</code> 을 잡고, 대상까지 거리를 <b>근/중/원 3구간</b>으로 나눠 각각 다른 운영 행동을 고릅니다:<br>"+
    "&nbsp;· <b>근거리</b> 경계 = <code>base / gb_rbx_div</code> &nbsp;· <b>중거리</b> = <code>base / gb_r15_div</code> &nbsp;· <b>원거리</b> = <code>base × gb_r14_num / 100</code><br>"+
    "가까운 구간일수록 그 대상에 <b>더 적극 관여</b>, 멀수록 덜 관여. <b>분모(div)를 키우면 경계가 좁아져 그 구간이 작아지고, 줄이면 넓어집니다</b>(멀리까지 운영=경계 넓힘=분모↓, 국지적으로=분모↑).",
    keys:["gb_rbx_div","gb_r15_div","gb_r14_num"]},
  {id:"lane", title:"🛣 라인전 (dd7700)", note:
    "<b>라인전 이동</b> — 챔프가 라인에서 어디로 갈지(더 밀기 / 물러나기 / 수비 합류)를 정합니다.<br>"+
    "<b>진척</b> = 라인(미니언이 부딪히는 전선)이 적 진영 쪽으로 얼마나 밀렸는지. <b>전선(프론티어)</b> = 그 최전선. (사라진 적 인지 창 dd_lane_margin은 👁시야 탭으로 이동)<br>"+
    "· 물러나기: <code>적 전선진척 − 아군 전선진척 × dd_frontier_mult</code> 가 작으면(아군이 밀려있으면) 후퇴<br>"+
    "· 수비 합류: 근처 적이 <code>dd_cover_count</code>명 이상 &amp; 라인 비율 &lt; <code>dd_ratio_thr</code> 면 라인 버리고 합류<br>"+
    "· 근접 판정: 적이 <code>거리² &lt; dd_main_near_dist</code> 안이면 '가까운 적'. <b>거리값은 제곱거리(²)라 매우 큼(예 87890625 = 9375²).</b>",
    keys:["dd_frontier_mult","dd_cover_count","dd_ratio_thr","dd_facet_thr","dd_near_dist","dd_main_near_dist","dd_gatee_dist","dd_ivar2_thr","dd_n_thr","dd_survivor_thr"]},
  {id:"poke", title:"🎯 견제 (Poke)", note:
    "<b>주요 몬스터(에픽/뱀 같은 오브젝트) 견제·교전</b>을 판단합니다.<br>"+
    "홈(아군 진영)에서 벗어나 있고 체력이 넉넉하면 견제 진행 · 홈+오브젝트 완료면 귀환.<br>"+
    "<small>그 체력·홈 경계를 잡던 pk_* 값들은 2026-07-15 내부 개편 때 읽는 코드가 없어져 뺐습니다.</small><br>"+
    "<b>pf_ 값들 = 맵을 구역(띠='밴드')으로 나눠 챔프 위치를 판정</b>합니다 — 가장자리/중앙 대각선 같은 구역(견제 시 어디에 설지 판단용). '<b>m1 밴드</b>'는 그 위치판정 방식 중 한 모드.",
    keys:["pf_edge_margin","pf_center_band","pf_diag_far","pf_diag_near","pf_band_width","poke_reach_bonus","poke_serpen_slot"]},
  {id:"def", title:"🐍 세르펜 사냥·견제", note:
    "<b>세르펜(뱀) 사냥·견제</b> 때의 대기·귀환 판단입니다.<br>"+
    "<small>⚠이 탭은 오래 '수비(DefenseNexus)'로 잘못 이름 붙어 있었습니다 — 실제로 읽는 판단은 SerpenHuntAndPoke 입니다. "+
    "넥서스 공수는 <b>설정편집기.exe</b> 의 [18·19] 탭을 쓰세요.</small><br>"+
    "아군 회복존 안에서 다쳤으면 나가지 않고 대기(<code>sn_home_*</code>) · 체력이 낮고 근처 아군이 열세면 견제를 접습니다(<code>sn_hp_crit</code>·<code>sn_self_hp</code>).",
    keys:["sn_home_lo","sn_home_hi","sn_home_x1","sn_home_y1","sn_hp_crit","sn_self_hp"]},
  {id:"misc", title:"⋯ 기타", note:
    "교전 판단(battle)의 추격·후퇴 게이트입니다. 거리는 그냥 거리로 넣으세요(제곱 변환은 모드가 합니다).<br>"+
    "<small>구 d8_slot_thr·bt_home_* 은 읽는 코드에 도달하지 않아 뺐습니다.</small>",
    keys:["bt_hp_flee","bt_hp_gate","bt_chase_stop","bt_chase_keep","bt_vision_mem"]},
  {id:"path", title:"🚶 경로탐색 (어디로 걸어갈지)", note:
    "0.5.8 재핀으로 208개 패치지점을 되살린 <b>길찾기</b> 값입니다. 바이트패치라 다른 대체 스위치와 무관하게 항상 적용됩니다.<br>"+
    "· 직교/대각 <b>한 칸 비용</b>과 위험 회피 비용의 <b>상대 크기</b>가 경로를 정합니다 — 회피 비용만 올리면 크게 돌아갑니다.<br>"+
    "· 전부 <b>-1 = 게임 원본</b>. 적용 확인은 <code>path_imm.txt</code>.",
    keys:["path_orth_cost","path_diag_cost","path_greedy","path_danger_cost","path_threat_floor","path_threat_cap","path_threat_scale","path_threat_default","path_wave_risk_ret"]}
];

var TOGGLE = {};
(function(){ var t=["cond_repl","gbskip","mp_repl","dd7_repl","poke_repl","recall_repl","engage_repl","e9jt","d4_repl","d4ttd","perf_measure","read_bench","replay_reset","enabled"]; for(var i=0;i<t.length;i++) TOGGLE[t[i]]=1; })();
var ADDED = {};   // ★게임 원본에 없던 신규 추가 항(초록 "신규" 배지로 표시)
(function(){ var a=["tower_threat","tower_range","tower_dps","numbers_threat","numbers_range","stat_influence"]; for(var i=0;i<a.length;i++) ADDED[a[i]]=1; })();
var REMOVED = { numbers_margin: 1 };   // ★폐기된 키(전력비교 numbers_threat가 대체) — serialize서 제외해 "적용"때 cfg에 안 남김(모델에 잔존해도)
var SELECT = { fast_read:[["0","0 · VirtualQuery (원본/느림)"],["1","1 · VEH spinlock"],["2","2 · VEH lockless (안전·권장)"],["3","3 · 직접read (VEH無·최速·⚠크래시위험·실험)"]] };

var DESC = {
  poke_reach_bonus:"주 경로는 전술 무관 · 두 갈래만 전술 전용. 포탑=다이브와 수비=교전일 때만 타는 경로가 따로 있습니다. ✅근접 도달거리 보너스(좌표단위). ↑=더 멀어도 contested 판정. 원본 120000",
  poke_serpen_slot:"주 경로는 전술 무관 · 두 갈래만 전술 전용. 포탑=다이브와 수비=교전일 때만 타는 경로가 따로 있습니다. ✅serpen 웨이포인트 점유 임계(코드 5). 원본 5",
  sn_home_lo:"세르펜 사냥·견제: 아군 기지의 회복존 안에 있고 다친 상태(체력<최대)면 나가지 않고 대기합니다. 그 회복존 영역의 X/Y 하위 경계(원본 64000). 회복존은 넥서스도 에픽도 아닌 부상 유닛 회복 구역입니다. -1=원본",
  sn_home_hi:"세르펜 사냥·견제: 위 회복존 영역의 X/Y 상위 경계(원본 960000). -1=원본",
  sn_home_x1:"세르펜 사냥·견제: 회복존 X 안쪽 경계(원본 892000). -1=원본",
  sn_home_y1:"세르펜 사냥·견제: 회복존 Y 안쪽 경계(원본 896000). -1=원본",
  sn_hp_crit:"세르펜 사냥·견제: 내 체력%가 이 값 이하이고 세르펜 근처 아군이 적보다 적으면 견제를 접고 물러납니다(원본 20). ↑=조금만 다쳐도 물러남. -1=원본",
  sn_self_hp:"세르펜 사냥·견제: 위협 대상이 온전할 때, 내 체력%가 이 값 미만이면 견제를 멈추고 대기합니다(원본 51). 재는 것은 넥서스가 아니라 내 챔피언 체력입니다. -1=원본",
  bt_hp_flee:"교전 판단의 후퇴/추격 체력 임계(%, 원본 21). 대상 체력이 이 값 이상일 때만 원거리 추격 오더가 나갑니다. ↑=더 건강한 적에게도 추격 판단 / ↓=거의 안 나감. -1=원본",
  bt_hp_gate:"도주 판단의 우물 귀환 체력 임계(%, 원본 41). 내 체력이 이 값 이상이면 아군 수를 2명 더 있는 셈 쳐서 버팁니다(적 수 ≥ 보정 아군 수면 귀환). ↑=더 일찍 물러남 / ↓=더 오래 버팀. -1=원본",
  bt_chase_stop:"교전 시 접근 정지 반경(유닛, 원본 15000, 2곳 동시). 적에게 이만큼 다가가면 멈춥니다. ↑=멀리서 멈춤(소극적) / ↓=끝까지 붙음. ⚠2곳 중 한 곳은 정지 반경이 아니라 '적이 나에게 닿는가' 판정에 더하는 여유라, 올리면 적을 더 일찍 위협으로 세기도 합니다. -1=원본",
  bt_chase_keep:"교전 추격 유지 거리(유닛, 원본 80000, 1곳 동시). 이 거리까지는 대상을 계속 쫓습니다. ↑=끈질기게 물고 늘어짐 / ↓=금방 포기(다이브 억제). -1=원본",
  bt_vision_mem:"교전 판단의 '마지막으로 본 적' 유효 시간(틱, 원본 120, 1곳 동시·상한 127). 시야에서 사라진 적을 이 시간 동안은 그 자리에 있다고 간주합니다. ↑=기억이 오래감(유령 추격 가능) / ↓=금방 잊음. -1=원본",
  path_orth_cost:"상하좌우 한 칸 이동 비용(원본 640). 위험 회피 비용과의 <b>상대 크기</b>가 경로를 정합니다 — 이걸 올리면 위험을 감수하고 지름길로 가고, 내리면 멀리 돌아갑니다. ⚠640보다 <b>낮추면</b> 최단경로 보장이 깨집니다(크래시 아님). 올리는 쪽은 안전. <b>76곳 동시</b>. -1=원본",
  path_diag_cost:"대각선 한 칸 이동 비용(원본 896 ≈ 640×√2). 올리면 대각선을 꺼려 <b>계단식(맨해튼)</b>으로 움직이고, 640까지 내리면 대각선이 직교와 같은 값이라 매우 자유롭게 씁니다. ⚠896보다 낮추면 최단경로 보장이 깨집니다. <b>20곳 동시</b>. -1=원본",
  path_greedy:"경로 탐색의 <b>탐욕도</b>(원본 7 = 휴리스틱 ×128). 올리면 목적지 쪽으로 밀어붙여 빠르지만 경로가 나빠지고, <b>0이면 완전탐색</b>이라 최적 경로 대신 CPU를 많이 씁니다(시뮬 속도 저하 주의). 0~9. <b>54곳 동시</b>. -1=원본",
  path_danger_cost:"<b>미니언 웨이브가 죽는 자리</b>를 얼마나 피할지(원본 1281 = 2칸 우회×640 + 1). 0이면 그 자리를 신경 쓰지 않습니다. <b>50곳 동시</b>. -1=원본",
  path_threat_floor:"타워 등 <b>위험지대 위를 지날 때 최소 몇 칸 돌아갈지</b>(원본 2). 0으로 두면 위험을 거의 무시하고 직진합니다. 0~60. -1=원본",
  path_threat_cap:"위험 회피 우회의 <b>상한 칸 수</b>(원본 60). 아무리 위험해도 이보다 더 돌지는 않습니다. <b>2곳 동시</b>(비교문과 대입문). 0~127. -1=원본",
  path_threat_scale:"체력 대비 받을 피해에 얼마나 <b>민감</b>할지(원본 30). 우회 칸 수 = 하한 + 이 값 × (한 칸에서 받을 피해 ÷ 체력). 0이면 피해량과 무관하게 늘 하한만 돕니다. <b>2곳 동시</b>. -1=원본",
  path_threat_default:"위험원을 찾지 못했을 때 쓰는 <b>기본 우회 칸 수</b>(원본 2). <b>2곳 동시</b>. 0~60. -1=원본",
  path_wave_risk_ret:"위협원 <b>안에 서 있을 때</b> 매기는 위험등급(원본 3 = 최고). 낮추면 위험지대 한복판에서도 태연해집니다. -1=원본",
  t_engage:"교전 공격성 전체 배율%. 모든 eng_role 임계에 ×t_engage/100. 100보다 크면 교전 적극(임계↑→후퇴 덜함), 작으면 소극. 기본 100",
  t_recall:"복귀 성향 가산. recall 점수에 +t_recall. 0보다 크면 자주 복귀(안전), 작으면 덜 복귀(공격적 체류). 기본 0",
  rc_u21_init:"mult 시작값(누적 기준선). 낮을수록 복귀 점수 전반↓(잘 안 복귀). 여기에 아래 가·감산이 쌓임",
  rc_ehp_t1:"적 HP% 상한 — 가장 가까운 적 HP%가 이 값 미만일 때부터 복귀 가산 시작(적이 약하면 복귀해 정비)",
  rc_ehp_t2:"적 HP% 중간 임계 — 미만이면 더 큰 가산(rc_ehp_v1/v2 − 적HP%)",
  rc_ehp_t3:"적 HP% 하한 — 미만이면 rc_ehp_v1 기준, 이상이면 rc_ehp_v2 기준으로 가산",
  rc_ehp_v1:"적 HP% 최하위 구간 가산 기준값 (가산 = 이값 − 적HP%)",
  rc_ehp_v2:"적 HP% 중간 구간 가산 기준값",
  rc_norp_bonus:"리콜포인트(귀환 지점)가 없을 때 mult 가산",
  rc_ed_near:"리콜포인트→가장 가까운 적 거리 근접 임계(미만이면 적이 가까움→복귀 억제). 실좌표 단위",
  rc_ed_mid:"리콜포인트→적 중간 거리 임계(이 구간은 가감 없음)",
  rc_ed_far:"리콜포인트→적 원거리 임계(이상이면 초원거리 가산)",
  rc_ed_near_pen:"적이 리콜포인트에 근접할 때 감산(복귀 위험→억제)",
  rc_ed_far_bonus:"적이 원거리일 때 가산(안전→복귀 유도)",
  rc_ed_vfar_bonus:"적이 초원거리일 때 가산(더 큰 복귀 유도)",
  rc_ahp_t1:"아군 오브젝트 HP% 상한 — 이 미만이면 건강 보너스(rc_u13_bonus) 취소",
  rc_ahp_t2:"아군 오브젝트 HP% 하한 — 이 미만이면 추가 감산(rc_ahp2_pen). 아군이 위험=복귀해 지킴",
  rc_u13_bonus:"아군 오브젝트가 건강할 때 mult 가산",
  rc_ahp2_pen:"아군 오브젝트가 위험(HP%<rc_ahp_t2)일 때 감산",
  rc_ad_near:"아군 오브젝트→적 거리 근접 임계(미만이면 적이 아군 근처→복귀 유도)",
  rc_ad_mid:"아군→적 중간 거리 임계(이 구간 가감 없음)",
  rc_ad_near_bonus:"적이 아군 오브젝트에 근접할 때 가산(지키러 복귀)",
  rc_ad_far_pen:"적이 아군 오브젝트에서 멀 때 감산(급할 것 없음)",
  rc_mult_bonus:"아군 수가 적보다 많을 때(수적우세) mult 가산",
  rc_ally_hp_min:"아군 오브젝트를 '유효'로 셀 HP% 하한(이하면 무시)",
  eng_role4:"핵심 타깃(우선순위 4) 후퇴 전환점. 난수 ≥ (이값×t_engage/100)이면 후퇴. 클수록 더 적극 교전. 기본 100",
  eng_role3:"우선순위 3 후퇴 전환점. 기본 70",
  eng_role2:"우선순위 2 후퇴 전환점. 기본 50",
  eng_role_def:"기타(낮은 우선순위) 후퇴 전환점. 기본 30 (가장 낮음=가장 잘 후퇴)",
  d4_dmg_scale:"데미지를 처치 기여로 환산하는 배율. 클수록 적을 빨리 죽일 수 있다고 봐 TTD↓ → 갱킹 잘함. 기본 1000",
  d4_div_base:"처치속도(coef) 계산의 분모 기준값(적 체력회복에 더함). 키우면 처치를 더 빠르다고 계산. 기본 100",
  d4_coef_scale:"처치속도(coef) 계산 배율. 기본 100",
  d4_coef_min:"처치속도(coef) 최소 — 이보다 작으면 d4_coef_clamp로 고정. 기본 4",
  d4_coef_clamp:"coef가 너무 작을 때 대신 쓰는 값. 기본 3",
  d4_coord_dist:"갱킹 사거리(거리²) — 이 안의 적만 처치 판단(갱킹 활동 반경). 기본 14400000001 = 120000²+1. 키우면 더 멀리도 갱킹",
  d4_ttd_scale:"TTD 식의 분자 배율(대상HP × 이값). 키우면 TTD↑ = 처치 어렵다고 봐 갱킹 덜함. 기본 1000",
  gb_rbx_div:"근거리 구간 경계 = base / 이값. 키우면 경계↓(근거리 범위 좁아짐), 줄이면 넓어짐. 기본 100",
  gb_r15_div:"중거리 구간 경계 = base / 이값. 기본 50",
  gb_r14_num:"원거리 구간 경계 = base × 이값 / 100. 키우면 원거리 관여 범위↑. 기본 3",
  pf_edge_margin:"맵 가장자리 띠 두께 — 이 안쪽이면 '가장자리'로 판정(견제 위치 판단). 실좌표",
  pf_center_band:"중앙 대각선 띠 폭(맵 중앙선 근처인지 판정)",
  pf_diag_far:"대각선 띠의 원거리 컷", pf_diag_near:"대각선 띠의 근거리 컷", pf_band_width:"위치판정 한 모드(m1)에서 쓰는 띠 폭(세로−가로 절댓값 비교 기준)",
  dd_frontier_mult:"전선 계산 배수 — (적 전선진척 − 아군 전선진척 × 이값)가 작으면 후퇴. 키우면 아군 진척을 크게 차감 → 더 잘 물러남. 기본 30",
  vis_window:"★사라진 적 기억 시간창(틱) — 후보필터(CAND_FILTER) 기준이라 교전·운영·합류 등 대부분 판단에 영향(가장 광범위). 기본 600(≈10초). ↑=사라진 적 더 오래 경계(신중·덜 방심), ↓=빨리 잊음(공격적)",
  dd_lane_margin:"★dd7700(라인 판단) 전용 — 사라진 적 기억 시간창(틱). 현재틱 ≤ 마지막 본 틱 + 이값 이면 아직 '인지'. 기본 120(≈2초). ↑=더 오래 경계, ↓=빨리 잊음",
  dd_cover_count:"수비 합류 발동 적 수 — 근처 적이 이 수 이상이면 라인 버리고 합류. 기본 2",
  dd_ratio_thr:"수비 합류 라인비율 기준 — 라인 비율이 이 미만이면 합류. 기본 51",
  dd_facet_thr:"운영 단계 전환 기준 — 운영 진척값이 이보다 크면 강하게 밀기. 기본 999",
  dd_near_dist:"근처 적 세는 거리². 기본 87890624",
  dd_main_near_dist:"내 주변 적 판정 거리²(이 안이면 가까운 적). 기본 87890625 ≈ 9375²",
  dd_gatee_dist:"특정 지점↔타깃 근접 거리². 기본 112890625",
  dd_ivar2_thr:"라인 진척 단계 기준값. 기본 2", dd_n_thr:"라인 슬롯 수 기준값. 기본 2", dd_survivor_thr:"생존자 수 기준(이하면 조정). 기본 3",
  fast_read:"AI judge가 게임 메모리를 읽는 방식. 2=VEH lockless(가장 빠름, 권장). 문제 생기면 1→0 으로 낮춰 롤백",
  cond_repl:"facet#1 condgate(목표 커밋 판단)를 우리 코드로 대체",
  gbskip:"generic_build 영역D(운영전환)를 우리 코드로 대체(게임 원본 건너뜀)",
  mp_repl:"facet#4 movepriority 대체 — 이동 판단 마스터 스위치(아래 dd7/poke가 이걸 따름)",
  dd7_repl:"disc3 dd7700(라인전 이동) 대체 — mp_repl 켜져야 동작",
  poke_repl:"disc9/11 Epic/SerpenPoke(오브젝트 견제) 대체 — mp_repl 켜져야 동작",
  recall_repl:"facet#5 recall(복귀 판단) 대체", engage_repl:"facet#5 교전 진입 대체",
  e9jt:"engage 점프테이블 경로 사용(정확도↑). 보통 1", d4_repl:"disc4(갱킹) 대체. 0=이 부분만 게임 원본 위임", d4ttd:"disc4 TTD 계산 경로 사용. 보통 1",
  perf_measure:"judge별 처리시간 측정→perf.txt. 측정 자체가 약간 느리게 함 → 평소 0", replay_reset:"다시보기 시작 시 내부 상태 리셋. 보통 1",
  enabled:"SDK 기반 Move override(개발용). 평소 0", team:"override 대상 팀(개발용)", x:"override 좌표 X(개발용)", y:"override 좌표 Y(개발용)",
  coef_mult:"데미지 계수 배율%(검증용). 기본 100", engage_base:"engage 베이스 임계 정적 패치(-1=원본)", engage_thr_mult:"engage 임계 배율%(구버전 레버). 기본 100",
  tower_threat:"★신규(게임에 없던 항). 포탑 조심 강도 0~100. 적 포탑 사거리 안에서 tower_threat≥전력승산(근처 양팀 ΣHP×Σ공격 비교, 100=호각)이면 후퇴. 100=호각싸움도 수비, 0=원본(미적용). 정글러는 포탑딜을 생존TTD에 가산하는 강도이기도 함. 기본 0",
  tower_range:"★신규. 포탑 위협 판정 반경 — 이 거리 안의 적 포탑만 셈. 작으면 더 가까이서만 반응(덜 조심), 크면 멀리서도. 기본 140000",
  tower_dps:"★신규. 정글러(disc4) 전용 — 포탑1개당 생존TTD의 받는데미지에 가산할 양(threat=100 기준). 8000≈챔피언1명분 위협. 라이너엔 미사용. 기본 8000",
  numbers_threat:"★신규(정식 DPS×HP). 일반교전 전력(force)승산 회피 — 근처 양팀 (ΣHP)×(Σ공격) 전력비교로 승산 계산 → numbers_threat≥승산이면 후퇴(포탑무관, 모든 싸움). 0=off(원본), 100=호각싸움도 수비(이길싸움만 함), 50=확실히 질때만. 강하면 적어도 싸움(머릿수+세기 동시반영). 기본 0",
  numbers_range:"★신규. 근처 챔프 세는 반경(전력승산 계산 반경). 작으면 코앞 교전만, 크면 넓게. 기본 300000",
  stat_influence:"★신규. 성향스탯 반영 강도 0~100(0=off=현행). 챔프의 공격성·에고·판단력으로 ★라이너 포탑/전력 후퇴판단 보정(정글러 판단엔 미반영) — 공격성↑=덜 후퇴(다이브, 위쪽 절반가중이라 100/100=많이안뺌·150/150쯤 돼야 거의 절대안뺌), 에고↑=잘 안 빠짐, 판단력↓=양방향 오판(들어갈때 안 가고·뺄때 안 빼고, 결정론적). 기준=공격성50·에고50·판단력100(=현행). 기본 0"
};

/* ===================== 렌더 ===================== */
var activeTab = "feel";
function buildNav(){
  var nav=document.getElementById("nav"); nav.innerHTML="<div class='cat'>탭</div>";
  for (var i=0;i<TABS.length;i++){
    var b=document.createElement("button"); b.innerHTML=TABS[i].title;
    if (TABS[i].id===activeTab) b.className="active";
    b.onclick=(function(id){ return function(){ activeTab=id; render(); }; })(TABS[i].id);
    nav.appendChild(b);
  }
}
function mark(row,key){
  var changed = (DEFAULTS[key]!==undefined && getVal(key)!==DEFAULTS[key]);
  if (changed){ if (row.className.indexOf("changed")<0) row.className=trimv(row.className+" changed"); }
  else { row.className=trimv(row.className.replace(/changed/g,"")); }
}
function fieldRow(key){
  var tr=document.createElement("tr");
  if (ADDED[key]) tr.className="added";   // ★신규 항목 표시(초록)
  var def=DEFAULTS[key], cur=getVal(key);
  var td1=document.createElement("td"); td1.className="k"; td1.innerHTML=key+(ADDED[key]?"<span class='newbadge'>신규</span>":"")+"<small>기본 "+(def===undefined?"—":def)+"</small>";
  var td2=document.createElement("td"); td2.className="ctrl";
  if (SELECT[key]){
    var sel=document.createElement("select"); var opts=SELECT[key];
    for (var j=0;j<opts.length;j++){ var op=document.createElement("option"); op.value=opts[j][0]; op.text=opts[j][1]; if (opts[j][0]===cur) op.selected=true; sel.appendChild(op); }
    sel.onchange=(function(k,s,row){ return function(){ setVal(k,s.value); mark(row,k); }; })(key,sel,tr);
    td2.appendChild(sel);
  } else if (TOGGLE[key]){
    var cb=document.createElement("input"); cb.type="checkbox"; cb.checked=(cur==="1"||cur==="true");
    var lab=document.createElement("span"); lab.className="tg"; lab.innerHTML=(cb.checked?"켜짐":"꺼짐");
    cb.onclick=(function(k,c,l,row){ return function(){ var v=c.checked?"1":"0"; l.innerHTML=(c.checked?"켜짐":"꺼짐"); setVal(k,v); mark(row,k); }; })(key,cb,lab,tr);
    td2.appendChild(cb); td2.appendChild(lab);
  } else {
    var inp=document.createElement("input"); inp.type="text"; inp.className="txt"; inp.value=cur;
    inp.onkeyup=(function(k,n,row){ return function(){ setVal(k, trimv(n.value)); mark(row,k); }; })(key,inp,tr);
    inp.onchange=inp.onkeyup;
    td2.appendChild(inp);
  }
  var td3=document.createElement("td"); td3.className="desc"; td3.appendChild(document.createTextNode(descOf(key)||"(설명 없음)"));
  tr.appendChild(td1); tr.appendChild(td2); tr.appendChild(td3); mark(tr,key); return tr;
}
function sectionRow(title){   // ★단락 헤더 행(키 앞에 "§" 접두면 필드 대신 헤더)
  var tr=document.createElement("tr"); tr.className="sect";
  var td=document.createElement("td"); td.colSpan=3; td.innerHTML=title;
  tr.appendChild(td); return tr;
}
function render(){
  buildNav();
  var tab=findTab(activeTab), main=document.getElementById("main");
  main.innerHTML="";
  var note=document.createElement("div"); note.className="tabnote"; note.innerHTML=tab.note; main.appendChild(note);
  var tbl=document.createElement("table"); tbl.className="fields";
  for (var i=0;i<tab.keys.length;i++){ var k=tab.keys[i];
    if (k.charAt(0)==="§") tbl.appendChild(sectionRow(k.substring(1)));
    else tbl.appendChild(fieldRow(k)); }
  main.appendChild(tbl);
  refreshChanged();
}
function refreshChanged(){
  var n=0; for (var i=0;i<MODEL.entries.length;i++){ var e=MODEL.entries[i]; if (e.type==="kv" && DEFAULTS[e.key]!==undefined && e.val!==DEFAULTS[e.key]) n++; }
  document.getElementById("changed").innerHTML="변경 "+n;
}
function refreshList(){
  var names=listConfigs(), sel=document.getElementById("cfgSel"), keep=sel.value;
  sel.innerHTML="";
  for (var i=0;i<names.length;i++){ var o=document.createElement("option"); o.value=names[i]; o.text=names[i]; sel.appendChild(o); }
  if (keep){ for (var j=0;j<sel.options.length;j++){ if (sel.options[j].value===keep){ sel.selectedIndex=j; break; } } }
}

/* ===================== 버튼 ===================== */
document.getElementById("applyBtn").onclick=function(){
  try { if (fso.FileExists(ACTIVE_PATH)) fso.CopyFile(ACTIVE_PATH, CFG_DIR+"\\_prev.bak", true); } catch(e){}
  try { writeUtf8NoBom(ACTIVE_PATH, serialize()); toast("tfm2_ai_adjust.cfg 에 적용됨 → 게임 메뉴 진입 시 반영"); }
  catch(e){ toast("적용 실패: "+e.message, true); }
};
document.getElementById("saveAsBtn").onclick=function(){
  var name=prompt("config 폴더에 저장할 이름 (예: 공격적):", "");
  if (!name) return;
  name=trimv(name.replace(/[\\\/:*?"<>|]/g,""));
  if (!name) return;
  try { writeUtf8NoBom(resolvePath(name), serialize()); refreshList();
    var sel=document.getElementById("cfgSel"), want=(/\.(cfg|txt)$/i.test(name)?name:name+".cfg");
    for (var j=0;j<sel.options.length;j++){ if (sel.options[j].value===want){ sel.selectedIndex=j; break; } }
    toast("저장됨: config\\"+want);
  } catch(e){ toast("저장 실패: "+e.message, true); }
};
document.getElementById("loadBtn").onclick=function(){
  var name=document.getElementById("cfgSel").value; if (!name) return;
  var txt=readUtf8(resolvePath(name));
  if (txt==null){ toast("불러오기 실패: 파일 없음", true); return; }
  loadInto(txt); toast("불러옴: "+name);
};
document.getElementById("resetBtn").onclick=function(){
  if (!confirm("모든 값을 기본값(default.txt)으로 되돌립니다. 진행할까요?")) return;
  var txt=readUtf8(DEFAULT_PATH);
  if (txt==null){ toast("default.txt 를 찾지 못함", true); return; }
  loadInto(txt); toast("기본값으로 초기화");
};

/* ===================== 시작 ===================== */
(function init(){
  DEFAULT_TEXT = readUtf8(DEFAULT_PATH);
  if (DEFAULT_TEXT==null) DEFAULT_TEXT = readUtf8(ACTIVE_PATH);
  if (DEFAULT_TEXT==null) DEFAULT_TEXT = "";
  var dp=parseCfg(DEFAULT_TEXT);
  for (var k in dp.map) DEFAULTS[k]=dp.entries[dp.map[k]].val;

  var atxt=readUtf8(ACTIVE_PATH);
  if (atxt==null) atxt=DEFAULT_TEXT;
  if (atxt===""){ alert("tfm2_ai_adjust.cfg 또는 config\\default.txt 를 찾지 못했습니다.\nHTA 위치: "+FOLDER); }
  refreshList();
  loadInto(atxt);
})();
</script>
</body>
</html>
