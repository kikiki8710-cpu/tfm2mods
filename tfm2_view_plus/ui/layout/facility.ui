        width: 220px;
        height: 24px;
        size: 18;
        color: #e8e8e8ff;
        text: "";
      }
      #upgrade_btn:color_icon_button {
        @"asset/base/style/main#tertiary_button";
        anchor_x: 1;
        pivot_x: 1;
        anchor_y: 0;
        pivot_y: 0;
        x: -20px;
        y: 20px;
        width: 216px;
        height: 40px;
        text: {
          text: "#asset/base/text/ui?facility.upgrade_btn";
          font: "asset/base/font/set/bold";
          size: 18;
          align_x: Center;
          align_y: Center;
