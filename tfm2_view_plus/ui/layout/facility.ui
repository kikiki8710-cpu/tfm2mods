facility:facility_ui {
  width: 1600px;
  height: 968px;
  x: 32px;
  y: 24px;
  anchor_x: 0;
  pivot_x: 0;
  anchor_y: 0;
  pivot_y: 0;
  #header:label {
    @"asset/base/style/main#bold_label";
    text: "#asset/base/text/ui?main.facility";
    width: 1200px;
    height: 32px;
    visible: false;
    align_x: Left;
    align_y: Center;
    size: 24;
    color: #e8e8e8ff;
  }
  #contents:empty {
    y: 0px;
    width: 1600px;
    height: 968px;
    child_type: Table {
      spacing_x: 15px;
      spacing_y: 15px;
    }
    #gaming_house:color {
      width: 792.5px;
      height: 201px;
      color: #161721ff;
      rounding: Uniform {
        rounding: 12;
      }
      #panel_icon:image {
        x: 20px;
        y: 20px;
        width: 20px;
        height: 20px;
        source: "asset/base/ui/icons/facility_house";
        ignore_event: true;
      }
      #panel_header:label {
        @"asset/base/style/main#label";
        x: 46px;
        y: 20px;
        width: 300px;
        height: 24px;
        size: 18;
        color: #e8e8e8ff;
        text: "#asset/base/text/ui?facility.training_facility";
      }
      #grade_label:label {
        @"asset/base/style/main#label";
        x: 20px;
        y: 65px;
        width: 280px;
        height: 24px;
        size: 16;
        color: #a3a9b6ff;
        text: "#asset/base/text/ui?team_data.training_facility_grade_label";
      }
      #grade_value:label {
        @"asset/base/style/main#label";
