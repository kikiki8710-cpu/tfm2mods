slot:button {
  width: 1584px;
  height: 44px;

  source: "asset/base/sprite/white";
  color: #161721ff;

  hover: {
    color: #1d1f2cff;
  }

  active: {
    color: #1d1f2cff;
  }

  child_type: LeftToRight {
    spacing: 0px;
  }

  hover_sound: "asset/base/sound/sfx/UI_mouse_hover";
  click_sound: "asset/base/sound/sfx/UI_mouse_click";

  #position:empty {
    width: 173px;
    height: 44px;

    padding: {
      left: 20px;
    }

    #icon:image {
      anchor_y: 0.5;
      pivot_y: 0.5;

      width: 18px;
      height: 18px;

      source: "asset/base/ui/icons/top";
    }

    #text:label {
      x: 24px;
      width: 100%;
      height: 100%;
      @"asset/base/style/main#label";
      align_x: Left;
      align_y: Center;

      text: "-";
      size: 18;
    }
  }

  #name:empty {
    width: 220px;
    height: 44px;

    padding: {
      left: 20px;
    }

    #text:label {
      x: 29px;
      width: 171px;
      height: 100%;
      @"asset/base/style/main#label";
      align_x: Left;
      align_y: Center;

      text: "Player";
      size: 18;
      fit_width: true;
    }
  }

  #team:empty {
    width: 240px;
    height: 44px;

    padding: {
      left: 20px;
    }

    #icon:image {
      anchor_y: 0.5;
      pivot_y: 0.5;

      width: 20px;
      height: 20px;

      source: "asset/base/aseprite_resources/team_logo";
      rect_tag: "0_0";
    }

    #text:label {
      width: 100%;
      height: 100%;
      x: 26px;
      @"asset/base/style/main#label";
      align_x: Left;
      align_y: Center;

      text: "Team";
      size: 18;
    }
  }

  #contract:empty {
    width: 155px;
    height: 44px;

    padding: {
      left: 20px;
    }

    #text:label {
      width: 100%;
      height: 100%;
      @"asset/base/style/main#label";
      align_x: Left;
      align_y: Center;

      text: "-";
      size: 18;
    }
  }

  #salary:empty {
    width: 140px;
    height: 44px;

    padding: {
      left: 20px;
    }

    #text:label {
      width: 100%;
      height: 100%;
      @"asset/base/style/main#label";
      align_x: Left;
      align_y: Center;

      text: "0";
      size: 18;
    }
  }

  #transfer_fee:empty {
    width: 140px;
    height: 44px;

    padding: {
      left: 20px;
    }

    #text:label {
      width: 100%;
      height: 100%;
      @"asset/base/style/main#label";
      align_x: Left;
      align_y: Center;

      text: "0";
      size: 18;
    }
  }

  #recommendation:empty {
    width: 170px;
    height: 44px;

    #text:label {
      width: 100%;
      height: 100%;
      @"asset/base/style/main#label";
      align_x: Center;
      align_y: Center;

      text: "-";
      size: 18;
    }
  }

  #potential:empty {
    width: 170px;
    height: 44px;

    #text:label {
      width: 100%;
      height: 100%;
      @"asset/base/style/main#label";
      align_x: Center;
      align_y: Center;

      text: "-";
      size: 18;
    }
  }

  #spacer:empty {
    width: 138px;
    height: 44px;
  }

  #sab_spacer:empty {
    visible: false;
    width: 813px;
    height: 44px;
  }

  #sab_spacer_staff:empty {
    visible: false;
    width: 1153px;
    height: 44px;
  }

  #delete:empty {
    width: 38px;
    height: 44px;

    #btn:color_icon_button {
      @"asset/base/style/main#tertiary_button";

      visible: false;
      width: 32px;
      height: 32px;

      anchor_x: 0.5;
      pivot_x: 0.5;
      anchor_y: 0.5;
      pivot_y: 0.5;

      icon: {
        source: "asset/base/ui/icons/delete";
        rect: {
          x: 6;
          y: 6;
          w: 20;
          h: 20;
        }
      }
    }
  }
}
