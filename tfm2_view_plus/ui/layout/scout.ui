scout:scout_ui {
  width: 1600px;
  height: 968px;

  x: 32px;
  y: 24px;

  #tabs:color {
    visible: true;
    width: 1128px;
    height: 39px;

    padding: {
      left: 4px;
      right: 4px;
      top: 4px;
      bottom: 4px;
    }

    color: #4a4c56ff;
    stroke: 1;
    back_color: #00000000;

    child_type: LeftToRight {
      spacing: 0px;
    }

    rounding: Uniform {
      rounding: 8;
    }

    #contract:color_selectable {
      @"asset/base/style/main#strategy_option";

      width: 176px;
      height: 32px;

      label: {
        size: 16;
      }

      selected_label: {
        size: 16;
      }

      text: "#asset/base/text/ui?scout.contract";
    }

    #contract_all:color_selectable {
      @"asset/base/style/main#strategy_option";

      width: 220px;
      height: 32px;

      label: {
        size: 16;
      }

      selected_label: {
        size: 16;
      }

      text: "#asset/base/text/ui?scout.contract_all";
    }

    #search:color_selectable {
      @"asset/base/style/main#strategy_option";
      width: 176px;
      height: 32px;

      label: {
        size: 16;
      }

      selected_label: {
        size: 16;
      }

      text: "#asset/base/text/ui?scout.search";
    }

    #search_list:color_selectable {
      @"asset/base/style/main#strategy_option";

      width: 176px;
      height: 32px;

      label: {
        size: 16;
      }

      selected_label: {
        size: 16;
      }

      text: "#asset/base/text/ui?scout.list_tab";
    }

    #interested:color_selectable {
      @"asset/base/style/main#strategy_option";

      width: 132px;
      height: 32px;

      label: {
        size: 16;
      }

      selected_label: {
        size: 16;
      }

      text: "#asset/base/text/ui?scout.sub_tab.interested";
    }

    #released:color_selectable {
      @"asset/base/style/main#strategy_option";

      width: 132px;
      height: 32px;

      label: {
        size: 16;
      }

      selected_label: {
        size: 16;
      }

      text: "#asset/base/text/ui?scout.sub_tab.released";
    }

    #all_players:color_selectable {
      @"asset/base/style/main#strategy_option";

      width: 108px;
      height: 32px;

      label: {
        size: 16;
      }

      selected_label: {
        size: 16;
      }

      text: "#asset/base/text/ui?scout.sub_tab.all_players";
    }
  }

  #filter_bar:empty {
    visible: false;
    width: 304px;
    height: 39px;

    anchor_x: 1;
    pivot_x: 1;

    padding: {
      top: 2px;
    }

    #filter_btn:color_icon_button {
      @"asset/base/style/main#tertiary_button";
      anchor_x: 1;
      pivot_x: 1;
      width: 128px;
      height: 36px;

      centering: {
        x: 0;
        y: 0;
        w: 128;
        h: 36;
      }
      centering_left: true;

      icon: {
        source: "asset/base/ui/icons/filter";
        rect: {
          x: 14;
          y: 8;
          w: 20;
          h: 20;
        }
      }

      text: {
        text: "#asset/base/text/ui?scout.filter.btn";
        size: 16;
        align_x: Center;
        align_y: Center;
      }
    }

    #filter_clear_btn:color_icon_button {
      @"asset/base/style/main#secondary_button";
      anchor_x: 1;
      pivot_x: 1;
      x: -136px;
      width: 168px;
      height: 36px;
      visible: false;

      centering: {
        x: 0;
        y: 0;
        w: 168;
        h: 36;
      }
      centering_left: true;

      icon: {
        source: "asset/base/ui/icons/filter_in";
        rect: {
          x: 14;
          y: 8;
          w: 20;
          h: 20;
        }
      }

      text: {
        text: "#asset/base/text/ui?scout.filter.clear";
        size: 16;
        align_x: Center;
        align_y: Center;
      }
    }
  }

  #search_list_bulk_delete_btn:color_icon_button {
    @"asset/base/style/main#tertiary_button";
    visible: false;
    anchor_x: 1;
    pivot_x: 1;
    y: 2px;
    width: 128px;
    height: 36px;

    centering: {
      x: 0;
      y: 0;
      w: 128;
      h: 36;
    }
    centering_left: true;

    icon: {
      source: "asset/base/ui/icons/delete";
      rect: {
        x: 8;
        y: 6;
        w: 24;
        h: 24;
      }
    }

    text: {
      text: "#asset/base/text/ui?scout.list.delete_all";
      size: 16;
      align_x: Center;
      align_y: Center;
    }
  }

  #recr_ability_btn:color_icon_button {
    @"asset/base/style/main#tertiary_button";
    visible: false;
    x: 1136px;
    y: 2px;
    width: 40px;
    height: 36px;
    icon: {
      source: "asset/base/ui/icons/swap";
      rect: { x: 10; y: 8; w: 20; h: 20; }
    }

    #icon:image {
      ignore_event: true;
      x: 10px;
      y: 8px;
      width: 20px;
      height: 20px;
      source: "asset/base/ui/icons/swap";
      color: #d7dbe4ff;
    }

    #icon_off:image {
      ignore_event: true;
      x: 10px;
      y: 8px;
      width: 20px;
      height: 20px;
      source: "asset/base/ui/icons/swap";
      color: #5a5e68ff;
      visible: false;
    }
  }
  #league:dropdown {
    @"asset/base/style/main#dropdown";
    width: 306px;
    height: 40px;

    anchor_x: 1;
    pivot_x: 1;

    text: {
      size: 18;
    }

    item_text: {
      size: 18;
    }

    text_layout: {
      x: 14px;
      y: 6px;
      width: 100%;
      height: 28px;
    }

    item_layout: {
      height: 40px;
      width: 302px;
      x: 14px;
    }

    item_text_layout: {
      y: 6px;
      width: 288px;
      height: 28px;
    }
  }
  
  #contents:empty {
    y: 52px;
    width: 1600px;
    height: 916px;

    #player_staff_toggle:empty {
      width: 1600px;
      height: 70px;

      #inner:empty {
