      #list:scroll_view {
        width: 1600px;
        height: 778px;

        speed: 100;
        bar_width: 4;
        bar: {
          source: "asset/base/sprite/white";
          color: #37d5b3ff;

          hover: {
          color: #ecfbf8ff;
          }
        }

        back: {
          source: "asset/base/sprite/white";
          color: #4a4c56ff;
        }

        #contents:empty {
          width: 1584px;
          height: 900px;

          child_type: TopToBottom {
            spacing: 0px;
          }
        }
