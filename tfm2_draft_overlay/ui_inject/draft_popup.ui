      hover_sound: "asset/base/sound/sfx/UI_mouse_hover";
      click_sound: "asset/base/sound/sfx/UI_mouse_click";
      color: #00000000;
      btn: { color: #ffffff0f; hover: { color: #ffffff22; } active: { color: #37d5b344; } rounding: Uniform { rounding: 5; } }
      icon: { source: "asset/base/ui/icons/solorank"; rect: { x: 5; y: 6; w: 15; h: 15; } }
    }
    #scope0l:label { z: 300; @"asset/base/style/main#bold_label"; x: 288px; anchor_y: 0.5; pivot_y: 0.5; width: 77px; height: 28px; size: 14; ignore_event: true; align_x: Center; align_y: Center; color: #37d5b3ff; text: "전체"; }
