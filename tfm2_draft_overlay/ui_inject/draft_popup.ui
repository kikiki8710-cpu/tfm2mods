    #scrollzone:color { z: 300;
      margin: { top: 36px; left: 4px; right: 4px; }
      width: 100%; height: 626px;
      color: #00000000;

      #sbar_track:color { z: 300; anchor_x: 1; pivot_x: 1; x: -2px; y: 0px; width: 6px; height: 626px; ignore_event: true; visible: false; color: #ffffff10; rounding: Uniform { rounding: 3; }
        #sbar_thumb:color { z: 300; x: 0px; y: 0px; width: 6px; height: 60px; ignore_event: true; color: #37d5b3cc; rounding: Uniform { rounding: 3; } }
      }

      #scroll:scroll_view { z: 300;
        width: 100%; height: 626px;
        speed: 60; bar_width: 7;
        bar: { source: "asset/base/sprite/white"; color: #37d5b3ff; hover: { color: #ecfbf8ff; } }
        back: { source: "asset/base/sprite/white"; color: #4a4c56ff; }

        #list:empty { z: 300;
          margin: { left: 12px; right: 20px; }
          width: 725px; height: 3134px; y: 4px;
          child_type: TopToBottom { spacing: 1px; }

          #status:label { z: 300; @"asset/base/style/main#label"; width: 100%; height: 22px; size: 13; align_y: Center; color: #6f7686ff; text: "데이터 대기 중… (TFM2.gg 를 켜세요)"; }
