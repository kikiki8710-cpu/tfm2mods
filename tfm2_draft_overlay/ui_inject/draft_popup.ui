          #bpset0:color_icon_button { z: 300; x: 46px; y: 4px; width: 41px; height: 26px; hover_sound: "asset/base/sound/sfx/UI_mouse_hover"; click_sound: "asset/base/sound/sfx/UI_mouse_click"; color: #00000000; btn: { color: #ffffff12; hover: { color: #ffffff28; } active: { color: #ffffff3c; } rounding: Uniform { rounding: 5; } } }
