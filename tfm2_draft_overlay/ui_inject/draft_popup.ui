draft_root:empty { z: 300;
  width: 100%;
  height: 100%;

  #draft_overlay:draggable_popup { z: 300;
  anchor_x: 1;
  pivot_x: 1;
  anchor_y: 0;
  pivot_y: 0;
  x: -36px;
  y: 64px;
  width: 816px;
  height: 824px;
  visible: true;
  back_color: #00000000;

  #ov_blocker:color_icon_button { x: 0px; y: 44px; width: 816px; height: 780px; btn: { color: #00000000; hover: { color: #00000000; } active: { color: #00000000; } } }
  #ov_bg:color { z: 300; x: 0px; y: 0px; width: 100%; height: 100%; ignore_event: true; color: #161721ff; rounding: Uniform { rounding: 8; } }

  #header:color { z: 300;
    width: 100%;
    height: 44px;
    color: #0f1016ff;
    ignore_event: true;
    rounding: Individual { top_left: 8; top_right: 8; }
    #title:label { z: 300;
      @"asset/base/style/main#bold_label";
      x: 18px; anchor_y: 0.5; pivot_y: 0.5;
      width: 252px; height: 28px; size: 18; align_y: Center;
      color: #37d5b3ff;
      text: "TFM2.gg 메타 분석";
    }
    #scope0:color_icon_button { z: 300;
      x: 278px; anchor_y: 0.5; pivot_y: 0.5; width: 89px; height: 28px;
      hover_sound: "asset/base/sound/sfx/UI_mouse_hover";
      click_sound: "asset/base/sound/sfx/UI_mouse_click";
      color: #00000000;
      btn: { color: #ffffff0f; hover: { color: #ffffff22; } active: { color: #37d5b344; } rounding: Uniform { rounding: 5; } }
      icon: { source: "asset/base/ui/icons/all"; rect: { x: 5; y: 6; w: 15; h: 15; } }
    }
    #scope1:color_icon_button { z: 300;
      x: 371px; anchor_y: 0.5; pivot_y: 0.5; width: 89px; height: 28px;
