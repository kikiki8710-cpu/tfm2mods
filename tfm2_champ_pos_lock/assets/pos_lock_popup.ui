  #right:color {
    x: 1254px; y: 136px; width: 477px; height: 787px; color: #1d1f2cff;
    rounding: Uniform { rounding: 8; }

    #summary:label { @"asset/base/style/main#bold_label"; x: 24px; y: 24px; width: 429px; height: 28px; size: 18; align_y: Center; text: "포지션을 고르세요"; }
    #pos_hint:label { @"asset/base/style/main#label"; x: 24px; y: 68px; width: 429px; height: 100px; size: 16; line_height: 26; align_y: Center; text: "탭에서 포지션을 고르고, 그 포지션에 쓸 챔피언을 클릭해 켜고 끕니다. 아무것도 안 고르면 그 포지션은 모든 챔피언을 쓸 수 있습니다."; }
    #rule_label:label { @"asset/base/style/main#label"; x: 24px; y: 178px; width: 429px; height: 24px; size: 16; align_y: Center; }
    #ban_label:label { @"asset/base/style/main#label"; x: 24px; y: 206px; width: 429px; height: 24px; size: 16; align_y: Center; }
    #min_label:label { @"asset/base/style/main#label"; x: 24px; y: 234px; width: 429px; height: 24px; size: 16; align_y: Center; }
    #count_label:label { @"asset/base/style/main#bold_label"; x: 24px; y: 262px; width: 429px; height: 26px; size: 16; align_y: Center; }
    #warning_min:label { @"asset/base/style/main#label"; x: 24px; y: 298px; width: 429px; height: 100px; size: 15; line_height: 24; color: #ff4a4aff; align_y: Center; }

    #clear_pos:color_icon_button { @"asset/base/style/main#tertiary_button"; x: 24px; y: 470px; width: 429px; height: 40px; text: { text: "이 포지션 비우기(전체 허용)"; font: "asset/base/font/set/bold"; size: 17; align_x: Center; align_y: Center; } }
    #select_all_pos:color_icon_button { @"asset/base/style/main#tertiary_button"; x: 24px; y: 522px; width: 429px; height: 40px; text: { text: "이 포지션에 전체 선택"; font: "asset/base/font/set/bold"; size: 17; align_x: Center; align_y: Center; } }
  }

  #cancel:color_icon_button { @"asset/base/style/main#tertiary_button"; x: 654px; y: 943px; width: 220px; height: 40px; text: { text: "취소"; font: "asset/base/font/set/bold"; size: 18; align_x: Center; align_y: Center; } }
  #ok:color_icon_button { @"asset/base/style/main#tertiary_button"; x: 890px; y: 943px; width: 220px; height: 40px; text: { text: "확인"; font: "asset/base/font/set/bold"; size: 18; align_x: Center; align_y: Center; } }
