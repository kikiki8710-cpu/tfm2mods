      "min_label": "Minimum picks: {need}",
      "min_shared": "Minimum picks: {need}  ·  overlap {count} positions {have}/{want}",
      "count_zero": "Selected: 0 (all champions allowed)",
      "count_label": "Selected: {n}",
      "warn_ban_unknown": "⚠ Ban card count not read yet - reopen in a moment. Position limits are not applied until then.",
      "warn_min": "⚠ Pool {pool} < minimum {need} - this position is treated as unrestricted ({more} more needed){tail}",
      "status_active": "✔ Limit active - pool {pool} >= minimum {need}",
      "status_active_shared": "✔ Limit active - pool {pool} >= minimum {need}  ·  FYI: {count} overlapping positions share a pool, {want} recommended in total (currently {have}) - does not change whether the limit applies",
      "warn_min_tail_stale": " · {n} champions not in the current roster are excluded from the count",
      "warn_shared": "⚠ {count} overlapping positions share a champion pool - {want} needed in total (currently {have})",
